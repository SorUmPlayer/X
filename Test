local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Garante que a GUI fique visível em cima do jogo (Exploit UI)
local TargetParent = (gethui and gethui()) or game:GetService("CoreGui")

local Window = WindUI:CreateWindow({
    Title = "Fake VR System v2",
    Icon = "gamepad-2",
    Author = "Script",
    Folder = "FakeVRConfig"
})

local Tab = Window:Tab({ Title = "Controles VR", Icon = "user" })

local VR_Enabled = false
local Sensitivity = 0.04
local LeftRotX, LeftRotY = 0, 0
local RightRotX, RightRotY = 0, 0
local BobStep = 0

-- Criando ScreenGui com DisplayOrder Alto
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FakeVR_Joysticks_Fix"
ScreenGui.DisplayOrder = 999
ScreenGui.ResetOnSpawn = false
ScreenGui.Enabled = false
ScreenGui.Parent = TargetParent

local function CreateJoystick(position, name)
    local Frame = Instance.new("Frame")
    Frame.Name = name
    Frame.Size = UDim2.new(0, 140, 0, 140)
    Frame.Position = position
    Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Frame.BackgroundTransparency = 0.2
    Frame.BorderSizePixel = 2
    Frame.BorderColor3 = Color3.fromRGB(0, 170, 255)
    Frame.Active = true
    Frame.ZIndex = 100
    Frame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(1, 0)
    UICorner.Parent = Frame

    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.Size = UDim2.new(0, 50, 0, 50)
    Knob.Position = UDim2.new(0.5, -25, 0.5, -25)
    Knob.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 101
    Knob.Parent = Frame

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local Dragging = false
    local VectorOutput = Vector2.new(0, 0)

    local function UpdateInput(input)
        local Center = Frame.AbsolutePosition + (Frame.AbsoluteSize / 2)
        local InputPos = Vector2.new(input.Position.X, input.Position.Y)
        local Direction = InputPos - Center
        local Distance = math.min(Direction.Magnitude, Frame.AbsoluteSize.X / 2)

        if Direction.Magnitude > 0 then
            Direction = Direction.Unit * Distance
        end

        Knob.Position = UDim2.new(0.5, Direction.X - 25, 0.5, Direction.Y - 25)
        VectorOutput = Direction / (Frame.AbsoluteSize.X / 2)
    end

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            UpdateInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
            Knob.Position = UDim2.new(0.5, -25, 0.5, -25)
            VectorOutput = Vector2.new(0, 0)
        end
    end)

    return function() return VectorOutput end
end

local GetLeftInput = CreateJoystick(UDim2.new(0.05, 0, 0.55, 0), "LeftJoystick")
local GetRightInput = CreateJoystick(UDim2.new(0.75, 0, 0.55, 0), "RightJoystick")

Tab:Toggle({
    Title = "Ativar Fake VR",
    Desc = "Mostra analógicos na tela e libera controle total dos braços.",
    Value = false,
    Callback = function(Value)
        VR_Enabled = Value
        ScreenGui.Enabled = Value
    end
})

-- Intercepta as animações no Stepped para os braços não travarem/resetarem
RunService.Stepped:Connect(function(_, deltaTime)
    if not VR_Enabled then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local LeftInput = GetLeftInput()
    local RightInput = GetRightInput()

    -- Acumula a rotação baseada no movimento dos analógicos
    LeftRotX = math.clamp(LeftRotX - (LeftInput.Y * Sensitivity), -2, 2)
    LeftRotY = math.clamp(LeftRotY - (LeftInput.X * Sensitivity), -2, 2)

    RightRotX = math.clamp(RightRotX - (RightInput.Y * Sensitivity), -2, 2)
    RightRotY = math.clamp(RightRotY - (RightInput.X * Sensitivity), -2, 2)

    -- Busca as juntas nos modelos R6 e R15
    local LeftShoulder = Character:FindFirstChild("Left Shoulder", true) or Character:FindFirstChild("LeftShoulder", true)
    local RightShoulder = Character:FindFirstChild("Right Shoulder", true) or Character:FindFirstChild("RightShoulder", true)

    if LeftShoulder then
        LeftShoulder.Transform = CFrame.new() -- Anula a animação padrão do Roblox
        LeftShoulder.C0 = CFrame.new(-1, 0.5, 0) * CFrame.Angles(LeftRotX, LeftRotY, 0)
    end

    if RightShoulder then
        RightShoulder.Transform = CFrame.new() -- Anula a animação padrão do Roblox
        RightShoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(RightRotX, RightRotY, 0)
    end
end)

-- Movimentação visual de câmera estilo VR
RunService.RenderStepped:Connect(function(deltaTime)
    if not VR_Enabled then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid and Humanoid.MoveDirection.Magnitude > 0 then
        BobStep = BobStep + (deltaTime * Humanoid.WalkSpeed * 1.2)
        local BobOffset = Vector3.new(
            math.cos(BobStep * 0.5) * 0.2,
            math.abs(math.sin(BobStep)) * 0.25,
            0
        )
        Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(BobOffset, 0.2)
    elseif Humanoid then
        Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(Vector3.new(0, 0, 0), 0.1)
    end
end)
