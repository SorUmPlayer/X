-- Toca a música (ID fornecido) com tentativa de repetição
local function playMusic()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://74575218169013"
    sound.Volume = 0.5
    sound.Looped = false
    sound.Parent = screenGui
    sound:Play()
    -- Se não tocar, tenta novamente após 1 segundo
    task.wait(1)
    if not sound.Playing then
        sound:Play()
    end
end
