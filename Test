local function aplicarHitboxNormal()
    if not hitbox then return end
    if hitboxReach then return end -- reach tem prioridade

    if hitboxNormal and not euTenhoBola() then
        hitbox.Size = Vector3.new(hitboxPlayerMagnetSize, hitboxPlayerMagnetSize, hitboxPlayerMagnetSize)
        hitbox.Transparency = 1
    elseif not hitboxNormal and not hitboxPlayerMagnet and not hitboxReach then
        hitbox.Size = hitboxOriginalSize
        hitbox.Transparency = hitboxOriginalTransparency
    end
end

-- =============================================
-- HITBOX PLAYER + MAGNET (software, touch interest)
-- =============================================
local function aplicarPlayerMagnet()
    if not hitboxPlayerMagnet then return end
    if euTenhoBola() then return end

    local ball = getBall()
    if not ball then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Magnet: puxa a bola se estiver perto
    local dist = (hrp.Position - ball.Position).Magnitude
    if dist <= magnetRange then
        local dir = (hrp.Position - ball.Position).Unit
        ball.AssemblyLinearVelocity = ball.AssemblyLinearVelocity + dir * 15
    end

    -- Player hitbox: touch interest quando muito perto (mesmo com velocidade alta)
    if dist <= hitboxPlayerMagnetSize then
        if firetouchinterest then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        firetouchinterest(part, ball, 0)
                        firetouchinterest(part, ball, 1)
                    end)
                end
            end
        end
    end
end

-- =============================================
-- HITBOX REACH (nova parte)
-- =============================================
local function atualizarReach()
    if not hitboxReach then
        if reachPart then
            reachPart:Destroy()
            reachPart = nil
        end
        return
    end

    local char = player.Character
    if not char then
        if reachPart then reachPart:Destroy() reachPart = nil end
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if reachPart then reachPart:Destroy() reachPart = nil end
        return
    end

    if not reachPart or not reachPart.Parent then
        reachPart = Instance.new("Part")
        reachPart.Name = "ReachHitbox"
        reachPart.Shape = Enum.PartType.Ball
        reachPart.Size = Vector3.new(hitboxReachSize, hitboxReachSize, hitboxReachSize)
        reachPart.Transparency = 1
        reachPart.CanCollide = false
        reachPart.Massless = true
        reachPart.Anchored = false
        reachPart.Parent = Workspace
    end

    reachPart.Size = Vector3.new(hitboxReachSize, hitboxReachSize, hitboxReachSize)
    reachPart.CFrame = hrp.CFrame

    -- Touch com a bola para pegar de longe
    if euTenhoBola() then return end
    local ball = getBall()
    if ball then
        local dist = (hrp.Position - ball.Position).Magnitude
        if dist <= hitboxReachSize then
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(reachPart, ball, 0)
                    firetouchinterest(reachPart, ball, 1)
                end)
            end
        end
    end
end

-- =============================================
-- ESP (mostra para Player+Magnet e Reach)
-- =============================================
local function atualizarESP()
    -- Player+Magnet ESP
    if mostrarESP and hitboxPlayerMagnet and hitbox and not euTenhoBola() then
        if not espSphere then
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = "PlayerMagnetESP"
            espSphere.Adornee = hitbox
            espSphere.Parent = hitbox
            espSphere.Color3 = Color3.fromRGB(0, 255, 0)
            espSphere.Transparency = 0.6
        end
        local scale = hitboxPlayerMagnetSize / 2.5
        espSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espSphere then espSphere:Destroy() espSphere = nil end
    end

    -- Reach ESP
    if mostrarESP and hitboxReach and reachPart then
        if not espReach then
            espReach = Instance.new("SelectionSphere")
            espReach.Name = "ReachESP"
            espReach.Adornee = reachPart
            espReach.Parent = reachPart
            espReach.Color3 = Color3.fromRGB(255, 165, 0)
            espReach.Transparency = 0.7
        end
        local scale = hitboxReachSize / 2.5
        espReach.Scale = Vector3.new(scale, scale, scale)
    else
        if espReach then espReach:Destroy() espReach = nil end
    end
end

-- =============================================
-- FORÇA DA BOLA
-- =============================================
local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    if not bola or not bolaValida then return end

    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        local vel = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
        bola.AssemblyLinearVelocity = vel
        -- Garante que o chute saia mesmo com lag
        task.wait(0.05)
        pcall(function() bola.AssemblyLinearVelocity = vel end)
    end
    tinhaBola = tenho
end

-- =============================================
-- CURVAS
-- =============================================
local function aplicarCurvas()
    if not curvasEnabled then return end
    if not bola or not bolaValida then return end
    if euTenhoBola() then return end

    local vel = bola.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed < 40 then return end
    if bola.Position.Y < 0.5 then return end

    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit

    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1

    if curvasModo == 1 then lado = 1
    elseif curvasModo == 2 then lado = -1
    elseif curvasModo == 3 then
        local now = tick()
        if now - curvasTimer > curvasIntervalo then
            curvasTimer = now
            curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
            curvasIntervalo = 0.5 + math.random() * 0.5
        end
        lado = curvasDirecaoAtual
    end

    local forcaLateral = perp * lado * fator
    bola.AssemblyLinearVelocity = vel + forcaLateral
end

