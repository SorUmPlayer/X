-- ===== ABA AUTO EXECUTE =====
local AutoTab = Window:Tab({ Title = "Auto Execute", Icon = "clock" })
local AutoSec = AutoTab:Section({ Title = "Configuração", TextXAlignment = "Left" })

local savedGame = "BlueLockRivals"
local autoEnabled = false

-- Salvar estado (usando dados do jogador)
local function saveState()
    local data = {
        game = savedGame,
        enabled = autoEnabled
    }
    -- Salva no player (persiste entre sessões)
    local save = Instance.new("StringValue")
    save.Name = "SorHubAutoExecute"
    save.Value = game:GetService("HttpService"):JSONEncode(data)
    save.Parent = player
end

local function loadState()
    local save = player:FindFirstChild("SorHubAutoExecute")
    if save then
        local data = game:GetService("HttpService"):JSONDecode(save.Value)
        savedGame = data.game or "BlueLockRivals"
        autoEnabled = data.enabled or false
    end
end

loadState()

local dropdown = AutoSec:Dropdown({
    Title = "Script",
    Desc = "Selecione o script para executar automaticamente",
    Options = {"BlueLockRivals", "VolleyballLegends", "FechaduraAzure"},
    Callback = function(opt)
        savedGame = opt
        saveState()
    end
})

local toggle = AutoSec:Toggle({
    Title = "Executar",
    Desc = "Ativa/desativa a execução automática ao entrar",
    Callback = function(v)
        autoEnabled = v
        saveState()
        if v then
            loadstring(game:HttpGet(gameUrls[savedGame]))()
        end
    end
})

-- Executa automaticamente se estiver ativado
if autoEnabled then
    task.spawn(function()
        loadstring(game:HttpGet(gameUrls[savedGame]))()
    end)
end

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification",{
        Title = "SorHub",
        Text = "Hub Central carregado!",
        Duration = 3
    })
end)
