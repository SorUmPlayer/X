local function getInimigoComBola()
    local my = getMyTeam()
    if not my then return nil end
    for _, o in ipairs(Players:GetPlayers()) do
        if o ~= player and o.Character and o.Character:FindFirstChild("Football") then
            local v = o:FindFirstChild("Values")
