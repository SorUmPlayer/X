-- =====================================================
--  LÓGICA DE BLOQUEIO DO AIMBOT (DELAY)
-- =====================================================
local function shouldAimbotWork()
    local tenho = euTenhoBola()
    
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    
    return true
end

-- =====================================================
--  HITBOX DO JOGADOR (DETECÇÃO DE TOQUE)
-- =====================================================
local function aplicarHitboxJogador()
    if not hitboxJogadorAtivo then
        if jogadorBox then
            jogadorBox:Destroy()
            jogadorBox = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Criar/atualizar a box visual ao redor do jogador (ESP)
    if mostrarESP then
        if not jogadorBox then
            jogadorBox = Instance.new("SelectionBox")
            jogadorBox.Name = "JogadorHitboxESP"
            jogadorBox.Adornee = hrp
            jogadorBox.Parent = hrp
            jogadorBox.Color3 = Color3.fromRGB(0, 100, 255) -- azul
            jogadorBox.Transparency = 0.6
        end
        -- Ajusta o tamanho da caixa
        local size = hitboxJogadorTamanho * 2
        jogadorBox.Size = Vector3.new(size, size, size)
    else
        if jogadorBox then
            jogadorBox:Destroy()
            jogadorBox = nil
        end
    end

    -- Verificar colisão com a bola
    if hitbox and bolaValida then
        local dist = (hrp.Position - hitbox.Position).Magnitude
        if dist <= hitboxJogadorTamanho then
            -- Força o toque para pegar a bola
            if firetouchinterest then
                firetouchinterest(hrp, hitbox, 0)
                task.wait()
                firetouchinterest(hrp, hitbox, 1)
            end
        end
    end
end

-- =====================================================
--  TAMANHO VISUAL DA BOLA
-- =====================================================
local function aplicarTamanhoVisual()
    if not tamanhoVisualAtivo then
        -- Restaura tamanhos originais
        for part, size in pairs(visualOriginalSizes) do
            if part and part.Parent then
                part.Size = size
            end
        end
        visualOriginalSizes = {}
        return
    end

    if not bolaValida or not bola then return end

    -- Atualiza partes visuais
    for _, part in ipairs(bolaVisualParts) do
        if part and part:IsA("BasePart") then
            if not visualOriginalSizes[part] then
                visualOriginalSizes[part] = part.Size
            end
            local newSize = visualOriginalSizes[part] * tamanhoVisualMultiplicador
            part.Size = newSize
        end
    end
end

-- =====================================================
--  HITBOX DA BOLA (REACH) + ESP
-- =====================================================
local function aplicarHitboxBola()
    if not hitbox then return end

    if not hitboxBolaAtivo or euTenhoBola() then
        -- Restaura tamanho original
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        if espBolaBox then
            espBolaBox:Destroy()
            espBolaBox = nil
        end
        return
    end

    -- Aplica tamanho e transparência (invisível)
    local novoSize = Vector3.new(hitboxBolaTamanho, hitboxBolaTamanho, hitboxBolaTamanho)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 1
    end

    -- ESP da bola (verde) com SelectionBox
    if mostrarESP then
        if not espBolaBox then
            espBolaBox = Instance.new("SelectionBox")
            espBolaBox.Name = "BolaHitboxESP"
            espBolaBox.Adornee = hitbox
            espBolaBox.Parent = hitbox
            espBolaBox.Color3 = Color3.fromRGB(0, 255, 0) -- verde
            espBolaBox.Transparency = 0.5
        end
        local size = hitboxBolaTamanho * 2
        espBolaBox.Size = Vector3.new(size, size, size)
    else
        if espBolaBox then
            espBolaBox:Destroy()
            espBolaBox = nil
        end
    end
end

-- =====================================================
--  LOOP PRINCIPAL (UNIFICA TUDO)
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        aplicarHitboxBola()
        aplicarHitboxJogador()
        aplicarTamanhoVisual()
    end
end)

-- =====================================================
--  CONTROLE BOLA – BOTÃO FLUTUANTE
-- =====================================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    
    if isControlActive then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        
        if controlConnection then controlConnection:Disconnect() end
        
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                camera.CameraSubject = ball
                local lookVector = camera.CFrame.LookVector
                ball.AssemblyLinearVelocity = lookVector * velocidadeBola
            else
                resetCamera()
            end
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        
        resetCamera()
    end
end

local function criarBotaoFlutuante()
    if controlScreenGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGui"
    screenGui.ResetOnSpawn = false
    safeParent(screenGui)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Control BALL [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn

    btn.MouseButton1Click:Connect(toggleControl)

