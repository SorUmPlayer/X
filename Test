-- =====================================================
--  FUNÇÃO SEGURA DE PARENT
-- =====================================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false
local bolaVisualParts = {}

local function atualizarReferenciaBola()
    -- Procura a bola solta
    local football = Workspace:FindFirstChild("Football")
    if football then
        bola = football
        local hb = bola:FindFirstChild("Hitbox")
        hitbox = (hb and hb:IsA("BasePart")) and hb or bola
        bolaValida = true
        -- Guarda partes visuais (todas as BasePart que não são a hitbox)
        bolaVisualParts = {}
        for _, part in ipairs(bola:GetDescendants()) do
            if part:IsA("BasePart") and part ~= hitbox then
                table.insert(bolaVisualParts, part)
            end
        end
        return
    end

    -- Procura a bola em posse de algum jogador
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local f = child:FindFirstChild("Football")
            if f then
                bola = f
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true
                bolaVisualParts = {}
                for _, part in ipairs(bola:GetDescendants()) do
                    if part:IsA("BasePart") and part ~= hitbox then
                        table.insert(bolaVisualParts, part)
                    end
                end
                return
            end
        end
    end

    -- Se não achou, invalida
    bola = nil
    hitbox = nil
    bolaValida = false
    bolaVisualParts = {}
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
atualizarReferenciaBola()

-- =====================================================
--  GETBALL (PARA O BOTÃO DE CONTROLE)
-- =====================================================
local function getBall()
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

-- =====================================================
--  POSSE DA BOLA
-- =====================================================
local function euTenhoBola()
    local meuModel = Workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

