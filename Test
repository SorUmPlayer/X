-- Função para criar item no dropdown
local function CreateDropdownItem(npc, name, health)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 25)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = name .. " (HP: " .. math.floor(health) .. ")"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSans
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(80, 80, 80)
    btn.Parent = DropdownList

    btn.MouseButton1Click:Connect(function()
        SelectedNPC = npc
        SelectedNPCLabel.Text = name .. " (HP: " .. math.floor(health) .. ")"
        DropdownFrame.Visible = false
        -- Destacar NPC (Chams)
        HighlightNPC(npc)
    end)
    return btn
end

-- Função para destacar NPC (verde)
local function HighlightNPC(npc)
    -- Remover highlight anterior
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Name == "FarmHighlight" then
            obj:Destroy()
        end
    end
    if not npc then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "FarmHighlight"
    highlight.Adornee = npc
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.5
    highlight.Parent = npc
end

-- Função de Scannear
local function ScanNPCs()
    -- Limpar lista
    for _, child in pairs(DropdownList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    NPCList = {}
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local distThreshold = 50 -- raio de busca

    for _, npc in pairs(workspace:GetDescendants()) do
        if npc:IsA("Model") and npc:FindFirstChild("Humanoid") then
            local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            if hrp then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= distThreshold then
                    local humanoid = npc:FindFirstChild("Humanoid")
                    if humanoid then
                        local health = humanoid.Health
                        local maxHealth = humanoid.MaxHealth
                        local healthPercent = health / maxHealth * 100
                        -- Criar item no dropdown
                        local item = CreateDropdownItem(npc, npc.Name, health)
                        table.insert(NPCList, npc)
                    end
                end
            end
        end
    end
    -- Atualizar canvas size
    local count = #DropdownList:GetChildren()
    DropdownList.CanvasSize = UDim2.new(0, 0, 0, count * 27)
end

ScanBtn.MouseButton1Click:Connect(function()
    ScanNPCs()
    -- Opcional: fechar dropdown
    DropdownFrame.Visible = false
end)

