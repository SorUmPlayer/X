local function getBall()
    if bola and bolaValida then return bola end
    local fb = Workspace:FindFirstChild("Football")
    if fb then
        local ba = fb:FindFirstChild("BallAnims")
        if ba then
            if ba:IsA("BasePart") then return ba end
            return ba:FindFirstChildWhichIsA("BasePart") or ba.PrimaryPart
        end
    end
    return nil
end
local function euTenhoBola()
    local m = Workspace:FindFirstChild(player.Name)
    if m and m:FindFirstChild("Football") then return true end
