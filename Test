local reachNovaPart = nil

local function criarReachNova()
    if reachNovaPart then return end
    reachNovaPart = Instance.new("Part")
    reachNovaPart.Name = "ReachNovaHitbox"
    reachNovaPart.Shape = Enum.PartType.Ball
    reachNovaPart.Size = Vector3.new(reachNovaTamanho, reachNovaTamanho, reachNovaTamanho)
    reachNovaPart.Transparency = 1
    reachNovaPart.CanCollide = false
    reachNovaPart.CanTouch = true
    reachNovaPart.CanQuery = true
    reachNovaPart.Anchored = true
    reachNovaPart.Massless = true
    reachNovaPart.Parent = Workspace
end

local function removerReachNova()
    if reachNovaPart then
        reachNovaPart:Destroy()
        reachNovaPart = nil
    end
end

local function atualizarReachNova()
    if not hitboxReachNovaAtivo then
        removerReachNova()
        return
    end

    local ball = getBall()
    if not ball then
        removerReachNova()
        return
    end

    criarReachNova()
    if reachNovaPart then
        reachNovaPart.Size = Vector3.new(reachNovaTamanho, reachNovaTamanho, reachNovaTamanho)
        reachNovaPart.CFrame = ball.CFrame

        -- Força toque com o player se estiver dentro
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - reachNovaPart.Position).Magnitude
                if dist <= (reachNovaTamanho / 2) + 3 then
                    if firetouchinterest then
                        firetouchinterest(hrp, ball, 0)
                        task.wait()
                        firetouchinterest(hrp, ball, 1)
                    end
                end
            end
        end
    end
end

