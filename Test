-- CÓDIGO DO JOGO
-- =============================================
local function getBall()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        return basketball:FindFirstChild("AnimBall")
    end
    return nil
end

local function getCollider()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        return basketball:FindFirstChild("Collider")
    end
    return nil
end

local linhaChute = nil
local circuloChute = nil
local espSphere = nil
local ultimaAtualizacao = 0

local function criarLinhaChute()
    if not linhaChute or not linhaChute.Parent then
        if linhaChute then linhaChute:Destroy() end
        linhaChute = Instance.new("Part")
        linhaChute.Name = "LinhaChute"
        linhaChute.Anchored = true
        linhaChute.CanCollide = false
        linhaChute.Transparency = 0.3
        linhaChute.Color = Color3.fromRGB(255, 255, 0)
        linhaChute.Material = Enum.Material.Neon
        linhaChute.Size = Vector3.new(0.3, 0.3, 10)
        linhaChute.Parent = workspace
    end
    return linhaChute
end

local function criarCirculoChute()
    if not circuloChute or not circuloChute.Parent then
        if circuloChute then circuloChute:Destroy() end
        circuloChute = Instance.new("Part")
        circuloChute.Name = "CirculoChute"
        circuloChute.Anchored = true
        circuloChute.CanCollide = false
        circuloChute.Transparency = 0.3
        circuloChute.Color = Color3.fromRGB(255, 255, 0)
        circuloChute.Material = Enum.Material.Neon
        circuloChute.Shape = Enum.PartType.Cylinder
        circuloChute.Size = Vector3.new(3, 0.1, 3)
        circuloChute.Parent = workspace
    end
    return circuloChute
end

local function criarEspHitbox()
    if not espSphere or not espSphere.Parent then
        if espSphere then espSphere:Destroy() end
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ESP_Hitbox"
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.5
        espSphere.Parent = workspace
    end
    return espSphere
end

local function atualizarAdvinhaChute()
    if not Config.advinhaChute then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local agora = tick()
    if agora - ultimaAtualizacao < Config.delay then
        return
    end
    ultimaAtualizacao = agora

    local ball = getBall()
    if not ball then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    -- Simulação física
    local gravidade = Vector3.new(0, -50, 0)
    local pos = ball.Position
    local v = vel
    local dt = 0.03
    local maxPassos = 150
    local chaoY = 0

    local pontos = {}
    table.insert(pontos, pos)

    for i = 1, maxPassos do
        v = v + gravidade * dt
        pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then
            break
        end
    end

    if #pontos < 2 then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local inicio = pontos[1]
    local fim = pontos[#pontos]
    fim = Vector3.new(fim.X, chaoY, fim.Z)

    local meio = (inicio + fim) / 2
    local distancia = (inicio - fim).Magnitude

    criarLinhaChute()
    if distancia > 0.1 then
        linhaChute.Size = Vector3.new(0.3, 0.3, distancia)
        linhaChute.CFrame = CFrame.lookAt(meio, fim)
        linhaChute.Transparency = 0.3
    else
        linhaChute.Transparency = 1
    end

    if v.Y < -0.5 then
        criarCirculoChute()
        circuloChute.Position = fim
        local tamanho = math.clamp(vel.Magnitude / 10, 2, 6)
        circuloChute.Size = Vector3.new(tamanho, 0.1, tamanho)
        circuloChute.Transparency = 0.3
    else
        if circuloChute then
            circuloChute.Transparency = 1
        end
    end
end

local function aplicarHitbox()
    local collider = getCollider()
    if not collider then return end

    if Config.hitboxAtivo then
        local tamanho = Vector3.new(Config.hitboxTamanho, Config.hitboxTamanho, Config.hitboxTamanho)
        if collider.Size ~= tamanho then
            collider.Size = tamanho
        end
        collider.Transparency = 0.5  -- visível para depuração
    else
        -- Restaura tamanho original (supondo 1.4, ajuste se necessário)
        if collider.Size ~= Vector3.new(1.4, 1.4, 1.4) then
            collider.Size = Vector3.new(1.4, 1.4, 1.4)
        end
        collider.Transparency = 0
    end

    -- ESP da hitbox
    if Config.espHitbox and Config.hitboxAtivo then
        criarEspHitbox()
        espSphere.Adornee = collider
        local scale = Config.hitboxTamanho / 2
        espSphere.Scale = Vector3.new(scale, scale, scale)
        espSphere.Transparency = 0.5
    else
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
end

-- Loop principal
RunService.Heartbeat:Connect(function()
    atualizarAdvinhaChute()
    aplicarHitbox()
end)

