    Step = 1,
    Value = { Min = 10, Max = 200, Default = 100 },
    Callback = function(v)
        forcaBolaVelocidade = v
    end
})

secExtras:Button({
    Title = "Infinite Stamina",
    Desc = "Stamina infinita",
    Callback = function()
        task.spawn(function()
            while true do
                if player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("Stamina") then
                    player.PlayerStats.Stamina.Value = 100
                end
                task.wait()
            end
        end)
    end
})

secExtras:Dropdown({
    Title = "Time (para fazer gol)",
    Desc = "Selecione seu time para o gol",
    Options = {"Home", "Away"},
    Callback = function(opt)
        selectedTeam = opt
        print("Time selecionado: " .. opt)
    end
})

secExtras:Button({
    Title = "Fazer Gol",
    Desc = "Marca um gol",
    Callback = function()
        if not selectedTeam then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local posOriginal = hrp.Position
        local posGol = selectedTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)

        hrp.CFrame = CFrame.new(posGol)
        task.wait(0.2)
        local args = { [1] = 110, [4] = posGol }
        local ballService = ReplicatedStorage:FindFirstChild("Packages")
        if ballService then
            ballService = ballService:FindFirstChild("Knit")
            if ballService then
                ballService = ballService:FindFirstChild("Services")
                if ballService then
                    ballService = ballService:FindFirstChild("BallService")
                    if ballService then
                        local shoot = ballService:FindFirstChild("RE")
                        if shoot then
                            shoot:FireServer(unpack(args))
                        end
                    end
                end
            end
        end
        task.wait(0.2)
        hrp.CFrame = CFrame.new(posOriginal)
    end
})

