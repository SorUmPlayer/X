-- Botão "Copiar link" (cinza)
local btnCopy = Instance.new("TextButton")
btnCopy.Size = UDim2.new(0, 160, 0, 45)
btnCopy.Position = UDim2.new(0.5, -80, 0, 205) -- reposicionado
btnCopy.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
btnCopy.Text = "Copiar link"
btnCopy.TextColor3 = Color3.fromRGB(255, 255, 255)
btnCopy.Font = Enum.Font.SourceSansBold
btnCopy.TextScaled = true
btnCopy.Parent = frame

-- Ação do botão copiar (manual)
btnCopy.MouseButton1Click:Connect(function()
    local sucesso, erro = pcall(function()
        setclipboard("https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp")
    end)
    if sucesso then
        btnCopy.Text = "✅ Link copiado!"
        task.wait(2)
        btnCopy.Text = "Copiar link"
    else
        btnCopy.Text = "❌ Erro ao copiar"
        task.wait(1.5)
        btnCopy.Text = "Copiar link"
    end
end)

-- ⭐ CÓPIA AUTOMÁTICA AO INICIAR O SCRIPT
task.wait(0.5) -- pequeno delay para garantir
local sucesso, erro = pcall(function()
    setclipboard("https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp")
end)
if sucesso then
    -- Opcional: mudar o texto do botão para indicar que já foi copiado
    btnCopy.Text = "✅ Já copiado"
    task.wait(2)
    btnCopy.Text = "Copiar link"
else
    btnCopy.Text = "❌ Falha auto-cópia"
    task.wait(2)
    btnCopy.Text = "Copiar link"
end
