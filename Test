local function refBola()
    local f = Workspace:FindFirstChild("Football")
    if f and f ~= bola then
        bola = f
        local hb = f:FindFirstChild("Hitbox")
        hitbox = (hb and hb:IsA("BasePart")) and hb or (f:IsA("Model") and f.PrimaryPart) or f
        bolaValida = true
        bolaSpawnTime = tick()
        return
    elseif f then bolaValida = true; return end
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") and c.Name ~= "Football" then
            local f2 = c:FindFirstChild("Football")
            if f2 and f2 ~= bola then
                bola = f2
                local hb = f2:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or (f2:IsA("Model") and f2.PrimaryPart) or f2
                bolaValida = true
                bolaSpawnTime = tick()
                return
            elseif f2 then bolaValida = true; return end
        end
    end
    bola = nil; hitbox = nil; bolaValida = false
end
Workspace.ChildAdded:Connect(refBola)
Workspace.ChildRemoved:Connect(refBola)
refBola()
task.spawn(function() while true do task.wait(1); if not bolaValida then refBola() end end end)

local function getBallPart()
    if bola and bolaValida then
        if bola:IsA("BasePart") then return bola end
        if bola:IsA("Model") then return bola.PrimaryPart or bola:FindFirstChildWhichIsA("BasePart") end
    end
    return nil
end

local function euTenhoBola()
    local m = Workspace:FindFirstChild(player.Name)
    return m and m:FindFirstChild("Football") ~= nil
end

local function alguemTemBola()
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") and c.Name ~= "Football" and c.Name ~= "Ball" then
            if c:FindFirstChild("Football") then return true end
        end
    end
    return false
end

