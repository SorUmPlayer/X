-- 6. REPLICAÇÃO DAS MÃOS NO SERVIDOR (Motor6D C0)
RunService.Stepped:Connect(function()
    if not VR_Enabled then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local LeftInput = GetLeftInput()
    local RightInput = GetRightInput()

    -- Atualiza ângulos
    LeftX = math.clamp(LeftX - (LeftInput.Y * Sensitivity), -2.2, 2.2)
    LeftY = math.clamp(LeftY - (LeftInput.X * Sensitivity), -2.2, 2.2)

    RightX = math.clamp(RightX - (RightInput.Y * Sensitivity), -2.2, 2.2)
    RightY = math.clamp(RightY - (RightInput.X * Sensitivity), -2.2, 2.2)

    -- Localiza as juntas para R6 e R15
    local LeftShoulder = Character:FindFirstChild("Left Shoulder", true) or Character:FindFirstChild("LeftShoulder", true)
    local RightShoulder = Character:FindFirstChild("Right Shoulder", true) or Character:FindFirstChild("RightShoulder", true)

    -- Anula as animações padrão do Roblox e aplica a rotação
    if LeftShoulder then
        LeftShoulder.Transform = CFrame.new()
        LeftShoulder.C0 = CFrame.new(-1, 0.5, 0) 
            * CFrame.Angles(LeftX, LeftY, 0) 
            * CFrame.Angles(0, -math.pi/2, 0)
    end

    if RightShoulder then
        RightShoulder.Transform = CFrame.new()
        RightShoulder.C0 = CFrame.new(1, 0.5, 0) 
            * CFrame.Angles(RightX, RightY, 0) 
            * CFrame.Angles(0, math.pi/2, 0)
    end
end)

-- 7. MOVIMENTAÇÃO DE CÂMERA VR (Head Bobbing)
RunService.RenderStepped:Connect(function(deltaTime)
    if not VR_Enabled then return end

    -- Trava Primeira Pessoa se Ativado
    if FirstPerson_Lock then
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 0.5
    else
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 400
    end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return end

    -- Simulação de Passos VR (Câmera balança suavemente ao andar)
    if Humanoid.MoveDirection.Magnitude > 0 then
        BobStep = BobStep + (deltaTime * Humanoid.WalkSpeed * 1.3)
        local CameraBob = Vector3.new(
            math.cos(BobStep * 0.5) * 0.15,
            math.abs(math.sin(BobStep)) * 0.2,
            0
        )
        Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(CameraBob, 0.2)
    else
        Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(Vector3.new(0, 0, 0), 0.15)
    end
end)
