-- ========== LOOP PRINCIPAL ==========
local linhaVisao, linhaChute, circuloChute = nil, nil, nil
local espSphere, gyro = nil, nil

local function updVisao()
    if not visaoBolaOn then
        if linhaVisao then linhaVisao:Destroy(); linhaVisao = nil end
        return
    end
    local my = getMyTeam()
    local alvo = nil
    if my then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("Football") then
                local v = p:FindFirstChild("Values")
                if v and v:FindFirstChild("Team") and tostring(v.Team.Value) ~= my then alvo = p; break end
            end
        end
    end
    if not alvo then
        if linhaVisao then linhaVisao:Destroy(); linhaVisao = nil end
        return
    end
    local char = alvo.Character
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local orig = head or hrp
    if not orig then return end
    local pi = orig.Position
    if orig == hrp then pi = pi + Vector3.new(0,1.5,0) end
    local d = head and head.CFrame.LookVector or (hrp and hrp.CFrame.LookVector or Vector3.new(1,0,0))
    d = Vector3.new(d.X, 0, d.Z)
    if d.Magnitude < 0.001 then d = Vector3.new(1,0,0) else d = d.Unit end
    local pf = pi + d * 100
    if not linhaVisao or not linhaVisao.Parent then
        linhaVisao = Instance.new("Part")
        linhaVisao.Name="LinhaVisao"; linhaVisao.Anchored=true; linhaVisao.CanCollide=false
        linhaVisao.Transparency=0.1; linhaVisao.Color=Color3.fromRGB(0,255,0)
        linhaVisao.Material=Enum.Material.Neon; linhaVisao.Size=Vector3.new(1,1,100)
        linhaVisao.Parent=workspace
    end
    local m = (pi + pf) / 2
    local dd = (pi - pf).Magnitude
    if dd < 0.1 then dd = 0.1 end
    linhaVisao.Size = Vector3.new(1,1,dd)
    linhaVisao.CFrame = CFrame.lookAt(m, pf)
end

local function updChute()
    if not advinhaOn then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    local ball = getBallPart()
    if not ball then return end
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    local g = Vector3.new(0,-50,0)
    local pos, v = ball.Position, vel
    local dt, maxP, chaoY = 0.02, 500, 0
    local pontos = {pos}
    for _ = 1, maxP do
        v = v + g * dt; pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then break end
    end
    if #pontos < 2 then return end
    local pf = pontos[#pontos]; pf = Vector3.new(pf.X, chaoY, pf.Z)
    local ini, fim = pontos[1], pontos[#pontos]
    local m = (ini + fim) / 2
    local dd = (ini - fim).Magnitude
    if not linhaChute or not linhaChute.Parent then
        linhaChute = Instance.new("Part")
        linhaChute.Name="LinhaChute"; linhaChute.Anchored=true; linhaChute.CanCollide=false
        linhaChute.Transparency=0.2; linhaChute.Color=Color3.fromRGB(255,255,0)
        linhaChute.Material=Enum.Material.Neon; linhaChute.Size=Vector3.new(0.5,0.5,25)
        linhaChute.Parent=workspace
    end
    if dd > 0.1 then
        linhaChute.Size = Vector3.new(0.5,0.5,dd); linhaChute.CFrame = CFrame.lookAt(m, fim)
        linhaChute.Transparency = 0.2
    else linhaChute.Transparency = 1 end
    if v.Y < -0.5 then
        if not circuloChute or not circuloChute.Parent then
            circuloChute = Instance.new("Part")
            circuloChute.Name="Circulo"; circuloChute.Anchored=true; circuloChute.CanCollide=false
            circuloChute.Transparency=0.2; circuloChute.Color=Color3.fromRGB(255,255,0)
            circuloChute.Material=Enum.Material.Neon; circuloChute.Shape=Enum.PartType.Cylinder
            circuloChute.Size=Vector3.new(4,0.1,4); circuloChute.Parent=workspace
        end
        circuloChute.Position = pf
        local tam = math.clamp(vel.Magnitude / 8, 3, 8)
        circuloChute.Size = Vector3.new(tam,0.1,tam)
    else
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
    end
end

local function updAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then gyro:Destroy(); gyro = nil end
        return
    end
    if not shouldAimbot() then
        if gyro then gyro:Destroy(); gyro = nil end
        return
    end
    local ball = getBallPart()
    if not ball then
        if gyro then gyro:Destroy(); gyro = nil end
        return
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp; gyro.D = 1000; gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000,8000,8000)
    end
    local d = (Vector3.new(ball.Position.X, hrp.Position.Y, ball.Position.Z) - hrp.Position).Unit
    gyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + d)
end

local function updAimbotCamera()
    if isControlActive then return end
    if not aimbotCamera then return end
    if not shouldAimbot() then return end
    local ball = getBallPart()
    if not ball then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dir = (Vector3.new(ball.Position.X, hrp.Position.Y, ball.Position.Z) - hrp.Position).Unit
    camera.CFrame = CFrame.new(hrp.Position - dir * 10 + Vector3.new(0,5,0), hrp.Position)
end

local function updESP()
    if alguemTemBola() or euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then espSphere:Destroy(); espSphere = nil end
        return
    end
    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name="ESP"; espSphere.Adornee=hitbox; espSphere.Parent=hitbox
        espSphere.Color3=Color3.fromRGB(0,255,0); espSphere.Transparency=0.6
    end
    local s = reachBolaDist / 2.5
    espSphere.Scale = Vector3.new(s,s,s)
end

local function updControle()
    if not isControlActive then return end
    local ball = getBallPart()
    if not ball then
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then camera.CameraSubject = char.Humanoid end
        return
    end
    if euTenhoBola() then
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then camera.CameraSubject = char.Humanoid end
    else
        camera.CameraSubject = ball
        ball.AssemblyLinearVelocity = camera.CFrame.LookVector * velocidadeBola
    end
end

local function updWalk()
    if not walkBoost then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    if not walkBV or not walkBV.Parent then
        walkBV = Instance.new("BodyVelocity")
        walkBV.MaxForce = Vector3.new(1e5,0,1e5); walkBV.Velocity = Vector3.zero
        walkBV.Parent = root
    end
    walkBV.Velocity = hum.MoveDirection.Magnitude > 0 and (hum.MoveDirection * walkSpeedValue) or Vector3.zero
end

