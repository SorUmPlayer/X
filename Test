local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    if isControlActive then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        if controlConnection then controlConnection:Disconnect() end
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                if euTenhoBola() then resetCamera()
                else
                    camera.CameraSubject = ball
                    ball.AssemblyLinearVelocity = camera.CFrame.LookVector * velocidadeBola
                end
            else resetCamera() end
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        if controlConnection then controlConnection:Disconnect(); controlConnection = nil end
        resetCamera()
    end
end

