local bola, hitbox, bolaValida = nil, nil, false

local function atualizarReferenciaBola()
    local f = Workspace:FindFirstChild("Football")
    if f then
        bola = f
        local hb = f:FindFirstChild("Hitbox")
        hitbox = (hb and hb:IsA("BasePart")) and hb or (f:IsA("Model") and f.PrimaryPart) or f
        bolaValida = true
        return
    end
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") and c.Name ~= "Football" then
            local f2 = c:FindFirstChild("Football")
            if f2 then
                bola = f2
                local hb = f2:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or (f2:IsA("Model") and f2.PrimaryPart) or f2
                bolaValida = true
                return
            end
        end
    end
    bola = nil; hitbox = nil; bolaValida = false
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
atualizarReferenciaBola()
task.spawn(function() while true do task.wait(1); if not bolaValida or not hitbox then atualizarReferenciaBola() end end end)

local function euTenhoBola()
    local m = Workspace:FindFirstChild(player.Name)
    if m and m:FindFirstChild("Football") then return true end
    return false
end

local function alguemTemBola()
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") and c.Name ~= "Football" and c.Name ~= "Ball" then
            if c:FindFirstChild("Football") then return true end
        end
    end
    return false
end

local reachAtivo = false
local reachTamanho = 15
local espAtivo = false
local reachPart = nil
local espSphere = nil

-- ===== REACH NO PLAYER (SEM FÍSICA) =====
local function aplicarReach()
    if alguemTemBola() or euTenhoBola() then
        if reachPart then reachPart:Destroy(); reachPart = nil end
        return
    end

    if not reachAtivo then
        if reachPart then reachPart:Destroy(); reachPart = nil end
        return
    end

    local char = player.Character
    if not char then
        if reachPart then reachPart:Destroy(); reachPart = nil end
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if reachPart then reachPart:Destroy(); reachPart = nil end
        return
    end

    -- Cria a parte UMA vez
    if not reachPart or not reachPart.Parent then
        if reachPart then reachPart:Destroy() end
        reachPart = Instance.new("Part")
        reachPart.Name = "PlayerReachHitbox"
        reachPart.Shape = Enum.PartType.Ball
        reachPart.Size = Vector3.new(reachTamanho, reachTamanho, reachTamanho)
        reachPart.Transparency = 1
        reachPart.CanCollide = false   -- não colide com NADA
        reachPart.CanTouch = true      -- MAS detecta toques
        reachPart.CanQuery = false     -- não interfere em raycast
        reachPart.Anchored = true      -- NÃO É AFETADA POR FÍSICA
        reachPart.Massless = true
        reachPart.Material = Enum.Material.ForceField
        reachPart.Parent = workspace
    end

    -- Atualiza tamanho + posição todo frame (sem weld, sem física)
    if reachPart.Size.X ~= reachTamanho then
        reachPart.Size = Vector3.new(reachTamanho, reachTamanho, reachTamanho)
    end
    reachPart.CFrame = hrp.CFrame
end

-- ===== ESP NA BOLA =====
local function aplicarESP()
    if not espAtivo or not hitbox then
        if espSphere then espSphere:Destroy(); espSphere = nil end
        return
    end

    if alguemTemBola() or euTenhoBola() then
        if espSphere then espSphere:Destroy(); espSphere = nil end
        return
    end

    if not espSphere or espSphere.Parent ~= workspace then
        if espSphere then espSphere:Destroy() end
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "BallESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = workspace
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachTamanho / 2.5
    if espSphere.Scale.X ~= scale then
        espSphere.Scale = Vector3.new(scale, scale, scale)
    end
end

RunService.Heartbeat:Connect(function()
    aplicarReach()
    aplicarESP()
end)

