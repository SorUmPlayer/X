local fpsOriginal = {
    shadows = Lighting.GlobalShadows,
    fogEnd = Lighting.FogEnd,
    brightness = Lighting.Brightness,
    ambient = Lighting.Ambient,
    outdoorAmbient = Lighting.OutdoorAmbient,
}
local removedEffects = {}
local originalEffects = {}

local function aplicarFPSPlus()
    if not Config.fpsPlus then return end
    -- Remove sombras e efeitos
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 1
        Lighting.Ambient = Color3.fromRGB(80, 80, 80)
        Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)
    end)
    -- Desativa PostEffects
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") then
            if not originalEffects[v] then originalEffects[v] = v.Enabled end
            v.Enabled = false
        end
    end
    -- Remove partículas
    task.spawn(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                if not originalEffects[v] then
                    originalEffects[v] = v.Enabled
                    table.insert(removedEffects, v)
                end
                v.Enabled = false
            end
        end
    end)
end

local function restaurarFPSPlus()
    pcall(function()
        Lighting.GlobalShadows = fpsOriginal.shadows
        Lighting.FogEnd = fpsOriginal.fogEnd
        Lighting.Brightness = fpsOriginal.brightness
        Lighting.Ambient = fpsOriginal.ambient
        Lighting.OutdoorAmbient = fpsOriginal.outdoorAmbient
    end)
    for v, state in pairs(originalEffects) do
        pcall(function() v.Enabled = state end)
    end
    originalEffects = {}
    removedEffects = {}
end

local function aplicarGrafico(nivel)
    -- 0 = leve, 3 = bonito
    pcall(function()
        if nivel == 0 then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 100000
            Lighting.Brightness = 1
        elseif nivel == 1 then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level02
            Lighting.GlobalShadows = false
        elseif nivel == 2 then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level05
            Lighting.GlobalShadows = true
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level10
            Lighting.GlobalShadows = true
            Lighting.FogEnd = 5000
            Lighting.Brightness = 2
        end
    end)
end

local function aplicarRemoverLag()
    if not Config.removerLag then return end
    -- Ajusta StreamingEnabled e otimizações de rede
    pcall(function()
        settings().Network.IncomingReplicationLag = 0
    end)
    -- Reduz qualidade de rede de personagens distantes
    pcall(function()
        for _, v in ipairs(Players:GetPlayers()) do
            if v ~= player and v.Character then
                local char = v.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        -- Não mexe no Animate
                        if not part:FindFirstChildOfClass("Motor6D") then
                            part.CastShadow = false
                        end
                    end
                end
            end
        end
    end)
end

pcall(function()
    if Config.fpsPlus then aplicarFPSPlus() end
    aplicarGrafico(Config.graficoLevel)
    if Config.removerLag then aplicarRemoverLag() end
end)

