    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 18); track.Position = UDim2.new(0, 10, 0, 35)
    track.BackgroundColor3 = Color3.fromRGB(50, 50, 60); track.BorderSizePixel = 0
    track.Parent = frame
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0, 9); tc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(math.clamp(velocidadeBola/150, 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255); fill.BorderSizePixel = 0
    fill.Parent = track
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 9); fc.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new(math.clamp(velocidadeBola/150, 0, 1), -9, 0, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255); knob.BorderSizePixel = 0
    knob.Parent = track
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

    local slidingKnob = false
    local draggingFrame = false
    local dragStart, startPos

    local function updateValue(inputX)
        local ax = track.AbsolutePosition.X
        local aw = track.AbsoluteSize.X
        local rel = math.clamp(inputX - ax, 0, aw)
        local val = math.floor((rel / aw) * 150)
        velocidadeBola = val
        Config.controleBolaVelocidade = val; SaveConfig()
        title.Text = "Velocidade da Bola: " .. val
        fill.Size = UDim2.new(val / 150, 0, 1, 0)
        knob.Position = UDim2.new(val / 150, -9, 0, 0)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            slidingKnob = true
            updateValue(input.Position.X)
        end
    end)
    track.InputChanged:Connect(function(input)
        if slidingKnob and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input.Position.X)
        end
    end)

    -- Arrastar pelo título
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingFrame = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    title.InputChanged:Connect(function(input)
        if draggingFrame and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            slidingKnob = false
            draggingFrame = false
        end
    end)

    _G.AtualizarSlideFlutuante = function(v)
        velocidadeBola = v
        title.Text = "Velocidade da Bola: " .. v
        fill.Size = UDim2.new(v / 150, 0, 1, 0)
        knob.Position = UDim2.new(v / 150, -9, 0, 0)
    end

    floatingSliderGUI = sg
end
local function removerSlideFlutuante()
    if floatingSliderGUI then floatingSliderGUI:Destroy(); floatingSliderGUI = nil end
end

