-- --- LÓGICA DE EXECUÇÃO (LOOPS) ---

local function GetPlayerPosition()
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position end
    end
    return nil
end

local function GetHRP()
    local character = LocalPlayer.Character
    if character then
        return character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

-- Loop 1: Kill Aura em workspace.NPCs
task.spawn(function()
    while true do
        task.wait(Config.Delay)
        if Config.KillauraEnabled and DamageEvent then
            local playerPos = GetPlayerPosition()
            local npcsFolder = workspace:FindFirstChild("NPCs")

            if playerPos and npcsFolder then
                for _, desc in ipairs(npcsFolder:GetDescendants()) do
                    if not Config.KillauraEnabled then break end
                    if desc:IsA("Humanoid") and desc.Health > 0 then
                        local model = desc.Parent
                        if model and model:IsA("Model") then
                            local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                            local inRange = true
                            if hrp then
                                local dist = (playerPos - hrp.Position).Magnitude
                                if dist > Config.KillauraDistance then
                                    inRange = false
                                end
                            end

                            if inRange then
                                pcall(function()
                                    DamageEvent:FireServer("NPCs", "Damage", desc, Config.KillauraDamage)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Loop 2: Coletar Cash com Teleporte Instantâneo
task.spawn(function()
    while true do
        task.wait(0.2)
        if Config.CashEnabled and DamageEvent then
            pcall(function()
                local hrp = GetHRP()
                local originalPos = hrp and hrp.CFrame
                local allCash = {}
                
                for _, obj in ipairs(getnilinstances()) do
                    if obj.Name == "Cash" or obj.Name:lower().find("cash") then
                        table.insert(allCash, obj)
                    end
                end

                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj.Name == "Cash" then
                        table.insert(allCash, obj)
                    end
                end

                for _, cashObj in ipairs(allCash) do
                    if not Config.CashEnabled then break end
                    
                    local targetPart = nil
                    if cashObj:IsA("BasePart") then
                        targetPart = cashObj
                    elseif cashObj:IsA("Model") then
                        targetPart = cashObj.PrimaryPart or cashObj:FindFirstChildWhichIsA("BasePart")
                    end

                    if hrp and targetPart then
                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
                        task.wait(0.05)
                        DamageEvent:FireServer("Cash", "Collect", cashObj)
                        task.wait(0.05)
                        if originalPos then
                            hrp.CFrame = originalPos
                        end
                    else
                        DamageEvent:FireServer("Cash", "Collect", cashObj)
                    end
                end
            end)
        end
    end
end)

-- Loop 3: Quebrar Máquinas Universal em workspace.Map.Buildings
task.spawn(function()
    while true do
        task.wait(Config.Delay)
        if Config.TemplateEnabled and DamageEvent then
            local map = workspace:FindFirstChild("Map")
            local buildings = map and map:FindFirstChild("Buildings")

            if buildings then
                for _, desc in ipairs(buildings:GetDescendants()) do
                    if not Config.TemplateEnabled then break end
                    if desc:IsA("BasePart") or desc:IsA("Model") then
                        pcall(function()
                            DamageEvent:FireServer(
                                "DamageToOpen",
                                "Damage",
                                desc,
                                Config.TemplateDamage,
                                "melee"
                            )
                        end)
                    end
                end
            end
        end
    end
end)

-- Loop 4: Loot Aura (Varre itens no mundo, mochilas e pastas de loot para pegar tudo)
task.spawn(function()
    while true do
        task.wait(0.3)
        if Config.LootEnabled and FunctionEvent then
            pcall(function()
                -- 1. Varre itens que estão no Workspace (ex: drops no chão)
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if not Config.LootEnabled then break end
                    if obj:IsA("Tool") or obj.Name == "Handle" or obj:IsA("Model") then
                        local handle = obj:IsA("Tool") and obj:FindFirstChild("Handle") or (obj.Name == "Handle" and obj) or obj:FindFirstChild("Handle")
                        if handle then
                            pcall(function()
                                FunctionEvent:InvokeServer("Loot", "LootEquip", handle)
                            end)
                        end
                    end
                end

                -- 2. Varre inventários/pastas de loot disponíveis no jogo
                for _, obj in ipairs(getnilinstances()) do
                    if not Config.LootEnabled then break end
                    if obj:IsA("Tool") or obj:IsA("BasePart") then
                        local handle = obj:IsA("Tool") and obj:FindFirstChild("Handle") or (obj:IsA("BasePart") and obj)
                        if handle then
                            pcall(function()
                                FunctionEvent:InvokeServer("Loot", "LootEquip", handle)
                            end)
                        end
                    end
                end
            end)
        end
    end
end)

