-- ========== SHOULD AIMBOT ==========
local function shouldAimbotWork()
    if euTenhoBola() then
        aimbotBlocked = true; aimbotBlockedUntil = tick() + aimbotDelayValue; return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then aimbotBlocked = false; return true
        else return false end
    end
    return true
end

-- ========== REACH BOLA ==========
local function aplicarReachBola()
    if not hitbox then return end
    local agora = tick()
    if alguemTemBola() then hitboxDesativadoAte = agora + 0.5 end
    if agora < hitboxDesativadoAte then
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize; hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end
    if not reachBolaAtivo then
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize; hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end
    local t = Vector3.new(reachBolaDistancia, reachBolaDistancia, reachBolaDistancia)
    if hitbox.Size ~= t or hitbox.Transparency ~= 1 then
        hitbox.Size = t; hitbox.Transparency = 1
    end
end

-- ========== REACH PERSONAGEM ==========
local function aplicarReachPersonagem()
    if not reachPersonagemAtivo then return end
    if euTenhoBola() then return end
    if not hitbox or not bolaValida then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - hitbox.Position).Magnitude
    if dist <= reachPersonagemTamanho then
        if firetouchinterest then
            for _ = 1, 3 do
                firetouchinterest(hrp, hitbox, 0); task.wait(0.005); firetouchinterest(hrp, hitbox, 1)
            end
        end
    end
end

-- ========== FORÇA ==========
local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    local ball = getBallPart()
    if not ball then return end
    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        ball.AssemblyLinearVelocity = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
    end
    tinhaBola = tenho
end

-- ========== CURVAS ==========
local function aplicarCurvas()
    if not curvasEnabled then return end
    local ball = getBallPart()
    if not ball then return end
    if euTenhoBola() then return end
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 40 then return end
    if ball.Position.Y < 0.5 then return end
    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1
    if curvasModo == 2 then lado = -1
    elseif curvasModo == 3 then
        local now = tick()
        if now - curvasTimer > curvasIntervalo then
            curvasTimer = now
            curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
            curvasIntervalo = 0.5 + math.random() * 0.5
        end
        lado = curvasDirecaoAtual
    end
    ball.AssemblyLinearVelocity = vel + perp * lado * fator
end

-- ========== TRAZER BOLA ==========
local function aplicarTrazerBola()
    if not trazerBolaAtivo then return end
    if euTenhoBola() then return end
    local ballPart = getBallPart()
    if not ballPart then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dir = hrp.Position - ballPart.Position
    local dist = dir.Magnitude
    if dist < 2 then return end
    dir = dir.Unit
    ballPart.AssemblyLinearVelocity = dir * math.clamp(dist * 15, 80, 250) + Vector3.new(0, 5, 0)
end

-- ========== STOP BALL (release speed maior) ==========
local function aplicarStopBall()
    if not stopBallAtivo then return end
    if euTenhoBola() then return end
    local ball = getBallPart()
    if not ball then return end
    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero
end

local function desativarStopBall()
    local ball = getBallPart()
    if ball then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.01 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        -- Solta com força + leve impulso pra cima pra não ficar "murcha"
        ball.AssemblyLinearVelocity = dir * 80 + Vector3.new(0, 20, 0)
    end
end

-- ========== AUTO GOL (auto-execute) ==========
local function executarAutoGol()
    if autoGolRunning then return end
    autoGolRunning = true
    task.spawn(function()
        local char = player.Character
        if not char then autoGolRunning = false; return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then autoGolRunning = false; return end
        local posOriginal = hrp.Position

        -- 1. Se não tem a bola, tenta pegar
        if not euTenhoBola() then
            local ballPart = getBallPart()
            if ballPart then
                hrp.CFrame = CFrame.new(ballPart.Position + Vector3.new(0, 3, 0))
                task.wait(0.3)
                if firetouchinterest then
                    for _ = 1, 12 do
                        firetouchinterest(hrp, ballPart, 0)
                        task.wait(0.02)
                        firetouchinterest(hrp, ballPart, 1)
                    end
                end
                task.wait(0.4)
            end
        end

        -- 2. Confere se realmente pegou
        if not euTenhoBola() then
            autoGolRunning = false
            hrp.CFrame = CFrame.new(posOriginal)
            return
        end

        -- 3. Vai pro gol
        local posGol = autoGolTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)
        hrp.CFrame = CFrame.new(posGol)
        task.wait(0.2)

        -- 4. Chuta (múltiplas tentativas)
        for _ = 1, 3 do
            local args = { [1] = 110, [4] = posGol }
            local pk = ReplicatedStorage:FindFirstChild("Packages")
            if pk then
                local knit = pk:FindFirstChild("Knit")
                if knit then
                    local sv = knit:FindFirstChild("Services")
                    if sv then
                        local bs = sv:FindFirstChild("BallService")
                        if bs then
                            local re = bs:FindFirstChild("RE")
                            if re then
                                local shoot = re:FindFirstChild("Shoot")
                                if shoot then
                                    pcall(function() shoot:FireServer(unpack(args)) end)
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end

        task.wait(0.3)

        -- 5. Volta pro lugar original
        hrp.CFrame = CFrame.new(posOriginal)
        autoGolRunning = false
    end)
end

local function checkAutoGol()
    if not autoGolToggle then return end
    if autoGolRunning then return end
    if tick() - autoGolLastRun < autoGolCooldown then return end
    if not euTenhoBola() then return end
    autoGolLastRun = tick()
    executarAutoGol()
end

