function getNil(name, class)
    for _, v in next, getnilinstances() do
        if v.ClassName == class and v.Name == name then 
            return v 
        end
    end
end

-- Função para achar todos StudBrick no jogo
local function getAllStudBricks()
    local studs = {}

    -- Procurar no workspace
    for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
        if v:IsA("Part") and v.Name == "StudBrick" then
            table.insert(studs, v)
        end
    end

    -- Procurar nos objetos nil
    for _, v in next, getnilinstances() do
        if v:IsA("Part") and v.Name == "StudBrick" then
            table.insert(studs, v)
        end
    end

    return studs
end

