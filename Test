--[[
  COMO CONFIGURAR:
  1. Crie um RemoteEvent dentro de ReplicatedStorage (ex: "TeleportEvent").
  2. Crie um ScreenGui com um TextButton (ex: "TeleportButton") dentro de StarterGui.
  3. Insira um LocalScript no botão com o código abaixo.
  4. Insira um Script em ServerScriptService com o código do servidor.
--]]

-- ============ LOCALSCRIPT (dentro do botão) ============
local player = game.Players.LocalPlayer
local remote = game.ReplicatedStorage:WaitForChild("TeleportEvent") -- Ajuste o nome

local button = script.Parent -- O TextButton

button.MouseButton1Click:Connect(function()
    -- Verifica se o personagem existe
    local character = player.Character
    if not character or not character.Parent then
        return
    end
    
    -- Dispara o evento para o servidor
    remote:FireServer()
end)
-- ============ SCRIPT (em ServerScriptService) ============
local remote = game.ReplicatedStorage:WaitForChild("TeleportEvent")
local targetPart = workspace.AreaEggSlotsClient["02057d36e0954bb79f2f3c0eec10b213"]

remote.OnServerEvent:Connect(function(player)
    if not targetPart or not targetPart:IsA("BasePart") then
        warn("Parte alvo não encontrada ou não é uma BasePart")
        return
    end
    
    local character = player.Character
    if not character or not character.Parent then
        return
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then
        return
    end
    
    -- Posiciona o personagem no centro da parte + 3 studs acima (para não ficar dentro)
    local teleportPos = targetPart.Position + Vector3.new(0, 3, 0)
    
    -- Move a raiz (primary part) do personagem
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        rootPart.CFrame = CFrame.new(teleportPos)
    else
        -- Fallback: move todas as partes (não recomendado)
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Position = teleportPos
            end
        end
    end
    
    -- Opcional: mensagem de confirmação
    -- player:WaitForChild("PlayerGui"):FindFirstChild("Feedback") etc.
end)
