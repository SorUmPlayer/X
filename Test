--[[
    Blue Lock Rivels Hub – 3 Hitboxes + ESP
    - Hitbox da Bola (Reach) – alcance invisível na bola
    - Hitbox do Jogador – alcance ao redor do personagem
    - Tamanho Visual da Bola – aumenta o tamanho visível da bola
    - ESP para cada uma (esferas coloridas)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- =====================================================
--  FUNÇÃO SEGURA DE PARENT
-- =====================================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false
local bolaVisualParts = {} -- para alterar o tamanho visual

local function atualizarReferenciaBola()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true
                -- Guarda partes visuais (todas as BasePart que não são a hitbox)
                bolaVisualParts = {}
                for _, part in ipairs(bola:GetDescendants()) do
                    if part:IsA("BasePart") and part ~= hitbox then
                        table.insert(bolaVisualParts, part)
                    end
                end
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or bola
            bolaValida = true
            bolaVisualParts = {}
            for _, part in ipairs(bola:GetDescendants()) do
                if part:IsA("BasePart") and part ~= hitbox then
                    table.insert(bolaVisualParts, part)
                end
            end
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
    bolaVisualParts = {}
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
atualizarReferenciaBola()

-- =====================================================
--  GETBALL (PARA O BOTÃO DE CONTROLE)
-- =====================================================
local function getBall()
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

-- =====================================================
--  POSSE DA BOLA
-- =====================================================
local function euTenhoBola()
    local meuModel = Workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local mostrarESP = false

-- Variáveis das 3 Hitboxes
local hitboxBolaAtivo = false
local hitboxBolaTamanho = 20

local hitboxJogadorAtivo = false
local hitboxJogadorTamanho = 15

local tamanhoVisualAtivo = false
local tamanhoVisualMultiplicador = 1.5 -- fator de escala (ex: 1.5x)

-- Armazenar tamanhos originais das partes visuais
local visualOriginalSizes = {}

-- Hitbox do Jogador: SelectionSphere no personagem
local jogadorSphere = nil

local velocidadeBola = 65
local isControlActive = false
local controlConnection = nil
local controlScreenGui = nil
local toggleButton = nil

-- Botão Câmera
local cameraButtonActive = false
local cameraScreenGui = nil
local cameraToggleButton = nil

-- Delay do Aimbot
local aimbotDelayValues = {0, 0.1, 0.2, 0.25, 0.40, 0.60, 0.70, 1.0, 2.0, 3.0, 5.0}
local aimbotDelayValue = 0
local aimbotBlocked = false
local aimbotBlockedUntil = 0

local gyro = nil
local selectedTeam = nil

-- ESP: esferas
local espBolaSphere = nil
local espJogadorSphere = nil

local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  LÓGICA DE BLOQUEIO DO AIMBOT (DELAY)
-- =====================================================
local function shouldAimbotWork()
    local tenho = euTenhoBola()
    
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    
    return true
end

-- =====================================================
--  HITBOX DO JOGADOR (DETECÇÃO DE TOQUE)
-- =====================================================
local function aplicarHitboxJogador()
    if not hitboxJogadorAtivo then
        if jogadorSphere then
            jogadorSphere:Destroy()
            jogadorSphere = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Criar/atualizar a esfera visual ao redor do jogador
    if not jogadorSphere then
        jogadorSphere = Instance.new("SelectionSphere")
        jogadorSphere.Name = "JogadorHitboxESP"
        jogadorSphere.Adornee = hrp
        jogadorSphere.Parent = hrp
        jogadorSphere.Color3 = Color3.fromRGB(0, 100, 255) -- azul
        jogadorSphere.Transparency = 0.5
    end

    local scale = hitboxJogadorTamanho / 2.5
    jogadorSphere.Scale = Vector3.new(scale, scale, scale)

    -- Verificar colisão com a bola
    if hitbox and bolaValida then
        local dist = (hrp.Position - hitbox.Position).Magnitude
        if dist <= hitboxJogadorTamanho then
            -- Força o toque para pegar a bola
            if firetouchinterest then
                firetouchinterest(hrp, hitbox, 0)
                task.wait()
                firetouchinterest(hrp, hitbox, 1)
            end
        end
    end
end

-- =====================================================
--  TAMANHO VISUAL DA BOLA
-- =====================================================
local function aplicarTamanhoVisual()
    if not tamanhoVisualAtivo then
        -- Restaura tamanhos originais
        for part, size in pairs(visualOriginalSizes) do
            if part and part.Parent then
                part.Size = size
            end
        end
        visualOriginalSizes = {}
        return
    end

    if not bolaValida or not bola then return end

    -- Atualiza partes visuais
    for _, part in ipairs(bolaVisualParts) do
        if part and part:IsA("BasePart") then
            if not visualOriginalSizes[part] then
                visualOriginalSizes[part] = part.Size
            end
            local newSize = visualOriginalSizes[part] * tamanhoVisualMultiplicador
            part.Size = newSize
        end
    end
end

-- =====================================================
--  HITBOX DA BOLA (REACH) + ESP
-- =====================================================
local function aplicarHitboxBola()
    if not hitbox then return end

    if not hitboxBolaAtivo or euTenhoBola() then
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        if espBolaSphere then
            espBolaSphere:Destroy()
            espBolaSphere = nil
        end
        return
    end

    -- Aplica tamanho e transparência (invisível)
    local novoSize = Vector3.new(hitboxBolaTamanho, hitboxBolaTamanho, hitboxBolaTamanho)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 1
    end

    -- ESP da bola (verde)
    if mostrarESP then
        if not espBolaSphere then
            espBolaSphere = Instance.new("SelectionSphere")
            espBolaSphere.Name = "BolaHitboxESP"
            espBolaSphere.Adornee = hitbox
            espBolaSphere.Parent = hitbox
            espBolaSphere.Color3 = Color3.fromRGB(0, 255, 0) -- verde
            espBolaSphere.Transparency = 0.6
        end
        local scale = hitboxBolaTamanho / 2.5
        espBolaSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espBolaSphere then
            espBolaSphere:Destroy()
            espBolaSphere = nil
        end
    end
end

-- =====================================================
--  LOOP PRINCIPAL (UNIFICA TUDO)
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.1) -- loop rápido para detecção do jogador
        aplicarHitboxBola()
        aplicarHitboxJogador()
        aplicarTamanhoVisual()
    end
end)

-- =====================================================
--  CONTROLE BOLA – BOTÃO FLUTUANTE
-- =====================================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    
    if isControlActive then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        
        if controlConnection then controlConnection:Disconnect() end
        
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                camera.CameraSubject = ball
                local lookVector = camera.CFrame.LookVector
                ball.AssemblyLinearVelocity = lookVector * velocidadeBola
            else
                resetCamera()
            end
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        
        resetCamera()
    end
end

