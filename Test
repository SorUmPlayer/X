-- =====================================================
--  AIMBOT PERSONAGEM (BodyGyro COM DELAY)
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        aimbotTimerRunning = false
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        aimbotTimerRunning = false
        return
    end

    -- Condições para ativar o aimbot
    local podeAtivar = not euTenhoBola() and bolaValida and hitbox ~= nil

    if not podeAtivar then
        -- Se não pode ativar, reseta o timer e remove o gyro
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        aimbotTimerRunning = false
        return
    end

    -- Se pode ativar, inicia o timer se não estiver rodando
    if not aimbotTimerRunning then
        aimbotTimerRunning = true
        aimbotTimerStart = tick()
    end

    -- Verifica se o delay já passou
    local elapsed = tick() - aimbotTimerStart
    if elapsed < aimbotDelay then
        -- Ainda em delay, não ativa o gyro
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    -- Delay passou, ativa o gyro
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA (ESTILO "ATRÁS DO PERSONAGEM")
-- =====================================================
local function atualizarAimbotCamera()
    if isControlActive then return end
    if not aimbotCamera or euTenhoBola() or not bolaValida or not hitbox then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

