})

local pastaDropdown = pastaCategory:CreateDropdown({
    Title = "Localização da pasta do NPC",
    Items = {},
    DefaultIndex = 1,
    Callback = function(item, index)
        -- item é o caminho completo (ex: "Workspace.Enemy.Boss")
        if selectNPCByPath(item) then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Selecionado",
                Text = "NPC destacado em verde!",
                Duration = 2
            })
        end
    end
})

pastaCategory:CreateButton({
    Title = "Copiar Pasta",
    Icon = "📂",
    Callback = function()
