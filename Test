-- ========== MÚSICA ==========
local function tocarMusica()
    local sound = Instance.new("Sound")
    -- ID fornecido (verifique se é válido; se não, use um som alternativo)
    local soundId = "rbxassetid://74575218169013"
    sound.SoundId = soundId
    sound.Volume = 0.5
    sound.Looped = false
    sound.Parent = screenGui
    
    -- Toca e, se falhar, tenta um som alternativo
    local success, err = pcall(function()
        sound:Play()
    end)
    if not success then
        -- Fallback: som de notificação padrão
        sound.SoundId = "rbxassetid://9120372320" -- som curto de notificação
        sound:Play()
        warn("Música principal falhou, usando fallback.")
    end
    return sound
end

