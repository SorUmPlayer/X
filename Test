-- Carga da biblioteca WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Serviços
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Evento de Dano
local DamageEvent = ReplicatedStorage:WaitForChild("FlowClient"):WaitForChild("ClientRunner"):WaitForChild("Event")

-- Configurações e Estado
local Config = {
    Enabled = false,
    Damage = 13.65,
    Distance = 50,
    Delay = 0.2 -- Intervalo de ataque
}

-- Função para obter a posição atual do jogador
local function GetPlayerPosition()
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp.Position
        end
    end
    return nil
end

-- Função para listar todos os Humanoids dentro da pasta workspace.NPCs (incluindo subpastas)
local function GetTargetsInFolder(folder)
    local targets = {}
    if not folder then return targets end

    for _, desc in ipairs(folder:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Health > 0 then
            local parentModel = desc.Parent
            if parentModel and parentModel:IsA("Model") then
                local hrp = parentModel:FindFirstChild("HumanoidRootPart") or parentModel.PrimaryPart
                targets[#targets + 1] = {
                    Humanoid = desc,
                    Part = hrp
                }
            end
        end
    end

    return targets
end

-- Loop Principal do Kill Aura
task.spawn(function()
    while true do
        task.wait(Config.Delay)

        if Config.Enabled then
            local playerPos = GetPlayerPosition()
            local npcsFolder = workspace:FindFirstChild("NPCs")

            if playerPos and npcsFolder then
                local targets = GetTargetsInFolder(npcsFolder)

                for _, targetData in ipairs(targets) do
                    if not Config.Enabled then break end

                    local humanoid = targetData.Humanoid
                    local part = targetData.Part

                    if humanoid and humanoid.Health > 0 then
                        local inRange = true

                        -- Checagem de distância caso exista uma parte física válida
                        if part then
                            local dist = (playerPos - part.Position).Magnitude
                            if dist > Config.Distance then
                                inRange = false
                            end
                        end

                        if inRange then
                            pcall(function()
                                DamageEvent:FireServer(
                                    "NPCs",
                                    "Damage",
                                    humanoid,
                                    Config.Damage
                                )
                            end)
                        end
                    end
                end
            end
        end
    end
end)

-- Criar a Janela WindUI
local Window = WindUI:CreateWindow({
    Title = "Kill Aura - NPCs",
    Icon = "rbxassetid://4483345998",
    Folder = "KillAuraConfig",
    Size = UDim2.fromOffset(380, 280),
    Transparent = true,
    Theme = "Dark"
})

-- Criar Aba
local MainTab = Window:Tab({ Title = "Main", Icon = "sword" })

MainTab:Section({ Title = "Configurações do Kill Aura" })

-- Input de Dano
MainTab:Input({
    Title = "Dano",
    Desc = "Quantidade de dano por ataque",
    Value = tostring(Config.Damage),
    Placeholder = "Digite o dano...",
    Callback = function(text)
        local num = tonumber(text)
        if num then
            Config.Damage = num
        end
    end
})

-- Input de Distância
MainTab:Input({
    Title = "Distância Máxima",
    Desc = "Alcance em studs do Kill Aura",
    Value = tostring(Config.Distance),
    Placeholder = "Digite a distância...",
    Callback = function(text)
        local num = tonumber(text)
        if num then
            Config.Distance = num
        end
    end
})

-- Toggle Ativar/Desativar
MainTab:Toggle({
    Title = "Ativar Kill Aura",
    Desc = "Aplica dano em todos os NPCs dentro de workspace.NPCs",
    Value = Config.Enabled,
    Callback = function(state)
        Config.Enabled = state
    end
})
