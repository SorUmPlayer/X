local function getBall()
    if bola and bolaValida then return bola end
    local f = Workspace:FindFirstChild("Football")
    if f then return f end
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") and c.Name ~= "Football" then
            local f2 = c:FindFirstChild("Football")
            if f2 then return f2 end
        end
    end
    return nil
end

local function getBallPart()
    local b = getBall()
    if not b then return nil end
    if b:IsA("BasePart") then return b end
    if b:IsA("Model") then return b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart") end
    return nil
end

