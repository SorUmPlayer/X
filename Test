-- ======================
--   MENU PRINCIPAL
-- ======================
local menu = Instance.new("Frame")
menu.Size = UDim2.new(0, 400, 0, 320) -- um pouco mais alto para o aviso interno
menu.Position = UDim2.new(0.5, -200, 0.5, -160)
menu.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
menu.BackgroundTransparency = 0.2
menu.BorderSizePixel = 0
menu.Parent = gui

-- Arrastar
local dragging = false
local dragStart, startPos
menu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = menu.Position
    end
end)
menu.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
menu.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        menu.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                   startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Mensagem traduzível
local mensagem = Instance.new("TextLabel")
mensagem.Size = UDim2.new(0.9, 0, 0.25, 0)
mensagem.Position = UDim2.new(0.05, 0, 0.05, 0)
mensagem.BackgroundTransparency = 1
mensagem.TextScaled = true
mensagem.TextColor3 = Color3.fromRGB(255, 255, 255)
mensagem.Text = "Bem-vindo ao canal!"
mensagem.Font = Enum.Font.GothamBold
mensagem.Parent = menu

-- Traduções
local traducoes = {
    PT = "Bem-vindo ao canal!",
    EN = "Welcome to the channel!",
    ES = "¡Bienvenido al canal!"
}

local function setLanguage(lang)
    mensagem.Text = traducoes[lang]
end

-- Botões de idioma
local botoes = {
    { texto = "Português", cor = Color3.fromRGB(0, 200, 0), lang = "PT" },
    { texto = "English", cor = Color3.fromRGB(0, 100, 255), lang = "EN" },
    { texto = "Español", cor = Color3.fromRGB(255, 150, 0), lang = "ES" }
}

local btnY = 0.33
local btnWidth = 0.28
local spacing = 0.03
local startX = (1 - (btnWidth * 3 + spacing * 2)) / 2

for i, dados in ipairs(botoes) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(btnWidth, 0, 0.18, 0)
    btn.Position = UDim2.new(startX + (btnWidth + spacing) * (i-1), 0, btnY, 0)
    btn.BackgroundColor3 = dados.cor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Text = dados.texto
    btn.Font = Enum.Font.GothamBold
    btn.Parent = menu
    
    btn.MouseButton1Click:Connect(function()
        setLanguage(dados.lang)
    end)
end

-- Botão "Copiar Link do canal"
local copiarBtn = Instance.new("TextButton")
copiarBtn.Size = UDim2.new(0.5, 0, 0.15, 0)
copiarBtn.Position = UDim2.new(0.25, 0, 0.65, 0)
