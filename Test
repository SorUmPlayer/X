-- Services
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

-- Carregamento da Biblioteca WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Criar a Janela Principal no WindUI
local Window = WindUI:CreateWindow({
    Title = "Blue Lock Rivals - Auto Spin",
    Icon = "dices",
    Author = "Developer",
    Folder = "BLRivalsConfig",
    Size = UDim2.fromOffset(500, 350),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 160
})

local MainTab = Window:Tab({ Title = "Spin Loop", Icon = "rotate-cw" })

-- Estado do Script
local State = {
    AutoSpin = false,
    TargetRarity = "World Class",
    SpinDelay = 0.5,
    IsSpinning = false
}

-- Interface de Controle no WindUI
local SpinSection = MainTab:Section({ Title = "Configuração do Auto Spin" })

local StatusParagraph = SpinSection:Paragraph({
    Title = "Status",
    Desc = "Aguardando início..."
})

SpinSection:Dropdown({
    Title = "Parar na Raridade",
    Values = { "Rare", "Epic", "Legendary", "World Class" },
    Value = "World Class",
    Callback = function(Value)
        State.TargetRarity = Value
    end
})

SpinSection:Toggle({
    Title = "Ativar Auto Spin",
    Value = false,
    Callback = function(Value)
        State.AutoSpin = Value
        if State.AutoSpin then
            task.spawn(function()
                while State.AutoSpin do
                    if not State.IsSpinning then
                        State.IsSpinning = true
                        StatusParagraph:SetTitle("Executando Giro...")
                        
                        -- Substitua este bloco pela chamada do RemoteEvent real do jogo:
                        -- game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("StyleService"):WaitForChild("RF"):WaitForChild("Spin"):InvokeServer()
                        
                        task.wait(State.SpinDelay)
                        StatusParagraph:SetTitle("Giro Concluído")
                        StatusParagraph:SetDesc("Aguardando próximo ciclo...")
                        
                        State.IsSpinning = false
                    end
                    task.wait(0.1)
                end
                StatusParagraph:SetTitle("Status")
                StatusParagraph:SetDesc("Auto Spin Parado.")
            end)
        end
    end
})

