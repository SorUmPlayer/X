-- Variáveis globais
local npcTable = {}          -- Tabela com todos os NPCs escaneados: { [path] = {npc, name, path, health} }
local selectedNPC = nil      -- NPC atualmente selecionado (objeto)
local highlightInstance = nil -- Instância de Highlight aplicada

-- Função para escanear NPCs no Workspace
local function scanNPCs()
    npcTable = {}
    local npcList = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local humanoid = obj.Humanoid
            if humanoid.Health > 0 then
                local path = getPath(obj) -- função para obter o caminho
                local name = obj.Name
                local health = humanoid.Health
                local maxHealth = humanoid.MaxHealth
                local healthPercent = math.floor((health / maxHealth) * 100)
                npcTable[path] = {
                    npc = obj,
                    name = name,
                    path = path,
                    health = healthPercent
                }
                table.insert(npcList, {path = path, display = name .. " (HP: " .. healthPercent .. "%)"})
            end
        end
    end

    -- Atualizar os dropdowns
    updateDropdowns(npcList)
end

-- Função auxiliar para obter o caminho completo de um objeto
local function getPath(obj)
    local path = ""
    local current = obj
    while current ~= workspace do
        if current.Parent then
            path = current.Name .. "." .. path
            current = current.Parent
        else
            break
        end
    end
    path = "workspace." .. path
    return path:sub(1, #path - 1) -- remove último ponto
end

-- Função para atualizar ambos os dropdowns
function updateDropdowns(npcList)
    -- Preparar itens para dropdown de Config (nome + HP)
    local configItems = {}
    local pastaItems = {}
    for _, info in ipairs(npcList) do
        table.insert(configItems, info.display)
        table.insert(pastaItems, info.path)
    end

    -- Atualizar dropdown de Config
    if configDropdown then
        configDropdown:SetItems(configItems)
        if #configItems > 0 then
            configDropdown:SetSelectedIndex(1)
        end
    end

    -- Atualizar dropdown de Pasta
    if pastaDropdown then
        pastaDropdown:SetItems(pastaItems)
        if #pastaItems > 0 then
            pastaDropdown:SetSelectedIndex(1)
        end
    end
end

-- Função para selecionar um NPC pelo caminho
function selectNPCByPath(path)
    if npcTable[path] then
        selectedNPC = npcTable[path].npc
        highlightNPC(selectedNPC)
        return true
    end
    return false
end

-- Função para destacar o NPC (chams verde)
function highlightNPC(npc)
    -- Remover highlight anterior
    if highlightInstance then
        highlightInstance:Destroy()
        highlightInstance = nil
    end

    if npc and npc:FindFirstChild("HumanoidRootPart") then
        highlightInstance = Instance.new("Highlight")
        highlightInstance.FillColor = Color3.new(0, 1, 0) -- verde
        highlightInstance.FillTransparency = 0.5
        highlightInstance.OutlineColor = Color3.new(0, 1, 0)
        highlightInstance.OutlineTransparency = 0.2
        highlightInstance.Adornee = npc
        highlightInstance.Parent = npc
    end
end

-- Função para teleportar até um NPC pelo nome
function teleportToNPC(npcName)
    for path, data in pairs(npcTable) do
        if data.name:lower() == npcName:lower() then
            local target = data.npc
            if target and target:FindFirstChild("HumanoidRootPart") then
                local pos = target.HumanoidRootPart.Position
                if humanoidRootPart then
                    humanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                    return true
                end
            end
        end
    end
    return false
end

