-- =============================================
-- SCRIPT DIMENSÃO 23 - KILL BOSS
-- =============================================
-- [[ SERVIÇOS ]]
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer

-- =============================================
-- CONFIGURAÇÕES PERSISTENTES
-- =============================================
local CONFIG_FILE = "Dimensao23_KillBoss_Config.json"

local Config = {
    Distancia = 10,
    Posicao = "Frente",
    Multiplicador = 1,
    Bivalvan = false,
    Galapagus = false
}

local function LoadConfig()
    if not isfile then return end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do
                Config[k] = v
            end
        end
    end
end

local function SaveConfig()
    if not writefile then return end
    local success, json = pcall(function()
        return HttpService:JSONEncode(Config)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
    end
end

LoadConfig()

-- =============================================
-- SISTEMA DE COMBATE (REMOTES)
-- =============================================
local RS = pcall(function()
    local remotes = ReplicatedStorage:FindFirstChild("AliensPowerRemotes")
    if remotes then
        return remotes:FindFirstChild("upgrade")
    end
end) and ReplicatedStorage:FindFirstChild("AliensPowerRemotes"):FindFirstChild("upgrade") or nil

local function Laser()
    if RS and RS.Laser then pcall(function() RS.Laser:InvokeServer() end) end
end
local function GunArm()
    if RS and RS.GunArm then pcall(function() RS.GunArm:InvokeServer() end) end
end
local function Armature()
    if RS and RS.Armature then pcall(function() RS.Armature:InvokeServer() end) end
end

local function ArmFire(targetRoot)
    if not RS or not RS.ArmFire then return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        local targetPosition = targetRoot and targetRoot.Position or (root.Position + Vector3.new(0, -100, 0))
        pcall(function()
            RS.ArmFire:InvokeServer(targetPosition)
        end)
    end
end

-- =============================================
-- LÓGICA DE POSIÇÃO
-- =============================================
local function getOffset(posicao, distancia)
    local offset = Vector3.new(0, 0, 0)
    if posicao == "Baixo" then
        offset = Vector3.new(0, -distancia, 0)
    elseif posicao == "Cima" then
        offset = Vector3.new(0, distancia, 0)
    elseif posicao == "Frente" then
        offset = Vector3.new(0, 0, -distancia)
    elseif posicao == "Costa" then
        offset = Vector3.new(0, 0, distancia)
    end
    return offset
end

-- =============================================
-- LOOP DE COMBATE
-- =============================================
local killBossRunning = false
local killBossConnection = nil

local function getBossTarget()
    local enemys = Workspace:FindFirstChild("Enemys")
    if not enemys then return nil end

    -- Prioridade: Bivalvan > Galapagus (primeiro ativo)
    if Config.Bivalvan then
        local folder = enemys:FindFirstChild("Bivalvan")
        if folder then
            local char = folder:FindFirstChild("Character")
            if char and char:IsA("Model") then
                local part = char:FindFirstChild("Ominitrix_Symbol") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                if part then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        return part
                    end
                end
            end
        end
    end

    if Config.Galapagus then
        local folder = enemys:FindFirstChild("Galapagus")
        if folder then
            local char = folder:FindFirstChild("Character")
            if char and char:IsA("Model") then
                local part = char:FindFirstChild("Ominitrix_Symbol") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                if part then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        return part
                    end
                end
            end
        end
    end

    return nil
end

local function startKillBossLoop()
    if killBossConnection then return end
    killBossRunning = true
    killBossConnection = RunService.Heartbeat:Connect(function()
        if not (Config.Bivalvan or Config.Galapagus) then
            killBossRunning = false
            if killBossConnection then
                killBossConnection:Disconnect()
                killBossConnection = nil
            end
            return
        end

        local targetPart = getBossTarget()
        if not targetPart then return end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- Calcula posição com offset
        local offset = getOffset(Config.Posicao, Config.Distancia)
        -- Aplica offset no CFrame do alvo
        local targetCFrame = targetPart.CFrame * CFrame.new(offset)
        root.CFrame = targetCFrame

        -- Multiplicador
        local multiplier = math.floor(tonumber(Config.Multiplicador) or 1)
        if multiplier < 1 then multiplier = 1 end

        for i = 1, multiplier do
            if not (Config.Bivalvan or Config.Galapagus) then break end
            Laser()
            GunArm()
            ArmFire(targetPart)
            Armature()
            task.wait(0.05)
        end
    end)
end

if Config.Bivalvan or Config.Galapagus then
    task.spawn(startKillBossLoop)
end

-- =============================================
-- INTERFACE WINDUI
-- =============================================
local function CriarMenu()
    -- Carrega a WindUI
    local WindUI
    local url = "https://raw.githubusercontent.com/ukinabr/WindUI/refs/heads/main/dist/main.lua"
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        WindUI = result
    else
        local fallbackUrl = "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
        success, result = pcall(function()
            return loadstring(game:HttpGet(fallbackUrl))()
        end)
        if success and result then
            WindUI = result
        else
            StarterGui:SetCore("SendNotification", {
                Title = "Erro",
                Text = "Não foi possível carregar a WindUI.",
                Duration = 5
            })
            return
        end
    end

    local Window = WindUI:CreateWindow({
        Title = "Dimensão 23 - Kill Boss",
        Icon = "rbxassetid://135710581431595",
        Author = "Noob Must Die",
        Folder = "Dimensao23_KillBoss",
        Size = UDim2.fromOffset(460, 320),
        Transparent = false,
        Theme = "Dark",
        Resizable = true,
        SideBarWidth = 200,
        BackgroundImageTransparency = 0.42,
        HideSearchBar = true,
        ScrollBarEnabled = false,
        User = {
            Enabled = true,
            Anonymous = false,
            Callback = function() print("clicked") end,
        },
    })
    Window:SetIconSize(60)

    Window:EditOpenButton({
        Title = "Dimensão 23",
        Icon = "",
        CornerRadius = UDim.new(0, 16),
        StrokeThickness = 2,
        Color = ColorSequence.new(Color3.fromHex("FFFFFF"), Color3.fromHex("000000")),
        OnlyMobile = false,
        Enabled = true,
        Draggable = false
    })

    -- Aba Kill Boss
    local TabKillBoss = Window:Tab({ Title = "Kill Boss", Icon = "rbxassetid://135710581431595" })

    -- Categoria Configuração do Boss
    TabKillBoss:Section({ Title = "Configuração do Boss" })

    TabKillBoss:Slider({
        Title = "Distância",
        Desc = "Distância do boss (1-100)",
        Step = 1,
        Value = { Min = 1, Max = 100, Default = Config.Distancia },
        Callback = function(value)
            Config.Distancia = math.floor(value)
            SaveConfig()
        end
    })

    TabKillBoss:Dropdown({
        Title = "Posição",
        Desc = "Posição relativa ao boss",
        Values = {"Baixo", "Cima", "Frente", "Costa"},
        Value = Config.Posicao,
        Callback = function(value)
            Config.Posicao = value
            SaveConfig()
        end
    })

    TabKillBoss:Input({
        Title = "Multiplicador do Tiro",
        Desc = "Número de tiros por ciclo (Ex: 9)",
        Value = tostring(Config.Multiplicador),
        Placeholder = "Digite um número...",
        Callback = function(text)
            local numero = tonumber(text)
            if numero and numero > 0 then
                Config.Multiplicador = numero
                SaveConfig()
            else
                StarterGui:SetCore("SendNotification", {
                    Title = "Erro",
                    Text = "Digite um número válido!",
                    Duration = 2
                })
            end
        end
    })

    -- Categoria Boss
    TabKillBoss:Section({ Title = "Boss" })

    TabKillBoss:Toggle({
        Title = "Bivalvan",
        Desc = "Ativa o farm automático do Bivalvan",
        Value = Config.Bivalvan,
        Callback = function(value)
            Config.Bivalvan = value
            SaveConfig()
            if value or Config.Galapagus then
                task.spawn(startKillBossLoop)
            else
                if killBossConnection then
                    killBossConnection:Disconnect()
                    killBossConnection = nil
                end
            end
        end
    })

    TabKillBoss:Toggle({
        Title = "Galapagus",
        Desc = "Ativa o farm automático do Galapagus",
        Value = Config.Galapagus,
        Callback = function(value)
            Config.Galapagus = value
            SaveConfig()
            if Config.Bivalvan or value then
                task.spawn(startKillBossLoop)
            else
                if killBossConnection then
                    killBossConnection:Disconnect()
                    killBossConnection = nil
                end
            end
        end
    })

    return Window
end

-- Inicia o menu
pcall(CriarMenu)

StarterGui:SetCore("SendNotification", {
    Title = "Dimensão 23",
    Text = "Kill Boss carregado!",
    Duration = 3
})

print("Dimensão 23 - Kill Boss carregado.")
