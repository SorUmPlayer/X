-- LOOP OTIMIZADO
-- =============================================
local frameCounter = 0
local trajTimer = 0

RunService.Heartbeat:Connect(function(dt)
    -- Aimbot câmera + hitbox rodam todo frame (leves)
    atualizarAimbotCamera()
    aplicarHitbox()

    frameCounter = frameCounter + 1

    -- A cada 6 frames (~0.1s) roda as coisas pesadas
    if frameCounter % 6 == 0 then
        atualizarAdvinhaBola()
        atualizarAdvinheChute()
        atualizarESP()
    end
end)

