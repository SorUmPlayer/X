-- FUNÇÃO SEGURA DE PARENT
-- =============================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

