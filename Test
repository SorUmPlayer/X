-- ============================================
-- BOTÕES DE IDIOMA (3)
-- ============================================
local function criarBotaoIdioma(texto, cor, posX, idioma)
    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Size = UDim2.new(0, 120, 0, 38)
    btn.Position = UDim2.new(0, posX, 0, 170)
    btn.BackgroundColor3 = cor
    btn.BorderSizePixel = 2
    btn.BorderColor3 = Color3.fromRGB(0, 0, 0)
    btn.Text = texto
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 15
    btn.Font = Enum.Font.SourceSansBold
    btn.Name = idioma .. "Btn"

    btn.MouseButton1Click:Connect(function()
        local dados = TEXTOS[idioma]
        if dados then
            content.Text = dados.titulo .. "\n" .. dados.corpo
            -- Atualiza o texto do botão copiar também
            if not linkCopiado then
                copyBtn.Text = dados.copiar
            else
                copyBtn.Text = dados.copiado
            end
        end
    end)

    return btn
end

-- Português (Verde)
