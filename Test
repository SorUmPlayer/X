local function formatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function getServerUptime()
    -- Retorna o tempo de servidor usando RunService (se disponível) ou estimativa
    local success, serverTime = pcall(function()
        return RunService:GetServerTime()
    end)
    if success and serverTime then
        return serverTime
    end
    -- Fallback: estimativa baseada no horário de carregamento do script
    return os.time() - serverStartTime
end

local function getPlayerTime()
    return os.time() - playerJoinTime
end

local function atualizarDisplay()
    if timeDisplay then
        local serverUptime = getServerUptime()
        local playerUptime = getPlayerTime()
        local texto = "Tempo de servidor: " .. formatTime(serverUptime) .. "\nTempo que Player entrou: " .. formatTime(playerUptime)
        timeDisplay:SetDesc(texto)
    end
end

