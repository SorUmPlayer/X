-- =============================================
-- 5. CATEGORIA "BRING NPCs"
-- =============================================
local category = Window:AddCategory({
    Title = "BRING NPCs",
    Icon = "", -- pode colocar um ícone se quiser
})

-- Definição dos NPCs com caminhos e uma função de verificação
local npcData = {
    { name = "Lazarus", path = workspace.World5.Lazarus },
    { name = "NPC 2.0", path = workspace.Enemies["NPC 2.0"] },
    { name = "NPC", path = workspace.Enemies.NPC },
    { name = "Doom", path = workspace.Enemies.Doom },
    { name = "Shop", path = workspace.Catacombs.Shop },
}

-- Tabela para controlar os loops
local bringing = {} -- nome -> boolean (ativo)

-- Função que tenta obter o NPC (com verificação de existência)
local function getNPC(path)
    if type(path) == "Instance" and path:IsA("Instance") then
        return path
    end
    -- Se o caminho for uma string, tenta acessar via getfenv (caso o path seja variável)
    -- Mas aqui os paths são diretos, então só retornamos nil se não for válido
    return nil
end

-- Função para iniciar o bring
local function startBring(npcName, path)
    if bringing[npcName] then return end
    bringing[npcName] = true
    debugLog("Iniciando bring de " .. npcName)

    coroutine.wrap(function()
        while bringing[npcName] do
            local character = localPlayer.Character
            if not character then
                task.wait(0.5)
                continue
            end
            local root = character:FindFirstChild("HumanoidRootPart")
            if not root then
                task.wait(0.5)
                continue
            end

            local npc = getNPC(path)
            if not npc then
                debugLog("NPC " .. npcName .. " não encontrado. Parando bring.")
                bringing[npcName] = false
                -- Desmarca o toggle automaticamente (se possível via callback)
                -- A WindUI não tem método direto, mas podemos notificar o usuário.
                -- Vamos usar uma notificação simples (se a WindUI suportar)
                if Window:Notification then
                    Window:Notification({
                        Title = "NPC não encontrado",
                        Description = npcName .. " não está no jogo.",
                        Duration = 3,
                    })
                end
                break
            end

            local npcRoot = npc:FindFirstChild("HumanoidRootPart")
            if not npcRoot then
                debugLog("NPC " .. npcName .. " não tem HumanoidRootPart")
                task.wait(0.5)
                continue
            end

            -- Teleporta o NPC para o jogador
            npcRoot.CFrame = root.CFrame
            task.wait(0.5)
        end
        debugLog("Bring de " .. npcName .. " finalizado.")
    end)()
end

-- Função para parar o bring
local function stopBring(npcName)
    if bringing[npcName] then
        bringing[npcName] = false
        debugLog("Parando bring de " .. npcName)
    end
end

-- Adicionar toggles
for _, data in ipairs(npcData) do
    local toggle = category:AddToggle({
        Title = data.name,
        Description = "Trazer " .. data.name .. " para você",
        Default = false,
        Callback = function(value)
            if value then
                -- Verifica se o NPC existe antes de iniciar
                local npc = getNPC(data.path)
                if not npc then
                    debugLog("NPC " .. data.name .. " não existe no momento.")
                    -- Notifica o usuário (se disponível)
                    if Window:Notification then
                        Window:Notification({
                            Title = "NPC não encontrado",
                            Description = data.name .. " não está disponível agora.",
                            Duration = 3,
                        })
                    end
                    -- Desmarca o toggle (a WindUI geralmente mantém o estado, mas podemos forçar)
                    -- Não temos como desmarcar programaticamente, então apenas paramos.
                    return
                end
                startBring(data.name, data.path)
            else
                stopBring(data.name)
            end
        end
    })
end

debugLog("Script finalizado com sucesso.")
