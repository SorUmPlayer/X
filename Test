local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer

-- =============================================
-- SISTEMA DE SAVE (com fallback)
-- =============================================
local CONFIG_FILE = "BlueLockConfig.json"
local Config = {
    toggle1 = false,
    input1 = "",
    slider1 = 5,
    dropdown1 = "Opção 1",
    botaoClicado = false,
}

local function LoadConfig()
    if not isfile then return end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do
                Config[k] = v
            end
            print("[BlueLock] Config carregada.")
        end
    end
end

local function SaveConfig()
    if not writefile then return
    local success, json = pcall(function()
        return HttpService:JSONEncode(Config)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
        print("[BlueLock] Config salva.")
    end
end

LoadConfig()

-- =============================================
-- SEGURANÇA PARA PARENT DA GUI
-- =============================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

