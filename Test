--[[
    COLETOR AUTOMÁTICO DE PROXIMITYPROMPT (SEM TELEPORTE)
    Como funciona: Ao clicar no botão, o script varre TODO o jogo,
    mas SÓ ativa os prompts que estão dentro do raio de alcance do seu personagem.
    Isso simula um "auto-clicker E" para tudo que está perto de você.
]]

local player = game:GetService("Players").LocalPlayer
local button = script.Parent -- O botão onde este script está inserido

-- Variável de controle para ligar/desligar (opcional, mas útil)
local isRunning = false
local loopConnection = nil

-- Função para descobrir a posição exata do prompt (suporta Part, Attachment e Model)
local function getPromptPosition(prompt)
    local parent = prompt.Parent
    if parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("Model") then
        local primary = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
        if primary then
            return primary.Position
        end
    end
    return nil
end

-- Função principal que executa uma rodada de coleta
local function collectNearby()
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local collectedCount = 0
    local prompts = game:GetDescendants()
    
    for _, prompt in ipairs(prompts) do
        if prompt:IsA("ProximityPrompt") then
            local pos = getPromptPosition(prompt)
            if pos then
                -- Calcula a distância real do seu personagem até o prompt
                local distance = (hrp.Position - pos).Magnitude
                -- Verifica se está dentro do raio máximo de ativação do prompt
                if distance <= prompt.MaxActivationDistance then
                    -- Tenta ativar (aperta o "E" automaticamente)
                    local success, err = pcall(function()
                        prompt:Trigger()
                    end)
                    if success then
                        collectedCount = collectedCount + 1
                    end
                end
            end
        end
    end
    
    if collectedCount > 0 then
        print(string.format("[Coletor] Ativou %d prompts próximos!", collectedCount))
    end
end

-- Função para iniciar a coleta em loop (a cada 0.2 segundos)
local function startCollector()
    if isRunning then return end
    isRunning = true
    button.Text = "⏹ Coletando..."
    
    -- Executa imediatamente a primeira vez
    collectNearby()
    
    -- Cria o loop contínuo
    loopConnection = game:GetService("RunService").Heartbeat:Connect(function()
        -- Executa a cada tick (aproximadamente 60x por segundo, mas limitamos com um contador)
        -- Para não sobrecarregar, usamos um timer manual dentro do heartbeat ou um while com task.wait
    end)
    
    -- Método mais estável: loop usando task.wait() dentro de uma thread separada
    task.spawn(function()
        while isRunning do
            collectNearby()
            task.wait(0.2) -- Ajuste: 0.2 segundos entre cada varredura (bom para tycoons)
        end
    end)
end

-- Função para parar a coleta
local function stopCollector()
    isRunning = false
    button.Text = "▶ Coletar Próximos"
    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end
end

-- Alterna entre ligar e desligar ao clicar no botão
button.MouseButton1Click:Connect(function()
    if isRunning then
        stopCollector()
    else
        startCollector()
    end
end)

-- Para garantir que pare se o personagem morrer ou o jogo fechar
player.CharacterRemoving:Connect(function()
    stopCollector()
end)

-- Configuração inicial do botão
button.Text = "▶ Coletar Próximos"
button.Size = UDim2.new(0, 150, 0, 40)
button.Position = UDim2.new(0.8, 0, 0.9, 0) -- Canto inferior direito (flutuante)
button.BackgroundColor3 = Color3.fromRGB(30, 144, 255)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.GothamBold
button.TextSize = 16
