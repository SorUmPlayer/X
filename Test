-- Script LocalScript (coloque em StarterGui ou dentro de um ScreenGui)
local player = game.Players.LocalPlayer

-- Cria a interface
local gui = Instance.new("ScreenGui")
gui.Parent = player.PlayerGui

-- Frame principal (verde)
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 500, 0, 300)  -- Aumentei um pouco para caber o texto
frame.Position = UDim2.new(0.5, -250, 0.5, -150)
frame.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
frame.BackgroundTransparency = 0.15
frame.BorderSizePixel = 0
frame.Parent = gui

-- Texto da mensagem (inicial em português)
local mensagem = Instance.new("TextLabel")
mensagem.Size = UDim2.new(1, -20, 0, 100)
mensagem.Position = UDim2.new(0, 10, 0, 10)
mensagem.BackgroundTransparency = 1
mensagem.Text = "Script foi Atualizado....\n\nPor Favor Entre no Canal Pegue Novo Script...\nLink foi copiado Automaticamente....."
mensagem.TextColor3 = Color3.fromRGB(255, 255, 255)
mensagem.TextScaled = true
mensagem.Font = Enum.Font.SourceSansBold
mensagem.Parent = frame

-- Traduções (agora com o novo texto em cada idioma)
local traducoes = {
    Portugues = "Script foi Atualizado....\n\nPor Favor Entre no Canal Pegue Novo Script...\nLink foi copiado Automaticamente.....",
    English = "Script has been updated....\n\nPlease Join the Channel Get New Script...\nLink was copied automatically.....",
    Espanhol = "El script ha sido actualizado....\n\nPor favor, únete al canal y obtén el nuevo script...\nEl enlace se copió automáticamente....."
}

-- Função para traduzir
local function traduzir(idioma)
    mensagem.Text = traducoes[idioma] or mensagem.Text
end

-- Botão "Português" (verde)
local btnPT = Instance.new("TextButton")
btnPT.Size = UDim2.new(0, 120, 0, 45)
btnPT.Position = UDim2.new(0.5, -185, 0, 130) -- reposicionado para caber o texto
btnPT.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
btnPT.Text = "Português"
btnPT.TextColor3 = Color3.fromRGB(255, 255, 255)
btnPT.Font = Enum.Font.SourceSansBold
btnPT.TextScaled = true
btnPT.Parent = frame
btnPT.MouseButton1Click:Connect(function() traduzir("Portugues") end)

