local function criarLinhaVisao()
    if not linhaVisao or not linhaVisao.Parent then
        if linhaVisao then linhaVisao:Destroy() end
        linhaVisao = Instance.new("Part")
        linhaVisao.Name = "LinhaVisao"; linhaVisao.Anchored = true; linhaVisao.CanCollide = false
        linhaVisao.Transparency = 0.1; linhaVisao.Color = Color3.fromRGB(0, 255, 0)
        linhaVisao.Material = Enum.Material.Neon; linhaVisao.Size = Vector3.new(1, 1, 100)
        linhaVisao.Parent = workspace
    end
    return linhaVisao
end

local function atualizarVisaoBola()
    if not visaoBolaEnabled then
        if linhaVisao then linhaVisao:Destroy(); linhaVisao = nil end
        return
    end
    local inimigo = getInimigoComBola()
    if not inimigo then
        if linhaVisao then linhaVisao:Destroy(); linhaVisao = nil end
        return
    end
    local char = inimigo.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp
    if not origem then return end
    local pi = origem.Position
    if origem == hrp then pi = pi + Vector3.new(0, 1.5, 0) end
    local d = Vector3.new(1, 0, 0)
    if head then d = head.CFrame.LookVector elseif hrp then d = hrp.CFrame.LookVector end
    d = Vector3.new(d.X, 0, d.Z)
    if d.Magnitude < 0.001 then d = Vector3.new(1, 0, 0) else d = d.Unit end
    local pf = pi + d * 100
    criarLinhaVisao()
    local m = (pi + pf) / 2
    local dist = (pi - pf).Magnitude
    if dist < 0.1 then dist = 0.1 end
    linhaVisao.Size = Vector3.new(1, 1, dist)
    linhaVisao.CFrame = CFrame.lookAt(m, pf)
end

