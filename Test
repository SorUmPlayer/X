local category = Window:AddCategory({
    Title = "BRING NPCs",
    Icon = "", -- opcional
})

-- Mapeamento dos NPCs
local npcData = {
    { name = "Lazarus", get = function() return workspace.World5.Lazarus end },
    { name = "NPC 2.0", get = function() return workspace.Enemies["NPC 2.0"] end },
    { name = "NPC", get = function() return workspace.Enemies.NPC end },
    { name = "Doom", get = function() return workspace.Enemies.Doom end },
    { name = "Shop", get = function() return workspace.Catacombs.Shop end },
}

-- Tabela para controlar os loops de cada NPC
local bringing = {} -- chave = nome do NPC, valor = boolean (true = ativo)

-- Função para iniciar o bring de um NPC
local function startBring(npcName, getNPCFunc)
    if bringing[npcName] then return end -- já está ativo

    bringing[npcName] = true

    task.spawn(function()
        while bringing[npcName] do
            local player = players.LocalPlayer
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local playerRoot = character.HumanoidRootPart
                local npc = getNPCFunc()
                if npc and npc:FindFirstChild("HumanoidRootPart") then
                    local npcRoot = npc.HumanoidRootPart
                    -- Teleporta o NPC para a posição do jogador
                    npcRoot.CFrame = playerRoot.CFrame
                else
                    -- Se o NPC não existir, para o loop e desativa o toggle
                    bringing[npcName] = false
                    -- Opcional: notificar o usuário
                    warn("NPC " .. npcName .. " não encontrado!")
                    break
                end
            end
            task.wait(0.5) -- intervalo entre teleportes
        end
    end)
end

-- Função para parar o bring
local function stopBring(npcName)
    bringing[npcName] = false
end

-- Adicionar toggles para cada NPC
for _, data in ipairs(npcData) do
    local toggle = category:AddToggle({
        Title = data.name,
        Description = "Trazer " .. data.name .. " para você",
        Default = false,
        Callback = function(value)
            if value then
                startBring(data.name, data.get)
            else
                stopBring(data.name)
            end
        end
    })
end
