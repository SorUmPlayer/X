local function atualizarVisaoBolaAzure()
    if not visaoBolaEnabledAzure then
        if linhaVisaoAzure then linhaVisaoAzure:Destroy(); linhaVisaoAzure = nil end
        return
    end
    local inimigo = getEnemyWithBall()
    if not inimigo then
        if linhaVisaoAzure then linhaVisaoAzure:Destroy(); linhaVisaoAzure = nil end
        return
    end
    local head = inimigo:FindFirstChild("Head")
    local hrp = inimigo:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp or inimigo.PrimaryPart
    if not origem then return end
    local posInicio = origem.Position
    if origem == hrp then posInicio = posInicio + Vector3.new(0, 1.5, 0) end
    local direcao = Vector3.new(1, 0, 0)
    if head then direcao = head.CFrame.LookVector
    elseif hrp then direcao = hrp.CFrame.LookVector end
    direcao = Vector3.new(direcao.X, 0, direcao.Z)
    if direcao.Magnitude < 0.001 then direcao = Vector3.new(1, 0, 0) else direcao = direcao.Unit end
    local posFim = posInicio + direcao * 100
    if not linhaVisaoAzure or not linhaVisaoAzure.Parent then
        if linhaVisaoAzure then linhaVisaoAzure:Destroy() end
        linhaVisaoAzure = Instance.new("Part")
        linhaVisaoAzure.Name = "LinhaVisao"
        linhaVisaoAzure.Anchored = true
        linhaVisaoAzure.CanCollide = false
        linhaVisaoAzure.Transparency = 0.1
        linhaVisaoAzure.Color = Color3.fromRGB(0, 255, 0)
        linhaVisaoAzure.Material = Enum.Material.Neon
        linhaVisaoAzure.Size = Vector3.new(1, 1, 100)
        linhaVisaoAzure.Parent = workspace
    end
    local meio = (posInicio + posFim) / 2
    local dist = (posInicio - posFim).Magnitude
    if dist < 0.1 then dist = 0.1 end
    linhaVisaoAzure.Size = Vector3.new(1, 1, dist)
    linhaVisaoAzure.CFrame = CFrame.lookAt(meio, posFim)
end

local function atualizarAdvinhaChuteAzure()
    if not advinhaChuteEnabledAzure then
        if linhaChuteAzure then linhaChuteAzure:Destroy(); linhaChuteAzure = nil end
        if circuloChuteAzure then circuloChuteAzure:Destroy(); circuloChuteAzure = nil end
        return
    end
    local ball = getBallAzure()
    if not ball then
        if linhaChuteAzure then linhaChuteAzure:Destroy(); linhaChuteAzure = nil end
        if circuloChuteAzure then circuloChuteAzure:Destroy(); circuloChuteAzure = nil end
        return
    end
    local vel = ball.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed < 0.5 then
        if linhaChuteAzure then linhaChuteAzure.Transparency = 1 end
        if circuloChuteAzure then circuloChuteAzure.Transparency = 1 end
        return
    end
    local gravidade = Vector3.new(0, -55, 0)
    local pos, v = ball.Position, vel
    local dt, maxPassos, chaoY = 0.03, 120, 0
    local pontos = {pos}
    for _ = 1, maxPassos do
        v = v + gravidade * dt
        pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then break end
    end
    if #pontos < 2 then return end
    local inicio, fim = pontos[1], pontos[#pontos]
    fim = Vector3.new(fim.X, chaoY, fim.Z)
    local meio = (inicio + fim) / 2
    local distancia = (inicio - fim).Magnitude
    if not linhaChuteAzure then
        linhaChuteAzure = Instance.new("Part")
        linhaChuteAzure.Name = "LinhaChute"
        linhaChuteAzure.Anchored = true
        linhaChuteAzure.CanCollide = false
        linhaChuteAzure.Transparency = 0.2
        linhaChuteAzure.Color = Color3.fromRGB(255, 255, 0)
        linhaChuteAzure.Material = Enum.Material.Neon
        linhaChuteAzure.Parent = workspace
    end
    local tamanho = math.max(distancia, 1)
    linhaChuteAzure.Size = Vector3.new(0.5, 0.5, tamanho)
    linhaChuteAzure.CFrame = CFrame.lookAt(meio, fim)
    linhaChuteAzure.Transparency = 0.2
    if v.Y < -0.5 then
        if not circuloChuteAzure then
            circuloChuteAzure = Instance.new("Part")
            circuloChuteAzure.Name = "CirculoChute"
            circuloChuteAzure.Anchored = true
            circuloChuteAzure.CanCollide = false
            circuloChuteAzure.Transparency = 0.2
            circuloChuteAzure.Color = Color3.fromRGB(255, 255, 0)
            circuloChuteAzure.Material = Enum.Material.Neon
            circuloChuteAzure.Shape = Enum.PartType.Cylinder
            circuloChuteAzure.Parent = workspace
        end
        circuloChuteAzure.Position = fim
        local tam = math.clamp(speed / 8, 3, 8)
        circuloChuteAzure.Size = Vector3.new(tam, 0.1, tam)
        circuloChuteAzure.Transparency = 0.2
    else
        if circuloChuteAzure then circuloChuteAzure.Transparency = 1 end
    end
end

local function aplicarDribleAzure()
    if not dribleEnabledAzure then
        if dribleSphereAzure then dribleSphereAzure.Transparency = 1 end
        return
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not dribleSphereAzure then
        dribleSphereAzure = Instance.new("Part")
        dribleSphereAzure.Name = "DetectionSphereVisual"
        dribleSphereAzure.Shape = Enum.PartType.Ball
        dribleSphereAzure.Size = Vector3.new(dribleRadiusAzure*2, dribleRadiusAzure*2, dribleRadiusAzure*2)
        dribleSphereAzure.Material = Enum.Material.ForceField
        dribleSphereAzure.Color = Color3.fromRGB(255, 0, 128)
        dribleSphereAzure.Transparency = 0.6
        dribleSphereAzure.CanCollide = false
        dribleSphereAzure.Anchored = false
        dribleSphereAzure.CastShadow = false
        dribleSphereAzure.Parent = workspace
    end
    dribleSphereAzure.Position = hrp.Position
    dribleSphereAzure.Transparency = 0.6
    local now = tick()
    if now - dribleLastFiredAzure < dribleCooldownAzure then return end
    local characters = Workspace:FindFirstChild("characters")
    if not characters then return end
    for _, charModel in ipairs(characters:GetChildren()) do
        if charModel:IsA("Model") and charModel ~= char then
            local targetHrp = charModel:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist <= dribleRadiusAzure and isDribleAnim(charModel) then
                    local dirInimigo = targetHrp.CFrame.LookVector
                    local dirParaMim = (hrp.Position - targetHrp.Position).Unit
                    if dirInimigo:Dot(dirParaMim) >= 0.5 then
                        dribleLastFiredAzure = now
                        dispararDribleEvent()
                        break
                    end
                end
            end
        end
    end
end

