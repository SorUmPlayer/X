-- 1. SERVER SCRIPT – Coloque em ServerScriptService
-- ============================================================
--[[
   Este script cria o RemoteEvent e gerencia o teleporte.
   Também cria a GUI para cada jogador que entrar (opcional).
   Mas a GUI é mais fácil de criar no cliente, então faremos no cliente.
   Apenas o servidor lida com a lógica de teleporte.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Cria o RemoteEvent se não existir
local remoteEvent = ReplicatedStorage:FindFirstChild("TeleportToPrompts")
if not remoteEvent then
	remoteEvent = Instance.new("RemoteEvent")
	remoteEvent.Name = "TeleportToPrompts"
	remoteEvent.Parent = ReplicatedStorage
end

-- Função que retorna os prompts do jogador
local function getPlayerPrompts(player)
	local prompts = {}
	local character = player.Character
	if not character then return prompts end

	-- Percorre todos os ProximityPrompt do workspace
	for _, prompt in ipairs(workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") then
			local parent = prompt.Parent
			-- Verifica se o pai é uma BasePart e tem o atributo "Owner" = nome do jogador
			if parent and parent:IsA("BasePart") and parent:GetAttribute("Owner") == player.Name then
				table.insert(prompts, prompt)
			end
		end
	end
	return prompts
end

-- Evento disparado quando o jogador clica no botão
remoteEvent.OnServerEvent:Connect(function(player)
	local prompts = getPlayerPrompts(player)
	if #prompts == 0 then
		warn("Nenhum prompt encontrado para " .. player.Name)
		return
	end

	local character = player.Character
	if not character or not character.Parent then
		character = player.CharacterAdded:Wait()
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	-- Teleporta para cada prompt (com pequeno intervalo)
	for _, prompt in ipairs(prompts) do
		local target = prompt.Parent -- BasePart
		if target and target:IsA("BasePart") then
			local pos = target.Position + Vector3.new(0, 3, 0) -- ajuste de altura
			rootPart.CFrame = CFrame.new(pos)
			task.wait(0.15)
		end
	end

	print(string.format("%s coletou %d itens.", player.Name, #prompts))
end)

