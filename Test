-- 2. LOCAL SCRIPT – Coloque em StarterGui (dentro de um ScreenGui)
-- ============================================================
--[[
   Este script cria o botão flutuante na tela do jogador.
   Ele se comunica com o servidor via RemoteEvent.
--]]

local player = game.Players.LocalPlayer
local remote = game:GetService("ReplicatedStorage"):WaitForChild("TeleportToPrompts")

-- Criar a GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 120, 0, 50)
frame.Position = UDim2.new(0, 20, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(30, 144, 255)
frame.BackgroundTransparency = 0.2
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

-- Arredondar cantos (opcional)
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, 0, 1, 0)
button.Text = "📦 Coletar"
button.TextColor3 = Color3.new(1, 1, 1)
button.TextScaled = true
button.BackgroundTransparency = 1
button.Parent = frame

-- Ação ao clicar
button.MouseButton1Click:Connect(function()
	remote:FireServer()
	-- Feedback visual (opcional)
	button.Text = "⏳ Buscando..."
	task.wait(0.5)
	button.Text = "📦 Coletar"
end)
