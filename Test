-- ANTI-TACKLE
-- =============================================
local tackleAnimIds = {"rasteira", "tackle", "slide", "17996440171"}
local tackleCooldown = 0

local function isTackleAnim(character)
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    local animator = humanoid:FindFirstChild("Animator") or humanoid
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation then
            local id = tostring(track.Animation.AnimationId):lower()
            for _, pattern in ipairs(tackleAnimIds) do
                if string.find(id, pattern) then return true end
            end
        end
    end
    return false
end

local function antiTackle()
    if tick() - tackleCooldown < 0.5 then return end
    local char = player.Character
    if not char then return end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local enemyHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if enemyHrp then
                local dist = (enemyHrp.Position - myHrp.Position).Magnitude
                if dist < 8 and isTackleAnim(plr.Character) then
                    local warn = Instance.new("TextLabel")
                    warn.Size = UDim2.new(0, 200, 0, 30)
                    warn.Position = UDim2.new(0.5, -100, 0.7, 0)
                    warn.BackgroundTransparency = 1
                    warn.TextColor3 = Color3.fromRGB(255, 0, 0)
                    warn.TextStrokeTransparency = 0
                    warn.Text = "⚠️ RASTEIRA DETECTADA!"
                    warn.Font = Enum.Font.GothamBold
                    warn.TextSize = 18
                    warn.Parent = player.PlayerGui
                    game:GetService("Debris"):AddItem(warn, 0.8)
                    tackleCooldown = tick()
                    break
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        antiTackle()
    end
end)

