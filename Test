local aimbotPersonagemAzure = false
local aimbotCameraAzure = false

local aimbotDelayValuesAzure = {0, 0.1, 0.2, 0.25, 0.40, 0.60, 0.70, 1.0, 2.0, 3.0, 5.0}
local aimbotDelayValueAzure = 0
