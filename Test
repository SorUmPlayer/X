-- =============================================
-- HITBOX (REACH)
-- =============================================
local function aplicarHitbox()
    local ball = getBall()
    if not ball then return end

    if hitboxAtivo and not euTenhoBola() then
        ball.Size = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
        ball.Transparency = 1
    else
        ball.Size = Vector3.new(1.4, 1.4, 1.4)
        ball.Transparency = 0
    end
end

local function atualizarESP()
    local ball = getBall()
    if not ball then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if espHitbox and hitboxAtivo and not euTenhoBola() then
        if not espSphere then
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = "ReachESP"
            espSphere.Adornee = ball
            espSphere.Parent = ball
            espSphere.Color3 = Color3.fromRGB(0, 255, 0)
            espSphere.Transparency = 0.6
        end
        local scale = hitboxTamanho / 2.5
        espSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
end

-- =============================================
-- INFINITE STAMINA
-- =============================================
local function infiniteStamina()
    task.spawn(function()
        while true do
            -- PlayerStats
            local stats = player:FindFirstChild("PlayerStats")
            if stats then
                local stamina = stats:FindFirstChild("Stamina")
                if stamina and stamina:IsA("NumberValue") then
                    stamina.Value = 100
                end
            end
            -- UI
            local gui = player.PlayerGui:FindFirstChild("Stamina")
            if gui then
                local frame = gui:FindFirstChild("Frame")
                if frame then
                    local label = frame:FindFirstChild("Stamina")
                    if label and label:IsA("TextLabel") then
                        label.Text = "100"
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

