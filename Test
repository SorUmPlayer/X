-- Função para popular dropdown
local function PopulateDropdown(npcs)
    for _, child in pairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, npc in pairs(npcs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,0,0,25)
        btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
        local humanoid = npc:FindFirstChild("Humanoid")
        local hp = humanoid and math.floor(humanoid.Health) or "?"
        btn.Text = npc.Name .. " (HP: " .. hp .. ")"
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextSize = 13
        btn.Parent = scroll
        btn.MouseButton1Click:Connect(function()
            selectedNPC = npc
            dropBtn.Text = npc.Name .. " (HP: " .. hp .. ")"
            dropFrame.Visible = false
            -- Highlight verde
            for _, h in pairs(workspace:GetDescendants()) do
                if h:IsA("Highlight") and h.Name == "FarmHL" then h:Destroy() end
            end
            local hl = Instance.new("Highlight")
            hl.Name = "FarmHL"
            hl.Adornee = npc
            hl.FillColor = Color3.fromRGB(0,255,0)
            hl.FillTransparency = 0.5
            hl.Parent = npc
        end)
    end
    scroll.CanvasSize = UDim2.new(0,0,0, #npcs * 27)
end

scanBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    npcList = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if hrp and (hrp.Position - root.Position).Magnitude <= 50 then
                table.insert(npcList, obj)
            end
        end
    end
    PopulateDropdown(npcList)
end)

