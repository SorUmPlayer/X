-- AUTO GOL (botão único – click executa, botão direito troca time)
-- =============================================
local function executarAutoGolImediato()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local posOriginal = hrp.Position
    local posGol = autoGolTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)
    hrp.CFrame = CFrame.new(posGol)
    task.wait(0.2)
    local args = { [1] = 110, [4] = posGol }
    local bs = ReplicatedStorage:FindFirstChild("Packages")
    if bs then
        bs = bs:FindFirstChild("Knit")
        if bs then
            bs = bs:FindFirstChild("Services")
            if bs then
                bs = bs:FindFirstChild("BallService")
                if bs then
                    local sh = bs:FindFirstChild("RE")
                    if sh then sh:FireServer(unpack(args)) end
                end
            end
        end
    end
    task.wait(0.2)
    hrp.CFrame = CFrame.new(posOriginal)
end

