-- BOTÃO FLUTUANTE (GUI protegida)
-- =============================================
local floatingButton = nil
local floatingGui = nil
local isControlActive = false
local controlConnection = nil
local velocidadeBola = Config.velocidadeBola

local function createFloatingButton()
    if floatingGui then return end

    -- Usa PlayerGui em vez de CoreGui para evitar detecção
    local gui = Instance.new("ScreenGui")
    gui.Name = tostring(math.random(1000, 9999))  -- nome aleatório
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Control BALL [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    floatingGui = gui
    floatingButton = btn

    btn.MouseButton1Click:Connect(function()
        isControlActive = not isControlActive
        Config.controleAtivo = isControlActive
        SaveConfig()

        if isControlActive then
            btn.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            btn.Text = "Control BALL [ON]"
            if controlConnection then controlConnection:Disconnect() end
            controlConnection = RunService.Heartbeat:Connect(function()
                local ball = getBall()
                if ball then
                    -- Usa BodyVelocity em vez de modificar AssemblyLinearVelocity diretamente
                    local bv = ball:FindFirstChild("ControlVelocity")
                    if not bv then
                        bv = Instance.new("BodyVelocity")
                        bv.Name = "ControlVelocity"
                        bv.MaxForce = Vector3.new(4000, 4000, 4000)
                        bv.Parent = ball
                    end
                    local look = camera.CFrame.LookVector
                    bv.Velocity = look * velocidadeBola
                end
            end)
        else
            btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            btn.Text = "Control BALL [OFF]"
            if controlConnection then
                controlConnection:Disconnect()
                controlConnection = nil
            end
            -- Remove BodyVelocity quando desligar
            local ball = getBall()
            if ball then
                local bv = ball:FindFirstChild("ControlVelocity")
                if bv then bv:Destroy() end
            end
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                camera.CameraSubject = player.Character.Humanoid
            end
        end
    end)

    -- Se já estiver ativo, mantém o estado
    if Config.controleAtivo then
        btn.MouseButton1Click:Fire()
    end
end

local function removeFloatingButton()
    if floatingGui then
        floatingGui:Destroy()
        floatingGui = nil
        floatingButton = nil
    end
    if controlConnection then
        controlConnection:Disconnect()
        controlConnection = nil
    end
    local ball = getBall()
    if ball then
        local bv = ball:FindFirstChild("ControlVelocity")
        if bv then bv:Destroy() end
    end
end

-- =============================================
-- AUTO SEXTA (sem modificar AssemblyLinearVelocity diretamente)
-- =============================================
local autoSextaActive = false
local timeSelecionado = Config.timeSelecionado

local function aplicarAutoSexta()
    if not autoSextaActive then return end

    local ball = getBall()
    if not ball then return end

    local aro = getAro(timeSelecionado)
    if not aro then return end

    -- Só atua se a bola estiver com velocidade alta (sinal de arremesso)
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 10 then return end

    -- Aplica força apenas se estiver a uma distância razoável do aro
    local dist = getDistance(ball.Position, aro.Position)
    if dist > 100 then return end

    -- Usa BodyVelocity para redirecionar, com delay aleatório
    task.wait(math.random(1, 5) / 100)
    local dir = (aro.Position - ball.Position).Unit
    local bv = ball:FindFirstChild("AutoSextaVelocity")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "AutoSextaVelocity"
        bv.MaxForce = Vector3.new(5000, 5000, 5000)
        bv.Parent = ball
    end
    bv.Velocity = dir * 80
end

-- =============================================
-- HITBOX POR SOFTWARE (sem mexer no Collider)
-- =============================================
local hitboxActive = false
local hitboxTamanho = 20
local espActive = false
local espSphere = nil

local function aplicarHitboxSoftware()
    -- Apenas simula a hitbox visualmente e através de um loop de detecção
    -- Não modifica o Collider original
    if not hitboxActive then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    -- Cria uma esfera de detecção (visual) ao redor da bola
    local ball = getBall()
    if not ball then return end

    if espActive then
        if not espSphere or espSphere.Parent ~= ball then
            if espSphere then espSphere:Destroy() end
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = "HitboxESP"
            espSphere.Adornee = ball
            espSphere.Parent = ball
            espSphere.Color3 = Color3.fromRGB(0, 255, 0)
            espSphere.Transparency = 0.5
        end
        local scale = hitboxTamanho / 2.5
        espSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
end

-- =============================================
-- COMANDO DE CHAT (velocidade da bola)
-- =============================================
local function onChatMessage(msg)
    local lower = msg:lower()
    if lower:match("^velocidade da bola") then
        local num = msg:match("^velocidade da bola (%d+)")
        if num then
            local val = tonumber(num)
            if val and val > 0 and val <= 200 then
                velocidadeBola = val
                Config.velocidadeBola = val
                SaveConfig()
                player:Chat("Velocidade da bola ajustada para " .. val)
            else
                player:Chat("Use um número entre 1 e 200.")
            end
        else
            player:Chat("Use: Velocidade da bola [número]")
        end
    end
end

local chatService = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
if chatService then
    local onMessage = chatService:FindFirstChild("OnMessage")
    if onMessage then
        onMessage.OnClientEvent:Connect(onChatMessage)
    end
end

