-- 1. Copiar link automaticamente após executar o script
local youtubeLink = "https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp"
if setclipboard then
    setclipboard(youtubeLink)
end

-- 2. Carregando a biblioteca WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- 3. Criando a Janela Principal (Menu)
local Window = WindUI:CreateWindow({
    Title = "Menu de Tradução",
    Icon = "lucide-globe",
    Author = "sorumplayer",
    Folder = "SorumScript",
    Size = UDim2.fromOffset(500, 400),
    Transparent = false,
    Theme = "Dark",
    SideBarWidth = 150,
    HasOutline = true
})

-- Ajustando o tema para: Menu Verde com Texto Branco
WindUI:SetTheme({
    Accent = Color3.fromRGB(40, 200, 40), -- Verde
    Text = Color3.fromRGB(255, 255, 255)  -- Branco
})

-- Notificação inicial avisando que o link já foi copiado
WindUI:Notify({
    Title = "Sucesso!",
    Content = "Link do YouTube copiado para a área de transferência ao iniciar.",
    Duration = 5,
})

-- 4. Criando a Aba e o Texto
local MainTab = Window:Tab({
    Title = "Idiomas",
    Icon = "lucide-message-square"
})

local Message = MainTab:Paragraph({
    Title = "Mensagem",
    Desc = "Olá! Escolha o seu idioma clicando nos botões abaixo."
})

MainTab:Divider()

-- 5. Criando os 3 Botões de Tradução

-- Botão Verde (Português)
MainTab:Button({
    Title = "🟢 Português",
    Desc = "Mudar texto para Português",
    Callback = function()
        Message:Set({
            Title = "Mensagem",
            Desc = "Olá! Escolha o seu idioma clicando nos botões abaixo."
        })
    end
})

-- Botão Azul (English)
MainTab:Button({
    Title = "🔵 English",
    Desc = "Change text to English",
    Callback = function()
        Message:Set({
            Title = "Message",
            Desc = "Hello! Choose your language by clicking the buttons below."
        })
    end
})

-- Botão Laranja (Espanhol)
MainTab:Button({
    Title = "🟠 Espanhol",
    Desc = "Cambiar texto al Español",
    Callback = function()
        Message:Set({
            Title = "Mensaje",
            Desc = "¡Hola! Elige tu idioma haciendo clic en los botones de abajo."
        })
    end
})

MainTab:Divider()

-- 6. Botão extra para copiar o link manualmente
MainTab:Button({
    Title = "🔗 Copiar link",
    Desc = "Copia o link do canal do YouTube",
    Callback = function()
        if setclipboard then
            setclipboard(youtubeLink)
            WindUI:Notify({
                Title = "Link Copiado!",
                Content = "O link foi copiado para a sua área de transferência.",
                Duration = 3,
            })
        end
    end
})

