-- =============================================
-- SHOULD AIMBOT WORK
-- =============================================
local function shouldAimbotWork()
    if euTenhoBola() then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then aimbotBlocked = false; return true
        else return false end
    end
    return true
end

-- =============================================
-- REACH DA BOLA (fix hitbox para qualquer jogador)
-- =============================================
local function aplicarReachBola()
    if not hitbox then return end
    local comAlguem = alguemTemBola()
    local agora = tick()
    if comAlguem then hitboxDesativadoAte = agora + 0.5 end
    if agora < hitboxDesativadoAte then
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end
    if not reachBolaAtivo then
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end
    local tamanhoDesejado = Vector3.new(reachBolaDistancia, reachBolaDistancia, reachBolaDistancia)
    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= 1 then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = 1
    end
end

