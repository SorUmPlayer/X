-- Dropdown que mostra nome + HP
local configDropdown = configCategory:CreateDropdown({
    Title = "Todos NPC próximo de mim",
    Items = {}, -- preenchido pelo scan
    DefaultIndex = 1,
    Callback = function(item, index)
        -- item é a string exibida (ex: "Boss (HP: 80%)")
        for path, data in pairs(npcTable) do
            local display = data.name .. " (HP: " .. data.health .. "%)"
            if display == item then
                selectNPCByPath(path)
                break
            end
        end
    end
})

