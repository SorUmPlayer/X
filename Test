local players = game:GetService("Players")
local coreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local LocalPlayer = players.LocalPlayer

-- =============================================
-- CONFIGURAÇÕES PERSISTENTES
-- =============================================
local CONFIG_FILE = "SorHubUniversal_Config.json"

local function LoadConfig()
    if not isfile then return {} end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            return data
        end
    end
    return {}
end

local function SaveConfigToFile(configTable)
    if not writefile then return end
    local success, json = pcall(function()
        return HttpService:JSONEncode(configTable)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
    end
end

local Config = {
    JogoSelecionado = "BlueLockRivals",
    AutoExecutar = false,
}
local savedConfig = LoadConfig()
for k, v in pairs(savedConfig) do
    Config[k] = v
end

local function SaveConfig()
    SaveConfigToFile(Config)
end

-- =============================================
-- SCRIPTS DOS JOGOS
-- =============================================
local Scripts = {
    BlueLockRivals = "https://raw.githubusercontent.com/SorUmPlayer/X/refs/heads/main/Blue%20Lock%20Rivals",
    VolleyballLegends = "https://raw.githubusercontent.com/SorUmPlayer/X/refs/heads/main/Volleyball%20Legends",
    FechaduraAzure = "https://raw.githubusercontent.com/SorUmPlayer/X/refs/heads/main/Fechadura%20Azure",
}

local function CarregarScript(jogo)
    local url = Scripts[jogo]
    if not url then
        StarterGui:SetCore("SendNotification", {
            Title = "Erro",
            Text = "Jogo não encontrado!",
            Duration = 3
        })
        return
    end
    pcall(function()
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)
        if success then
            local func, err = loadstring(result)
            if func then
                func()
                StarterGui:SetCore("SendNotification", {
                    Title = "SorHub",
                    Text = "Script carregado: " .. jogo,
                    Duration = 3
                })
            else
                StarterGui:SetCore("SendNotification", {
                    Title = "Erro",
                    Text = "Falha ao compilar: " .. tostring(err),
                    Duration = 5
                })
            end
        else
            StarterGui:SetCore("SendNotification", {
                Title = "Erro",
                Text = "Falha ao baixar: " .. tostring(result),
                Duration = 5
            })
        end
    end)
end

-- =============================================
-- AUTO EXECUTAR
-- =============================================
local autoExecutado = false

local function TentarAutoExecutar()
    if Config.AutoExecutar and not autoExecutado then
        autoExecutado = true
        CarregarScript(Config.JogoSelecionado)
    end
end

-- Tenta executar automaticamente quando o jogo carregar
task.spawn(function()
    -- Aguarda o jogador estar pronto
    repeat task.wait(1) until LocalPlayer and LocalPlayer.Character
    TentarAutoExecutar()
end)

-- Também tenta executar quando o script é carregado (já pode estar pronto)
if LocalPlayer and LocalPlayer.Character then
    TentarAutoExecutar()
end

