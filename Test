end

-- =============================================
-- FORÇA / CURVAS / DRIBLE
-- =============================================
local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    if not bola or not bolaValida then return end
    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        bola.AssemblyLinearVelocity = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
    end
    tinhaBola = tenho
end

local function aplicarCurvas()
    if not curvasEnabled then return end
    if not bola or not bolaValida then return end
    if euTenhoBola() then return end
    local vel = bola.AssemblyLinearVelocity
    if vel.Magnitude < 40 then return end
    if bola.Position.Y < 0.5 then return end
    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1
    if curvasModo == 1 then lado = 1
    elseif curvasModo == 2 then lado = -1
    elseif curvasModo == 3 then
        local now = tick()
        if now - curvasTimer > curvasIntervalo then
            curvasTimer = now
            curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
            curvasIntervalo = 0.5 + math.random() * 0.5
        end
        lado = curvasDirecaoAtual
    end
    bola.AssemblyLinearVelocity = vel + perp * lado * fator
end

local function setupDrible()
    if not dribleEvent then
        pcall(function()
            local pk = ReplicatedStorage:FindFirstChild("Packages")
            if pk then
                local k = pk:FindFirstChild("Knit")
                if k then
                    local s = k:FindFirstChild("Services")
                    if s then
                        local bs = s:FindFirstChild("BallService")
                        if bs then
                            local re = bs:FindFirstChild("RE")
                            if re then dribleEvent = re:FindFirstChild("Dribble") end
                        end
                    end
                end
            end
        end)
    end
    if not dribleSphere then
        dribleSphere = Instance.new("Part")
        dribleSphere.Name = "DetectionSphereVisual"
        dribleSphere.Shape = Enum.PartType.Ball
        dribleSphere.Size = Vector3.new(dribleRadius * 2, dribleRadius * 2, dribleRadius * 2)
        dribleSphere.Material = Enum.Material.ForceField
        dribleSphere.Color = Color3.fromRGB(255, 0, 128)
        dribleSphere.Transparency = 0.6
        dribleSphere.CanCollide = false
        dribleSphere.Anchored = false
        dribleSphere.CastShadow = false
        dribleSphere.Parent = workspace
    end
end

local function trackDribleAnimation(character)
    local hum = character:FindFirstChild("Humanoid")
    if not hum then return end
    local anim = hum:FindFirstChild("Animator") or hum
    local function check(track)
        if not track or not track.Animation then return end
        if string.find(tostring(track.Animation.AnimationId), dribleAnimId) then
            driblePlayingAnims[character] = true
            local cs, ce
            cs = track.Stopped:Connect(function() driblePlayingAnims[character] = nil; cs:Disconnect(); if ce then ce:Disconnect() end end)
            ce = track.Ended:Connect(function() driblePlayingAnims[character] = nil; cs:Disconnect(); ce:Disconnect() end)
        end
    end
    for _, t in ipairs(anim:GetPlayingAnimationTracks()) do check(t) end
    anim.AnimationPlayed:Connect(check)
end

local function setupDriblePlayerTracking(plr)
    if plr == player then return end
    if plr.Character then task.spawn(trackDribleAnimation, plr.Character) end
    plr.CharacterAdded:Connect(function(c)
        driblePlayingAnims[c] = nil
        task.spawn(trackDribleAnimation, c)
    end)
end

local function isDribleAnimActive(char)
    if driblePlayingAnims[char] then return true end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return false end
    local anim = hum:FindFirstChild("Animator") or hum
    for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
        if t.Animation and string.find(tostring(t.Animation.AnimationId), dribleAnimId) then return true end
    end
    return false
end

local function isLookingAtLocal(th, lh)
    local d = (lh.Position - th.Position).Unit
    return th.CFrame.LookVector:Dot(d) >= 0.5
end

local function aplicarDrible()
    if not dribleEnabled then
        if dribleSphere then dribleSphere.Transparency = 1 end
        return
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if dribleSphere then
        dribleSphere.Position = hrp.Position
        dribleSphere.Transparency = 0.6
        dribleSphere.Parent = workspace
    end
    local now = tick()
    if now - dribleLastFired < dribleCooldown then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local th = p.Character:FindFirstChild("HumanoidRootPart")
            if th then
                if (th.Position - hrp.Position).Magnitude <= dribleRadius
                    and isLookingAtLocal(th, hrp) and isDribleAnimActive(p.Character) then
                    dribleLastFired = now
                    if dribleEvent then dribleEvent:FireServer("fbc7892b8f694cfd98d7ef93bc018abe", 3) end
                    break
                end
            end
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupDriblePlayerTracking(p) end
Players.PlayerAdded:Connect(setupDriblePlayerTracking)
Players.PlayerRemoving:Connect(function(p) if p.Character then driblePlayingAnims[p.Character] = nil end end)

