local function getBall()
    local b = Workspace:FindFirstChild("ball")
    if b then return b end
    return Workspace:FindFirstChild("Ball")
end

local function euTenhoBola()
    local ball = getBall()
    if not ball then return false end
    local char = player.Character
    if not char then return false end
    if ball:IsDescendantOf(char) then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local diff = hrp.Position - ball.Position
    local horizontal = math.sqrt(diff.X * diff.X + diff.Z * diff.Z)
    local vertical = math.abs(diff.Y)
    return horizontal < 4 and vertical < 6
end

local function alguemTemBola()
    local ball = getBall()
    if not ball then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char then
            if ball:IsDescendantOf(char) then return plr, char end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local diff = hrp.Position - ball.Position
                local horizontal = math.sqrt(diff.X * diff.X + diff.Z * diff.Z)
                local vertical = math.abs(diff.Y)
                if horizontal < 4 and vertical < 6 then
                    return plr, char
                end
            end
        end
    end
    return nil
end

