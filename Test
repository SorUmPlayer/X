-- =============================================
-- CARREGA A WINDUI COM FALLBACK
-- =============================================
local WindUI = nil
local urls = {
    "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
    "https://raw.githubusercontent.com/ukinabr/WindUI/refs/heads/main/dist/main.lua",
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
}

for _, url in ipairs(urls) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        WindUI = result
        print("[Blue Lock] WindUI carregada de: " .. url)
        break
    end
end

if not WindUI then
    error("[Blue Lock] Falha ao carregar WindUI em todas as tentativas. Verifique sua conexão.")
end

