-- =============================================
-- RAINHA INFINITY 1 - LOOP ESPECIAL
-- =============================================
local raidInfinity1Running = false
local raidInfinity1Connection = nil
local bossSpawnado = false
local bossMorto = false
local coletando = false
local velocidadeOriginal = 16
local walkSpeedOriginal = 16

local function startRaidInfinity1()
    if raidInfinity1Connection then return end
    raidInfinity1Running = true
    raidInfinity1Connection = RunService.Heartbeat:Connect(function()
        if not Config.RaidInfinity1Enabled then
            raidInfinity1Running = false
            if raidInfinity1Connection then
                raidInfinity1Connection:Disconnect()
                raidInfinity1Connection = nil
            end
            return
        end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not root or not hum then return end

        -- Aplicar noclip nos spikes
        aplicarNoclipSpikes()

        -- Procurar o boss
        local bossFolder = Workspace:FindFirstChild("Enemys")
        if bossFolder then
            local salamander = bossFolder:FindFirstChild("Double Fire Salamander")
            if salamander then
                local bossChar = salamander:FindFirstChild("Character")
                if bossChar and bossChar:IsA("Model") then
                    local bossRoot = bossChar:FindFirstChild("HumanoidRootPart")
                    local bossHum = bossChar:FindFirstChildOfClass("Humanoid")
                    if bossRoot and bossHum and bossHum.Health > 0 then
                        bossSpawnado = true
                        bossMorto = false
                        -- Atirar no boss
                        root.CFrame = bossRoot.CFrame * CFrame.new(0, 2, 0)
                        local multiplier = math.floor(tonumber(Config.ShotSpeedIndex) or 1)
                        if multiplier < 1 then multiplier = 1 end
                        for i = 1, multiplier do
                            if not Config.RaidInfinity1Enabled then break end
                            Laser()
                            GunArm()
                            ArmFire(bossRoot)
                            Armature()
                            task.wait(0.05)
                        end
                        return
                    else
                        -- Boss morto ou não encontrado
                        if bossSpawnado and not bossMorto then
                            bossMorto = true
                            print("[Infinity 1] Boss morto! Teleportando para Map_Part...")
                            -- Teleportar para Map_Part
                            local mapPart = Workspace:FindFirstChild("World")
                            if mapPart then
                                mapPart = mapPart:FindFirstChild("Map")
                                if mapPart then
                                    mapPart = mapPart:FindFirstChild("Milkya_Temple")
                                    if mapPart then
                                        local target = mapPart:FindFirstChild("Map_Part")
                                        if target and target:IsA("BasePart") then
                                            -- Teleportar com velocidade 350
                                            local originalSpeed = hum.WalkSpeed
                                            hum.WalkSpeed = 350
                                            ExecutarTeleporte(target.CFrame)
                                            -- Grudar no Map_Part (seguir)
                                            task.spawn(function()
                                                while Config.RaidInfinity1Enabled and target and target.Parent do
                                                    local char2 = LocalPlayer.Character
                                                    local root2 = char2 and char2:FindFirstChild("HumanoidRootPart")
                                                    if root2 then
                                                        root2.CFrame = target.CFrame * CFrame.new(0, 0, 5)
                                                    end
                                                    task.wait(0.5)
                                                end
                                            end)
                                            -- Coletar ProximityPrompt
                                            coletando = true
                                            Config.RaidInfinity1Coletando = true
                                            task.spawn(function()
                                                while Config.RaidInfinity1Enabled and coletando do
                                                    local prompts = Workspace:GetDescendants()
                                                    for _, obj in ipairs(prompts) do
                                                        if obj:IsA("ProximityPrompt") then
                                                            pcall(function()
                                                                obj:InputHoldBegin(LocalPlayer)
                                                                task.wait(0.1)
                                                                obj:InputHoldEnd(LocalPlayer)
                                                            end)
                                                        end
                                                    end
                                                    task.wait(0.2)
                                                end
                                            end)
                                            hum.WalkSpeed = originalSpeed
                                            return
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        -- Se o boss não existir e não tiver sido spawnado, teleportar para a posição inicial
        if not bossSpawnado and not bossMorto then
            ExecutarTeleporte(CFrame.new(430, -137, 95))
        end
    end)
end

if Config.RaidInfinity1Enabled then
    task.spawn(startRaidInfinity1)
end

