-- Lógica de Detecção da Bola Dinâmica & Alteração da Hitbox
----------------------------------------------------------------

-- Função para encontrar todas as partes válidas da bola no workspace
local function getBallParts()
    local parts = {}
    
    for _, item in ipairs(workspace:GetChildren()) do
        -- Verifica se o nome começa com "CLIENT_BALL_"
        if string.sub(item.Name, 1, 12) == "CLIENT_BALL_" then
            if item:IsA("BasePart") then
                table.insert(parts, item)
            else
                -- Caso a bola seja um Folder ou Model
                for _, child in ipairs(item:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(parts, child)
                    end
                end
            end
        end
    end
    
    return parts
end

-- Loop Contínuo aplicando o tamanho e transparência
task.spawn(function()
    while task.wait(0.1) do
        if HitboxEnabled then
            local balls = getBallParts()
            for _, part in ipairs(balls) do
                part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                part.Transparency = 0.6
                part.CanCollide = false
            end
        end
    end
end)
