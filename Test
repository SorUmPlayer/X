-- =====================================================
--  CATEGORIA GK (Goleiro)
-- =====================================================

local gkEnabled = false
local gkTeam = nil           -- "Home" ou "Away"
local gkPosition = nil       -- posição fixa do goleiro no gol
local gkCircle = nil         -- círculo de detecção
local gkRadius = 30          -- raio do círculo (gigante)
local gkGrabRadius = 5       -- raio para pegar a bola
local gkLastDive = 0
local gkDiveCooldown = 1.0   -- evitar spam de Dive

-- Determinar time pela posição do jogador
local function determinarTime()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local pos = hrp.Position
    local distHome = (pos - Vector3.new(-234, 11, -49)).Magnitude
    local distAway = (pos - Vector3.new(311, 11, -48)).Magnitude

    if distHome < distAway then
        return "Home"
    else
        return "Away"
    end
end

-- Posição fixa do goleiro conforme time
local function getGKPosition()
    if gkTeam == "Home" then
        return Vector3.new(-234, 11, -47)
    elseif gkTeam == "Away" then
        return Vector3.new(311, 11, -50)
    else
        return nil
    end
end

-- Criar círculo de detecção (fixo)
local function criarCirculoGK()
    if gkCircle then return end
    if not gkPosition then return end

    gkCircle = Instance.new("Part")
    gkCircle.Name = "GKDetectionCircle"
    gkCircle.Shape = Enum.PartType.Cylinder
    gkCircle.Size = Vector3.new(gkRadius * 2, 0.5, gkRadius * 2)
    gkCircle.Position = gkPosition
    gkCircle.Transparency = 0.6
    gkCircle.Color = Color3.fromRGB(0, 150, 255)
    gkCircle.Anchored = true
    gkCircle.CanCollide = false
    gkCircle.Parent = workspace
end

-- Remover círculo
local function removerCirculoGK()
    if gkCircle then
        gkCircle:Destroy()
        gkCircle = nil
    end
end

-- Pegar a bola (simula toque)
local function pegarBola(ball)
    -- Cria uma parte temporária na posição do goleiro para simular toque
    local tempPart = Instance.new("Part")
    tempPart.Size = Vector3.new(2, 2, 2)
    tempPart.Position = gkPosition
    tempPart.Anchored = true
    tempPart.CanCollide = false
    tempPart.Transparency = 1
    tempPart.Parent = workspace

    if firetouchinterest then
        firetouchinterest(tempPart, ball, 0)
        task.wait(0.01)
        firetouchinterest(tempPart, ball, 1)
    end

    tempPart:Destroy()
end

-- Chutar a bola longe
local function chutarLonge(ball)
    local dir = (ball.Position - gkPosition).Unit
    -- Chuta para frente (direção oposta ao gol)
    local shootEvent = game:GetService("ReplicatedStorage").Packages.Knit.Services.BallService.RE.Shoot
    if shootEvent then
        shootEvent:FireServer(110, ball.Position + dir * 60)
    end
end

-- Usar Dive (mergulho)
local function usarDive(ball)
    local now = tick()
    if now - gkLastDive < gkDiveCooldown then return end
    gkLastDive = now

    local diveEvent = game:GetService("ReplicatedStorage").Packages.Knit.Services.BallService.RE.Dive
    if diveEvent then
        diveEvent:FireServer()
    end
end

-- Verificar se um adversário com bola está dentro da área AttemptGrabBox
local function getAdversarioComBolaNaArea()
    local area = workspace:FindFirstChild("AttemptGrabBox")
    if not area then return nil end
    if not area:IsA("BasePart") then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char and char:FindFirstChild("Football") then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Verifica se o ponto está dentro da área (caixa)
                    local relative = hrp.Position - area.Position
                    local size = area.Size / 2
                    if math.abs(relative.X) <= size.X and
                       math.abs(relative.Y) <= size.Y and
                       math.abs(relative.Z) <= size.Z then
                        return plr
                    end
                end
            end
        end
    end
    return nil
end

-- Posicionar o goleiro na frente do adversário
local function posicionarFrenteAdversario(adversario)
    local char = adversario.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local advPos = hrp.Position
    local dir = (gkPosition - advPos).Unit
    local novaPos = advPos + dir * 8 -- distância de segurança

    -- Atualiza posição do goleiro (apenas referência, não movimenta um modelo real)
    gkPosition = novaPos
    if gkCircle then
        gkCircle.Position = novaPos
    end
end

-- Restaurar posição fixa do goleiro
local function restaurarPosicaoGK()
    local pos = getGKPosition()
    if pos then
        gkPosition = pos
        if gkCircle then
            gkCircle.Position = pos
        end
    end
end

-- Função principal de atualização do GK (chamada no Heartbeat)
local function atualizarGK()
    if not gkEnabled then return end
    if not gkTeam then return end
    if not gkPosition then return end

    local ball = getBall()   -- usa a função getBall() já existente no script
    if not ball then return end

    -- 1. Verificar se a bola está dentro do círculo de detecção
    local distBola = (ball.Position - gkPosition).Magnitude
    if distBola <= gkRadius then
        local vel = ball.AssemblyLinearVelocity
        local speed = vel.Magnitude

        if speed < 2 then
            -- Bola parada → pegar e chutar longe
            pegarBola(ball)
            chutarLonge(ball)
        else
            -- Bola em movimento: prever se vai em direção ao gol
            local dirBola = vel.Unit
            local dirGol = (gkPosition - ball.Position).Unit
            local dot = dirBola:Dot(dirGol)

            if dot > 0.3 then
                -- Está vindo em direção ao gol
                if speed > 15 or distBola > 15 then
                    -- Se muito rápida ou longe, usar Dive
                    usarDive(ball)
                else
                    -- Se perto e lenta, tentar pegar correndo (mas não temos movimento)
                    -- Pode tentar pegar se estiver muito perto
                    if distBola < gkGrabRadius then
                        pegarBola(ball)
                        chutarLonge(ball)
                    end
                end
            end
        end
    end

    -- 2. Verificar adversário com bola na área
    local adv = getAdversarioComBolaNaArea()
    if adv then
        posicionarFrenteAdversario(adv)
    else
        -- Se não houver adversário na área, volta para posição fixa
        restaurarPosicaoGK()
    end
end

-- Inicialização do GK
local function iniciarGK()
    gkTeam = determinarTime()
    if not gkTeam then
        warn("Não foi possível determinar o time. Posicione-se próximo ao gol.")
        return
    end

    gkPosition = getGKPosition()
    if not gkPosition then
        warn("Posição do gol não encontrada.")
        return
    end

    print("Você é do Time: " .. gkTeam)
    criarCirculoGK()
end

-- Desativar GK
local function desativarGK()
    gkEnabled = false
    removerCirculoGK()
end

-- =====================================================
--  ADICIONAR NA INTERFACE (seção GK)
-- =====================================================

-- Vamos adicionar uma seção "GK" na aba "Blue Lock Rivals"
-- Presumindo que as variáveis MainTab e sec... existem

local secGK = MainTab:Section({ Title = "GK (Goleiro)", TextXAlignment = "Left" })

secGK:Toggle({
    Title = "Auto GK",
    Desc = "Ativa o goleiro automático",
    Callback = function(v)
        gkEnabled = v
        if v then
            iniciarGK()
        else
            desativarGK()
        end
    end
})

-- Adicionar a função ao loop principal (Heartbeat)
-- Como o loop Heartbeat já existe, precisamos adicionar a chamada lá dentro.
-- Vamos supor que o loop principal está em algum lugar. Vou criar uma conexão separada.
-- Se preferir, pode inserir a chamada dentro do loop existente.

-- Conecta a função de atualização ao Heartbeat (se já existir, pode adicionar)
local gkConnection
local function conectarGK()
    if gkConnection then gkConnection:Disconnect() end
    gkConnection = RunService.Heartbeat:Connect(atualizarGK)
end

-- Quando o toggle for ativado, também conecta
-- Precisamos modificar o callback para conectar também
-- Vamos redefinir o toggle para incluir a conexão:

-- Substituir o toggle acima por este (com conexão)
-- Como não podemos redefinir facilmente, faremos uma segunda conexão independente.

-- Cria uma conexão separada que só executa se o GK estiver ativo
RunService.Heartbeat:Connect(function()
    if gkEnabled then
        atualizarGK()
    end
end)

