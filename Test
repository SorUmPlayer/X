-- ===== AUTO SAVE =====
local saveName = "SorHub_BlueLock"
local function saveState()
    local data = {
        velocidadeBola = velocidadeBola,
        aimbotPersonagem = aimbotPersonagem,
        aimbotCamera = aimbotCamera,
        reachAtivo = reachAtivo,
        reachDistancia = reachDistancia,
        mostrarESP = mostrarESP,
        hitboxPersonagemAtivo = hitboxPersonagemAtivo,
        hitboxPersonagemTamanho = hitboxPersonagemTamanho,
        forcaBolaEnabled = forcaBolaEnabled,
        forcaBolaVelocidade = forcaBolaVelocidade,
        curvasEnabled = curvasEnabled,
        curvasIntensidade = curvasIntensidade,
        dribleEnabled = dribleEnabled,
        visaoBolaEnabled = visaoBolaEnabled,
        advinhaChuteEnabled = advinhaChuteEnabled,
        aimbotDelayValue = aimbotDelayValue,
    }
    local save = player:FindFirstChild(saveName)
    if not save then
        save = Instance.new("StringValue")
        save.Name = saveName
        save.Parent = player
    end
    save.Value = game:GetService("HttpService"):JSONEncode(data)
end

local function loadState()
    local save = player:FindFirstChild(saveName)
    if save then
        local data = game:GetService("HttpService"):JSONDecode(save.Value)
        velocidadeBola = data.velocidadeBola or 65
        aimbotPersonagem = data.aimbotPersonagem or false
        aimbotCamera = data.aimbotCamera or false
        reachAtivo = data.reachAtivo or false
        reachDistancia = data.reachDistancia or 20
        mostrarESP = data.mostrarESP or false
        hitboxPersonagemAtivo = data.hitboxPersonagemAtivo or false
        hitboxPersonagemTamanho = data.hitboxPersonagemTamanho or 5
        forcaBolaEnabled = data.forcaBolaEnabled or false
        forcaBolaVelocidade = data.forcaBolaVelocidade or 100
        curvasEnabled = data.curvasEnabled or false
        curvasIntensidade = data.curvasIntensidade or 5
        dribleEnabled = data.dribleEnabled or false
        visaoBolaEnabled = data.visaoBolaEnabled or false
        advinhaChuteEnabled = data.advinhaChuteEnabled or false
        aimbotDelayValue = data.aimbotDelayValue or 0
    end
end

-- ===== BOLA =====
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or bola
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
atualizarReferenciaBola()

task.spawn(function()
    while true do
        task.wait(1)
        if not bolaValida or not hitbox then
            atualizarReferenciaBola()
        end
    end
end)

local function getBall()
    if bola and bolaValida then
        return bola
    end
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

local function euTenhoBola()
    local meuModel = Workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

local function getMyTeam()
    local values = player:FindFirstChild("Values")
    if values then
        local teamVal = values:FindFirstChild("Team")
        if teamVal then
            return tostring(teamVal.Value)
        end
    end
    return nil
end

