-- ===== HITBOX MAGNET =====
local hitboxMagnetAtivo = Config.hitboxMagnet
local hitboxTamanho = Config.hitboxTamanho
local hitboxOriginalSizeAzure = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparencyAzure = 0
local hitboxTracked = nil
local magnetSphere = nil

local function aplicarHitboxMagnet()
    local ball = getHitboxAzure()
    if not ball then
        if magnetSphere then magnetSphere:Destroy(); magnetSphere = nil end
        return
    end
    hitboxTracked = ball
    local tenho = euTenhoBolaAzure()
    if not hitboxMagnetAtivo or tenho then
        if ball.Size ~= hitboxOriginalSizeAzure or ball.Transparency ~= hitboxOriginalTransparencyAzure then
            ball.Size = hitboxOriginalSizeAzure
            ball.Transparency = hitboxOriginalTransparencyAzure
        end
        if magnetSphere then magnetSphere:Destroy(); magnetSphere = nil end
        return
    end
    local novoSize = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
    if ball.Size ~= novoSize then ball.Size = novoSize end
    ball.Transparency = 1
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - ball.Position).Magnitude
    if dist <= (hitboxTamanho / 2) + 2 then
        if firetouchinterest then
            for _ = 1, 4 do
                firetouchinterest(hrp, ball, 0)
                task.wait(0.003)
                firetouchinterest(hrp, ball, 1)
            end
        end
    end
end

local function updateMagnetESP()
    if not hitboxMagnetAtivo then
        if magnetSphere then magnetSphere:Destroy(); magnetSphere = nil end
        return
    end
    local ball = getHitboxAzure()
    if not ball then
        if magnetSphere then magnetSphere:Destroy(); magnetSphere = nil end
        return
    end
    if not magnetSphere then
        magnetSphere = Instance.new("SelectionSphere")
        magnetSphere.Name = "MagnetESP"
        magnetSphere.Adornee = ball
        magnetSphere.Parent = ball
        magnetSphere.Color3 = Color3.fromRGB(0, 200, 255)
        magnetSphere.Transparency = 0.6
    end
    if magnetSphere.Adornee ~= ball then magnetSphere.Adornee = ball end
    local s = hitboxTamanho / 2.5
    magnetSphere.Scale = Vector3.new(s, s, s)
end

-- ===== RAGE (auto-aim agressivo no inimigo mais próximo) =====
local rageAtivo = Config.rageAtivo
local rageAlcance = Config.rageAlcance

local function aplicarRage()
    if not rageAtivo then
        if rageGyro then rageGyro:Destroy(); rageGyro = nil end
        return
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local alvo, dist = getNearestEnemy()
    if not alvo or dist > rageAlcance then
        if rageGyro then rageGyro:Destroy(); rageGyro = nil end
        return
    end
    local alvoHrp = alvo:FindFirstChild("HumanoidRootPart")
    local alvoHead = alvo:FindFirstChild("Head")
    local mira = alvoHead or alvoHrp
    if not mira then return end
    if not rageGyro then
        rageGyro = Instance.new("BodyGyro")
        rageGyro.Parent = hrp
        rageGyro.D = 1500
        rageGyro.P = 20000
        rageGyro.MaxTorque = Vector3.new(10000, 10000, 10000)
    end
    local direcao = (mira.Position - hrp.Position)
    if direcao.Magnitude > 0.1 then
        rageGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + direcao.Unit)
    end
    rageTarget = alvo
end

-- ===== AUTO DRIBLE AUTOCONTER =====
local autoCounterAtivo = Config.autoCounter
local counterRadius = Config.counterRadius
local counterCooldown = 0
local counterAnimIds = {"dribble", "18668814876", "skill"}

local function dispararTackle()
    if not ByteNet then return end
    local bytes = {24, 1}
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i - 1, bytes[i]) end
    pcall(function()
        ByteNet:FireServer(b, { {"tackle"} })
    end)
end

local function dispararDribleEvent()
    if not ByteNet then return end
    local bytes = {24, 1}
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i - 1, bytes[i]) end
    pcall(function()
        ByteNet:FireServer(b, { {"dribble", false} })
    end)
end

local function isDribleAnim(character)
    if driblePlayingAnims[character] then return true end
    local h = character:FindFirstChild("Humanoid")
    if not h then return false end
    local anim = h:FindFirstChild("Animator") or h
    for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
        if t.Animation then
            local id = tostring(t.Animation.AnimationId):lower()
            for _, pattern in ipairs(counterAnimIds) do
                if string.find(id, pattern) then
                    driblePlayingAnims[character] = true
                    return true
                end
            end
        end
    end
    return false
end

local function aplicarAutoCounter()
    if not autoCounterAtivo then return end
    if tick() - counterCooldown < 0.5 then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local characters = Workspace:FindFirstChild("characters")
    if not characters then return end
    for _, charModel in ipairs(characters:GetChildren()) do
        if charModel:IsA("Model") and charModel ~= char then
            local eHrp = charModel:FindFirstChild("HumanoidRootPart")
            if eHrp then
                local d = (eHrp.Position - hrp.Position).Magnitude
                if d <= counterRadius then
                    -- Direção que o inimigo está olhando
                    local dirInimigo = eHrp.CFrame.LookVector
                    local dirParaMim = (hrp.Position - eHrp.Position).Unit
                    local olhandoPraMim = dirInimigo:Dot(dirParaMim) >= 0.3
                    if olhandoPraMim and isDribleAnim(charModel) then
                        counterCooldown = tick()
                        dispararTackle()
                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(0, 220, 0, 30)
                        label.Position = UDim2.new(0.5, -110, 0.72, 0)
                        label.BackgroundTransparency = 1
                        label.TextColor3 = Color3.fromRGB(0, 255, 100)
                        label.TextStrokeTransparency = 0
                        label.Text = "⚡ COUNTER AUTOMÁTICO!"
                        label.Font = Enum.Font.GothamBold
                        label.TextSize = 16
                        label.Parent = player.PlayerGui
                        game:GetService("Debris"):AddItem(label, 1)
                        break
                    end
                end
            end
        end
    end
end

local function trackDribleAnims(character)
    local h = character:FindFirstChild("Humanoid")
    if not h then return end
    local anim = h:FindFirstChild("Animator") or h
    anim.AnimationPlayed:Connect(function(track)
        if not track.Animation then return end
        local id = tostring(track.Animation.AnimationId):lower()
        for _, pattern in ipairs(counterAnimIds) do
            if string.find(id, pattern) then
                driblePlayingAnims[character] = true
                track.Stopped:Connect(function() driblePlayingAnims[character] = nil end)
                track.Ended:Connect(function() driblePlayingAnims[character] = nil end)
                break
            end
        end
    end)
end

