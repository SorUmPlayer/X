-- =============================================
-- 1. CONFIGURAÇÃO INICIAL COM TRATAMENTO DE ERROS
-- =============================================
local players = game:GetService("Players")
local coreGui = game:GetService("CoreGui")
local lighting = game:GetService("Lighting")
local tweenService = game:GetService("TweenService")
local localPlayer = players.LocalPlayer

-- Função para log no console
local function debugLog(msg)
    warn("[Project Sor] " .. msg)
end

debugLog("Iniciando script...")

-- =============================================
-- 2. ANIMAÇÃO DE ABERTURA (com pcall para não travar)
-- =============================================
local blur = Instance.new("BlurEffect")
blur.Name = "UIBlurEffect"
blur.Size = 0
blur.Enabled = true
blur.Parent = lighting

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "OverlayGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local successGui = pcall(function()
    screenGui.Parent = coreGui
end)
if not successGui then
    debugLog("Não foi possível por no CoreGui, usando PlayerGui")
    screenGui.Parent = localPlayer:WaitForChild("PlayerGui")
end

local img = Instance.new("ImageLabel")
img.Name = "DisplayImage"
img.BackgroundTransparency = 1
img.Image = "rbxassetid://135710581431595" -- verifique se esse ID existe
img.AnchorPoint = Vector2.new(0.5, 0.5)
img.Position = UDim2.new(0.5, 0, 0.45, 0)
img.Size = UDim2.new(0, 400, 0, 400)
img.ImageTransparency = 1
img.ZIndex = 10
img.Parent = screenGui

-- Aguarda um pouco para a GUI ser criada
task.wait(2)

-- Animação
local fadeInfo = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ok, err = pcall(function()
    tweenService:Create(img, fadeInfo, {ImageTransparency = 0}):Play()
    tweenService:Create(blur, fadeInfo, {Size = 20}):Play()
end)
if not ok then
    debugLog("Erro na animação de fade: " .. tostring(err))
end

task.wait(1.5)
local pulseInfo = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local pulseTween = tweenService:Create(img, pulseInfo, {Size = UDim2.new(0, 440, 0, 440)})
pulseTween:Play()

task.wait(8)

-- Fecha a animação
pulseTween:Cancel()
tweenService:Create(img, fadeInfo, {ImageTransparency = 1}):Play()
tweenService:Create(blur, fadeInfo, {Size = 0}):Play()

task.wait(1.5)
screenGui:Destroy()
blur:Destroy()

debugLog("Animação de abertura concluída.")

-- =============================================
