    elseif hrp then dir = hrp.CFrame.LookVector end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.001 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
    local pf = pi + dir * 100
    criarLinhaVisao()
    local m = (pi + pf) / 2
    local d = (pi - pf).Magnitude
    if d < 0.1 then d = 0.1 end
    linhaVisao.Size = Vector3.new(1.0, 1.0, d)
    linhaVisao.CFrame = CFrame.lookAt(m, pf)
