-- ========== HITBOX ==========
local function aplicarReach()
    if not hitbox then return end
    local now = tick()
    if now - bolaSpawnTime < 0.5 then
        if hitbox.Size ~= Vector3.new(1,1,1) or hitbox.Transparency ~= hitboxOrigTransp then
            hitbox.Size = Vector3.new(1,1,1); hitbox.Transparency = hitboxOrigTransp
        end
        return
    end
    if alguemTemBola() then
        hitboxBloqAte = now + 0.5
        if hitbox.Size ~= Vector3.new(1,1,1) or hitbox.Transparency ~= hitboxOrigTransp then
            hitbox.Size = Vector3.new(1,1,1); hitbox.Transparency = hitboxOrigTransp
        end
        return
    end
    if now < hitboxBloqAte then
        if hitbox.Size ~= Vector3.new(1,1,1) then
            hitbox.Size = Vector3.new(1,1,1); hitbox.Transparency = hitboxOrigTransp
        end
        return
    end
    if not reachBolaAtivo then
        if hitbox.Size ~= hitboxOrigSize or hitbox.Transparency ~= hitboxOrigTransp then
            hitbox.Size = hitboxOrigSize; hitbox.Transparency = hitboxOrigTransp
        end
        return
    end
    local t = Vector3.new(reachBolaDist, reachBolaDist, reachBolaDist)
    if hitbox.Size ~= t or hitbox.Transparency ~= 1 then
        hitbox.Size = t; hitbox.Transparency = 1
    end
end

-- ========== FORÇA ==========
local function aplicarForca()
    if not forcaBolaEnabled then return end
    local ball = getBallPart()
    if not ball then return end
    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1,0,0) else dir = dir.Unit end
        ball.AssemblyLinearVelocity = dir * forcaBolaVel + Vector3.new(0,15,0)
    end
    tinhaBola = tenho
end

-- ========== CURVAS ==========
local function aplicarCurvas()
    if not curvasEnabled then return end
    local ball = getBallPart()
    if not ball then return end
    if euTenhoBola() then return end
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 40 then return end
    if ball.Position.Y < 0.5 then return end
    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1
    if curvasModo == 2 then lado = -1
    elseif curvasModo == 3 then
        local now = tick()
        if now - curvasTimer > curvasInt then
            curvasTimer = now
            curvasDir = (curvasDir == 1) and -1 or 1
            curvasInt = 0.5 + math.random() * 0.5
        end
        lado = curvasDir
    end
    ball.AssemblyLinearVelocity = vel + perp * lado * fator
end

-- ========== TRAZER ==========
local function aplicarTrazer()
    if not trazerBolaAtivo then return end
    if euTenhoBola() then return end
    local ball = getBallPart()
    if not ball then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dir = hrp.Position - ball.Position
    local dist = dir.Magnitude
    if dist < 2 then return end
    dir = dir.Unit
    ball.AssemblyLinearVelocity = dir * math.clamp(dist * 15, 80, 250) + Vector3.new(0,5,0)
end

-- ========== STOP BALL ==========
local function aplicarStop()
    if not stopBallAtivo then return end
    if euTenhoBola() then return end
    local ball = getBallPart()
    if not ball then return end
    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero
end

local function desativarStop()
    local ball = getBallPart()
    if ball then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.01 then dir = Vector3.new(1,0,0) else dir = dir.Unit end
        ball.AssemblyLinearVelocity = dir * 80 + Vector3.new(0,20,0)
    end
end

-- ========== AUTO GOL ==========
local function execAutoGol()
    if autoGolRunning then return end
    autoGolRunning = true
    task.spawn(function()
        local char = player.Character
        if not char then autoGolRunning = false; return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then autoGolRunning = false; return end
        local posOrig = hrp.Position
        if not euTenhoBola() then
            local ball = getBallPart()
            if ball then
                hrp.CFrame = CFrame.new(ball.Position + Vector3.new(0,3,0))
                task.wait(0.3)
                if firetouchinterest then
                    for _ = 1, 12 do
                        firetouchinterest(hrp, ball, 0); task.wait(0.02); firetouchinterest(hrp, ball, 1)
                    end
                end
                task.wait(0.4)
            end
        end
        if not euTenhoBola() then
            autoGolRunning = false; hrp.CFrame = CFrame.new(posOrig); return
        end
        local posGol = autoGolTeam == "Home" and Vector3.new(-234,11,-47) or Vector3.new(311,11,-50)
        hrp.CFrame = CFrame.new(posGol)
        task.wait(0.2)
        for _ = 1, 3 do
            local pk = ReplicatedStorage:FindFirstChild("Packages")
            if pk then
                local kn = pk:FindFirstChild("Knit")
                if kn then
                    local sv = kn:FindFirstChild("Services")
                    if sv then
                        local bs = sv:FindFirstChild("BallService")
                        if bs then
                            local re = bs:FindFirstChild("RE")
                            if re then
                                local sh = re:FindFirstChild("Shoot")
                                if sh then pcall(function() sh:FireServer({[1]=110,[4]=posGol}) end) end
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end
        task.wait(0.3)
        hrp.CFrame = CFrame.new(posOrig)
        autoGolRunning = false
    end)
end

local function checkAutoGol()
    if not autoGolToggle or autoGolRunning then return end
    if tick() - autoGolLast < 3 then return end
    if not euTenhoBola() then return end
    autoGolLast = tick()
    execAutoGol()
end

-- ========== DRIBLE ==========
local function setupDrible()
    if not dribleEvent then
        pcall(function()
            local pk = ReplicatedStorage:FindFirstChild("Packages")
            if pk then
                local kn = pk:FindFirstChild("Knit")
                if kn then
                    local sv = kn:FindFirstChild("Services")
                    if sv then
                        local bs = sv:FindFirstChild("BallService")
                        if bs then
                            local re = bs:FindFirstChild("RE")
                            if re then dribleEvent = re:FindFirstChild("Dribble") end
                        end
                    end
                end
            end
        end)
    end
    if not dribleSphere then
        dribleSphere = Instance.new("Part")
        dribleSphere.Name = "DetectionSphere"
        dribleSphere.Shape = Enum.PartType.Ball
        dribleSphere.Size = Vector3.new(dribleRadius*2, dribleRadius*2, dribleRadius*2)
        dribleSphere.Material = Enum.Material.ForceField
        dribleSphere.Color = Color3.fromRGB(255,0,128)
        dribleSphere.Transparency = 0.6
        dribleSphere.CanCollide = false
        dribleSphere.Anchored = false
        dribleSphere.CastShadow = false
        dribleSphere.Parent = workspace
    end
end

local function trackDribleAnim(c)
    local h = c:FindFirstChild("Humanoid")
    if not h then return end
    local an = h:FindFirstChild("Animator") or h
    local function chk(t)
        if not t or not t.Animation then return end
        if string.find(tostring(t.Animation.AnimationId), dribleAnimId) then
            dribleAnims[c] = true
            local cs, ce
            cs = t.Stopped:Connect(function() dribleAnims[c]=nil; cs:Disconnect(); if ce then ce:Disconnect() end end)
            ce = t.Ended:Connect(function() dribleAnims[c]=nil; cs:Disconnect(); ce:Disconnect() end)
        end
    end
    for _, t in ipairs(an:GetPlayingAnimationTracks()) do chk(t) end
    an.AnimationPlayed:Connect(chk)
end

local function setupDriblePlayer(p)
    if p == player then return end
    if p.Character then task.spawn(trackDribleAnim, p.Character) end
    p.CharacterAdded:Connect(function(c) dribleAnims[c]=nil; task.spawn(trackDribleAnim, c) end)
end

local function isDribleAnim(c)
    if dribleAnims[c] then return true end
    local h = c:FindFirstChild("Humanoid")
    if not h then return false end
    local an = h:FindFirstChild("Animator") or h
    for _, t in ipairs(an:GetPlayingAnimationTracks()) do
        if t.Animation and string.find(tostring(t.Animation.AnimationId), dribleAnimId) then return true end
    end
    return false
end

local tolDots = {0.5, 0.3, 0.1, -0.3, -0.7, -2}
local function isLooking(th, lh)
    if dribleTol >= 5 then return true end
    local dot = tolDots[math.clamp(dribleTol+1, 1, 6)] or 0.5
    local d = (lh.Position - th.Position).Unit
    return th.CFrame.LookVector:Dot(d) >= dot
end

local function aplicarDrible()
    if not dribleEnabled then
        if dribleSphere then dribleSphere.Transparency = 1 end
        return
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if dribleSphere then
        dribleSphere.Position = hrp.Position
        dribleSphere.Transparency = 0.6
        dribleSphere.Parent = workspace
    end
    local now = tick()
    if now - dribleLastFired < dribleCooldown then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local th = p.Character:FindFirstChild("HumanoidRootPart")
            if th then
                local d = (th.Position - hrp.Position).Magnitude
                if d <= dribleRadius and isLooking(th, hrp) and isDribleAnim(p.Character) then
                    dribleLastFired = now
                    if dribleEvent then pcall(function() dribleEvent:FireServer("fbc7892b8f694cfd98d7ef93bc018abe", 3) end) end
                    break
                end
            end
        end
    end
end

