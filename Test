local draggingSlider = false
local function updateSlider(x)
    local relX = math.clamp((x - sliderBtn.AbsolutePosition.X) / sliderBtn.AbsoluteSize.X, 0, 1)
    local val = math.floor(relX * 10 + 0.5)
    if val < 1 then val = 1 end
    if val > 10 then val = 10 end
    Config.slider = val
    sliderValue.Text = tostring(val)
    sliderFill.Size = UDim2.new(val / 10, 0, 1, 0)
    SaveConfig()
end

sliderBtn.MouseButton1Down:Connect(function()
    draggingSlider = true
    local mouse = player:GetMouse()
    updateSlider(mouse.X)
end)
sliderBtn.MouseButton1Up:Connect(function() draggingSlider = false end)
sliderBtn.MouseMoved:Connect(function()
    if draggingSlider then
        local mouse = player:GetMouse()
        updateSlider(mouse.X)
    end
end)

