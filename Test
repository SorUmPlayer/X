-- 2. Sistema de Arrastar (Drag Suave)
local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- 3. Lógica do Coletador
local autoCollectEnabled = false

-- Função para verificar se o ProximityPrompt é do SEU personagem/tycoon
local function belongsToMyTycoon(prompt)
    local currentObj = prompt
    local isMine = false
    
    -- Sobe na hierarquia procurando pistas de que o Tycoon é seu
    while currentObj and currentObj ~= workspace do
        -- Verifica se a pasta/modelo tem o seu nome
        if string.find(string.lower(currentObj.Name), string.lower(LocalPlayer.Name)) then
            isMine = true
            break
        end
        
        -- Verifica se existe um valor de "Dono" com o seu nome
        local ownerValue = currentObj:FindFirstChild("Owner") or currentObj:FindFirstChild("OwnerName")
        if ownerValue and (ownerValue:IsA("StringValue") or ownerValue:IsA("ObjectValue")) then
            if tostring(ownerValue.Value) == LocalPlayer.Name then
                isMine = true
                break
            end
        end
        
        currentObj = currentObj.Parent
    end
    
    -- Se o jogo não usar o nome no Tycoon, retornamos true como fallback para tentar coletar.
    -- (Pode ajustar isso se o jogo for muito rigoroso)
    return isMine or true 
end

local function startAutoCollect()
    while autoCollectEnabled do
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local hrp = character.HumanoidRootPart
            
            for _, prompt in ipairs(workspace:GetDescendants()) do
                if not autoCollectEnabled then break end
                
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    if belongsToMyTycoon(prompt) then
                        local part = prompt.Parent
                        if part and part:IsA("BasePart") then
                            
                            -- Dá TP do personagem até o botão (para o servidor validar)
                            hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.2) -- Tempo rápido pro servidor registrar sua posição
                            
                            -- Executa o prompt
                            if fireproximityprompt then
                                fireproximityprompt(prompt, 1)
                            else
                                -- Fallback caso o executor não suporte fireproximityprompt
                                prompt:InputHoldBegin()
                                task.wait(prompt.HoldDuration + 0.1)
                                prompt:InputHoldEnd()
                            end
                            
                            task.wait(0.5) -- Pequeno delay para não bugar o jogo (anti-spam)
                        end
                    end
                end
            end
        end
        task.wait(1) -- Espera antes de fazer a varredura do mapa novamente
    end
end

-- 4. Botão de Ativação
ToggleButton.MouseButton1Click:Connect(function()
