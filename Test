-- LOOP DOS BOSSES
-- =============================================
local bossConnection = nil
local function getActiveBossTarget()
    local enemys = workspace:FindFirstChild("Enemys")
    if not enemys then return nil end
    local bosses = {
        { key = "BossShip", folder = "Ship [ Ferris Wheel Form ]", char = "Character" },
        { key = "BossKraken", folder = "Kraken", char = "Character" },
        { key = "BossTransDimensional", folder = "Trans Dimensional Monster", char = "Character" },
    }
    for _, b in ipairs(bosses) do
        if Config[b.key] then
            local f = enemys:FindFirstChild(b.folder)
            if f then
                local c = f:FindFirstChild(b.char)
                if c and c:IsA("Model") then
                    local part = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
                    if not part then
                        for _, child in ipairs(c:GetChildren()) do
                            if child:IsA("BasePart") then part = child break end
                        end
                    end
                    if part and part:IsA("BasePart") then return part end
                end
            end
        end
    end
    return nil
end

local function startBossLoop()
    if bossConnection then return end
    bossConnection = RunService.Heartbeat:Connect(function()
        if not (Config.BossShip or Config.BossKraken or Config.BossTransDimensional) then
            if bossConnection then bossConnection:Disconnect() bossConnection = nil end
            return
        end
        local target = getActiveBossTarget()
        if not target then return end
        local _, myRoot = getLocalCharacter()
        if not myRoot then return end
        myRoot.CFrame = target.CFrame * CFrame.new(0, Config.BossDistance, 0)
        local mult = math.floor(tonumber(Config.BossShotMultiplier) or 1)
        for i = 1, mult do
            if not (Config.BossShip or Config.BossKraken or Config.BossTransDimensional) then break end
            Laser()
            GunArm()
            ArmFire(target)
            Armature()
            task.wait()
        end
    end)
end
if Config.BossShip or Config.BossKraken or Config.BossTransDimensional then task.spawn(startBossLoop) end

