-- =====================================================
--  AIMBOT PERSONAGEM (COM DELAY)
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not shouldAimbotWork() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA (COM DELAY)
-- =====================================================
local function atualizarAimbotCamera()
    if isControlActive then return end
    if not aimbotCamera then return end

    if not shouldAimbotWork() then
        return
    end

    if not bolaValida or not hitbox then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

-- =====================================================
--  CONTROLE DA HITBOX DA BOLA (REACH)
-- =====================================================
local function restaurarHitboxBola()
    if hitbox then
        hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
        hitbox.Transparency = 0
    end
end

local function aplicarTamanhoHitbox()
    if not hitbox then return end

    local tenho = euTenhoBola()
    local tamanhoDesejado
    local transparenciaDesejada

    if tenho or not reachAtivo then
        tamanhoDesejado = Vector3.new(1.4, 1.4, 1.4)
        transparenciaDesejada = 0
    else
        tamanhoDesejado = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        transparenciaDesejada = 1
    end

    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= transparenciaDesejada then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = transparenciaDesejada
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        aplicarTamanhoHitbox()
    end
end)

