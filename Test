            end
            if path ~= "" then
                copyToClipboard(path)
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Copiado",
                    Text = "Caminho: " .. path,
                    Duration = 3
                })
            else
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Erro",
                    Text = "Caminho não encontrado!",
                    Duration = 2
                })
