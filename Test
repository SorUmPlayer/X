    addTeleportSection(lang.SecEstacaoAcademia, { [lang.BtnAcademia] = CFrame.new(72994,1933,-3128) })
    addTeleportSection(lang.SecMarte, { [lang.BtnArenaMarte] = CFrame.new(64779,30,65676) })
    addTeleportSection(lang.SecAlienX, {
        [lang.BtnCubo] = CFrame.new(78944,2547,-3139),
        [lang.BtnBBAlienX] = CFrame.new(1143,1930,300137),
        [lang.BtnAlienXDNA] = CFrame.new(188,1496,300251)
    })
    addTeleportSection(lang.SecGalvanPrime, { [lang.BtnPredioGalvan] = CFrame.new(80324,-56,-79417) })

    -- CONFIG
    TabConfig:Section({ Title = lang.SecConfig })
    TabConfig:Dropdown({
        Title = lang.DropIdioma, Desc = lang.DescIdioma,
        Values = {"Português", "Espanhol", "English"}, Value = Config.Language,
        Callback = function(v)
            if Config.Language ~= v then
                Config.Language = v
                CriarMenu()
            end
        end
    })
    TabConfig:Toggle({
        Title = lang.ToggleIntro, Desc = lang.DescIntro, Value = Config.RemoverIntro,
        Callback = function(v) Config.RemoverIntro = v end
    })
    TabConfig:Toggle({
        Title = lang.ToggleAFK, Desc = lang.DescAFK, Value = Config.AntiAFK,
        Callback = function(v)
            Config.AntiAFK = v
            if v then task.spawn(startAntiAFK) else if antiAFKThread then task.cancel(antiAFKThread) antiAFKThread = nil end end
        end
    })
    TabConfig:Button({
        Title = lang.BtnManualSave, Desc = lang.DescManualSave,
        Callback = ManualSave
    })
    TabConfig:Button({
        Title = lang.BtnReset, Desc = lang.DescReset,
        Callback = function()
            Config.RaidEnabled = false
            Config.Language = "Português"
            Config.RemoverIntro = false
            Config.AntiAFK = false
            Config.BossShip = false
            Config.BossKraken = false
            Config.BossTransDimensional = false
            if Window.Notify then Window:Notify({Title = lang.NotifTitle, Desc = lang.NotifDesc, Duration = 3}) end
            CriarMenu()
        end
    })
