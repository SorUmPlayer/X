        and ReplicatedStorage.RemoteFunctions.Character:FindFirstChild("Morph")
        and ReplicatedStorage.RemoteFunctions.Character.Morph:FindFirstChild("AlienMorph")
end)

local function transformarAlien(nomeAlien)
    if not nomeAlien or nomeAlien == "" then return end
    if not alienMorphRemote then
        print("[Omnitrix] Remote não encontrado!")
        return
    end
    pcall(function()
        alienMorphRemote:InvokeServer(tostring(nomeAlien), 0.3)
        print("[Omnitrix] Transformado em: " .. tostring(nomeAlien))
    end)
end

