local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

-- Carregamento WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Variáveis de controle
local selectedEggName = nil
local tpSpeed = 150 -- Velocidade padrão (Studs por segundo)
local isTeleporting = false
local returnPos = CFrame.new(509, 71, -372)

-- Função para listar os ovos da pasta
local function getEggList()
    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    local list = {}
    if area then
        for _, child in pairs(area:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    if #list == 0 then
        table.insert(list, "Nenhum ovo encontrado")
    end
    return list
end

-- Função de TweenTeleport com Noclip
local function tweenTo(targetCFrame)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / math.max(tpSpeed, 1)

    -- Ativa Noclip durante o percurso para não trancar em paredes/chão
    local noclipConn = RunService.Stepped:Connect(function()
        if player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()

    noclipConn:Disconnect()
end

-- Função para ativar ProximityPrompt no local
local function triggerPrompt(targetObj)
    task.wait(0.2)
    local prompt = targetObj:FindFirstChildOfClass("ProximityPrompt", true)
    
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            -- Fallback padrão caso o executor não suporta fireproximityprompt
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end
    end
end

-- Função que executa a sequência completa
local function startCycle()
    if isTeleporting then 
        WindUI:Notify({ Title = "Aviso", Content = "Teleporte já em andamento!", Duration = 2 })
        return 
    end

    if not selectedEggName or selectedEggName == "Nenhum ovo encontrado" then
        WindUI:Notify({ Title = "Erro", Content = "Selecione um ovo válido no Dropdown!", Duration = 3 })
        return
    end

    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    local eggTarget = area and area:FindFirstChild(selectedEggName)

    if not eggTarget then
        WindUI:Notify({ Title = "Erro", Content = "Ovo não encontrado no Workspace!", Duration = 3 })
        return
    end

    isTeleporting = true

    -- Descobre a CFrame do Alvo
    local targetCFrame
    if eggTarget:IsA("Model") then
        targetCFrame = eggTarget:GetPivot()
    elseif eggTarget:IsA("BasePart") then
        targetCFrame = eggTarget.CFrame
    end

    if targetCFrame then
        -- 1. Tween até o Ovo
        WindUI:Notify({ Title = "Teleporte", Content = "Indo até o Ovo...", Duration = 2 })
        tweenTo(targetCFrame)

        -- 2. Ativa o ProximityPrompt
        WindUI:Notify({ Title = "Coletor", Content = "Coletando ovo...", Duration = 2 })
        triggerPrompt(eggTarget)
        task.wait(0.5)

        -- 3. Tween de Volta para (509, 71, -372)
        WindUI:Notify({ Title = "Retorno", Content = "Voltando para a base...", Duration = 2 })
        tweenTo(returnPos)

        WindUI:Notify({ Title = "Sucesso", Content = "Ciclo concluído!", Duration = 3 })
    end

    isTeleporting = false
end

-- Interface WindUI
local Window = WindUI:CreateWindow({
    Title = "Egg Auto-Collector",
    Icon = "egg",
    Folder = "EggCollector_Config",
    Size = UDim2.fromOffset(360, 280)
})

local Tab = Window:Tab({ Title = "Principal", Icon = "navigation" })

-- Dropdown com lista de ovos
local EggDropdown = Tab:Dropdown({
    Title = "Selecione o Ovo",
    Values = getEggList(),
    Value = "",
    Callback = function(val)
        selectedEggName = val
    end
})

-- Botão para atualizar lista do Dropdown
Tab:Button({
    Title = "🔄 Atualizar Lista de Ovos",
    Callback = function()
        local newList = getEggList()
        EggDropdown:SetValues(newList)
        WindUI:Notify({ Title = "Atualizado", Content = "Lista de ovos recarregada!", Duration = 2 })
    end
})

-- Slider de Velocidade (0 - 500)
Tab:Slider({
    Title = "Velocidade do Tween",
    Min = 10,
    Max = 500,
    Default = 150,
    Callback = function(val)
        tpSpeed = val
    end
})

-- Botão para Iniciar o Ciclo
Tab:Button({
    Title = "🚀 Iniciar Ciclo (TP -> Coletar -> Retornar)",
    Callback = startCycle
})
