local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local Window = WindUI:CreateWindow({
    Title = "Fake VR System",
    Icon = "gamepad-2",
    Author = "Script",
    Folder = "FakeVRConfig"
})

local Tab = Window:Tab({ Title = "Controles VR", Icon = "user" })

-- Configurações Globais
local VR_Enabled = false
local Sensitivity = 0.03
local LeftHandVector = Vector2.new(0, 0)
local RightHandVector = Vector2.new(0, 0)

-- UI dos Analógicos
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FakeVR_Joysticks"
ScreenGui.ResetOnSpawn = false
ScreenGui.Enabled = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local function CreateJoystick(position, name)
    local Frame = Instance.new("Frame")
    Frame.Name = name
    Frame.Size = UDim2.new(0, 130, 0, 130)
    Frame.Position = position
    Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Frame.BackgroundTransparency = 0.5
    Frame.BorderSizePixel = 0
    Frame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(1, 0)
    UICorner.Parent = Frame

    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.Size = UDim2.new(0, 50, 0, 50)
    Knob.Position = UDim2.new(0.5, -25, 0.5, -25)
    Knob.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    Knob.BackgroundTransparency = 0.2
    Knob.BorderSizePixel = 0
    Knob.Parent = Frame

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local Dragging = false
    local TouchInput = nil
    local VectorOutput = Vector2.new(0, 0)

    local function UpdateInput(input)
        local Center = Frame.AbsolutePosition + (Frame.AbsoluteSize / 2)
        local InputPos = Vector2.new(input.Position.X, input.Position.Y)
        local Direction = InputPos - Center
        local Distance = math.min(Direction.Magnitude, Frame.AbsoluteSize.X / 2)

        if Direction.Magnitude > 0 then
            Direction = Direction.Unit * Distance
        end

        Knob.Position = UDim2.new(0.5, Direction.X - 25, 0.5, Direction.Y - 25)
        VectorOutput = Direction / (Frame.AbsoluteSize.X / 2)
    end

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            TouchInput = input
            UpdateInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if Dragging and (input == TouchInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            UpdateInput(input)
        end
    end)

    local function EndDrag(input)
        if input == TouchInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
            Knob.Position = UDim2.new(0.5, -25, 0.5, -25)
            VectorOutput = Vector2.new(0, 0)
        end
    end

    UserInputService.InputEnded:Connect(EndDrag)

    return function() return VectorOutput end
end

local GetLeftInput = CreateJoystick(UDim2.new(0.05, 0, 0.65, 0), "LeftJoystick")
local GetRightInput = CreateJoystick(UDim2.new(0.75, 0, 0.65, 0), "RightJoystick")

-- Toggle do Sistema no WindUI
Tab:Toggle({
    Title = "Ativar Fake VR",
    Desc = "Habilita analógicos, movimentação VR e replicação de braços.",
    Value = false,
    Callback = function(Value)
        VR_Enabled = Value
        ScreenGui.Enabled = Value
    end
})

-- Loop de Animação e Replicação Física
local LeftRotX, LeftRotY = 0, 0
local RightRotX, RightRotY = 0, 0
local BobStep = 0

RunService.RenderStepped:Connect(function(deltaTime)
    if not VR_Enabled then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local LeftInput = GetLeftInput()
    local RightInput = GetRightInput()

    -- Atualiza Ângulos dos Analógicos
    LeftRotX = math.clamp(LeftRotX - (LeftInput.Y * Sensitivity), -1.5, 1.5)
    LeftRotY = math.clamp(LeftRotY - (LeftInput.X * Sensitivity), -1.5, 1.5)

    RightRotX = math.clamp(RightRotX - (RightInput.Y * Sensitivity), -1.5, 1.5)
    RightRotY = math.clamp(RightRotY - (RightInput.X * Sensitivity), -1.5, 1.5)

    -- R15 e R6 Compatibilidade de Motor6D (Replica no Servidor)
    local LeftShoulder = Character:FindFirstChild("Left Shoulder", true) or Character:FindFirstChild("LeftShoulder", true)
    local RightShoulder = Character:FindFirstChild("Right Shoulder", true) or Character:FindFirstChild("RightShoulder", true)

    if LeftShoulder then
        LeftShoulder.C0 = CFrame.new(-1, 0.5, 0) 
            * CFrame.Angles(LeftRotX, LeftRotY, 0)
    end

    if RightShoulder then
        RightShoulder.C0 = CFrame.new(1, 0.5, 0) 
            * CFrame.Angles(RightRotX, RightRotY, 0)
    end

    -- Efeito de Câmera e Caminhada VR (Balanço Procedural)
    if Humanoid and Humanoid.MoveDirection.Magnitude > 0 then
        BobStep = BobStep + (deltaTime * Humanoid.WalkSpeed * 1.5)
        local BobOffset = Vector3.new(
            math.cos(BobStep * 0.5) * 0.15,
            math.abs(math.sin(BobStep)) * 0.2,
            0
        )
        Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(BobOffset, 0.2)
    else
        Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(Vector3.new(0, 0, 0), 0.1)
    end
end)
