-- =============================================
-- NO COOLDOWN
-- =============================================
local function getAbilityController()
    local c = ReplicatedStorage:FindFirstChild("Controllers")
    if c then return c:FindFirstChild("AbilityController") end
    return nil
end
local function zerarCooldownsDoModulo(mod)
    if type(mod) ~= "table" then return end
    if mod.legacy then
        for _, k in ipairs({"AbilityOne","AbilityTwo","AbilityThree","AbilityFour"}) do
            if mod.legacy[k] ~= nil then mod.legacy[k] = 0 end
        end
        for k, v in pairs(mod.legacy) do
            if type(v) == "number" and v > 0 then mod.legacy[k] = 0 end
        end
    end
    for _, k in ipairs({"Cooldowns","cooldowns","CD","cd","Cooldown"}) do
        if type(mod[k]) == "table" then
            for kk, _ in pairs(mod[k]) do mod[k][kk] = 0 end
        end
    end
    for k, v in pairs(mod) do
        if type(v) == "number" and type(k) == "string" then
            local lk = k:lower()
            if lk:find("cooldown") or lk:find("recharge") or lk:find("reload") then mod[k] = 0 end
        end
    end
end
local function aplicarHooksNoModulo(mod)
    if type(mod) ~= "table" then return end
    for _, fn in ipairs({"AbilityCooldown","SetCooldown","StartCooldown","Cooldown","ApplyCooldown","StartCooldownTimer","SetCooldownTimer"}) do
        local orig = mod[fn]
        if type(orig) == "function" and not noCooldownHooks[fn] then
            mod[fn] = function(self, ...)
                local a = {...}
                if type(a[1]) == "number" then a[1] = 0 end
                if type(a[2]) == "number" then a[2] = 0 end
                return orig(self, table.unpack(a))
            end
            noCooldownHooks[fn] = { mod = mod, original = orig }
        end
    end
end
local function aplicarNoCooldown()
    local ac = getAbilityController()
    if not ac then return end
    local ok, mod = pcall(require, ac)
    if not ok or type(mod) ~= "table" then return end
    aplicarHooksNoModulo(mod)
    zerarCooldownsDoModulo(mod)
end
local function iniciarLoopNoCooldown()
    if noCooldownLoopActive then return end
    noCooldownLoopActive = true
    task.spawn(function()
        while noCooldownAtivo do
            aplicarNoCooldown()
            task.wait(0.25)
        end
        noCooldownLoopActive = false
    end)
end
local function conectarEventoHabilidade()
    if abilityEventConn then return end
    local pk = ReplicatedStorage:FindFirstChild("Packages")
    if not pk then return end
    local k = pk:FindFirstChild("Knit")
    if not k then return end
    local s = k:FindFirstChild("Services")
    if not s then return end
    local as = s:FindFirstChild("AbilityService")
    if not as then return end
    local re = as:FindFirstChild("RE")
    if not re then return end
    local ae = re:FindFirstChild("Ability")
    if not ae then return end
    abilityEventConn = ae.OnClientEvent:Connect(function(...)
        if noCooldownAtivo then
            task.spawn(function() task.wait(0.05); aplicarNoCooldown() end)
        end
    end)
end
local function ativarNoCooldown(estado)
    noCooldownAtivo = estado
    Config.noCooldown = estado; SaveConfig()
    if estado then
        aplicarNoCooldown()
        iniciarLoopNoCooldown()
        conectarEventoHabilidade()
    else
        for fn, info in pairs(noCooldownHooks) do
            if info.mod and info.original then info.mod[fn] = info.original end
        end
        noCooldownHooks = {}
    end
end

