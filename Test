local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local selectedEggName = nil
local tpSpeed = 150
local isTeleporting = false
local returnCFrame = CFrame.new(509, 71, -372)

-- Função para listar os ovos da pasta no Workspace
local function getEggList()
    local list = {}
    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    if area then
        for _, child in ipairs(area:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    if #list == 0 then
        table.insert(list, "Nenhum ovo encontrado")
    end
    return list
end

-- TweenTeleport com Noclip
local function tweenTo(targetCFrame)
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = distance / math.max(tpSpeed, 1)

    local noclipConn = RunService.Stepped:Connect(function()
        if player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    noclipConn:Disconnect()
end

-- Disparo do ProximityPrompt
local function triggerPrompt(targetObj)
    task.wait(0.2)
    if not targetObj then return end
    local prompt = targetObj:FindFirstChildOfClass("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end
    end
end

-- Ciclo Principal (TP -> Coletar -> Retornar)
local function startCycle()
    if isTeleporting then 
        WindUI:Notify({ Title = "Aviso", Content = "Teleporte já em andamento!", Duration = 2 })
        return 
    end

    if not selectedEggName or selectedEggName == "" or selectedEggName == "Nenhum ovo encontrado" then
        WindUI:Notify({ Title = "Erro", Content = "Selecione um ovo no Dropdown!", Duration = 3 })
        return
    end

    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    local eggTarget = area and area:FindFirstChild(selectedEggName)

    if not eggTarget then
        WindUI:Notify({ Title = "Erro", Content = "Ovo não encontrado no Workspace!", Duration = 3 })
        return
    end

    isTeleporting = true

    local targetCFrame
    if eggTarget:IsA("Model") then
        targetCFrame = eggTarget:GetPivot()
    elseif eggTarget:IsA("BasePart") then
        targetCFrame = eggTarget.CFrame
    end

    if targetCFrame then
        WindUI:Notify({ Title = "Teleporte", Content = "Indo até o ovo...", Duration = 2 })
        tweenTo(targetCFrame)

        WindUI:Notify({ Title = "Coletor", Content = "Pegando ProximityPrompt...", Duration = 2 })
        triggerPrompt(eggTarget)
        task.wait(0.5)

        WindUI:Notify({ Title = "Retorno", Content = "Voltando para (509, 71, -372)...", Duration = 2 })
        tweenTo(returnCFrame)

        WindUI:Notify({ Title = "Sucesso", Content = "Ciclo Concluído!", Duration = 3 })
    end

    isTeleporting = false
end

-- Criando Interface WindUI
local Window = WindUI:CreateWindow({
    Title = "Egg Collector",
