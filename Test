-- 1. PROPERTY SPOOFING – Previne detecção de propriedades modificadas[reference:7]
local function spoofProperty(instance, property, originalValue, fakeValue)
    if not instance then return end
    local old = instance[property]
    instance[property] = fakeValue
    bypass.originalFunctions[instance] = bypass.originalFunctions[instance] or {}
    bypass.originalFunctions[instance][property] = old
    return old
end

-- 2. REMOTE EVENT BLOCKING – Bloqueia eventos remotos suspeitos[reference:8]
local function blockRemoteEvent(eventName)
    pcall(function()
        local event = ReplicatedStorage:FindFirstChild(eventName)
        if event and event:IsA("RemoteEvent") then
            local oldFire = event.FireServer
            event.FireServer = function(...)
                if bypass.debug then
                    warn("[Bypass] Bloqueado: " .. eventName)
                end
                return
            end
            bypass.originalFunctions[event] = {FireServer = oldFire}
        end
    end)
end

-- 3. DEBUG FUNCTION HOOKING – Esconde scripts da detecção[reference:9]
local function hookDebugFunctions()
    pcall(function()
        local oldGetInfo = debug.getinfo
        debug.getinfo = function(...)
            local args = {...}
            if type(args[1]) == "function" then
                local info = oldGetInfo(...)
                if info and info.source and string.find(info.source, "Basketball") then
                    info.source = "[C]"
                end
                return info
            end
            return oldGetInfo(...)
        end
        bypass.originalFunctions.debug = {getinfo = oldGetInfo}
    end)
end

-- 4. ANTI-CHEAT CONNECTION DISABLING[reference:10]
local function disableAntiCheatConnections()
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local connections = getconnections and getconnections(obj.OnServerEvent)
                if connections then
                    for _, conn in ipairs(connections) do
                        if conn and conn.Disconnect then
                            conn:Disconnect()
                        end
                    end
                end
            end
        end
    end)
end

-- 5. GUI DETECTION PREVENTION[reference:11]
local function hideGUIFromDetection()
