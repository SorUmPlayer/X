-- Dropdown para NPCs (nome + HP)
local configDropdown = configTab:Dropdown({
    Title = "Todos NPC próximo de mim",
    Values = {},  -- preenchido pelo scan
    Default = "",
    Callback = function(value)
        -- value é a string exibida (ex: "Boss (HP: 80%)")
        for path, data in pairs(npcTable) do
            local display = data.name .. " (HP: " .. data.health .. "%)"
            if display == value then
                selectNPCByPath(path)
                break
            end
        end
    end
})

-- Botão Copiar nome
configTab:Button({
    Title = "📋 Copiar apenas nome do NPC",
    Callback = function()
        if selectedNPC then
            copyToClipboard(selectedNPC.Name)
            StarterGui:SetCore("SendNotification", {
