-- 1. DETECÇÃO SEGURA DE PARENT DA UI (Evita crash no CoreGui)
local function GetSafeUIContainer()
    local successHui, hui = pcall(function() return gethui() end)
    if successHui and hui then return hui end

    local successCore, core = pcall(function() return game:GetService("CoreGui") end)
    if successCore and core then
        local testPermission = pcall(function()
            local folder = Instance.new("Folder")
            folder.Parent = core
            folder:Destroy()
        end)
        if testPermission then return core end
    end

    return LocalPlayer:WaitForChild("PlayerGui")
end

local UIContainer = GetSafeUIContainer()

