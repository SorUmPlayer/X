-- =============================================
local bossRunning = false
local bossConnection = nil

local function getActiveBossTarget()
    local enemys = Workspace:FindFirstChild("Enemys")
    if not enemys then return nil end

    local bosses = {
        { configKey = "BossShip", folderName = "Ship [ Ferris Wheel Form ]", charName = "Character", partName = "Ship" },
        { configKey = "BossKraken", folderName = "Kraken", charName = "Character", partName = "Kraken" },
        { configKey = "BossTransDimensional", folderName = "Trans Dimensional Monster", charName = "Character", partName = "Boss" },
        { configKey = "BossRajo", folderName = "Rojo", charName = "Character", partName = "Rojo" },
        { configKey = "BossAhPuchTotem", folderName = "Ah Puch Totem", charName = "Character", partName = "HumanoidRootPart" },
        { configKey = "BossAddwaitya", folderName = "Addwaitya", charName = "Character", partName = "Addwaitya" },
    }

    for _, boss in ipairs(bosses) do
        if Config[boss.configKey] then
            local folder = enemys:FindFirstChild(boss.folderName)
            if folder then
                local char = folder:FindFirstChild(boss.charName)
                if char and char:IsA("Model") then
                    local part = char:FindFirstChild(boss.partName) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if not part then
                        for _, child in ipairs(char:GetChildren()) do
                            if child:IsA("BasePart") then
                                part = child
                                break
                            end
                        end
                    end
                    if part and part:IsA("BasePart") then
                        return part
                    end
                end
            end
        end
    end
    return nil
end

local function startBossLoop()
    if bossConnection then return end
    bossRunning = true
    bossConnection = RunService.Heartbeat:Connect(function()
        if not (Config.BossShip or Config.BossKraken or Config.BossTransDimensional or Config.BossRajo or Config.BossAhPuchTotem or Config.BossAddwaitya) then
            bossRunning = false
            if bossConnection then
                bossConnection:Disconnect()
                bossConnection = nil
            end
            return
        end

        local targetPart = getActiveBossTarget()
        if not targetPart then return end

        local _, myRoot = getLocalCharacter()
        if not myRoot then return end

        myRoot.CFrame = targetPart.CFrame * CFrame.new(0, Config.BossDistance, 0)

        local multiplier = math.floor(tonumber(Config.BossShotMultiplier) or 1)
        if multiplier < 1 then multiplier = 1 end

        for i = 1, multiplier do
            if not (Config.BossShip or Config.BossKraken or Config.BossTransDimensional or Config.BossRajo or Config.BossAhPuchTotem or Config.BossAddwaitya) then break end
            Laser()
            GunArm()
            ArmFire(targetPart)
            Armature()
            task.wait(0.05)
        end
    end)
end

if Config.BossShip or Config.BossKraken or Config.BossTransDimensional or Config.BossRajo or Config.BossAhPuchTotem or Config.BossAddwaitya then
    task.spawn(startBossLoop)
