-- =====================================================
--  FUNÇÃO SEGURA DE PARENT
-- =====================================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE COM RECARGA)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or bola
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
atualizarReferenciaBola()

-- Recarregar referência periodicamente para evitar perda
task.spawn(function()
    while true do
        task.wait(1)
        if not bolaValida or not hitbox then
            atualizarReferenciaBola()
        end
    end
end)

-- =====================================================
--  GETBALL (PARA O BOTÃO DE CONTROLE)
-- =====================================================
local function getBall()
    if bola and bolaValida then
        return bola
    end
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

