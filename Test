local function setupChatListener()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.MessageReceived:Connect(function(message)
            if message.TextSource then
                local player = players:GetPlayerByUserId(message.TextSource.UserId)
                if player == LocalPlayer then
                    local texto = message.Text
                    if texto and texto ~= "" then
                        transformarAlien(texto)
                    end
                end
            end
        end)
    else
        local sayMsg = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
        if sayMsg then
            sayMsg.OnClientEvent:Connect(function(message, speaker)
                if speaker == LocalPlayer.Name then
                    transformarAlien(message)
                end
            end)
        end
    end
end
