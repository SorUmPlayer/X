-- ============================================
-- BOTÃO COPIAR LINK
-- ============================================
local linkCopiado = false
local copyBtn = Instance.new("TextButton")
copyBtn.Name = "CopyButton"
copyBtn.Parent = frame
copyBtn.Size = UDim2.new(0, 390, 0, 44)
copyBtn.Position = UDim2.new(0.5, -195, 0, 225)
copyBtn.BackgroundColor3 = Color3.fromRGB(140, 140, 140)  -- Cinza
copyBtn.BorderSizePixel = 2
copyBtn.BorderColor3 = Color3.fromRGB(0, 0, 0)
copyBtn.Text = TEXTOS.portugues.copiar
copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
copyBtn.TextSize = 17
copyBtn.Font = Enum.Font.SourceSansBold

copyBtn.MouseButton1Click:Connect(function()
    -- Copiar link
    local sucesso = false
    if setclipboard then
        sucesso = pcall(function()
            setclipboard(LINK_CANAL)
        end)
    end

    if not sucesso then
        -- Fallback: mostra no console e tenta via gui
        print("Link: " .. LINK_CANAL)
        -- Tenta usar o clipboard do jogo
        if game:GetService("HttpService") then
            pcall(function()
                game:GetService("HttpService"):SetClipboard(LINK_CANAL)
            end)
        end
    end

    -- Atualiza estado e aparência
    linkCopiado = true
    copyBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)  -- Verde
    copyBtn.Text = TEXTOS.portugues.copiado

    -- Notificação visual (opcional)
    local notif = Instance.new("TextLabel")
    notif.Parent = frame
    notif.Size = UDim2.new(0, 200, 0, 30)
    notif.Position = UDim2.new(0.5, -100, 0, 280)
    notif.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    notif.BackgroundTransparency = 0.7
    notif.BorderSizePixel = 0
    notif.Text = "✅ Link copiado!"
    notif.TextColor3 = Color3.fromRGB(0, 255, 100)
    notif.TextSize = 16
    notif.Font = Enum.Font.SourceSansBold
    notif.TextWrapped = true
    notif.TextXAlignment = Enum.TextXAlignment.Center
    notif.Name = "Notification"

    -- Remove a notificação após 2 segundos
    task.delay(2.5, function()
        if notif and notif.Parent then
            notif:Destroy()
        end
    end)
end)

-- ============================================
-- TECLA "M" PARA MOSTRAR/ESCONDER MENU
-- ============================================
local function onKeyPress(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.M then
        frame.Visible = not frame.Visible
    end
end

game:GetService("UserInputService").InputBegan:Connect(onKeyPress)

-- ============================================
-- DRAG PARA MOVER O MENU (opcional)
-- ============================================
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

