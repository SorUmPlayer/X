local fpsOriginalSettings, fpsModeParticles = nil, {}

local function salvarSettingsOriginais()
    if fpsOriginalSettings then return end
    fpsOriginalSettings = {
        GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd,
        Brightness = Lighting.Brightness, Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
    }
end

local function restaurarSettings()
    if not fpsOriginalSettings then return end
    Lighting.GlobalShadows = fpsOriginalSettings.GlobalShadows
    Lighting.FogEnd = fpsOriginalSettings.FogEnd
    Lighting.Brightness = fpsOriginalSettings.Brightness
    Lighting.Ambient = fpsOriginalSettings.Ambient
    Lighting.OutdoorAmbient = fpsOriginalSettings.OutdoorAmbient
    for _, o in ipairs(fpsModeParticles) do if o and o.Parent then o.Enabled = true end end
    fpsModeParticles = {}
end

local function aplicarFpsMode(level)
    if level == 0 then restaurarSettings(); return end
    salvarSettingsOriginais()
    if level >= 1 then
        Lighting.GlobalShadows = false; Lighting.FogEnd = 100000
        pcall(function() sethiddenproperty(Lighting, "Technology", 2) end)
        pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)
    end
    if level >= 2 then
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke") or o:IsA("Fire")
                or o:IsA("Sparkles") or o:IsA("Explosion") or o:IsA("Beam") or o:IsA("PointLight")
                or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
                if o.Enabled then o.Enabled = false; table.insert(fpsModeParticles, o) end
            end
        end
        Lighting.Brightness = 0
        Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    end
    if level >= 3 then
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function()
            for _, o in ipairs(Lighting:GetChildren()) do
                if o:IsA("Atmosphere") or o:IsA("BloomEffect") or o:IsA("BlurEffect")
                    or o:IsA("ColorCorrectionEffect") or o:IsA("SunRaysEffect") or o:IsA("DepthOfFieldEffect") then
                    o.Enabled = false; table.insert(fpsModeParticles, o)
                end
            end
        end)
    end
end

local function aplicarPingMenos(estado)
    Config.pingMenos = estado; SaveConfig()
    if estado then
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function() sethiddenproperty(Lighting, "Technology", 2) end)
        pcall(function()
            for _, o in ipairs(workspace:GetDescendants()) do
                if o:IsA("ParticleEmitter") then o.Enabled = false end
            end
        end)
    else
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
    end
end

