local pastaSection = configTab:Section({
    Title = "Pasta",
    TextXAlignment = "Left",
    TextSize = 17
})

-- Dropdown para caminho completo
local pastaDropdown = configTab:Dropdown({
    Title = "Localização da pasta do NPC",
    Values = {},  -- preenchido pelo scan
    Default = "",
    Callback = function(value)
        -- value é o caminho (ex: "Workspace.Enemy.Boss")
        if selectNPCByPath(value) then
            StarterGui:SetCore("SendNotification", {
                Title = "Selecionado",
                Text = "NPC destacado em verde!",
                Duration = 2
            })
        end
    end
})

-- Botão Copiar Pasta (caminho completo)
configTab:Button({
    Title = "📂 Copiar Pasta",
    Callback = function()
        if selectedNPC then
            local path = ""
            for p, data in pairs(npcTable) do
                if data.npc == selectedNPC then
                    path = p
                    break
                end
            end
            if path ~= "" then
                copyToClipboard(path)
                StarterGui:SetCore("SendNotification", {
                    Title = "Copiado",
                    Text = "Caminho: " .. path,
                    Duration = 3
                })
            else
                StarterGui:SetCore("SendNotification", {
                    Title = "Erro",
                    Text = "Caminho não encontrado!",
                    Duration = 2
                })
            end
        else
            StarterGui:SetCore("SendNotification", {
                Title = "Erro",
                Text = "Nenhum NPC selecionado!",
                Duration = 2
            })
        end
    end
})

