--[[
    Script: Ativador Automático de ProximityPrompt
    Funcionamento: O script encontra TODOS os ProximityPrompt do jogo,
    teletransporta seu personagem para perto de cada um, ativa o prompt
    e depois retorna à posição original.
]]

local player = game:GetService("Players").LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:FindFirstChild("HumanoidRootPart")

if not hrp then
    warn("HumanoidRootPart não encontrado!")
    return
end

-- Salva a posição original e estado de ancoragem
local originalCFrame = hrp.CFrame
local wasAnchored = hrp.Anchored
hrp.Anchored = false

-- Função para descobrir onde o prompt está (suporta BasePart, Attachment e Model)
local function getPromptPosition(prompt)
    local parent = prompt.Parent
    if parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("Model") then
        local primary = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
        if primary then
            return primary.Position
        end
    end
    return nil
end

-- Coleta todos os ProximityPrompts do jogo
local prompts = {}
for _, obj in ipairs(game:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        table.insert(prompts, obj)
    end
end

print(string.format("Encontrados %d ProximityPrompts.", #prompts))

-- Se não houver nenhum, encerra
if #prompts == 0 then
    print("Nenhum prompt encontrado.")
    return
end

-- Percorre a lista de prompts
for i, prompt in ipairs(prompts) do
    local pos = getPromptPosition(prompt)
    if pos then
        -- Teletransporta para a posição do prompt (2.5 unidades acima para não ficar preso no chão)
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
        task.wait(0.1) -- Pequena pausa para o servidor reconhecer a nova posição

        -- Tenta ativar o prompt
        local success, err = pcall(function()
            prompt:Trigger()
        end)

        if success then
            print(string.format("[%d/%d] Prompt ativado em %s", i, #prompts, tostring(pos)))
        else
            warn(string.format("Erro ao ativar prompt %s: %s", prompt.Name, err))
        end

        task.wait(0.1) -- Delay entre as ativações para evitar sobrecarga
    else
        warn(string.format("Não foi possível achar a posição do prompt: %s", prompt.Name))
    end
end

-- Retorna o personagem para o local original e restaura a ancora
hrp.CFrame = originalCFrame
hrp.Anchored = wasAnchored
print("Todos os prompts foram processados!")
