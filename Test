    -- ====== BOTÃO RESET ======
    TabBoss:Button({
        Title = "🔄 Resetar Configurações",
        Desc = "Reseta todas as configurações para os valores padrão",
        Callback = function()
            Config.Distancia = 10
            Config.Direcao = "Cima"
            Config.Multiplicador = 1
            Config.Bivalvan = false
            Config.Galapagus = false
            SaveConfig()
            if bossKillConnection then
                bossKillConnection:Disconnect()
                bossKillConnection = nil
