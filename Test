local function getBallAzure()
    local terrain = Workspace:FindFirstChild("Terrain")
    if terrain then
        local ball = terrain:FindFirstChild("Ball")
        if ball and ball:IsA("BasePart") then return ball end
    end
    local characters = Workspace:FindFirstChild("characters")
    if characters then
        for _, charModel in ipairs(characters:GetChildren()) do
            if charModel:IsA("Model") then
                local ball = charModel:FindFirstChild("Ball")
                if ball and ball:IsA("BasePart") then return ball end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Ball" then return obj end
    end
    return nil
end

local function getHitboxAzure() return getBallAzure() end

local function euTenhoBolaAzure()
    local characters = Workspace:FindFirstChild("characters")
    if characters then
        local myChar = characters:FindFirstChild(player.Name)
        if myChar then return myChar:FindFirstChild("Ball") ~= nil end
    end
    return false
end

local function getEnemyWithBall()
    local characters = Workspace:FindFirstChild("characters")
    if not characters then return nil end
    for _, charModel in ipairs(characters:GetChildren()) do
        if charModel:IsA("Model") and charModel.Name ~= player.Name then
            if charModel:FindFirstChild("Ball") then return charModel end
        end
    end
    return nil
end

local function getNearestEnemy()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local nearest, nearestDist = nil, math.huge
    local characters = Workspace:FindFirstChild("characters")
    if not characters then return nil end
    for _, charModel in ipairs(characters:GetChildren()) do
        if charModel:IsA("Model") and charModel.Name ~= player.Name then
            local eHrp = charModel:FindFirstChild("HumanoidRootPart")
            if eHrp then
                local d = (eHrp.Position - hrp.Position).Magnitude
                if d < nearestDist then nearest, nearestDist = charModel, d end
            end
        end
    end
    return nearest, nearestDist
end

