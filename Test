local function atualizarAdvinhaChute()
    if not Config.advinhaChute then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end
    if not bola or not bolaValida then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end
    local vel = bola.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end
    local gravidade = Vector3.new(0, -50, 0)
    local pos = bola.Position
    local v = vel
    local dt = 0.02
    local maxPassos = 500
    local chaoY = 0
    local pontos = {pos}
    for i = 1, maxPassos do
        v = v + gravidade * dt
        pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then break end
    end
    if #pontos < 2 then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end
    local posFinal = pontos[#pontos]
    posFinal = Vector3.new(posFinal.X, chaoY, posFinal.Z)
    local inicio = pontos[1]
    local fim = pontos[#pontos]
    local meio = (inicio + fim) / 2
    local distancia = (inicio - fim).Magnitude
    criarLinhaChute()
    if distancia > 0.1 then
        linhaChute.Size = Vector3.new(0.5, 0.5, distancia)
        linhaChute.CFrame = CFrame.lookAt(meio, fim)
        linhaChute.Transparency = 0.2
    else
        linhaChute.Transparency = 1
    end
    if v.Y < -0.5 then
        criarCirculoChute()
        circuloChute.Position = posFinal
        local tamanho = math.clamp(vel.Magnitude / 8, 3, 8)
        circuloChute.Size = Vector3.new(tamanho, 0.1, tamanho)
        circuloChute.Transparency = 0.2
    else
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
    end
end

-- (f) Funções de jogo (Heartbeat)
local function shouldAimbotWork()
    local tenho = euTenhoBola()
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    return true
end

local function aplicarTamanhoHitbox()
    if not hitbox then return end
    local tenho = euTenhoBola()
    local tamanhoDesejado, transparenciaDesejada
    if tenho or not Config.hitboxBola then
        tamanhoDesejado = hitboxOriginalSize
        transparenciaDesejada = hitboxOriginalTransparency
    else
        tamanhoDesejado = Vector3.new(Config.reachDistancia, Config.reachDistancia, Config.reachDistancia)
        transparenciaDesejada = 1
    end
    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= transparenciaDesejada then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = transparenciaDesejada
    end
end

local function aplicarHitboxPersonagem()
    if not Config.hitboxPersonagem then return end
    if euTenhoBola() then return end
    if not hitbox or not bolaValida then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - hitbox.Position).Magnitude
    if dist <= Config.hitboxPersonagemTamanho then
        if firetouchinterest then
            firetouchinterest(hrp, hitbox, 0)
            task.wait(0.01)
            firetouchinterest(hrp, hitbox, 1)
        end
    end
end

local function aplicarForcaBola()
    if not Config.forcaBola then return end
    if not bola or not bolaValida then return end
    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then
            dir = Vector3.new(1, 0, 0)
        else
            dir = dir.Unit
        end
        local vel = dir * Config.forcaBolaVelocidade + Vector3.new(0, 15, 0)
        bola.AssemblyLinearVelocity = vel
    end
    tinhaBola = tenho
end
local tinhaBola = false

local function aplicarCurvas()
    if not Config.curvas then return end
    if not bola or not bolaValida then return end
    if euTenhoBola() then return end
    local vel = bola.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed < 40 then return end
    if bola.Position.Y < 0.5 then return end
    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local fator = (Config.curvasIntensidade / 10) * 15 + 1.5
    local lado = 1
    if Config.curvasModo == 1 then
        lado = 1
    elseif Config.curvasModo == 2 then
        lado = -1
    elseif Config.curvasModo == 3 then
        if tick() - curvasTimer > curvasIntervalo then
            curvasTimer = tick()
            curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
            curvasIntervalo = 0.5 + math.random() * 0.5
        end
        lado = curvasDirecaoAtual
    end
    local forcaLateral = perp * lado * fator
    bola.AssemblyLinearVelocity = vel + forcaLateral
end
local curvasTimer = 0
local curvasIntervalo = 1.0
local curvasDirecaoAtual = 1

local function atualizarAimbotPersonagem()
    if not Config.aimbotPersonagem then
        if gyro then gyro:Destroy() gyro = nil end
        return
    end
    if not shouldAimbotWork() then
        if gyro then gyro:Destroy() gyro = nil end
        return
    end
    if not hitbox or not bolaValida then
        if gyro then gyro:Destroy() gyro = nil end
        return
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end
    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

local function atualizarAimbotCamera()
    if isControlActive then return end
    if not Config.aimbotCamera then return end
    if not shouldAimbotWork() then return end
    if not hitbox or not bolaValida then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

local function atualizarESP()
    if euTenhoBola() or not Config.mostrarESP or not hitbox then
        if espSphere then espSphere:Destroy() espSphere = nil end
        return
    end
    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end
    local scale = Config.reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

