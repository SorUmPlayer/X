-- =====================================================
--  VARIÁVEIS & LÓGICA VOLLEYBALL LEGENDS (CLIENT_BALL_)
-- =====================================================
local vbHitboxEnabled = false
local vbHitboxSize = 15
local vbOriginalProps = {}

local function restoreVbOriginals()
    for part, props in pairs(vbOriginalProps) do
        if part and part.Parent then
            part.Size = props.Size
            part.Transparency = props.Transparency
            part.CanCollide = props.CanCollide
            part.CanTouch = props.CanTouch
        end
    end
    table.clear(vbOriginalProps)
end

local function getVbBallParts()
    local ballParts = {}
    for _, item in ipairs(Workspace:GetChildren()) do
        if string.sub(item.Name, 1, 12) == "CLIENT_BALL_" then
            if item:IsA("BasePart") then
                table.insert(ballParts, item)
            else
                for _, child in ipairs(item:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(ballParts, child)
                    end
                end
            end
        end
    end
    return ballParts
end

RunService.Heartbeat:Connect(function()
    if not vbHitboxEnabled then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bodyParts = {
        char:FindFirstChild("Right Foot") or char:FindFirstChild("RightLeg") or char:FindFirstChild("Right Lower Leg"),
        char:FindFirstChild("Left Foot") or char:FindFirstChild("LeftLeg") or char:FindFirstChild("Left Lower Leg"),
        hrp
    }

    local balls = getVbBallParts()
    for _, part in ipairs(balls) do
        if not vbOriginalProps[part] then
            vbOriginalProps[part] = {
                Size = part.Size,
                Transparency = part.Transparency,
                CanCollide = part.CanCollide,
                CanTouch = part.CanTouch
            }
        end

        part.Size = Vector3.new(vbHitboxSize, vbHitboxSize, vbHitboxSize)
        part.Transparency = 0.5
        part.CanCollide = false
        part.CanTouch = true
        if pcall(function() return part.CanQuery end) then
            part.CanQuery = true
        end

        local distance = (hrp.Position - part.Position).Magnitude
        if distance <= (vbHitboxSize / 2) + 3 then
            for _, bPart in ipairs(bodyParts) do
                if bPart and firetouchinterest then
                    firetouchinterest(bPart, part, 0)
                    firetouchinterest(bPart, part, 1)
                end
            end
        end
    end
end)

-- =====================================================
--  CONTROLE DA HITBOX (UNIFICADO)
-- =====================================================
local function aplicarTamanhoHitbox()
    if not hitbox then return end

    local tenho = euTenhoBola()
    local tamanhoDesejado
    local transparenciaDesejada

    if tenho or not reachAtivo then
        tamanhoDesejado = hitboxOriginalSize
        transparenciaDesejada = hitboxOriginalTransparency
    else
        tamanhoDesejado = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        transparenciaDesejada = 1
    end

    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= transparenciaDesejada then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = transparenciaDesejada
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        aplicarTamanhoHitbox()
    end
end)

-- =====================================================
--  CONTROLE BOLA – BOTÃO FLUTUANTE
-- =====================================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    
    if isControlActive then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        
        if controlConnection then controlConnection:Disconnect() end
        
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                camera.CameraSubject = ball
                local lookVector = camera.CFrame.LookVector
                ball.AssemblyLinearVelocity = lookVector * velocidadeBola
            else
                resetCamera()
            end
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        
        resetCamera()
    end
end

local function criarBotaoFlutuante()
    if controlScreenGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGui"
    screenGui.ResetOnSpawn = false
    safeParent(screenGui)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Control BALL [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn

    btn.MouseButton1Click:Connect(toggleControl)

    toggleButton = btn
    controlScreenGui = screenGui
end

local function removerBotaoFlutuante()
    if isControlActive then
        toggleControl()
    end
    if controlScreenGui then
        controlScreenGui:Destroy()
        controlScreenGui = nil
        toggleButton = nil
    end
end

