-- VISÃO DE JOGO – ADVINHA A BOLA (amarela)
-- =============================================
local function criarOuReutilizar(parteAtual, cor, nome)
    if parteAtual and parteAtual.Parent then return parteAtual end
    if parteAtual then parteAtual:Destroy() end
    local p = Instance.new("Part")
    p.Name = nome
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Transparency = 0.3
    p.Color = cor
    p.Material = Enum.Material.Neon
    p.Parent = Workspace
    return p
end

local function atualizarAdvinhaBola()
    if not visaoBolaEnabled then
        if linhaTrajetoria then linhaTrajetoria:Destroy() linhaTrajetoria = nil end
        if circuloImpacto then circuloImpacto:Destroy() circuloImpacto = nil end
        return
    end

    local ball = getBall()
    if not ball then
        if linhaTrajetoria then linhaTrajetoria:Destroy() linhaTrajetoria = nil end
        if circuloImpacto then circuloImpacto:Destroy() circuloImpacto = nil end
        return
    end

    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 1 then
        if linhaTrajetoria then linhaTrajetoria.Transparency = 1 end
        if circuloImpacto then circuloImpacto.Transparency = 1 end
        return
    end

    local gravidade = Vector3.new(0, -90, 0)
    local pos = ball.Position
    local v = vel
    local dt = 0.05
    local chaoY = 0

    local pontos = {pos}
    for _ = 1, 80 do
        v = v + gravidade * dt
        pos = pos + v * dt
        pontos[#pontos + 1] = pos
        if pos.Y <= chaoY then break end
    end

    if #pontos < 2 then
        if linhaTrajetoria then linhaTrajetoria.Transparency = 1 end
        if circuloImpacto then circuloImpacto.Transparency = 1 end
        return
    end

    local inicio = pontos[1]
    local fim = pontos[#pontos]
    fim = Vector3.new(fim.X, chaoY, fim.Z)

    linhaTrajetoria = criarOuReutilizar(linhaTrajetoria, Color3.fromRGB(255, 255, 0), "TrajectoryLine")
    local meio = (inicio + fim) / 2
    local dist = (inicio - fim).Magnitude
    if dist > 0.5 then
        linhaTrajetoria.Size = Vector3.new(0.4, 0.4, dist)
        linhaTrajetoria.CFrame = CFrame.lookAt(meio, fim)
        linhaTrajetoria.Transparency = 0.3
    else
        linhaTrajetoria.Transparency = 1
    end

    if v.Y < -0.5 then
        circuloImpacto = criarOuReutilizar(circuloImpacto, Color3.fromRGB(255, 255, 0), "ImpactCircle")
        circuloImpacto.Shape = Enum.PartType.Cylinder
        circuloImpacto.Position = fim
        local tam = math.clamp(vel.Magnitude / 10, 3, 6)
        circuloImpacto.Size = Vector3.new(tam, 0.1, tam)
        circuloImpacto.Transparency = 0.3
    else
        if circuloImpacto then circuloImpacto.Transparency = 1 end
    end
end

-- =============================================
-- VISÃO DE JOGO – ADVINHE CHUTE (verde)
-- =============================================
local function atualizarAdvinheChute()
    if not visaoChuteEnabled then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local plr, char = alguemTemBola()
    if not plr or plr == player or not char then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp
    if not origem then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local posInicio = origem.Position
    if origem == hrp then
        posInicio = posInicio + Vector3.new(0, 1.5, 0)
    end

    local dir = Vector3.new(1, 0, 0)
    if head then
        dir = head.CFrame.LookVector
    elseif hrp then
        dir = hrp.CFrame.LookVector
    end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.001 then
        dir = Vector3.new(1, 0, 0)
    else
        dir = dir.Unit
    end

    local posFim = posInicio + dir * 80

    linhaOlhar = criarOuReutilizar(linhaOlhar, Color3.fromRGB(0, 255, 0), "LookLine")
    local meio = (posInicio + posFim) / 2
    local dist = (posInicio - posFim).Magnitude
    if dist < 0.5 then dist = 0.5 end
    linhaOlhar.Size = Vector3.new(0.5, 0.5, dist)
    linhaOlhar.CFrame = CFrame.lookAt(meio, posFim)
    linhaOlhar.Transparency = 0.2
end

-- =============================================
-- CONTROLE DE BOLA (SetNetworkOwner)
-- =============================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    if isControlActive then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        if controlConnection then controlConnection:Disconnect() end
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if not ball then
                resetCamera()
                return
            end

            if euTenhoBola() then
                resetCamera()
                return
            end

            -- Toma posse da bola
            pcall(function()
                ball:SetNetworkOwner(player)
            end)

            camera.CameraSubject = ball

            local look = camera.CFrame.LookVector
            local target = look * velocidadeBola
            ball.AssemblyLinearVelocity = ball.AssemblyLinearVelocity:Lerp(target, 0.5)
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        local ball = getBall()
        if ball then
            pcall(function() ball:SetNetworkOwner(nil) end)
        end
        resetCamera()
    end
end

