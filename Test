local bola, hitbox, bolaValida = nil, nil, false
local function atualizarReferenciaBola()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local fb = child:FindFirstChild("Football")
            if fb then
                bola = fb
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true; return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or bola
            bolaValida = true; return
        end
    end
    bola = nil; hitbox = nil; bolaValida = false
end
