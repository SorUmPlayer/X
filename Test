local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    Config.aimbotPersonagem = estado
    SaveConfig()
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not shouldAimbotWork() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not hitbox or not bolaValida then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

local function atualizarAimbotCamera()
    if isControlActive then return end
    if not aimbotCamera then return end

    if not shouldAimbotWork() then
        return
    end

    if not hitbox or not bolaValida then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

local function atualizarBotaoCurvas()
    if not curvasBotao then return end
    if curvasModo == 1 then
        curvasBotao.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        curvasBotao.Text = "Curva: Direita ☛"
    elseif curvasModo == 2 then
        curvasBotao.BackgroundColor3 = Color3.fromRGB(0, 0, 255)
        curvasBotao.Text = "Curva: Esquerda ☚"
    elseif curvasModo == 3 then
        curvasBotao.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        curvasBotao.Text = "Curva: Aleatório 🥴"
    end
end

local function toggleCurvasModo()
    curvasModo = curvasModo + 1
    if curvasModo > 3 then curvasModo = 1 end
    atualizarBotaoCurvas()
end

local function criarBotaoCurvas()
    if curvasBotaoGUI then return end
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CurvasGui"
    screenGui.ResetOnSpawn = false
    safeParent(screenGui)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 45)
    btn.Position = UDim2.new(0.5, -100, 0.3, 0)
    btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    btn.BackgroundTransparency = 0
    btn.Text = "Curva: Direita ☛"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn
    btn.MouseButton1Click:Connect(toggleCurvasModo)
    curvasBotao = btn
    curvasBotaoGUI = screenGui
    atualizarBotaoCurvas()
end

local function removerBotaoCurvas()
    if curvasBotaoGUI then
        curvasBotaoGUI:Destroy()
        curvasBotaoGUI = nil
        curvasBotao = nil
    end
end

