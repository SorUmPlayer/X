        [lang.BtnFloresta] = CFrame.new(84,7,-3524),
        [lang.BtnColiseu] = CFrame.new(-1124,8,-6871),
        [lang.BtnYggasill] = CFrame.new(-8206,-368,-12277),
        [lang.BtnLedgerDomain] = CFrame.new(913,-2514,-1566)
