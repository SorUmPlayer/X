-- CHAT COMMAND
-- =============================================
pcall(function()
    local chatService = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if chatService then
        local onMessage = chatService:FindFirstChild("OnMessage")
        if onMessage then
            onMessage.OnClientEvent:Connect(function(msg)
                if type(msg) ~= "string" then return end
                local lower = string.lower(msg)
                if string.match(lower, "^velocidade da bola") then
                    local num = string.match(msg, "%d+")
                    if num then
                        local val = tonumber(num)
                        if val and val > 0 and val <= 300 then
                            velocidadeBola = val
                            Config.velocidadeBola = val
                            saveConfig()
                        end
                    end
                end
            end)
        end
    end
end)

