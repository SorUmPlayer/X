local function enableBypass()
    if bypass.enabled then return end
    bypass.enabled = true

    if bypass.debug then
        print("[Bypass] Ativando Anti-Cheat Bypass...")
    end

    -- Aplica todas as técnicas de bypass
    spoofProperty(player, "WalkSpeed", 16, 16)
    spoofProperty(player, "JumpPower", 50, 50)
    
    hookDebugFunctions()
    disableAntiCheatConnections()
    hideGUIFromDetection()
    hookAntiCheatFunctions()
    bypassIAC()
    bypassAdonis()
    hookMetamethods()
    
    -- Bloqueia eventos remotos comuns
    blockRemoteEvent("Report")
    blockRemoteEvent("Log")
    blockRemoteEvent("Telemetry")
    blockRemoteEvent("Crash")
    blockRemoteEvent("Ban")
    
    if bypass.debug then
        print("[Bypass] Anti-Cheat Bypass ativado!")
    end
end

-- =============================================
-- DESATIVAR BYPASS
-- =============================================
local function disableBypass()
    if not bypass.enabled then return end
    bypass.enabled = false

    -- Restaura funções originais
    for obj, funcs in pairs(bypass.originalFunctions) do
        for key, val in pairs(funcs) do
            pcall(function()
                obj[key] = val
            end)
        end
    end
    
    -- Limpa hooks
    if bypass.hookedMetamethods.game then
        pcall(function()
            hookmetamethod(game, "__index", bypass.hookedMetamethods.game)
        end)
    end

    if bypass.debug then
        print("[Bypass] Anti-Cheat Bypass desativado.")
    end
end

