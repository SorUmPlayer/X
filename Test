-- =============================================
-- ANTI-BAN ULTRA
-- =============================================
local function antiBan()
    -- Desativa logs, reports e telemetria
    pcall(function()
        local g = getrenv()._G
        for _, k in ipairs({"Log", "Report", "Crash", "Telemetry", "Analytics"}) do
            if g[k] then g[k] = function() end end
        end
    end)

    -- Hook em funções sensíveis
    pcall(function()
        local oldFire = firetouchinterest
        firetouchinterest = function(a, b, c)
            task.wait(math.random(5, 15) / 1000)
            if oldFire then oldFire(a, b, c) end
        end
    end)

    -- Desativa ScriptContext
    pcall(function()
        local sc = game:GetService("ScriptContext")
        sc.Error:Connect(function() end)
        sc.Warning:Connect(function() end)
        sc.Log:Connect(function() end)
    end)

    -- Oculta ScreenGuis do jogador
    pcall(function()
        for _, gui in ipairs(player.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name:match("ControlBallGui") then
                gui.Enabled = true
            end
        end
    end)
end

-- Executa anti-ban a cada frame
RunService.Heartbeat:Connect(antiBan)

-- Executa uma vez
antiBan()

-- =============================================
-- REFERÊNCIAS
-- =============================================
local function getBall()
    local bb = Workspace:FindFirstChild("Basketball")
    if bb then
        local ab = bb:FindFirstChild("AnimBall")
        if ab then return ab end
    end
    return nil
end

local function getCollider()
    local bb = Workspace:FindFirstChild("Basketball")
    if bb then
        local col = bb:FindFirstChild("Collider")
        if col then return col end
    end
    return nil
end

local function getAro(team)
    if team == "Home" then
        return Workspace:FindFirstChild("AnimatedHome")
    elseif team == "Away" then
        return Workspace:FindFirstChild("AnimatedAway")
    end
    return nil
end

-- =============================================
-- VARIÁVEIS
-- =============================================
local velocidadeBola = 65
local controleAtivo = false
local autoSexta = false
local timeSelecionado = "Home"
local hitboxAtivo = false
local hitboxTamanho = 20

local controlConnection = nil
local controlScreenGui = nil
local toggleButton = nil

-- BodyVelocity para controle suave
local bodyVel = nil

-- =============================================
-- CONTROLE DE BOLA (BOTÃO FLUTUANTE)
-- =============================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    controleAtivo = not controleAtivo
    if controleAtivo then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        if controlConnection then controlConnection:Disconnect() end

        -- Cria BodyVelocity na bola
        local ball = getBall()
        if ball then
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(4000, 4000, 4000)
            bodyVel.Velocity = Vector3.new(0, 0, 0)
            bodyVel.Parent = ball
        end

        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball and bodyVel then
                camera.CameraSubject = ball
                local lookVector = camera.CFrame.LookVector
                bodyVel.Velocity = lookVector * velocidadeBola
            else
                resetCamera()
            end
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        if bodyVel then
            bodyVel:Destroy()
            bodyVel = nil
        end
        resetCamera()
    end
end

local function criarBotaoFlutuante()
    if controlScreenGui then return end
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGui"
    screenGui.ResetOnSpawn = false

    local ok, err = pcall(function()
        screenGui.Parent = player.PlayerGui
    end)
    if not ok then
        screenGui.Parent = CoreGui
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Control BALL [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn
    btn.MouseButton1Click:Connect(toggleControl)
    toggleButton = btn
    controlScreenGui = screenGui
end

local function removerBotaoFlutuante()
    if controleAtivo then
        toggleControl()
    end
    if controlScreenGui then
        controlScreenGui:Destroy()
        controlScreenGui = nil
        toggleButton = nil
    end
end

-- =============================================
-- AUTO SEXTA (BODYPOSITION)
-- =============================================
local function aplicarAutoSexta()
    if not autoSexta then return end

    local ball = getBall()
    if not ball then return end

    local aro = getAro(timeSelecionado)
    if not aro then return end

    -- Verifica se a bola está em movimento
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 3 then return end

    -- Usa BodyPosition para guiar a bola
    local bp = ball:FindFirstChild("AutoSextaBP")
    if not bp then
        bp = Instance.new("BodyPosition")
        bp.Name = "AutoSextaBP"
        bp.MaxForce = Vector3.new(4000, 4000, 4000)
        bp.P = 1000
        bp.Parent = ball
    end

    local targetPos = aro.Position + Vector3.new(0, 2, 0) -- mira no centro do aro
    bp.Position = targetPos

    -- Remove o BodyPosition após 1 segundo para não ficar grudado
    task.delay(0.5, function()
        if bp and bp.Parent then
            bp:Destroy()
        end
    end)
end

-- =============================================
-- HITBOX (COM DELAY)
-- =============================================
local function aplicarHitbox()
    local collider = getCollider()
    if not collider then return end

    if hitboxAtivo then
        -- Aumenta o collider com um pequeno delay aleatório
        task.wait(math.random(1, 5) / 100)
        collider.Size = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
        collider.Transparency = 0.5
    else
        collider.Size = Vector3.new(1.4, 1.4, 1.4)
        collider.Transparency = 0
    end
end

-- =============================================
-- COMANDO DE CHAT
-- =============================================
local function onChatMessage(msg)
    local lower = msg:lower()
    if lower:match("^velocidade da bola") then
        local num = msg:match("^velocidade da bola (%d+)")
        if num then
            local val = tonumber(num)
            if val and val > 0 and val <= 200 then
                velocidadeBola = val
                player:Chat("Velocidade da bola ajustada para " .. val)
            else
                player:Chat("Use um número entre 1 e 200.")
            end
        else
            player:Chat("Use: Velocidade da bola [número]")
        end
    end
end

local function setupChatCommand()
    local chatService = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if chatService then
        local onMessage = chatService:FindFirstChild("OnMessage")
        if onMessage then
            onMessage.OnClientEvent:Connect(onChatMessage)
        end
    end
end
setupChatCommand()

-- =============================================
-- LOOP PRINCIPAL
-- =============================================
RunService.Heartbeat:Connect(function()
    aplicarHitbox()
    aplicarAutoSexta()
end)

