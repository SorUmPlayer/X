-- =============================================
-- HITBOX (REACH LOCAL – NÃO MODIFICA A BOLA SERVER-SIDE)
-- =============================================
local function aplicarHitbox()
    -- Não modifica mais a bola real! Ao invés disso, cria uma parte local
    -- invisível em volta da bola que só o cliente vê.
    local ball = getBall()
    if not ball then
        if reachHitbox then reachHitbox:Destroy() reachHitbox = nil end
        return
    end

    if hitboxAtivo and not euTenhoBola() then
        if not reachHitbox or not reachHitbox.Parent then
            if reachHitbox then reachHitbox:Destroy() end
            reachHitbox = Instance.new("Part")
            reachHitbox.Name = randName()
            reachHitbox.Anchored = true
            reachHitbox.CanCollide = false
            reachHitbox.CanTouch = true
            reachHitbox.CanQuery = false
            reachHitbox.CastShadow = false
            reachHitbox.Transparency = 1
            reachHitbox.Size = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
            reachHitbox.Parent = CameraFolder
        end
        reachHitbox.Size = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
        reachHitbox.CFrame = ball.CFrame
    else
        if reachHitbox then reachHitbox:Destroy() reachHitbox = nil end
    end
end

local function atualizarESP()
    if espHitbox and hitboxAtivo and reachHitbox then
        if not espSphere or not espSphere.Parent then
            if espSphere then espSphere:Destroy() end
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = randName()
            espSphere.Adornee = reachHitbox
            espSphere.Parent = reachHitbox
            espSphere.Color3 = Color3.fromRGB(0, 255, 0)
            espSphere.Transparency = 0.6
        end
        local scale = hitboxTamanho / 2.5
        espSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espSphere then espSphere:Destroy() espSphere = nil end
    end
end

