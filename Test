-- SISTEMA DE COMBATE (REMOTES)
-- =============================================
local RS = pcall(function()
    local remotes = ReplicatedStorage:FindFirstChild("AliensPowerRemotes")
    if remotes then
        return remotes:FindFirstChild("upgrade")
    end
end) and ReplicatedStorage:FindFirstChild("AliensPowerRemotes"):FindFirstChild("upgrade") or nil

local SonicRemote = nil
pcall(function()
    local remotes = ReplicatedStorage:FindFirstChild("AliensPowerRemotes")
    if remotes then
        SonicRemote = remotes:FindFirstChild("uechoecho")
        if SonicRemote then
            SonicRemote = SonicRemote:FindFirstChild("Sonic_Shard")
        end
    end
end)

local function LaserAttack()
    if RS and RS.Laser then pcall(function() RS.Laser:InvokeServer() end) end
end
local function GunArm()
    if RS and RS.GunArm then pcall(function() RS.GunArm:InvokeServer() end) end
end
local function Armature()
    if RS and RS.Armature then pcall(function() RS.Armature:InvokeServer() end) end
end

local function ArmFire(targetRoot)
    if not RS or not RS.ArmFire then return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        local targetPosition = targetRoot and targetRoot.Position or (root.Position + Vector3.new(0, -100, 0))
        pcall(function()
            RS.ArmFire:InvokeServer(targetPosition)
        end)
    end
end

local function SonicAttack(targetRoot)
    if not SonicRemote then
        print("[Kill Boss] Remote Sonic_Shard não encontrado!")
        return false
    end
    if not targetRoot then
        print("[Kill Boss] Alvo inválido para Sonic_Shard!")
        return false
    end
    local targetPosition = targetRoot.Position
    pcall(function()
        SonicRemote:InvokeServer(targetPosition, 26.567533493042)
        print("[Kill Boss] Sonic_Shard invocado para posição: " .. tostring(targetPosition))
    end)
    return true
end

-- =============================================
-- LÓGICA DE ALVO E TELEPORTE
-- =============================================
local function getLocalCharacter()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return char, root
end

local function getBossPart(bossName, partName)
    local enemys = Workspace:FindFirstChild("Enemys")
    if not enemys then
        print("[Kill Boss] Pasta Enemys não encontrada!")
        return nil
    end
    local bossFolder = enemys:FindFirstChild(bossName)
    if not bossFolder then
        print("[Kill Boss] Boss " .. bossName .. " não encontrado!")
        return nil
    end
    local char = bossFolder:FindFirstChild("Character")
    if not char then
        print("[Kill Boss] Character de " .. bossName .. " não encontrado!")
        return nil
    end
    local part = char:FindFirstChild(partName)
    if part and part:IsA("BasePart") then
        print("[Kill Boss] Parte " .. partName .. " encontrada para " .. bossName)
        return part
    end
    part = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if part and part:IsA("BasePart") then
        print("[Kill Boss] Usando parte alternativa para " .. bossName)
        return part
    end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("BasePart") then
            print("[Kill Boss] Usando parte genérica (" .. child.Name .. ") para " .. bossName)
            return child
        end
    end
    print("[Kill Boss] Nenhuma BasePart encontrada para " .. bossName)
    return nil
end

local function getActiveBossTarget()
    if Config.Bivalvan then
        local part = getBossPart("Bivalvan", "Ominitrix_Symbol")
        if part then return part end
    end
    if Config.Galapagus then
        local part = getBossPart("Galapagus", "Ominitrix_Symbol")
        if part then return part end
    end
    if Config.Pandor then
        local part = getBossPart("P'Andor", "Ominitrix_Symbol")
        if part then return part end
    end
    if Config.Andreas then
        local part = getBossPart("Andreas", "Ominitrix_Symbol")
        if part then return part end
    end
    return nil
end

-- =============================================
-- LOOP KILL BOSS
-- =============================================
local killBossRunning = false
local killBossConnection = nil

local function startKillBossLoop()
    if killBossConnection then return end
    killBossRunning = true
    killBossConnection = RunService.Heartbeat:Connect(function()
        if not (Config.Bivalvan or Config.Galapagus or Config.Pandor or Config.Andreas) then
            killBossRunning = false
            if killBossConnection then
                killBossConnection:Disconnect()
                killBossConnection = nil
            end
            return
        end

        local targetPart = getActiveBossTarget()
        if not targetPart then
            if not killBossConnection._lastPrint or tick() - killBossConnection._lastPrint > 5 then
                print("[Kill Boss] Nenhum boss alvo encontrado.")
                killBossConnection._lastPrint = tick()
            end
            return
        end

        local _, myRoot = getLocalCharacter()
        if not myRoot then return end

        myRoot.CFrame = targetPart.CFrame * CFrame.new(0, Config.Distancia, 0)

        local multiplier = math.floor(tonumber(Config.Multiplicador) or 1)
        if multiplier < 1 then multiplier = 1 end

        for i = 1, multiplier do
            if not (Config.Bivalvan or Config.Galapagus or Config.Pandor or Config.Andreas) then break end
            if Config.ModoTiro then
                LaserAttack()
                GunArm()
                ArmFire(targetPart)
                Armature()
            else
                SonicAttack(targetPart)
            end
            task.wait(0.05)
        end
    end)
end

if Config.Bivalvan or Config.Galapagus or Config.Pandor or Config.Andreas then
    task.spawn(startKillBossLoop)
end

