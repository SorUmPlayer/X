-- =====================================================
-- Menu Verde com Tradução + Música + Cópia de Link
-- =====================================================

local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "MenuTraducao"
gui.Parent = player.PlayerGui

-- Frame principal (verde)
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 450, 0, 380)  -- Aumentei a altura para caber o aviso
frame.Position = UDim2.new(0.5, -225, 0.5, -190)
frame.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
frame.BorderSizePixel = 0
frame.Parent = gui

-- Título / Mensagem (a que será traduzida)
local mensagem = Instance.new("TextLabel")
mensagem.Size = UDim2.new(1, -20, 0, 50)
mensagem.Position = UDim2.new(0, 10, 0, 10)
mensagem.BackgroundTransparency = 1
mensagem.Text = "Bem-vindo ao Menu! Escolha seu idioma."
mensagem.TextColor3 = Color3.new(1, 1, 1)
mensagem.TextScaled = true
mensagem.Font = Enum.Font.SourceSansBold
mensagem.Parent = frame

-- Dicionário de traduções
local traducoes = {
    Portugues = "Bem-vindo ao Menu! Escolha seu idioma.",
    English = "Welcome to the Menu! Choose your language.",
    Espanhol = "¡Bienvenido al Menú! Elige tu idioma."
}

-- Função para criar botões
local function criarBotao(texto, cor, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 40)
    btn.Position = UDim2.new(0.5, -100, 0, posY)
    btn.BackgroundColor3 = cor
    btn.Text = texto
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = frame
    return btn
end

-- Botões
local btnPt = criarBotao("Português", Color3.fromRGB(0, 180, 0), 80)
local btnEn = criarBotao("English", Color3.fromRGB(0, 100, 255), 140)
local btnEs = criarBotao("Espanhol", Color3.fromRGB(255, 140, 0), 200)

-- Eventos de clique para traduzir
btnPt.MouseButton1Click:Connect(function()
    mensagem.Text = traducoes.Portugues
end)
btnEn.MouseButton1Click:Connect(function()
    mensagem.Text = traducoes.English
end)
btnEs.MouseButton1Click:Connect(function()
    mensagem.Text = traducoes.Espanhol
end)

-- ========== AVISO (agora com tamanho maior e visível) ==========
local aviso = Instance.new("TextLabel")
aviso.Size = UDim2.new(1, -20, 0, 80)          -- Altura 80 para caber 3 linhas
aviso.Position = UDim2.new(0, 10, 0, 270)      -- Posicionado abaixo dos botões
aviso.BackgroundTransparency = 1
aviso.Text = "Script foi Atualizando....\nPor Favo Entre no Canal Pegue Novo Script...\nLink foi copiado Automaticamente....."
aviso.TextColor3 = Color3.new(1, 1, 0)         -- Amarelo
aviso.TextScaled = true
aviso.Font = Enum.Font.SourceSans
aviso.TextWrapped = true                       -- Quebra linha automaticamente
aviso.Visible = false                          -- Começa oculto, será mostrado após copiar
aviso.Parent = frame

-- ========== COPIAR LINK PARA ÁREA DE TRANSFERÊNCIA ==========
local link = "https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp"
local sucesso, erro = pcall(function()
    game:GetService("UserInputService"):SetClipboard(link)
end)

if sucesso then
    aviso.Visible = true
else
    warn("Erro ao copiar link: " .. tostring(erro))
    -- Exibe o link manualmente caso a cópia falhe
    aviso.Text = "Link: " .. link .. "\nCopie manualmente."
    aviso.Visible = true
end

-- ========== MÚSICA ==========
-- Toca ao abrir o menu (ID fornecido)
local som = Instance.new("Sound")
som.SoundId = "rbxassetid://74575218169013"   -- ID da música
som.Volume = 0.5
som.Looped = false
som.Parent = gui                              -- Coloca no GUI para tocar localmente
som:Play()

