local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local npcTable = {}          -- tabela com todos os NPCs escaneados
local selectedNPC = nil      -- NPC atualmente selecionado (objeto)
local highlightInstance = nil
local uiVisible = true

-- ============================================================
-- FUNÇÕES AUXILIARES
-- ============================================================

-- Obtém caminho completo (ex: "Workspace.Enemy.Boss")
local function getPath(obj)
    return workspace:GetFullName(obj):gsub(" ", ".")
end

-- Copia para área de transferência
local function copyToClipboard(text)
    pcall(function()
        if setclipboard then setclipboard(text)
        elseif Clipboard then Clipboard:SetAsync(text)
        end
    end)
end

-- ============================================================
-- ESCANEAMENTO DE NPCs
-- ============================================================

function scanNPCs()
    npcTable = {}
    local npcList = {}  -- para popular dropdowns

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local humanoid = obj.Humanoid
            if humanoid.Health > 0 then
                local path = getPath(obj)
                local healthPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
                npcTable[path] = {
                    npc = obj,
                    name = obj.Name,
                    path = path,
                    health = healthPercent
                }
                table.insert(npcList, {
                    path = path,
                    display = obj.Name .. " (HP: " .. healthPercent .. "%)"
                })
            end
        end
    end

    -- Atualiza os dropdowns (se existirem)
    updateDropdowns(npcList)
    return #npcList
end

-- ============================================================
-- ATUALIZA OS DROPDOWNS
-- ============================================================

function updateDropdowns(npcList)
    local configItems = {}
    local pastaItems = {}
    for _, info in ipairs(npcList) do
        table.insert(configItems, info.display)
        table.insert(pastaItems, info.path)
    end

    -- Atualiza dropdown da aba Config
    if configDropdown then
        configDropdown:SetItems(configItems)
        if #configItems > 0 then
            configDropdown:SetSelectedIndex(1)
        end
    end

    -- Atualiza dropdown da aba Pasta
    if pastaDropdown then
        pastaDropdown:SetItems(pastaItems)
        if #pastaItems > 0 then
            pastaDropdown:SetSelectedIndex(1)
        end
    end
end

-- ============================================================
-- DESTAQUE DO NPC (CHAMS VERDE)
-- ============================================================

function highlightNPC(npc)
    if highlightInstance then
        highlightInstance:Destroy()
        highlightInstance = nil
    end
    if npc and npc:FindFirstChild("HumanoidRootPart") then
        highlightInstance = Instance.new("Highlight")
        highlightInstance.FillColor = Color3.new(0, 1, 0)
        highlightInstance.FillTransparency = 0.5
        highlightInstance.OutlineColor = Color3.new(0, 1, 0)
        highlightInstance.OutlineTransparency = 0.2
        highlightInstance.Adornee = npc
        highlightInstance.Parent = npc
        return true
    end
    return false
end

-- ============================================================
-- SELECIONA NPC POR CAMINHO
-- ============================================================

function selectNPCByPath(path)
    local data = npcTable[path]
    if data then
        selectedNPC = data.npc
        highlightNPC(selectedNPC)
        return true
    end
    return false
end

-- ============================================================
-- TELEPORTE PARA NPC POR NOME
-- ============================================================

function teleportToNPC(npcName)
    for path, data in pairs(npcTable) do
        if data.name:lower() == npcName:lower() then
            local target = data.npc
            if target and target:FindFirstChild("HumanoidRootPart") then
                local pos = target.HumanoidRootPart.Position
                if humanoidRootPart then
                    humanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                    return true
                end
            end
        end
    end
    return false
end

