-- =====================================================
--  FUNÇÃO SEGURA DE PARENT
-- =====================================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

-- =====================================================
--  DETECÇÃO DA BOLA
-- =====================================================
local function getBall()
    -- Bola solta
    local terrain = Workspace:FindFirstChild("Terrain")
    if terrain then
        local ball = terrain:FindFirstChild("Ball")
        if ball and ball:IsA("BasePart") then return ball end
    end
    -- Bola em posse
    local characters = Workspace:FindFirstChild("characters")
    if characters then
        for _, charModel in ipairs(characters:GetChildren()) do
            if charModel:IsA("Model") then
                local ball = charModel:FindFirstChild("Ball")
                if ball and ball:IsA("BasePart") then return ball end
            end
        end
    end
    -- Fallback
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Ball" then return obj end
    end
    return nil
end

local function getHitbox()
    return getBall()
end

local function isBallFree()
    local terrain = Workspace:FindFirstChild("Terrain")
    if terrain then
        local ball = terrain:FindFirstChild("Ball")
        if ball and ball:IsA("BasePart") then return true end
    end
    return false
end

local function euTenhoBola()
    local characters = Workspace:FindFirstChild("characters")
    if characters then
        local myChar = characters:FindFirstChild(player.Name)
        if myChar and myChar:FindFirstChild("Ball") then return true end
    end
    return false
end

