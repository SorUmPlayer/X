local function BuildJoystick(position, labelText, name)
    -- Frame Base (Fundo do Analógico)
    local OuterFrame = Instance.new("Frame")
    OuterFrame.Name = name
    OuterFrame.Size = UDim2.new(0, 140, 0, 140)
    OuterFrame.Position = position
    OuterFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    OuterFrame.BackgroundTransparency = 0.3
    OuterFrame.BorderSizePixel = 2
    OuterFrame.BorderColor3 = Color3.fromRGB(0, 170, 255)
    OuterFrame.Active = true
    OuterFrame.ZIndex = 1000
    OuterFrame.Parent = ScreenGui

    local OuterCorner = Instance.new("UICorner")
    OuterCorner.CornerRadius = UDim.new(1, 0)
    OuterCorner.Parent = OuterFrame

    -- Texto Indicador da Mão
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Name = "TitleLabel"
    TitleLabel.Size = UDim2.new(1, 0, 0, 25)
    TitleLabel.Position = UDim2.new(0, 0, 0, -32)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = labelText
    TitleLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
    TitleLabel.TextSize = 14
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.ZIndex = 1001
    TitleLabel.Parent = OuterFrame

    -- Knob (Pino Central do Analógico)
    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.Size = UDim2.new(0, 50, 0, 50)
    Knob.Position = UDim2.new(0.5, -25, 0.5, -25)
    Knob.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 1002
    Knob.Parent = OuterFrame

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    -- Lógica de Arraste (Suporta Mouse e Touch Screen)
    local Dragging = false
    local OutputVector = Vector2.new(0, 0)

    local function ProcessDrag(input)
        local Center = OuterFrame.AbsolutePosition + (OuterFrame.AbsoluteSize / 2)
        local InputPos = Vector2.new(input.Position.X, input.Position.Y)
        local Delta = InputPos - Center
        local Radius = OuterFrame.AbsoluteSize.X / 2
        local Distance = math.min(Delta.Magnitude, Radius)

        if Delta.Magnitude > 0 then
            Delta = Delta.Unit * Distance
        end

        Knob.Position = UDim2.new(0.5, Delta.X - 25, 0.5, Delta.Y - 25)
        OutputVector = Delta / Radius
    end

    OuterFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            ProcessDrag(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            ProcessDrag(input)
        end
    end)

    local function ResetJoystick(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
            Knob.Position = UDim2.new(0.5, -25, 0.5, -25)
            OutputVector = Vector2.new(0, 0)
        end
    end

    UserInputService.InputEnded:Connect(ResetJoystick)

    return function() return OutputVector end
end

-- Instanciando o Analógico Esquerdo e Direito
