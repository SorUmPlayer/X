-- Carregamento seguro da WindUI (URL oficial atualizada)
local success, WindUI = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
end)

if not success or not WindUI then
    warn("[ERRO] Não foi possível carregar a WindUI. Verifique o console (F9).")
    return
end

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Configurações do Ciclo
local selectedEgg = ""
local tpSpeed = 150
local returnCFrame = CFrame.new(509, 71, -372)
local isRunning = false

-- Função para listar os ovos da pasta
local function getEggList()
    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    local list = {}
    if area then
        for _, child in ipairs(area:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    if #list == 0 then
        table.insert(list, "Nenhum ovo encontrado")
    end
    return list
end

-- Função de TweenTeleport com Noclip
local function tweenTo(targetCFrame)
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / math.max(tpSpeed, 1)

    -- Ativa Noclip durante o trajeto
    local noclipConn = RunService.Stepped:Connect(function()
        if player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    noclipConn:Disconnect()
end

-- Função de Ativação do ProximityPrompt
local function triggerPrompt(targetObj)
    task.wait(0.2)
    local prompt = targetObj:FindFirstChildOfClass("ProximityPrompt", true)
    
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end
    end
end

-- Ciclo Principal: TP -> Coletar -> Retornar
local function startCycle()
    if isRunning then 
        WindUI:Notify({ Title = "Aviso", Content = "Ciclo já em andamento!", Duration = 2 })
        return 
    end

    if selectedEgg == "" or selectedEgg == "Nenhum ovo encontrado" then
        WindUI:Notify({ Title = "Erro", Content = "Selecione um ovo no Dropdown!", Duration = 3 })
        return
    end

    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    local eggTarget = area and area:FindFirstChild(selectedEgg)

    if not eggTarget then
        WindUI:Notify({ Title = "Erro", Content = "Ovo selecionado não existe no Workspace!", Duration = 3 })
        return
    end

    isRunning = true

    -- Posição Alvo
    local targetCFrame = eggTarget:IsA("Model") and eggTarget:GetPivot() or eggTarget.CFrame

    if targetCFrame then
        -- 1. Tween até o Ovo
        WindUI:Notify({ Title = "Teleporte", Content = "Indo até o ovo...", Duration = 2 })
        tweenTo(targetCFrame)

        -- 2. Ativar ProximityPrompt
        WindUI:Notify({ Title = "Coletor", Content = "Coletando ovo...", Duration = 2 })
        triggerPrompt(eggTarget)
        task.wait(0.5)

        -- 3. Tween de Volta
        WindUI:Notify({ Title = "Retorno", Content = "Voltando para (509, 71, -372)...", Duration = 2 })
        tweenTo(returnCFrame)

        WindUI:Notify({ Title = "Sucesso", Content = "Ciclo Concluído!", Duration = 3 })
    end

    isRunning = false
end

