-- Função para obter o caminho completo de um objeto
local function getFullPath(obj)
    local path = obj.Name
    local parent = obj.Parent
    while parent and parent ~= workspace do
        path = parent.Name .. "." .. path
        parent = parent.Parent
    end
    if parent == workspace then
        path = "workspace." .. path
    end
    return path
end

-- Função para escanear NPCs próximos
local function scanNPCs()
    npcList = {}
    local player = game.Players.LocalPlayer
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        warn("Personagem não encontrado.")
        return
    end
    local playerPos = player.Character.HumanoidRootPart.Position
    local range = 100  -- distância máxima para considerar "próximo"

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local humanoid = obj.Humanoid
            local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if rootPart then
                local dist = (playerPos - rootPart.Position).Magnitude
                if dist <= range then
                    table.insert(npcList, {
                        Object = obj,
                        Name = obj.Name,
                        Path = getFullPath(obj),
                        Health = humanoid.Health,
                        MaxHealth = humanoid.MaxHealth
                    })
                end
            end
        end
    end

    -- Ordenar por distância (opcional)
    table.sort(npcList, function(a, b)
        local distA = (playerPos - (a.Object:FindFirstChild("HumanoidRootPart") and a.Object.HumanoidRootPart.Position or a.Object.PrimaryPart.Position)).Magnitude
        local distB = (playerPos - (b.Object:FindFirstChild("HumanoidRootPart") and b.Object.HumanoidRootPart.Position or b.Object.PrimaryPart.Position)).Magnitude
        return distA < distB
    end)

    return npcList
end

-- Função para atualizar os dropdowns com a lista de NPCs
local function updateDropdowns()
    -- Construir lista de strings para o dropdown Config (com saúde)
    local configValues = {}
    local configDisplayMap = {}  -- mapeia string -> NPC data
    for _, npc in ipairs(npcList) do
        local healthStr = string.format("%.0f/%.0f", npc.Health, npc.MaxHealth)
        local display = string.format("%s - Health: %s", npc.Name, healthStr)
        table.insert(configValues, display)
        configDisplayMap[display] = npc
    end

    -- Atualizar dropdown Config
    if dropdownConfig then
        dropdownConfig:SetValues(configValues)
        dropdownConfig:SetValue("")  -- limpar seleção
    end

    -- Construir lista para o dropdown Pasta (apenas nomes)
    local pastaValues = {}
    local pastaDisplayMap = {}
    for _, npc in ipairs(npcList) do
        local display = npc.Name
        table.insert(pastaValues, display)
        pastaDisplayMap[display] = npc
    end

    -- Atualizar dropdown Pasta
    if dropdownPasta then
        dropdownPasta:SetValues(pastaValues)
        dropdownPasta:SetValue("")
    end

    -- Armazenar os maps para uso nos callbacks
    _G.configDisplayMap = configDisplayMap
    _G.pastaDisplayMap = pastaDisplayMap
end

-- Função para aplicar highlight (chams verde) em um NPC
local function applyHighlight(npc)
    -- Remover highlight anterior
    if highlightObj then
        highlightObj:Destroy()
        highlightObj = nil
    end

    if not npc then return end

    -- Criar novo Highlight
    highlightObj = Instance.new("Highlight")
    highlightObj.Adornee = npc.Object
    highlightObj.FillColor = Color3.fromRGB(0, 255, 0)  -- verde
    highlightObj.FillTransparency = 0.5
    highlightObj.OutlineColor = Color3.fromRGB(0, 255, 0)
    highlightObj.OutlineTransparency = 0
    highlightObj.Parent = npc.Object
end

