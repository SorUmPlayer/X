local function onChatMessage(msg)
    local lower = msg:lower()
    if lower:match("^força da bola") then
        local num = msg:match("^força da bola (%d+)")
        if num then
            local val = tonumber(num)
            if val and val > 0 and val <= 200 then
                forcaBolaVelocidade = val
                Config.forcaBolaVelocidade = val
                pcall(SaveConfig)
                player:Chat("Força da bola: " .. val)
            else player:Chat("Use 1-200.") end
        else player:Chat("Use: Força da bola [número]") end
    end
end

