local function LoadConfig()
    if not isfile then return {} end
    if isfile(CONFIG_FILE) then
        local s, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if s and type(d) == "table" then return d end
    end
    return {}
end
local function SaveConfigToFile(t)
    if not writefile then return end
    local s, j = pcall(function() return HttpService:JSONEncode(t) end)
    if s then pcall(function() writefile(CONFIG_FILE, j) end) end
end
