-- =============================================
-- AIMBOT CÂMERA
-- =============================================
local function shouldAimbotWork()
    if euTenhoBola() then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelay
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        end
        return false
    end
    return true
end

local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if not shouldAimbotWork() then return end

    local ball = getBall()
    if not ball then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = ball.Position
    local posJogador = hrp.Position
    local dir = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = posJogador - dir * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, posJogador)
end

