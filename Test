local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    if not bola or not bolaValida then return end

    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then
            dir = Vector3.new(1, 0, 0)
        else
            dir = dir.Unit
        end
        local vel = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
        bola.AssemblyLinearVelocity = vel
    end
    tinhaBola = tenho
end

-- ===== CURVAS ATUALIZADAS =====
local function aplicarCurvas()
    if not curvasEnabled then return end
    if not bola or not bolaValida then return end
    if euTenhoBola() then return end

    local vel = bola.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed < 40 then return end
    if bola.Position.Y < 0.5 then return end

    local dirAtual = Vector3.new(vel.X, 0, vel.Z)
    if dirAtual.Magnitude < 0.01 then return end
    dirAtual = dirAtual.Unit

    local perp = Vector3.new(-dirAtual.Z, 0, dirAtual.X)
    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1

    -- Verifica se o modo de controle está ativo e a velocidade >= 50
    if controleCurvasAtivo and speed >= 50 then
        -- Direção da câmera (horizontal)
        local camDir = camera.CFrame.LookVector
        camDir = Vector3.new(camDir.X, 0, camDir.Z)
        if camDir.Magnitude < 0.001 then
            camDir = Vector3.new(1, 0, 0)
        else
            camDir = camDir.Unit
        end

        -- Determina se a bola deve curvar para a esquerda ou direita em direção à câmera
        -- Calcula o ângulo entre a direção atual e a direção da câmera
        local cross = dirAtual.X * camDir.Z - dirAtual.Z * camDir.X
        local dot = dirAtual.X * camDir.X + dirAtual.Z * camDir.Z
        local angle = math.atan2(cross, dot)

        -- Se o ângulo for positivo, curva para a esquerda; se negativo, para a direita
        if angle > 0.05 then
            lado = -1  -- vira para a esquerda (em relação à direção atual)
        elseif angle < -0.05 then
            lado = 1   -- vira para a direita
        else
            lado = 0   -- já está alinhado, não curva
        end

        -- Aplica a força lateral com intensidade proporcional ao ângulo (mas limitada)
        if lado ~= 0 then
            local forcaControle = math.min(math.abs(angle) * 3, fator) -- intensidade adaptativa
            local forcaLateral = perp * lado * forcaControle
            bola.AssemblyLinearVelocity = vel + forcaLateral
        end
    else
        -- Modo normal (direita/esquerda/aleatório)
        if curvasModo == 1 then
            lado = 1
        elseif curvasModo == 2 then
            lado = -1
        elseif curvasModo == 3 then
            local now = tick()
            if now - curvasTimer > curvasIntervalo then
                curvasTimer = now
                curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
                curvasIntervalo = 0.5 + math.random() * 0.5
            end
            lado = curvasDirecaoAtual
        end

        local forcaLateral = perp * lado * fator
        bola.AssemblyLinearVelocity = vel + forcaLateral
    end
end

