-- Random part names (anti-detecção)
local function randName()
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local s = ""
    for i = 1, 8 do
        local idx = math.random(1, #chars)
        s = s .. chars:sub(idx, idx)
    end
    return s
end

-- =============================================
-- AIMBOT CÂMERA
-- =============================================
local function shouldAimbotWork()
    if euTenhoBola() then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelay
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        end
        return false
    end
    return true
end

local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if not shouldAimbotWork() then return end

    local ball = getBall()
    if not ball then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = ball.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = posJogador - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, posJogador)
end

-- =============================================
-- VISÃO DE JOGO – ADVINHA A BOLA (amarela)
-- =============================================
-- Retorna pontos da trajetória (usado só quando recalculado)
local function calcularTrajetoria(ball)
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then return nil end

    local gravidade = Vector3.new(0, -50, 0)
    local pos = ball.Position
    local v = vel
    local dt = 0.1
    local chaoY = 0
    local pontos = {pos}

    for i = 1, 100 do
        v = v + gravidade * dt
        pos = pos + v * dt
        pontos[#pontos + 1] = pos
        if pos.Y <= chaoY then break end
    end

    return pontos, v
end

local function atualizarAdvinhaBola()
    if not visaoBolaEnabled then
        if linhaTrajetoria then linhaTrajetoria:Destroy() linhaTrajetoria = nil end
        if circuloImpacto then circuloImpacto:Destroy() circuloImpacto = nil end
        return
    end

    local ball = getBall()
    if not ball then
        if linhaTrajetoria then linhaTrajetoria:Destroy() linhaTrajetoria = nil end
        if circuloImpacto then circuloImpacto:Destroy() circuloImpacto = nil end
        return
    end

    local pontos, vFinal = calcularTrajetoria(ball)
    if not pontos or #pontos < 2 then
        if linhaTrajetoria then linhaTrajetoria:Destroy() linhaTrajetoria = nil end
        if circuloImpacto then circuloImpacto:Destroy() circuloImpacto = nil end
        return
    end

    local inicio = pontos[1]
    local fim = pontos[#pontos]
    fim = Vector3.new(fim.X, 0, fim.Z)

    local meio = (inicio + fim) / 2
    local distancia = (inicio - fim).Magnitude

    if not linhaTrajetoria or not linhaTrajetoria.Parent then
        if linhaTrajetoria then linhaTrajetoria:Destroy() end
        linhaTrajetoria = Instance.new("Part")
        linhaTrajetoria.Name = randName()
        linhaTrajetoria.Anchored = true
        linhaTrajetoria.CanCollide = false
        linhaTrajetoria.CanTouch = false
        linhaTrajetoria.CanQuery = false
        linhaTrajetoria.CastShadow = false
        linhaTrajetoria.Transparency = 0.3
        linhaTrajetoria.Color = Color3.fromRGB(255, 255, 0)
        linhaTrajetoria.Material = Enum.Material.Neon
        linhaTrajetoria.Parent = CameraFolder -- client-only
    end

    if distancia > 0.1 then
        linhaTrajetoria.Size = Vector3.new(0.4, 0.4, distancia)
        linhaTrajetoria.CFrame = CFrame.lookAt(meio, fim)
        linhaTrajetoria.Transparency = 0.3
    else
        linhaTrajetoria.Transparency = 1
    end

    if vFinal and vFinal.Y < -0.5 then
        if not circuloImpacto or not circuloImpacto.Parent then
            if circuloImpacto then circuloImpacto:Destroy() end
            circuloImpacto = Instance.new("Part")
            circuloImpacto.Name = randName()
            circuloImpacto.Anchored = true
            circuloImpacto.CanCollide = false
            circuloImpacto.CanTouch = false
            circuloImpacto.CanQuery = false
            circuloImpacto.CastShadow = false
            circuloImpacto.Transparency = 0.3
            circuloImpacto.Color = Color3.fromRGB(255, 255, 0)
            circuloImpacto.Material = Enum.Material.Neon
            circuloImpacto.Shape = Enum.PartType.Cylinder
            circuloImpacto.Parent = CameraFolder
        end
        circuloImpacto.Position = fim
        local tamanho = math.clamp(ball.AssemblyLinearVelocity.Magnitude / 10, 3, 6)
        circuloImpacto.Size = Vector3.new(tamanho, 0.1, tamanho)
        circuloImpacto.Transparency = 0.3
    else
        if circuloImpacto then circuloImpacto:Destroy() circuloImpacto = nil end
    end
end

-- =============================================
-- VISÃO DE JOGO – ADVINHE CHUTE (verde)
-- =============================================
local function getJogadorComBola()
    local ball = getBall()
    if not ball then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - ball.Position).Magnitude < 3 then
                    return plr
                end
            end
        end
    end
    return nil
end

local function atualizarAdvinheChute()
    if not visaoChuteEnabled then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local jogador = getJogadorComBola()
    if not jogador then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local char = jogador.Character
    if not char then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp
    if not origem then
        if linhaOlhar then linhaOlhar:Destroy() linhaOlhar = nil end
        return
    end

    local posInicio = origem.Position
    if origem == hrp then
        posInicio = posInicio + Vector3.new(0, 1.5, 0)
    end

    local direcao = Vector3.new(1, 0, 0)
    if head then
        direcao = head.CFrame.LookVector
    elseif hrp then
        direcao = hrp.CFrame.LookVector
    end
    direcao = Vector3.new(direcao.X, 0, direcao.Z)
    if direcao.Magnitude < 0.001 then
        direcao = Vector3.new(1, 0, 0)
    else
        direcao = direcao.Unit
    end

    local posFim = posInicio + direcao * 80

    if not linhaOlhar or not linhaOlhar.Parent then
        if linhaOlhar then linhaOlhar:Destroy() end
        linhaOlhar = Instance.new("Part")
        linhaOlhar.Name = randName()
        linhaOlhar.Anchored = true
        linhaOlhar.CanCollide = false
        linhaOlhar.CanTouch = false
        linhaOlhar.CanQuery = false
        linhaOlhar.CastShadow = false
        linhaOlhar.Transparency = 0.2
        linhaOlhar.Color = Color3.fromRGB(0, 255, 0)
        linhaOlhar.Material = Enum.Material.Neon
        linhaOlhar.Size = Vector3.new(0.5, 0.5, 80)
        linhaOlhar.Parent = CameraFolder
    end

    local meio = (posInicio + posFim) / 2
    local distancia = (posInicio - posFim).Magnitude
    if distancia < 0.1 then distancia = 0.1 end
    linhaOlhar.Size = Vector3.new(0.5, 0.5, distancia)
    linhaOlhar.CFrame = CFrame.lookAt(meio, posFim)
end

