-- LocalScript em StarterGui

local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Parent = player.PlayerGui

local link = "https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp"

-- ======================
--   MENU PRINCIPAL
-- ======================
local menu = Instance.new("Frame")
menu.Size = UDim2.new(0, 450, 0, 380) -- um pouco mais alto para a mensagem extra
menu.Position = UDim2.new(0.5, -225, 0.5, -190)
menu.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
menu.BackgroundTransparency = 0.2
menu.BorderSizePixel = 0
menu.Parent = gui

-- Arrastar
local dragging = false
local dragStart, startPos
menu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = menu.Position
    end
end)
menu.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
menu.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        menu.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                   startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ======================
--   MENSAGEM PRINCIPAL
-- ======================
local mensagem = Instance.new("TextLabel")
mensagem.Size = UDim2.new(0.9, 0, 0.35, 0)
mensagem.Position = UDim2.new(0.05, 0, 0.05, 0)
mensagem.BackgroundTransparency = 1
mensagem.TextScaled = true
mensagem.TextWrapped = true
mensagem.TextColor3 = Color3.fromRGB(255, 255, 255)
mensagem.Font = Enum.Font.GothamBold
mensagem.Text = "Script foi Atualizado....\nPor Favor Entre no Canal Pegue Novo Script...\nClick no Botão abaixo Pra copiar Link....."
mensagem.Parent = menu

-- Traduções
local traducoes = {
    PT = "Script foi Atualizado....\nPor Favor Entre no Canal Pegue Novo Script...\nClick no Botão abaixo Pra copiar Link.....",
    EN = "Script has been updated....\nPlease enter the channel to get the new script...\nClick the button below to copy the link.....",
    ES = "¡El script ha sido actualizado....\nPor favor, entre al canal para obtener el nuevo script...\nHaga clic en el botón de abajo para copiar el enlace....."
}

local function setLanguage(lang)
    mensagem.Text = traducoes[lang]
end

-- ======================
--   BOTÕES DE IDIOMA
-- ======================
local idiomas = {
    { texto = "Português", cor = Color3.fromRGB(0, 200, 0), lang = "PT" },
    { texto = "English", cor = Color3.fromRGB(0, 100, 255), lang = "EN" },
    { texto = "Español", cor = Color3.fromRGB(255, 150, 0), lang = "ES" }
}

local btnY = 0.45
local btnWidth = 0.28
local spacing = 0.03
local startX = (1 - (btnWidth * 3 + spacing * 2)) / 2

for i, dados in ipairs(idiomas) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(btnWidth, 0, 0.15, 0)
    btn.Position = UDim2.new(startX + (btnWidth + spacing) * (i-1), 0, btnY, 0)
    btn.BackgroundColor3 = dados.cor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Text = dados.texto
    btn.Font = Enum.Font.GothamBold
    btn.Parent = menu

    btn.MouseButton1Click:Connect(function()
        setLanguage(dados.lang)
    end)
end

-- ======================
--   BOTÃO "COPIAR LINK"
-- ======================
local copiarBtn = Instance.new("TextButton")
copiarBtn.Size = UDim2.new(0.4, 0, 0.15, 0)
copiarBtn.Position = UDim2.new(0.3, 0, 0.7, 0)
copiarBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 200)
copiarBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
copiarBtn.TextScaled = true
copiarBtn.Text = "Copiar Link"
copiarBtn.Font = Enum.Font.GothamBold
copiarBtn.Parent = menu

-- Label de feedback (aparece abaixo do botão)
local feedback = Instance.new("TextLabel")
feedback.Size = UDim2.new(0.8, 0, 0.1, 0)
feedback.Position = UDim2.new(0.1, 0, 0.87, 0)
feedback.BackgroundTransparency = 1
feedback.TextScaled = true
feedback.TextColor3 = Color3.fromRGB(255, 255, 0)
feedback.Font = Enum.Font.GothamBold
feedback.Text = ""
feedback.Parent = menu

-- Função para copiar com segurança e feedback
local function copiarLink()
    local clipboard = game:GetService("Clipboard")
    local sucesso, erro = pcall(function()
        clipboard:setText(link)
    end)
    
    if sucesso then
        feedback.Text = "✅ Link copiado! Cole onde quiser."
        copiarBtn.Text = "Link copiado!"
        task.wait(2)
        copiarBtn.Text = "Copiar Link"
        task.wait(3)
        feedback.Text = ""
    else
        feedback.Text = "❌ Erro ao copiar. Tente novamente."
        warn("Falha ao copiar: ", erro)
        task.wait(3)
        feedback.Text = ""
    end
end

copiarBtn.MouseButton1Click:Connect(copiarLink)
