    local TabBoss = Window:Tab({ Title = "Kill Boss", Icon = "rbxassetid://135710581431595" })

    -- ====== CONFIGURAÇÃO DO BOSS ======
    TabBoss:Section({ Title = "⚙️ Configuração do Boss" })

