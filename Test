-- =============================================
-- SISTEMA DE AUTO SAVE
-- =============================================
local CONFIG_FILE = "BasketballZero_AutoSave.json"

local function LoadConfig()
    if not isfile then return {} end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            return data
        end
    end
    return {}
end

local function SaveConfigToFile(configTable)
    if not writefile then return end
    local success, json = pcall(function()
        return HttpService:JSONEncode(configTable)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
    end
end

local Config = {
    controleAtivo = false,
    velocidadeBola = 65,
    autoSexta = false,
    timeSelecionado = "Home", -- "Home" ou "Away"
    hitboxAtivo = false,
    hitboxTamanho = 20,
    espHitbox = false,
}
local savedConfig = LoadConfig()
for k, v in pairs(savedConfig) do
    Config[k] = v
end

local function SaveConfig()
    SaveConfigToFile(Config)
end

task.spawn(function()
    while true do
        task.wait(5)
        SaveConfig()
    end
end)

