-- 6. LOOP PRINCIPAL DE FÍSICA E CÂMERA VR
RunService.RenderStepped:Connect(function(dt)
    if not VR_Enabled then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local camera = Workspace.CurrentCamera

    if not hum or not root or not head or not camera then return end

    -- Desativa rotação automática do Roblox em 1ª pessoa
    hum.AutoRotate = false

    -- Trava visão em 1ª pessoa sem forçar o corpo a girar
    if FirstPersonVR then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 0.5
    end

    ---------------------------------------------------------
    -- 1. SISTEMA DE VISÃO VR (CABEÇA E CORPO DESACOPLADOS)
    ---------------------------------------------------------
    local neck = char:FindFirstChild("Neck", true) or (head:FindFirstChild("Neck"))
    if neck then
        local rootCF = root.CFrame
        local camCF = camera.CFrame

        -- Ângulo de rotação da Câmera em relação ao Corpo
        local _, camYaw, _ = camCF:ToOrientation()
        local _, rootYaw, _ = rootCF:ToOrientation()

        local diffYaw = camYaw - rootYaw
        diffYaw = (diffYaw + math.pi) % (2 * math.pi) - math.pi

        local camPitch = math.asin(camCF.LookVector.Y)
        local maxRad = math.rad(MaxHeadAngleDeg)

        -- Se a cabeça virar mais que o limite (60°), o corpo gira junto
        if math.abs(diffYaw) > maxRad then
            local overflow = diffYaw > 0 and (diffYaw - maxRad) or (diffYaw + maxRad)
            local newRootYaw = rootYaw + overflow
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, newRootYaw, 0)
            diffYaw = math.clamp(diffYaw, -maxRad, maxRad)
        end

        -- Aplica rotação independente no pescoço
        neck.Transform = CFrame.Angles(camPitch, diffYaw, 0)
    end

    ---------------------------------------------------------
    -- 2. MOVIMENTAÇÃO E BALANÇO DE CAMINHADA VR
    ---------------------------------------------------------
    if hum.MoveDirection.Magnitude > 0 then
        BobStep = BobStep + (dt * hum.WalkSpeed * 1.3)
        local bobOffset = Vector3.new(
            math.cos(BobStep * 0.5) * 0.12,
            math.abs(math.sin(BobStep)) * 0.18,
            0
        )
        hum.CameraOffset = hum.CameraOffset:Lerp(bobOffset, 0.2)
    else
        hum.CameraOffset = hum.CameraOffset:Lerp(Vector3.new(0, 0, 0), 0.15)
    end

    ---------------------------------------------------------
    -- 3. CONTROLE DOS BRAÇOS (REPLICADO NO SERVIDOR)
    ---------------------------------------------------------
    local leftVec = GetLeftInput()
    local rightVec = GetRightInput()

    local leftShoulder = char:FindFirstChild("Left Shoulder", true) or char:FindFirstChild("LeftShoulder", true)
    local rightShoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)

    local lP, lY, rP, rY

    if ControlMode == "Direto (1:1)" then
        -- Mover analógico eleva/gira a mão diretamente
        lP = -leftVec.Y * math.rad(100)
        lY = -leftVec.X * math.rad(80)

        rP = -rightVec.Y * math.rad(100)
        rY = rightVec.X * math.rad(80)
    else
        -- Modo acumulativo
        LeftArmPitch = math.clamp(LeftArmPitch - (leftVec.Y * 0.03), -math.rad(110), math.rad(110))
        LeftArmYaw   = math.clamp(LeftArmYaw - (leftVec.X * 0.03), -math.rad(90), math.rad(90))

        RightArmPitch = math.clamp(RightArmPitch - (rightVec.Y * 0.03), -math.rad(110), math.rad(110))
        RightArmYaw   = math.clamp(RightArmYaw + (rightVec.X * 0.03), -math.rad(90), math.rad(90))

        lP, lY = LeftArmPitch, LeftArmYaw
        rP, rY = RightArmPitch, RightArmYaw
    end

    if leftShoulder then
        leftShoulder.Transform = CFrame.Angles(lP, lY, 0)
    end
    if rightShoulder then
        rightShoulder.Transform = CFrame.Angles(rP, rY, 0)
    end
end)
