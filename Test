local function atualizarAdvinhaChute()
    if not advinhaChuteEnabled then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    if not bola or not bolaValida then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    local vel = bola.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    local g = Vector3.new(0, -50, 0)
    local pos = bola.Position
    local v = vel
    local dt = 0.02
    local maxP = 500
    local chao = 0
    local pts = {pos}
    for i = 1, maxP do
        v = v + g * dt; pos = pos + v * dt
        table.insert(pts, pos)
        if pos.Y <= chao then break end
    end
    if #pts < 2 then return end
    local posF = pts[#pts]
    posF = Vector3.new(posF.X, chao, posF.Z)
    local ini = pts[1]; local fim = pts[#pts]
    local m = (ini + fim) / 2
    local d = (ini - fim).Magnitude
    criarLinhaChute()
    if d > 0.1 then
        linhaChute.Size = Vector3.new(0.5, 0.5, d)
        linhaChute.CFrame = CFrame.lookAt(m, fim)
        linhaChute.Transparency = 0.2
    else linhaChute.Transparency = 1 end
    if v.Y < -0.5 then
        criarCirculoChute()
        circuloChute.Position = posF
        local t = math.clamp(vel.Magnitude / 8, 3, 8)
        circuloChute.Size = Vector3.new(t, 0.1, t)
        circuloChute.Transparency = 0.2
    else
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
    end
end

