-- SISTEMA DE MÚSICA
-- =============================================
local soundObject = nil
local currentSoundId = nil

local function tocarMusica(id)
    if not id or id == "" then return end
    if soundObject then
        soundObject:Stop()
        soundObject:Destroy()
        soundObject = nil
    end
    soundObject = Instance.new("Sound")
    soundObject.SoundId = "rbxassetid://" .. tostring(id)
    soundObject.Looped = true
    soundObject.Volume = 0.5
    soundObject.Parent = SoundService
    soundObject:Play()
    currentSoundId = id
    print("[Música] Tocando: " .. id)
end

local function pararMusica()
    if soundObject then
        soundObject:Stop()
        soundObject:Destroy()
        soundObject = nil
        currentSoundId = nil
        print("[Música] Parada")
    end
end

