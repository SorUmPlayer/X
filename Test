end

-- =============================================
-- FORÇA DA BOLA
-- =============================================
local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    if not bola or not bolaValida then return end
    local tenho = euTenhoBola()
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        local vel = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
        bola.AssemblyLinearVelocity = vel
    end
    tinhaBola = tenho
end

-- =============================================
-- CURVAS
-- =============================================
local function aplicarCurvas()
    if not curvasEnabled then return end
    if not bola or not bolaValida then return end
    if euTenhoBola() then return end
    local vel = bola.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed < 40 then return end
    if bola.Position.Y < 0.5 then return end
    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1
    if curvasModo == 1 then lado = 1
    elseif curvasModo == 2 then lado = -1
    elseif curvasModo == 3 then
        local now = tick()
        if now - curvasTimer > curvasIntervalo then
            curvasTimer = now
            curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
            curvasIntervalo = 0.5 + math.random() * 0.5
        end
        lado = curvasDirecaoAtual
    end
    bola.AssemblyLinearVelocity = vel + perp * lado * fator
end

-- =============================================
-- TRAZER BOLA (somente bola livre)
-- =============================================
local function aplicarTrazerBola()
    if not trazerBolaAtivo then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if euTenhoBola() then return end

    local ball = getFreeBall()
    if not ball then return end

    local targetPos = hrp.Position + Vector3.new(0, 2, 0)
    local dir = (targetPos - ball.Position)
    local dist = dir.Magnitude
    if dist < 2 then return end

    local speed = math.min(dist * 10, 220)
    ball.AssemblyLinearVelocity = dir.Unit * speed
end

-- =============================================
-- STOP BALL (só para a bola no ar e LIVRE)
-- =============================================
local function aplicarStopBall()
    if not stopBallAtivo then return end
    if euTenhoBola() then return end
    local ball = getFreeBall()
    if not ball then return end
    if ball.Position.Y < 3 then return end
    if ball.AssemblyLinearVelocity.Magnitude < 3 then return end
    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero
end

-- =============================================
-- AUTO GOL
-- =============================================
local function executarAutoGol()
    if not autoGolAtivo then return end
    if autoGolRunning then return end
    if not euTenhoBola() then return end
    autoGolRunning = true
    task.spawn(function()
        local char = player.Character
        if not char then autoGolRunning = false; return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then autoGolRunning = false; return end
        local posOriginal = hrp.Position
        local posGol = autoGolTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)
        hrp.CFrame = CFrame.new(posGol)
        task.wait(0.2)
        local args = { [1] = 110, [4] = posGol }
        local ballService = ReplicatedStorage:FindFirstChild("Packages")
        if ballService then
            ballService = ballService:FindFirstChild("Knit")
            if ballService then
                ballService = ballService:FindFirstChild("Services")
                if ballService then
                    ballService = ballService:FindFirstChild("BallService")
                    if ballService then
                        local shoot = ballService:FindFirstChild("RE")
                        if shoot then shoot:FireServer(unpack(args)) end
                    end
                end
            end
        end
        task.wait(0.2)
        hrp.CFrame = CFrame.new(posOriginal)
        autoGolRunning = false
    end)
end

