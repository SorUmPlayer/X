end
local function Armature()
    if RS and RS.Armature then pcall(function() RS.Armature:InvokeServer() end) end
end

local function ArmFire(targetRoot)
    if not RS or not RS.ArmFire then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local targetPos = targetRoot and targetRoot.Position or (root.Position + Vector3.new(0, -100, 0))
        pcall(function() RS.ArmFire:InvokeServer(targetPos) end)
    end
end

-- =============================================
-- LÓGICA DE ALVO E TELEPORTE
-- =============================================
local function getLocalCharacter()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return char, root
end

local function getClosestNPC()
    local _, myRoot = getLocalCharacter()
    if not myRoot then return nil end
    local enemys = workspace:FindFirstChild("Enemys")
    if not enemys then return nil end

    local closest, bestDist = nil, math.huge
    for _, folder in ipairs(enemys:GetChildren()) do
        local npc = folder:FindFirstChild("Character")
        if npc and npc:IsA("Model") then
            local root = npc:FindFirstChild("HumanoidRootPart")
            local hum = npc:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    closest = root
                end
            end
        end
    end
    return closest
end

local estaTeleportando = false
local function ExecutarTeleporte(cframe)
    if estaTeleportando then return end
    estaTeleportando = true
    pcall(function()
        if LocalPlayer.Character then
            LocalPlayer.Character:PivotTo(cframe)
        end
    end)
    task.wait(0.1)
    estaTeleportando = false
end

local function MudarServidor(ordem)
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. ordem .. "&limit=100"
    local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    if ok and result and result.data then
        for _, s in ipairs(result.data) do
            if type(s) == "table" and s.id ~= game.JobId and s.playing > 0 and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                return
            end
        end
    end
end

-- =============================================
-- LOOP DA RAID (restaurado automaticamente)
-- =============================================
local raidConnection = nil
local function startRaidLoop()
    if raidConnection then return end
    raidConnection = RunService.Heartbeat:Connect(function()
        if not Config.RaidEnabled then
            if raidConnection then
                raidConnection:Disconnect()
                raidConnection = nil
            end
            return
        end
        local _, myRoot = getLocalCharacter()
        local target = getClosestNPC()
        if not myRoot or not target then return end
        myRoot.CFrame = target.CFrame * CFrame.new(0, Config.NpcDistance, 0)
        local mult = math.floor(tonumber(Config.ShotSpeedIndex) or 1)
        for i = 1, mult do
            if not Config.RaidEnabled then break end
            Laser()
            GunArm()
            ArmFire(target)
            Armature()
            task.wait()
        end
    end)
end
if Config.RaidEnabled then task.spawn(startRaidLoop) end

