local MainTab = Window:Tab({ Title = "MAIN", Icon = "rbxassetid://135710581431595" })
local BringSection = MainTab:Section({ Title = "BRING NPCs" })

-- Bring NPC Logic
local bringStates = {}

local function bringNPC(path, stateKey)
    task.spawn(function()
        while bringStates[stateKey] do
            local character = localPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                local target = path()
                if target then
                    local targetRoot = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso") or target.PrimaryPart
                    if targetRoot then
                        targetRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

