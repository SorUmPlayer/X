    local posBola, posJogador = hitbox.Position, hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyroAzure.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

local function atualizarAimbotCameraAzure()
