-- =============================================
-- NO COOLDOWN
-- =============================================
local function getAbilityController()
    local controllers = ReplicatedStorage:FindFirstChild("Controllers")
    if controllers then return controllers:FindFirstChild("AbilityController") end
    return nil
end

local function zerarCooldownsDoModulo(mod)
    if type(mod) ~= "table" then return end
    if mod.legacy then
        for _, key in ipairs({"AbilityOne", "AbilityTwo", "AbilityThree", "AbilityFour"}) do
            if mod.legacy[key] ~= nil then mod.legacy[key] = 0 end
        end
        for k, v in pairs(mod.legacy) do
            if type(v) == "number" and v > 0 then mod.legacy[k] = 0 end
        end
    end
    for _, key in ipairs({"Cooldowns", "cooldowns", "CD", "cd", "Cooldown"}) do
        if type(mod[key]) == "table" then
            for k, _ in pairs(mod[key]) do mod[key][k] = 0 end
        end
    end
    for k, v in pairs(mod) do
        if type(v) == "number" and type(k) == "string" then
            local lk = k:lower()
            if lk:find("cooldown") or lk:find("cd") or lk:find("recharge") or lk:find("reload") then
                mod[k] = 0
            end
        end
    end
end

local function aplicarHooksNoModulo(mod)
    if type(mod) ~= "table" then return end
    for _, fnName in ipairs({
        "AbilityCooldown", "SetCooldown", "StartCooldown", "Cooldown",
        "ApplyCooldown", "StartCooldownTimer", "SetCooldownTimer"
    }) do
        local original = mod[fnName]
        if type(original) == "function" and not noCooldownHooks[fnName] then
            mod[fnName] = function(self, ...)
                local args = {...}
                if type(args[1]) == "number" then args[1] = 0 end
                if type(args[2]) == "number" then args[2] = 0 end
                return original(self, table.unpack(args))
            end
            noCooldownHooks[fnName] = { mod = mod, original = original }
        end
    end
end

local function aplicarNoCooldown()
    local ac = getAbilityController()
    if not ac then return end
    local ok, mod = pcall(require, ac)
    if not ok or type(mod) ~= "table" then return end
    aplicarHooksNoModulo(mod)
    zerarCooldownsDoModulo(mod)
end

local function iniciarLoopNoCooldown()
    if noCooldownLoopActive then return end
    noCooldownLoopActive = true
    task.spawn(function()
        while noCooldownAtivo do
            aplicarNoCooldown()
            task.wait(0.25)
        end
        noCooldownLoopActive = false
    end)
end

local function conectarEventoHabilidade()
    if abilityEventConn then return end
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if not packages then return end
    local knit = packages:FindFirstChild("Knit")
    if not knit then return end
    local services = knit:FindFirstChild("Services")
    if not services then return end
    local abilityService = services:FindFirstChild("AbilityService")
    if not abilityService then return end
    local re = abilityService:FindFirstChild("RE")
    if not re then return end
    local abilityEvent = re:FindFirstChild("Ability")
    if not abilityEvent then return end
    abilityEventConn = abilityEvent.OnClientEvent:Connect(function(...)
        if noCooldownAtivo then
            task.spawn(function()
                task.wait(0.05)
                aplicarNoCooldown()
            end)
        end
    end)
end

local function ativarNoCooldown(estado)
    noCooldownAtivo = estado
    Config.noCooldown = estado
    SaveConfig()
    if estado then
        aplicarNoCooldown()
        iniciarLoopNoCooldown()
        conectarEventoHabilidade()
    else
        for fnName, info in pairs(noCooldownHooks) do
            if info.mod and info.original then info.mod[fnName] = info.original end
        end
        noCooldownHooks = {}
    end
end

