    btn.Text = name
    btn.Font = Enum.Font.GothamBold
    btn.TextScaled = true
    btn.BorderSizePixel = 2
    btn.BorderColor3 = Color3.fromRGB(0, 0, 0)
    btn.Parent = mainFrame
    
    btn.MouseButton1Click:Connect(function()
        updateLanguage(name)
        fallbackTextBox.Visible = false
        browserButton.Visible = false
        copyButton.Position = UDim2.new(0.25, 0, 0.72, 0)
        if not isCopied then
            copyButton.BackgroundColor3 = Color3.fromRGB(128, 128, 128)
            copyButton.Text = translations[name].buttonCopy
            copyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        mainFrame.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
    end)
end

