        btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
        btn.Text = npc.Name
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextSize = 13
        btn.Parent = pastaScroll
        btn.MouseButton1Click:Connect(function()
            local path = "workspace." .. npc:GetFullName():gsub(" ", ".")
            selectedPasta = path
            pastaDropBtn.Text = path
            pastaDropFrame.Visible = false
            -- Highlight também
            for _, h in pairs(workspace:GetDescendants()) do
                if h:IsA("Highlight") and h.Name == "FarmHL" then h:Destroy() end
            end
            local hl = Instance.new("Highlight")
            hl.Name = "FarmHL"
            hl.Adornee = npc
            hl.FillColor = Color3.fromRGB(0,255,0)
            hl.FillTransparency = 0.5
            hl.Parent = npc
        end)
    end
    pastaScroll.CanvasSize = UDim2.new(0,0,0, #npcs * 27)
end

