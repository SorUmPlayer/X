            end
        end
    })

    -- ====== BOSS ======
    TabBoss:Section({ Title = "👾 Boss" })

    TabBoss:Toggle({
        Title = "Bivalvan",
        Desc = "Ativa o farm para Bivalvan",
        Value = Config.Bivalvan,
        Callback = function(value)
            Config.Bivalvan = value
            SaveConfig()
            if value or Config.Galapagus then
                task.spawn(startBossKillLoop)
            else
                if bossKillConnection then
                    bossKillConnection:Disconnect()
                    bossKillConnection = nil
                end
            end
        end
    })

    TabBoss:Toggle({
        Title = "Galapagus",
        Desc = "Ativa o farm para Galapagus",
        Value = Config.Galapagus,
        Callback = function(value)
            Config.Galapagus = value
            SaveConfig()
            if Config.Bivalvan or value then
                task.spawn(startBossKillLoop)
            else
                if bossKillConnection then
                    bossKillConnection:Disconnect()
                    bossKillConnection = nil
                end
