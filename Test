-- CRIANDO AS ABAS E ELEMENTOS
-- ============================================================
-- Aba Farm
local farmTab = Window:CreateTab({ Title = "Farm", Icon = "🌾" })
local teleportCategory = farmTab:CreateCategory({ Title = "Teleporte" })
local npcNameBox = teleportCategory:CreateTextbox({
    Title = "Escreva nome do NPC",
    Placeholder = "Ex: Boss",
    Default = ""
})
teleportCategory:CreateButton({
    Title = "Teleportar",
    Icon = "🚀",
    Callback = function()
        local name = npcNameBox:GetValue()
        if name and name ~= "" then
            if teleportToNPC(name) then
                game:GetService("StarterGui"):SetCore("SendNotification", {Title="Teleporte", Text="Teleportado para "..name, Duration=3})
            else
                game:GetService("StarterGui"):SetCore("SendNotification", {Title="Erro", Text="NPC não encontrado!", Duration=3})
            end
        else
            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Aviso", Text="Digite o nome do NPC!", Duration=3})
        end
    end
})

-- Aba Config
local configTab = Window:CreateTab({ Title = "Config", Icon = "⚙️" })
local configCategory = configTab:CreateCategory({ Title = "Config" })

configCategory:CreateButton({
    Title = "Scannear",
    Icon = "🔍",
    Callback = function()
        local count = scanNPCs()
        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Scan", Text="NPCs: "..count, Duration=3})
    end
})

local configDropdown = configCategory:CreateDropdown({
    Title = "Todos NPC próximo de mim",
    Items = {},
    DefaultIndex = 1,
    Callback = function(item, index)
        for path, data in pairs(npcTable) do
            if (data.name .. " (HP: " .. data.health .. "%)") == item then
                selectNPCByPath(path)
                break
            end
        end
    end
})

configCategory:CreateButton({
    Title = "Copiar apenas nome do NPC",
    Icon = "📋",
    Callback = function()
        if selectedNPC then
            copyToClipboard(selectedNPC.Name)
            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Copiado", Text="Nome: "..selectedNPC.Name, Duration=2})
        else
            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Erro", Text="Nenhum NPC selecionado!", Duration=2})
        end
    end
})

-- Categoria Pasta
local pastaCategory = configTab:CreateCategory({ Title = "Pasta" })
local pastaDropdown = pastaCategory:CreateDropdown({
    Title = "Localização da pasta do NPC",
    Items = {},
    DefaultIndex = 1,
    Callback = function(item, index)
        if selectNPCByPath(item) then
            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Selecionado", Text="NPC destacado em verde!", Duration=2})
        end
    end
})

pastaCategory:CreateButton({
    Title = "Copiar Pasta",
    Icon = "📂",
    Callback = function()
        if selectedNPC then
            local path = ""
            for p, data in pairs(npcTable) do
                if data.npc == selectedNPC then path = p; break end
            end
            if path ~= "" then
                copyToClipboard(path)
                game:GetService("StarterGui"):SetCore("SendNotification", {Title="Copiado", Text="Caminho: "..path, Duration=3})
            else
                game:GetService("StarterGui"):SetCore("SendNotification", {Title="Erro", Text="Caminho não encontrado!", Duration=2})
            end
        else
            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Erro", Text="Nenhum NPC selecionado!", Duration=2})
        end
    end
})

