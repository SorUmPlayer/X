-- =====================================================
--  HITBOX DO PERSONAGEM – FOCADA NOS PÉS
-- =====================================================
local personagemHitboxAtivo = false
local personagemHitboxTamanho = 5
local personagemEspAtivo = false
local personagemOriginalSizes = {} -- guarda tamanhos originais das partes dos pés
local personagemEspCirculo = nil   -- círculo no chão

-- Lista de nomes de partes que são os pés/pernas inferiores
local PE_NAMES = {
    "RightFoot", "LeftFoot",
    "RightLeg", "LeftLeg",
    "Right Lower Leg", "Left Lower Leg",
    "RightUpperLeg", "LeftUpperLeg" -- também incluímos para maior cobertura
}

local function isFootPart(partName)
    for _, name in ipairs(PE_NAMES) do
        if partName == name then return true end
    end
    return false
end

-- Salva apenas os tamanhos originais das partes dos pés
local function salvarTamanhosOriginaisPes(char)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and isFootPart(part.Name) then
            if not personagemOriginalSizes[part] then
                personagemOriginalSizes[part] = part.Size
            end
        end
    end
end

-- Aplica o aumento apenas nos pés
local function aplicarHitboxPersonagem(tamanho)
    local char = player.Character
    if not char then return
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and isFootPart(part.Name) then
            if personagemOriginalSizes[part] then
                -- Aumenta proporcionalmente ao tamanho original
                local escala = tamanho / 1.4 -- base de escala
                part.Size = personagemOriginalSizes[part] * escala
            end
        end
    end
end

-- Restaura apenas as partes dos pés
local function restaurarHitboxPersonagem()
    for part, originalSize in pairs(personagemOriginalSizes) do
        if part and part.Parent then
            part.Size = originalSize
        end
    end
    personagemOriginalSizes = {}
end

-- Ativa/desativa a hitbox dos pés
local function ativarHitboxPersonagem(estado)
    personagemHitboxAtivo = estado
    if estado then
        local char = player.Character
        if char then
            salvarTamanhosOriginaisPes(char)
            aplicarHitboxPersonagem(personagemHitboxTamanho)
        end
    else
        restaurarHitboxPersonagem()
    end
end

-- Atualiza quando o personagem spawna
player.CharacterAdded:Connect(function(char)
    if personagemHitboxAtivo then
        task.wait(0.5)
        salvarTamanhosOriginaisPes(char)
        aplicarHitboxPersonagem(personagemHitboxTamanho)
    end
end)

-- =====================================================
--  ESP DA HITBOX DO PERSONAGEM (CÍRCULO NO CHÃO)
-- =====================================================
local function criarCirculoPersonagem()
    if not personagemEspCirculo then
        personagemEspCirculo = Instance.new("Part")
        personagemEspCirculo.Name = "PersonagemHitboxESP"
        personagemEspCirculo.Anchored = true
        personagemEspCirculo.CanCollide = false
        personagemEspCirculo.Transparency = 0.3
        personagemEspCirculo.Color = Color3.fromRGB(255, 200, 0) -- amarelo
        personagemEspCirculo.Material = Enum.Material.Neon
        personagemEspCirculo.Shape = Enum.PartType.Cylinder
        personagemEspCirculo.Size = Vector3.new(4, 0.1, 4)
        personagemEspCirculo.Parent = Workspace
    end
    return personagemEspCirculo
end

local function atualizarEspPersonagem()
    if not personagemEspAtivo or not personagemHitboxAtivo then
        if personagemEspCirculo then
            personagemEspCirculo:Destroy()
            personagemEspCirculo = nil
        end
        return
    end

    local char = player.Character
    if not char then
        if personagemEspCirculo then
            personagemEspCirculo:Destroy()
            personagemEspCirculo = nil
        end
        return
    end

    -- Usa a posição dos pés (direito ou esquerdo) para centralizar o círculo
    local peDir = char:FindFirstChild("RightFoot") or char:FindFirstChild("RightLeg")
    local peEsq = char:FindFirstChild("LeftFoot") or char:FindFirstChild("LeftLeg")
    local pe = peDir or peEsq
    if not pe then
        -- fallback: usa HumanoidRootPart
        pe = char:FindFirstChild("HumanoidRootPart")
    end
    if not pe then
        if personagemEspCirculo then
            personagemEspCirculo:Destroy()
            personagemEspCirculo = nil
        end
        return
    end

    criarCirculoPersonagem()
    local pos = pe.Position
    pos = Vector3.new(pos.X, 0, pos.Z) -- fixa no chão
    personagemEspCirculo.Position = pos
    local tamanho = personagemHitboxTamanho * 2.5 -- ajuste para diâmetro
    personagemEspCirculo.Size = Vector3.new(tamanho, 0.1, tamanho)
end

