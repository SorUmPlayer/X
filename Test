copiarBtn.Font = Enum.Font.GothamBold
copiarBtn.Parent = menu

-- ======================
--   FUNÇÃO PARA COPIAR E MOSTRAR AVISO
-- ======================
local function copiarLinkEMostrarAviso()
    local clipboard = game:GetService("Clipboard")
    clipboard:setText(link)
    
    -- Cria um aviso temporário dentro do menu
    local avisoMenu = Instance.new("TextLabel")
    avisoMenu.Size = UDim2.new(0.9, 0, 0.2, 0)
    avisoMenu.Position = UDim2.new(0.05, 0, 0.82, 0)
    avisoMenu.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    avisoMenu.BackgroundTransparency = 0.3
    avisoMenu.TextColor3 = Color3.fromRGB(0, 0, 0)
    avisoMenu.TextScaled = true
    avisoMenu.TextWrapped = true
    avisoMenu.Font = Enum.Font.GothamBold
    avisoMenu.Text = "Link copiado!\nEntre no canal para o novo script."
    avisoMenu.Parent = menu
    
    task.wait(4)
    avisoMenu:Destroy()
end

-- Ao clicar no botão, copia e mostra aviso
copiarBtn.MouseButton1Click:Connect(copiarLinkEMostrarAviso)

