local function CreateJoystick(pos, labelText, name)
    local Frame = Instance.new("Frame")
    Frame.Name = name
    Frame.Size = UDim2.new(0, 135, 0, 135)
    Frame.Position = pos -- Posição mais elevada (0.38)
    Frame.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
    Frame.BackgroundTransparency = 0.25
    Frame.BorderSizePixel = 2
    Frame.BorderColor3 = Color3.fromRGB(0, 180, 255)
    Frame.Active = true
    Frame.ZIndex = 1000
    Frame.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 24)
    Label.Position = UDim2.new(0, 0, 0, -28)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(0, 230, 255)
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamBold
    Label.ZIndex = 1001
    Label.Parent = Frame

    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.Size = UDim2.new(0, 48, 0, 48)
    Knob.Position = UDim2.new(0.5, -24, 0.5, -24)
    Knob.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 1002
    Knob.Parent = Frame

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    -- Sistema Isolado de Multi-Touch (Sem interferência cruzada)
    local activeTouch = nil
    local outputVector = Vector2.new(0, 0)

    local function UpdatePos(input)
        local center = Frame.AbsolutePosition + (Frame.AbsoluteSize / 2)
        local inputPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = inputPos - center
        local radius = Frame.AbsoluteSize.X / 2
        local dist = math.min(delta.Magnitude, radius)

        if delta.Magnitude > 0 then
            delta = delta.Unit * dist
        end

        Knob.Position = UDim2.new(0.5, delta.X - 24, 0.5, delta.Y - 24)
        outputVector = delta / radius
    end

    Frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not activeTouch then
            activeTouch = input
            UpdatePos(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == activeTouch then
            UpdatePos(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == activeTouch then
            activeTouch = nil
            Knob.Position = UDim2.new(0.5, -24, 0.5, -24)
            outputVector = Vector2.new(0, 0)
        end
    end)

    return function() return outputVector end
end

