-- --- LÓGICA DE EXECUÇÃO (LOOPS) ---

local function GetPlayerPosition()
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position end
    end
    return nil
end

-- Loop 1: Kill Aura em workspace.NPCs
task.spawn(function()
    while true do
        task.wait(Config.Delay)
        if Config.KillauraEnabled and DamageEvent then
            local playerPos = GetPlayerPosition()
            local npcsFolder = workspace:FindFirstChild("NPCs")

            if playerPos and npcsFolder then
                for _, desc in ipairs(npcsFolder:GetDescendants()) do
                    if not Config.KillauraEnabled then break end
                    if desc:IsA("Humanoid") and desc.Health > 0 then
                        local model = desc.Parent
                        if model and model:IsA("Model") then
                            local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                            local inRange = true
                            if hrp then
                                local dist = (playerPos - hrp.Position).Magnitude
                                if dist > Config.KillauraDistance then
                                    inRange = false
                                end
                            end

                            if inRange then
                                pcall(function()
                                    DamageEvent:FireServer("NPCs", "Damage", desc, Config.KillauraDamage)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

