-- =============================================
-- MENSAGEM DE INÍCIO (para confirmar execução)
-- =============================================
print("[BlueLock] Script iniciado!")

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
print("[BlueLock] Player: " .. player.Name)

-- =============================================
-- SISTEMA DE SAVE SIMPLES
-- =============================================
local CONFIG_FILE = "BlueLockTest.json"
local Config = { toggle = false }

local function SaveConfig()
    if not writefile then 
        print("[BlueLock] writefile não disponível.")
        return 
    end
    local success, json = pcall(function()
        return HttpService:JSONEncode(Config)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
        print("[BlueLock] Config salva.")
    end
end

local function LoadConfig()
    if not isfile then return end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            Config.toggle = data.toggle or false
            print("[BlueLock] Config carregada: toggle=" .. tostring(Config.toggle))
        end
    end
end

LoadConfig()

-- =============================================
-- CRIA UMA INTERFACE SUPER SIMPLES
-- =============================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BlueLockTest"
screenGui.ResetOnSpawn = false

-- Tenta colocar em CoreGui, com fallback para PlayerGui
local success, err = pcall(function()
    if gethui then
        screenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(screenGui)
        screenGui.Parent = CoreGui
    else
        screenGui.Parent = CoreGui
    end
end)

if not success then
    print("[BlueLock] Erro ao colocar no CoreGui: " .. tostring(err))
    screenGui.Parent = player:WaitForChild("PlayerGui")
    print("[BlueLock] Colocado no PlayerGui")
end

-- Cria um Frame simples
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 200)
frame.Position = UDim2.new(0.5, -150, 0.5, -100)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "⚽ Blue Lock Test"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- Toggle
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 100, 0, 40)
toggleBtn.Position = UDim2.new(0.5, -50, 0, 60)
toggleBtn.BackgroundColor3 = Config.toggle and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(200, 50, 50)
toggleBtn.Text = Config.toggle and "ON" or "OFF"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextSize = 16
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.Parent = frame

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 8)
toggleCorner.Parent = toggleBtn

toggleBtn.MouseButton1Click:Connect(function()
    Config.toggle = not Config.toggle
    toggleBtn.BackgroundColor3 = Config.toggle and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(200, 50, 50)
    toggleBtn.Text = Config.toggle and "ON" or "OFF"
    SaveConfig()
    print("[Toggle] Estado: " .. tostring(Config.toggle))
end)

-- Botão de notificação
local notifBtn = Instance.new("TextButton")
notifBtn.Size = UDim2.new(0, 150, 0, 40)
notifBtn.Position = UDim2.new(0.5, -75, 0, 120)
notifBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
notifBtn.Text = "Notificar"
notifBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
notifBtn.TextSize = 16
notifBtn.Font = Enum.Font.GothamBold
notifBtn.Parent = frame

local notifCorner = Instance.new("UICorner")
notifCorner.CornerRadius = UDim.new(0, 8)
notifCorner.Parent = notifBtn

notifBtn.MouseButton1Click:Connect(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Blue Lock",
        Text = "Botão funcionando! Toggle: " .. tostring(Config.toggle),
        Duration = 3
    })
    print("[Notif] Botão clicado")
end)

