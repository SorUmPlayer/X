-- =====================================================
--  INICIALIZAÇÃO DO DRIBLE
-- =====================================================
local function setupDrible()
    if not dribleEvent then
        pcall(function()
            local packages = ReplicatedStorage:FindFirstChild("Packages")
            if packages then
                local knit = packages:FindFirstChild("Knit")
                if knit then
                    local services = knit:FindFirstChild("Services")
                    if services then
                        local ballService = services:FindFirstChild("BallService")
                        if ballService then
                            local re = ballService:FindFirstChild("RE")
                            if re then
                                dribleEvent = re:FindFirstChild("Dribble")
                            end
                        end
                    end
                end
            end
        end)
    end

    if not dribleSphere then
        dribleSphere = Instance.new("Part")
        dribleSphere.Name = "DetectionSphereVisual"
        dribleSphere.Shape = Enum.PartType.Ball
        dribleSphere.Size = Vector3.new(dribleRadius * 2, dribleRadius * 2, dribleRadius * 2)
        dribleSphere.Material = Enum.Material.ForceField
        dribleSphere.Color = Color3.fromRGB(255, 0, 128)
        dribleSphere.Transparency = 0.6
        dribleSphere.CanCollide = false
        dribleSphere.Anchored = false
        dribleSphere.CastShadow = false
        dribleSphere.Parent = workspace
    end
end

local function trackDribleAnimation(character)
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChild("Animator") or humanoid

    local function checkTrack(track)
        if not track or not track.Animation then return end
        local animId = tostring(track.Animation.AnimationId)
        if string.find(animId, dribleAnimId) then
            driblePlayingAnims[character] = true
            local connStopped, connEnded
            connStopped = track.Stopped:Connect(function()
                driblePlayingAnims[character] = nil
                if connStopped then connStopped:Disconnect() end
                if connEnded then connEnded:Disconnect() end
            end)
            connEnded = track.Ended:Connect(function()
                driblePlayingAnims[character] = nil
                if connStopped then connStopped:Disconnect() end
                if connEnded then connEnded:Disconnect() end
            end)
        end
    end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        checkTrack(track)
    end

    animator.AnimationPlayed:Connect(checkTrack)
end

local function setupDriblePlayerTracking(plr)
    if plr == player then return end
    if plr.Character then
        task.spawn(trackDribleAnimation, plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        driblePlayingAnims[char] = nil
        task.spawn(trackDribleAnimation, char)
    end)
end

local function isDribleAnimActive(character)
    if driblePlayingAnims[character] then return true end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    local animator = humanoid:FindFirstChild("Animator") or humanoid
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation and string.find(tostring(track.Animation.AnimationId), dribleAnimId) then
            return true
        end
    end
    return false
end

local function isLookingAtLocal(targetHrp, localHrp)
    local directionToLocal = (localHrp.Position - targetHrp.Position).Unit
    local lookVector = targetHrp.CFrame.LookVector
    return lookVector:Dot(directionToLocal) >= 0.5
end

local function aplicarDrible()
    if not dribleEnabled then
        if dribleSphere then
            dribleSphere.Transparency = 1
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if dribleSphere then
        dribleSphere.Position = hrp.Position
        dribleSphere.Transparency = 0.6
        dribleSphere.Parent = workspace
    end

    local now = tick()
    if now - dribleLastFired < dribleCooldown then return end

    local radius = dribleRadius
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local targetChar = plr.Character
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist <= radius then
                    if isLookingAtLocal(targetHrp, hrp) then
                        if isDribleAnimActive(targetChar) then
                            dribleLastFired = now
                            if dribleEvent then
                                dribleEvent:FireServer("fbc7892b8f694cfd98d7ef93bc018abe", 3)
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end

-- Inicializa o rastreamento de jogadores para o Drible
for _, plr in ipairs(Players:GetPlayers()) do
    setupDriblePlayerTracking(plr)
end
Players.PlayerAdded:Connect(setupDriblePlayerTracking)
Players.PlayerRemoving:Connect(function(plr)
    if plr.Character then
        driblePlayingAnims[plr.Character] = nil
    end
end)

-- =====================================================
--  CONTROLE DA HITBOX DA BOLA (REACH)
-- =====================================================
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

local function aplicarTamanhoHitbox()
    if not hitbox or not bolaValida then
        atualizarReferenciaBola()
        if not hitbox then return end
    end

    local tenho = euTenhoBola()
    local tamanhoDesejado
    local transparenciaDesejada

    if tenho or not reachAtivo then
        tamanhoDesejado = hitboxOriginalSize
        transparenciaDesejada = hitboxOriginalTransparency
    else
        tamanhoDesejado = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        transparenciaDesejada = 1
    end

    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= transparenciaDesejada then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = transparenciaDesejada
    end
end

-- =====================================================
--  HITBOX DO PERSONAGEM (POR SOFTWARE)
-- =====================================================
local function aplicarHitboxPersonagem()
    if not hitboxPersonagemAtivo then return end
    if euTenhoBola() then return end
    if not hitbox or not bolaValida then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - hitbox.Position).Magnitude
    if dist <= hitboxPersonagemTamanho then
        if firetouchinterest then
            firetouchinterest(hrp, hitbox, 0)
            task.wait(0.01)
            firetouchinterest(hrp, hitbox, 1)
        end
    end
end

-- =====================================================
--  FORÇA DA BOLA
-- =====================================================
local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    if not bola or not bolaValida then return end

    local tenho = euTenhoBola()
    
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then
            dir = Vector3.new(1, 0, 0)
        else
            dir = dir.Unit
        end
        
        local vel = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
        bola.AssemblyLinearVelocity = vel
    end
    
    tinhaBola = tenho
end

-- =====================================================
--  CURVAS
-- =====================================================
local function aplicarCurvas()
    if not curvasEnabled then return end
    if not bola or not bolaValida then return end
    if euTenhoBola() then return end

    local vel = bola.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed < 40 then return end
    if bola.Position.Y < 0.5 then return end

    local dir = Vector3.new(vel.X, 0, vel.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit

    local perp = Vector3.new(-dir.Z, 0, dir.X)

    local fator = (curvasIntensidade / 10) * 15 + 1.5
    local lado = 1

    if curvasModo == 1 then
        lado = 1
    elseif curvasModo == 2 then
        lado = -1
    elseif curvasModo == 3 then
        local now = tick()
        if now - curvasTimer > curvasIntervalo then
            curvasTimer = now
            curvasDirecaoAtual = (curvasDirecaoAtual == 1) and -1 or 1
            curvasIntervalo = 0.5 + math.random() * 0.5
        end
        lado = curvasDirecaoAtual
    end

    local forcaLateral = perp * lado * fator
    bola.AssemblyLinearVelocity = vel + forcaLateral
end

