-- Serviço e Config
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MAGNET_RADIUS = 9999
local ARRIVE_OFFSET = Vector3.new(0, 1.5, 0)
local HOLDER_PATH = {"Gameplay", "CurrencyPickup", "CurrencyHolder"}

-- Cria chave global de controle
local toggle = ReplicatedStorage:FindFirstChild("CrownMagnetEnabled")
if not toggle then
    toggle = Instance.new("BoolValue")
    toggle.Name = "CrownMagnetEnabled"
    toggle.Value = false
    toggle.Parent = ReplicatedStorage
end

-- Função util para achar caminho
local function waitPath(root, names)
    local obj = root
    for _, name in ipairs(names) do
        obj = obj:WaitForChild(name)
    end
    return obj
end

-- Player e HRP
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

player.CharacterAdded:Connect(function(char)
    character = char
    hrp = character:WaitForChild("HumanoidRootPart")
end)

local holder = waitPath(workspace, HOLDER_PATH)

-- Controle de puxada
local pulling = {} :: {[Instance]: boolean}

local function getRoot(partOrModel: Instance): BasePart?
    if partOrModel:IsA("BasePart") then
        return partOrModel
    elseif partOrModel:IsA("Model") then
        return partOrModel.PrimaryPart or partOrModel:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function isCrown(inst: Instance): boolean
    return inst.Name == "Crown"
end

-- Teleportar coroa
local function teleportToYou(crownInst: Instance)
    if not hrp or not hrp.Parent then return end
    if pulling[crownInst] then return end

    local root = getRoot(crownInst)
    if not root or not root:IsDescendantOf(workspace) then return end

    pulling[crownInst] = true
    pcall(function() root.Anchored = false end)

    root.CFrame = CFrame.new(hrp.Position + ARRIVE_OFFSET)

    task.delay(0.1, function()
        pulling[crownInst] = nil
    end)
end

-- Puxar coroa
local function tryPull(inst: Instance)
    if not toggle.Value then return end
    if not isCrown(inst) then return end
    local root = getRoot(inst)
    if root and (root.Position - hrp.Position).Magnitude <= MAGNET_RADIUS then
        teleportToYou(inst)
    end
end

-- Eventos (criados uma vez só)
holder.ChildAdded:Connect(function(child)
    task.wait(0.05)
    tryPull(child)
end)

RunService.Heartbeat:Connect(function()
    if not toggle.Value then return end
    for _, crown in ipairs(holder:GetChildren()) do
        if isCrown(crown) and not pulling[crown] then
            local root = getRoot(crown)
            if root and (root.Position - hrp.Position).Magnitude <= MAGNET_RADIUS then
                teleportToYou(crown)
            end
        end
    end
end)

toggle.Changed:Connect(function(val)
    if toggle.Value then
        for _, crown in ipairs(holder:GetChildren()) do
            tryPull(crown)
        end
    end
end)

