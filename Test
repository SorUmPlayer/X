-- Função para criar Inputs
local function CreateInput(name, placeholder, defaultValue, callback)
    local Wrapper = Instance.new("Frame")
    Wrapper.Size = UDim2.new(1, -20, 0, 50)
    Wrapper.BackgroundTransparency = 1
    Wrapper.Parent = ScrollFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 20)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.TextSize = 12
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Wrapper

    local TextBox = Instance.new("TextBox")
    TextBox.Size = UDim2.new(1, 0, 0, 26)
    TextBox.Position = UDim2.new(0, 0, 0, 22)
    TextBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBox.Text = tostring(defaultValue)
    TextBox.PlaceholderText = placeholder
    TextBox.TextSize = 13
    TextBox.Font = Enum.Font.Gotham
    TextBox.ClearTextOnFocus = false
    TextBox.Parent = Wrapper

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 6)
    BoxCorner.Parent = TextBox

    TextBox.FocusLost:Connect(function()
        callback(TextBox.Text)
    end)
end

-- Função para criar Botões de Toggle
local function CreateToggle(name, callback)
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Size = UDim2.new(1, -20, 0, 36)
    ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleButton.Text = name .. ": [DESLIGADO]"
    ToggleButton.TextSize = 13
    ToggleButton.Font = Enum.Font.GothamBold
    ToggleButton.Parent = ScrollFrame

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 6)
    ButtonCorner.Parent = ToggleButton

    local state = false
    ToggleButton.MouseButton1Click:Connect(function()
        state = not state
        if state then
            ToggleButton.Text = name .. ": [LIGADO]"
            ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        else
            ToggleButton.Text = name .. ": [DESLIGADO]"
            ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        end
        callback(state)
    end)
end

