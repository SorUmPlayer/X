                Config.Multiplicador = numero
                SaveConfig()
                print("[Multiplicador] Novo valor: " .. numero)
            else
                StarterGui:SetCore("SendNotification", {
                    Title = "Erro",
                    Text = "Digite um número válido!",
                    Duration = 2
