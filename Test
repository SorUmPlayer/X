local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Configurações Globais
local Settings = {
    Enabled = false,
    Size = 15,
    Transparency = 0.5,
    OriginalSizes = {} -- Guarda o tamanho original para restaurar
}

-- Função de busca dinâmica da bola
local function getBallPart()
    for _, child in ipairs(workspace:GetChildren()) do
        -- Busca por padrão "CLIENT_BALL_" no nome do objeto pai
        if string.find(child.Name, "CLIENT_BALL_") or string.find(child.Name, "BALL") then
            -- Procura por nomes conhecidos ou pela primeira parte física válida
            local target = child:FindFirstChild("BoundingBox") 
                or child:FindFirstChild("Cylinder.006")
                or child:FindFirstChildOfClass("MeshPart") 
                or child:FindFirstChildOfClass("Part")
                
            if target and target:IsA("BasePart") then
                return target
            end
        end
    end
    return nil
end

-- Criar Janela do WindUI
local Window = WindUI:CreateWindow({
    Title = "Hitbox Ball",
    Icon = "target",
    Size = UDim2.fromOffset(380, 240),
    Transparent = true,
    Theme = "Dark"
})

local MainTab = Window:Tab({ Title = "Ajustes", Icon = "sliders" })

-- Toggle Principal
MainTab:Toggle({
    Title = "Ativar Hitbox",
    Default = Settings.Enabled,
    Callback = function(state)
        Settings.Enabled = state
        if not state then
            -- Restaura o tamanho caso desative
            local ball = getBallPart()
            if ball and Settings.OriginalSizes[ball] then
                ball.Size = Settings.OriginalSizes[ball]
            end
        end
    end
})

-- Slider do Tamanho da Hitbox
MainTab:Slider({
    Title = "Tamanho da Bola",
    Min = 2,
    Max = 60,
    Default = Settings.Size,
    Callback = function(value)
        Settings.Size = value
    end
})

-- Slider de Transparência
MainTab:Slider({
    Title = "Transparência",
    Min = 0,
    Max = 1,
    Step = 0.1,
    Default = Settings.Transparency,
    Callback = function(value)
        Settings.Transparency = value
    end
})

-- Loop Principal (Executa de forma leve via Heartbeat)
game:GetService("RunService").Heartbeat:Connect(function()
    if not Settings.Enabled then return end

    local ball = getBallPart()
    if ball then
        -- Salva o tamanho original na primeira vez que encontra
        if not Settings.OriginalSizes[ball] then
            Settings.OriginalSizes[ball] = ball.Size
        end

        -- Aplica os novos valores
        ball.Size = Vector3.new(Settings.Size, Settings.Size, Settings.Size)
        ball.Transparency = Settings.Transparency
        ball.CanCollide = false
    end
end)
