local SliderKnob = Instance.new("Frame")
SliderKnob.Size = UDim2.new(0, 14, 0, 14)
SliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
SliderKnob.Position = UDim2.new((HitboxSize - MinSize) / (MaxSize - MinSize), 0, 0.5, 0)
SliderKnob.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
SliderKnob.Parent = SliderTrack

local KnobCorner = Instance.new("UICorner", SliderKnob)
KnobCorner.CornerRadius = UDim.new(1, 0)

-- Lógica do Slider
local sliding = false
local function updateSlider(input)
    local trackPos = SliderTrack.AbsolutePosition.X
    local trackSize = SliderTrack.AbsoluteSize.X
    local mousePos = input.Position.X
    local percentage = math.clamp((mousePos - trackPos) / trackSize, 0, 1)
    
    HitboxSize = math.floor(MinSize + (MaxSize - MinSize) * percentage)
    SliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)
    SliderLabel.Text = "Tamanho: " .. HitboxSize
end

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

