local players = game:GetService("Players")
local coreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local LocalPlayer = players.LocalPlayer
local estaTeleportando = false

-- =============================================
-- CONFIGURAÇÕES PERSISTENTES
-- =============================================
local CONFIG_FILE = "Dimensao23_KillBoss_Config.json"

local function LoadConfig()
    if not isfile then return {} end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            return data
        end
    end
    return {}
end

local function SaveConfigToFile(configTable)
    if not writefile then return end
    local success, json = pcall(function()
        return HttpService:JSONEncode(configTable)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
    end
end

local Config = {
    Distancia = 10,
    Direcao = "Cima", -- "Baixo", "Cima", "Frente", "Costa"
    Multiplicador = 1,
    Bivalvan = false,
    Galapagus = false,
}
local savedConfig = LoadConfig()
for k, v in pairs(savedConfig) do
    Config[k] = v
end

local function SaveConfig()
    SaveConfigToFile(Config)
end

-- =============================================
-- SISTEMA DE COMBATE (REMOTES)
-- =============================================
local RS = pcall(function()
    local remotes = ReplicatedStorage:FindFirstChild("AliensPowerRemotes")
    if remotes then
        return remotes:FindFirstChild("upgrade")
    end
end) and ReplicatedStorage:FindFirstChild("AliensPowerRemotes"):FindFirstChild("upgrade") or nil

local function Laser()
    if RS and RS.Laser then pcall(function() RS.Laser:InvokeServer() end) end
end
local function GunArm()
    if RS and RS.GunArm then pcall(function() RS.GunArm:InvokeServer() end) end
end
local function Armature()
    if RS and RS.Armature then pcall(function() RS.Armature:InvokeServer() end) end
end

local function ArmFire(targetRoot)
    if not RS or not RS.ArmFire then return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        local targetPosition = targetRoot and targetRoot.Position or (root.Position + Vector3.new(0, -100, 0))
        pcall(function()
            RS.ArmFire:InvokeServer(targetPosition)
        end)
    end
end

-- =============================================
-- LÓGICA DE ALVO
-- =============================================
local function getLocalCharacter()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return char, root
end

-- Função para obter a parte alvo do boss ativo
local function getActiveBossTarget()
    local enemys = Workspace:FindFirstChild("Enemys")
    if not enemys then return nil end

    local bosses = {
        { configKey = "Bivalvan", folderName = "Bivalvan", partName = "Ominitrix_Symbol" },
        { configKey = "Galapagus", folderName = "Galapagus", partName = "Ominitrix_Symbol" },
    }

    for _, boss in ipairs(bosses) do
        if Config[boss.configKey] then
            local folder = enemys:FindFirstChild(boss.folderName)
            if folder then
                local char = folder:FindFirstChild("Character")
                if char and char:IsA("Model") then
                    local part = char:FindFirstChild(boss.partName) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if part and part:IsA("BasePart") then
                        return part
                    end
                end
            end
        end
    end
    return nil
end

-- Função para calcular o offset com base na direção e distância
local function getOffset(direcao, distancia)
    local offset = Vector3.new(0, 0, 0)
    if direcao == "Baixo" then
        offset = Vector3.new(0, -distancia, 0)
    elseif direcao == "Cima" then
        offset = Vector3.new(0, distancia, 0)
    elseif direcao == "Frente" then
        offset = Vector3.new(0, 0, distancia)
    elseif direcao == "Costa" then
        offset = Vector3.new(0, 0, -distancia)
    end
    return offset
end

-- =============================================
-- LOOP KILL BOSS
-- =============================================
local bossKillRunning = false
local bossKillConnection = nil

local function startBossKillLoop()
    if bossKillConnection then return end
    bossKillRunning = true
    bossKillConnection = RunService.Heartbeat:Connect(function()
        -- Verifica se algum boss está ativo
        if not (Config.Bivalvan or Config.Galapagus) then
            bossKillRunning = false
            if bossKillConnection then
                bossKillConnection:Disconnect()
                bossKillConnection = nil
            end
            return
        end

        local targetPart = getActiveBossTarget()
        if not targetPart then return end

        local _, myRoot = getLocalCharacter()
        if not myRoot then return end

        -- Calcula a posição alvo com offset
        local offset = getOffset(Config.Direcao, Config.Distancia)
        local targetCFrame = targetPart.CFrame * CFrame.new(offset)
        myRoot.CFrame = targetCFrame

        -- Executa os disparos com multiplicador
        local multiplier = math.floor(tonumber(Config.Multiplicador) or 1)
        if multiplier < 1 then multiplier = 1 end

        for i = 1, multiplier do
            if not (Config.Bivalvan or Config.Galapagus) then break end
            Laser()
            GunArm()
            ArmFire(targetPart)
            Armature()
            task.wait(0.05)
        end
    end)
end

-- Inicia automaticamente se algum boss estiver ativo ao carregar
if Config.Bivalvan or Config.Galapagus then
    task.spawn(startBossKillLoop)
end

