local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("Btn_PartialMaster") then CoreGui.Btn_PartialMaster:Destroy() end

local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "Btn_PartialMaster"

local Button = Instance.new("TextButton", ScreenGui)
Button.Size = UDim2.new(0, 180, 0, 40)
Button.Position = UDim2.new(0.5, -90, 0.3, 0)
Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Button.TextColor3 = Color3.fromRGB(255, 170, 0)
Button.Font = Enum.Font.GothamBold
Button.Text = "2. Partial_MasterControl"
Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

local arrastando, inputInicio, posInicio
Button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true; inputInicio = input.Position; posInicio = Button.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then arrastando = false end end)
    end
end)
Button.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and arrastando then
        local delta = input.Position - inputInicio
        Button.Position = UDim2.new(posInicio.X.Scale, posInicio.X.Offset + delta.X, posInicio.Y.Scale, posInicio.Y.Offset + delta.Y)
    end
end)

Button.MouseButton1Click:Connect(function()
    local atributos = LocalPlayer:FindFirstChild("atributos")
    if atributos then
        local folder = atributos:FindFirstChild("Ominitrix_Properties") or Instance.new("Folder", atributos)
        folder.Name = "Ominitrix_Properties"
        
        local val = folder:FindFirstChild("Partial_MasterControl") or Instance.new("BoolValue", folder)
        val.Name = "Partial_MasterControl"
        val.Value = true
        print("[Teste 2]: Partial_MasterControl Ativado!")
    end
end)
