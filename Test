-- SISTEMA DE SAVE (com fallback)
-- =============================================
local CONFIG_FILE = "BlueLockConfig.json"
local Config = {
    velocidadeBola = 65,
    aimbotPersonagem = false,
    aimbotCamera = false,
    botaoFlutuante = false,
    botaoCameraFlutuante = false,
    aimbotDelayIndex = 1,
    visaoBola = false,
    advinhaChute = false,
    hitboxPersonagem = false,
    hitboxPersonagemTamanho = 5,
    hitboxBola = false,
    reachDistancia = 20,
    mostrarESP = false,
    forcaBola = false,
    forcaBolaVelocidade = 100,
    curvas = false,
    curvasIntensidade = 5,
    curvasModo = 1,
    drible = false,
    selectedTeam = "Home",
}

local function LoadConfig()
    if not isfile then return end
    if isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do
                Config[k] = v
            end
            print("[Blue Lock] Config carregada com sucesso.")
        end
    end
end

local function SaveConfig()
    if not writefile then return
    local success, json = pcall(function()
        return HttpService:JSONEncode(Config)
    end)
    if success then
        pcall(function() writefile(CONFIG_FILE, json) end)
        print("[Blue Lock] Config salva.")
    end
end

LoadConfig()

