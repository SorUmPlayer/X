-- [[ Blue Lock: Rivals - Reo Mikage Skill Steal (Apenas Botão Flutuante) ]] --

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local CopiedSkill = "Nenhuma"
local CopiedTarget = nil

-- Função para encontrar o jogador mais próximo
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local myPos = myChar.HumanoidRootPart.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (myPos - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- Função para copiar a habilidade do alvo
local function CopyNearestSkill()
    local target = GetClosestPlayer()
    
    if target and target.Character then
        CopiedTarget = target
        local tool = target.Character:FindFirstChildOfClass("Tool") or target.Backpack:FindFirstChildOfClass("Tool")
        CopiedSkill = tool and tool.Name or ("Estilo do " .. target.DisplayName)
        
        -- Efeito visual de Aura Roxa no seu personagem
        local char = LocalPlayer.Character
        if char then
            local highlight = char:FindFirstChild("ReoCopyEffect") or Instance.new("Highlight")
            highlight.Name = "ReoCopyEffect"
            highlight.FillColor = Color3.fromRGB(138, 43, 226) -- Roxo Reo Mikage
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.Parent = char
            
            task.delay(2, function()
                if highlight and highlight.Parent then
                    highlight:Destroy()
                end
            end)
        end
        
        print("[REO SYSTEM] Skill Copiada: " .. CopiedSkill .. " (Jogador: " .. target.Name .. ")")
    else
        print("[REO SYSTEM] Nenhum jogador próximo para copiar.")
    end
end

-- Executa automaticamente uma vez ao injetar o script
task.spawn(function()
    task.wait(0.1)
    CopyNearestSkill()
end)

