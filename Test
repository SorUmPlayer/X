local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("Btn_GiveMaster") then CoreGui.Btn_GiveMaster:Destroy() end

local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "Btn_GiveMaster"

local Button = Instance.new("TextButton", ScreenGui)
Button.Size = UDim2.new(0, 180, 0, 40)
Button.Position = UDim2.new(0.5, -90, 0.4, 0)
Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Button.TextColor3 = Color3.fromRGB(0, 170, 255)
Button.Font = Enum.Font.GothamBold
Button.Text = "3. Give_Master_Control"
Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

local arrastando, inputInicio, posInicio
Button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true; inputInicio = input.Position; posInicio = Button.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then arrastando = false end end)
    end
end)
Button.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and arrastando then
        local delta = input.Position - inputInicio
        Button.Position = UDim2.new(posInicio.X.Scale, posInicio.X.Offset + delta.X, posInicio.Y.Scale, posInicio.Y.Offset + delta.Y)
    end
end)

Button.MouseButton1Click:Connect(function()
    local inventory = LocalPlayer:FindFirstChild("Inventory")
    if inventory then
        local folder1 = inventory:FindFirstChild("Ominitrix_Unlocker") or Instance.new("Folder", inventory)
        folder1.Name = "Ominitrix_Unlocker"
        
        local folder2 = folder1:FindFirstChild("Ominitrix_Unlocker") or Instance.new("Folder", folder1)
        folder2.Name = "Ominitrix_Unlocker"

        local val = folder2:FindFirstChild("Give_Master_Control") or Instance.new("BoolValue", folder2)
        val.Name = "Give_Master_Control"
        val.Value = true
        print("[Teste 3]: Give_Master_Control Ativado no Inventário!")
    end
end)
