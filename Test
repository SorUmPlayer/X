-- [[ Blue Lock: Rivals - Reo Mikage (Injeção Direta na UI Native de Skills) ]] --

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local CopiedSkill = "Nenhuma"
local CopiedTarget = nil

-- Função para encontrar o jogador mais próximo
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local myPos = myChar.HumanoidRootPart.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (myPos - player.Character.HumanoidRootPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- Aura Roxa do Reo Mikage no Personagem
local function ApplyReoAura(char)
    if not char then return end
    local highlight = char:FindFirstChild("ReoCopyEffect") or Instance.new("Highlight")
    highlight.Name = "ReoCopyEffect"
    highlight.FillColor = Color3.fromRGB(147, 51, 234)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.3
    highlight.Parent = char
    
    task.delay(2.5, function()
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end)
end

-- Atualiza a interface gráfica oficial do jogo no slot especificado (ex: "5", "6", etc.)
local function UpdateAbilitySlotUI(slotIndex, skillTitle)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    local abilitiesFolder = playerGui:FindFirstChild("InGameUI") 
        and playerGui.InGameUI:FindFirstChild("Bottom") 
        and playerGui.InGameUI.Bottom:FindFirstChild("Abilities")
        
    if not abilitiesFolder then return end
    
    local targetSlot = abilitiesFolder:FindFirstChild(tostring(slotIndex))
    if not targetSlot then return end
    
    targetSlot.Visible = true
    
    -- Procura o TextLabel do Slot para alterar o nome da Skill
    for _, desc in ipairs(targetSlot:GetDescendants()) do
        if desc:IsA("TextLabel") then
            desc.Text = skillTitle
        end
    end
    
    -- Adiciona borda roxa de destaque do Reo no Slot da UI
    local stroke = targetSlot:FindFirstChild("ReoBorder") or Instance.new("UIStroke")
    stroke.Name = "ReoBorder"
    stroke.Color = Color3.fromRGB(147, 51, 234)
    stroke.Thickness = 2
    stroke.Parent = targetSlot
end

-- Função principal para roubar skill e atribuir ao Slot
local function CopySkillToSlot(slotIndex)
    slotIndex = tostring(slotIndex or "5")
    local target = GetClosestPlayer()
    local char = LocalPlayer.Character
    
    if target and target.Character then
        CopiedTarget = target
        local tool = target.Character:FindFirstChildOfClass("Tool") or target.Backpack:FindFirstChildOfClass("Tool")
        CopiedSkill = tool and tool.Name or ("Estilo: " .. target.DisplayName)
        
        -- Aplica aura e atualiza o Slot na UI
        ApplyReoAura(char)
        UpdateAbilitySlotUI(slotIndex, CopiedSkill)
        
        print("[REO SYSTEM] Skill '" .. CopiedSkill .. "' injetada no Slot Abilities['" .. slotIndex .. "']")
    else
        print("[REO SYSTEM] Nenhum jogador próximo para copiar.")
    end
end

-- Vincula eventos de clique nos Slots de 5 até 10 da InGameUI
local function SetupNativeSlots()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local inGameUI = playerGui:WaitForChild("InGameUI", 10)
    if not inGameUI then return end
    
    local abilities = inGameUI:WaitForChild("Bottom", 5) and inGameUI.Bottom:WaitForChild("Abilities", 5)
    if not abilities then return end
    
    -- Configura os slots de 5 a 10
    for i = 5, 10 do
        local slotName = tostring(i)
        local slot = abilities:FindFirstChild(slotName)
        
        if slot then
            slot.Visible = true
            
            -- Detecta clique na caixa do slot
            local clickDetector = slot:IsA("GuiButton") and slot 
                or slot:FindFirstChildOfClass("GuiButton") 
                or slot:FindFirstChildOfClass("ImageButton") 
                or slot:FindFirstChildOfClass("TextButton")
            
            if clickDetector then
                clickDetector.MouseButton1Click:Connect(function()
                    CopySkillToSlot(slotName)
                end)
            end
        end
    end
end

-- Execução Automática ao Injetar
task.spawn(function()
    SetupNativeSlots()
    CopySkillToSlot("5") -- Aloca direto no Slot 5 na primeira execução
end)

-- Re-aplica a UI em caso de Respawn / Nova Rodada
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1.5)
    SetupNativeSlots()
    CopySkillToSlot("5")
end)

-- Tecla "5" do teclado aciona a cópia direto pro Slot 5
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Five or input.KeyCode == Enum.KeyCode.KeypadFive then
        CopySkillToSlot("5")
    end
end)
