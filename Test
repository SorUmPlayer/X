        Callback = function(v) Config.BossDistance = math.floor(v) end
    })
    TabBoss:Input({
        Title = lang.ChatMulti, Desc = lang.DescBossMulti, Value = tostring(Config.BossShotMultiplier),
        Placeholder = lang.PlaceMulti,
        Callback = function(t)
            local n = tonumber(t)
            if n and n > 0 then Config.BossShotMultiplier = n end
        end
    })
    TabBoss:Section({ Title = lang.SecBoss })
    TabBoss:Toggle({
        Title = lang.ToggleShip, Value = Config.BossShip,
        Callback = function(v)
            Config.BossShip = v
            if v or Config.BossKraken or Config.BossTransDimensional then task.spawn(startBossLoop)
            else if bossConnection then bossConnection:Disconnect() bossConnection = nil end end
        end
    })
    TabBoss:Toggle({
        Title = lang.ToggleKraken, Value = Config.BossKraken,
        Callback = function(v)
            Config.BossKraken = v
            if Config.BossShip or v or Config.BossTransDimensional then task.spawn(startBossLoop)
            else if bossConnection then bossConnection:Disconnect() bossConnection = nil end end
        end
    })
    TabBoss:Toggle({
        Title = lang.ToggleTrans, Value = Config.BossTransDimensional,
        Callback = function(v)
            Config.BossTransDimensional = v
            if Config.BossShip or Config.BossKraken or v then task.spawn(startBossLoop)
            else if bossConnection then bossConnection:Disconnect() bossConnection = nil end end
        end
    })

    -- TELEPORTE
    local function addTeleportSection(title, coords)
