    Callback = function(state) 
        rodando = state
        print("Toggle Activated: " .. tostring(state))

        -- Configurável
        local HITBOX_SIZE = Vector3.new(40, 100, 100) -- tamanho da hitbox do boss

        local plr  = game.Players.LocalPlayer
        local char = plr.Character or plr.CharacterAdded:Wait()
        local hrp  = char:WaitForChild("HumanoidRootPart")

        local gp         = workspace:FindFirstChild("Gameplay")
        local bossModel  = gp and gp:FindFirstChild("Boss")
        local arenaBase  = bossModel and bossModel:FindFirstChild("ArenaBase")
        local bossHolder = bossModel and bossModel:FindFirstChild("BossHolder")

        if state then
            -- Teleportar apenas uma vez
            if arenaBase and arenaBase:IsA("BasePart") then
                hrp.CFrame = arenaBase.CFrame + Vector3.new(0, 5, 0)
            else
                warn("ArenaBase não encontrada em workspace.Gameplay.Boss.ArenaBase")
            end

            -- Aumentar hitbox apenas uma vez
            if bossHolder then
                for _, part in ipairs(bossHolder:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Size = HITBOX_SIZE
                        part.CanCollide = false
                        part.Transparency = 1
                        part.Massless = true
                    end
                end
            else
                warn("BossHolder não encontrado em workspace.Gameplay.Boss.BossHolder")
            end
        else
            -- Quando desligar, restaurar hitbox (se quiser)
            if bossHolder then
                for _, part in ipairs(bossHolder:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Size = Vector3.new(10,10,10) -- tamanho padrão (ajuste se souber o original)
                        part.CanCollide = true
                        part.Transparency = 0
                        part.Massless = false
                    end
                end
            end
        end
    end
})

