local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Procura o objeto no Workspace
local targetObject = workspace:FindFirstChild("AreaEggSlotsClient") 
    and workspace.AreaEggSlotsClient:FindFirstChild("02057d36e0954bb79f2f3c0eec10b213")

-- Função para realizar o teleporte
local function teleportToTarget()
    local character = game.Players.LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp and targetObject then
        -- Teleporta para a CFrame do objeto ou para a posição (se for Model ou Part)
        if targetObject:IsA("Model") then
            hrp.CFrame = targetObject:GetPivot()
        elseif targetObject:IsA("BasePart") then
            hrp.CFrame = targetObject.CFrame
        else
            WindUI:Notify({ Title = "Erro", Content = "Objeto não possui posição física válida.", Duration = 3 })
        end
    else
        WindUI:Notify({ Title = "Erro", Content = "Objeto ou Jogador não encontrado!", Duration = 3 })
    end
end

-- Janela Principal
local Window = WindUI:CreateWindow({
    Title = "Teleport Tool",
    Icon = "map-pin",
    Author = "Script",
    Folder = "TP_Config",
    Size = UDim2.fromOffset(320, 200),
    Transparent = true
})

local Tab = Window:Tab({ Title = "Teleport", Icon = "navigation" })

-- Botão de Teleporte na UI Principal
Tab:Button({
    Title = "Teleportar para AreaEgg",
    Callback = teleportToTarget
})

-- Criação do Botão Flutuante (Draggable ScreenGui)
local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui", playerGui)
screenGui.Name = "FloatingTPGui"
screenGui.ResetOnSpawn = false

local floatButton = Instance.new("TextButton", screenGui)
floatButton.Size = UDim2.new(0, 120, 0, 40)
floatButton.Position = UDim2.new(0.1, 0, 0.2, 0)
floatButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
floatButton.TextColor3 = Color3.fromRGB(255, 255, 255)
floatButton.Text = "TP Egg Slot"
floatButton.Font = Enum.Font.SourceSansBold
floatButton.TextSize = 14
floatButton.Active = true
floatButton.Draggable = true -- Torna o botão arrastável/voado pela tela

local UICorner = Instance.new("UICorner", floatButton)
UICorner.CornerRadius = UDim.new(0, 8)

-- Ação ao clicar no botão flutuante
floatButton.MouseButton1Click:Connect(teleportToTarget)
