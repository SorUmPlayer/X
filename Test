local function atualizarAdvinhaChute()
    if not advinhaChuteEnabled then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    if not bola or not bolaValida then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    local vel = bola.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        if linhaChute then linhaChute:Destroy(); linhaChute = nil end
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
        return
    end
    local gravidade = Vector3.new(0, -50, 0)
    local pos = bola.Position; local v = vel
    local dt = 0.02; local maxPassos = 500; local chaoY = 0
    local pontos = {pos}
    for i = 1, maxPassos do
        v = v + gravidade * dt; pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then break end
    end
    if #pontos < 2 then return end
    local posFinal = pontos[#pontos]
    posFinal = Vector3.new(posFinal.X, chaoY, posFinal.Z)
    local inicio = pontos[1]; local fim = pontos[#pontos]
    local meio = (inicio + fim) / 2
    local dist = (inicio - fim).Magnitude
    criarLinhaChute()
    if dist > 0.1 then
        linhaChute.Size = Vector3.new(0.5, 0.5, dist)
        linhaChute.CFrame = CFrame.lookAt(meio, fim)
        linhaChute.Transparency = 0.2
    else linhaChute.Transparency = 1 end
    if v.Y < -0.5 then
        criarCirculoChute()
        circuloChute.Position = posFinal
        local tam = math.clamp(vel.Magnitude / 8, 3, 8)
        circuloChute.Size = Vector3.new(tam, 0.1, tam)
        circuloChute.Transparency = 0.2
    else
        if circuloChute then circuloChute:Destroy(); circuloChute = nil end
    end
end

