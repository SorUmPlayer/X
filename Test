-- Lógica da Hitbox & Toque
----------------------------------------------------------------

-- Função para restaurar o estado original da bola quando desligar
local function restoreOriginals()
    for part, props in pairs(originalProps) do
        if part and part.Parent then
            part.Size = props.Size
            part.Transparency = props.Transparency
            part.CanCollide = props.CanCollide
            part.CanTouch = props.CanTouch
        end
    end
    table.clear(originalProps)
end

ToggleBtn.MouseButton1Click:Connect(function()
    HitboxEnabled = not HitboxEnabled
    if HitboxEnabled then
        ToggleBtn.Text = "Hitbox: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        ToggleBtn.Text = "Hitbox: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        restoreOriginals()
    end
end)

-- Encontra partes da bola cliente
local function getBallParts()
    local ballParts = {}
    for _, item in ipairs(workspace:GetChildren()) do
        if string.sub(item.Name, 1, 12) == "CLIENT_BALL_" then
            if item:IsA("BasePart") then
                table.insert(ballParts, item)
            else
                for _, child in ipairs(item:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(ballParts, child)
                    end
                end
            end
        end
    end
    return ballParts
end

-- Loop de verificação rápida (Heartbeat)
RunService.Heartbeat:Connect(function()
    if not HitboxEnabled then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Partes do corpo para forçar toque
    local bodyParts = {
        char:FindFirstChild("Right Foot") or char:FindFirstChild("RightLeg") or char:FindFirstChild("Right Lower Leg"),
        char:FindFirstChild("Left Foot") or char:FindFirstChild("LeftLeg") or char:FindFirstChild("Left Lower Leg"),
        hrp
    }

    local balls = getBallParts()
    for _, part in ipairs(balls) do
        -- Salva propriedades originais na primeira vez
        if not originalProps[part] then
            originalProps[part] = {
                Size = part.Size,
                Transparency = part.Transparency,
                CanCollide = part.CanCollide,
                CanTouch = part.CanTouch
            }
        end

        -- Aplica alterações de tamanho e permissão de toque
        part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
        part.Transparency = 0.5
        part.CanCollide = false
        part.CanTouch = true
        if pcall(function() return part.CanQuery end) then
            part.CanQuery = true
        end

        -- Se o jogador estiver dentro do raio da Hitbox, dispara o evento de toque
        local distance = (hrp.Position - part.Position).Magnitude
        if distance <= (HitboxSize / 2) + 3 then
            for _, bPart in ipairs(bodyParts) do
                if bPart and firetouchinterest then
                    firetouchinterest(bPart, part, 0)
                    firetouchinterest(bPart, part, 1)
                end
            end
        end
    end
end)
