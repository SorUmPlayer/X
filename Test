local function restoreVbOriginals()
    for part, props in pairs(vbOriginalProps) do
        if part and part.Parent then
            part.Size = props.Size
            part.Transparency = props.Transparency
            part.CanCollide = props.CanCollide
            part.CanTouch = props.CanTouch
        end
    end
    table.clear(vbOriginalProps)
end

local function getVbBallParts()
    local ballParts = {}
    for _, item in ipairs(Workspace:GetChildren()) do
        if string.sub(item.Name, 1, 12) == "CLIENT_BALL_" then
            if item:IsA("BasePart") then
                table.insert(ballParts, item)
            else
                for _, child in ipairs(item:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(ballParts, child)
                    end
                end
            end
        end
    end
    return ballParts
end

RunService.Heartbeat:Connect(function()
    if not vbHitboxEnabled then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bodyParts = {
        char:FindFirstChild("Right Foot") or char:FindFirstChild("RightLeg") or char:FindFirstChild("Right Lower Leg"),
        char:FindFirstChild("Left Foot") or char:FindFirstChild("LeftLeg") or char:FindFirstChild("Left Lower Leg"),
        hrp
    }

    local balls = getVbBallParts()
    for _, part in ipairs(balls) do
        if not vbOriginalProps[part] then
            vbOriginalProps[part] = {
                Size = part.Size,
                Transparency = part.Transparency,
                CanCollide = part.CanCollide,
                CanTouch = part.CanTouch
            }
        end

        part.Size = Vector3.new(vbHitboxSize, vbHitboxSize, vbHitboxSize)
        part.Transparency = 0.5
        part.CanCollide = false
        part.CanTouch = true
        if pcall(function() return part.CanQuery end) then
            part.CanQuery = true
        end

        local distance = (hrp.Position - part.Position).Magnitude
        if distance <= (vbHitboxSize / 2) + 3 then
            for _, bPart in ipairs(bodyParts) do
                if bPart and firetouchinterest then
                    firetouchinterest(bPart, part, 0)
                    firetouchinterest(bPart, part, 1)
                end
            end
        end
    end
end)

-- =====================================================
--  CONTROLE DA HITBOX DA BOLA (REACH)
-- =====================================================
local function aplicarTamanhoHitbox()
    if not hitbox then return end
    local tenho = euTenhoBola()
    local tamanhoDesejado
    local transparenciaDesejada

    if tenho or not reachAtivo then
        tamanhoDesejado = hitboxOriginalSize
        transparenciaDesejada = hitboxOriginalTransparency
    else
        tamanhoDesejado = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        transparenciaDesejada = 1
    end

    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= transparenciaDesejada then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = transparenciaDesejada
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        aplicarTamanhoHitbox()
    end
end)

-- =====================================================
--  HITBOX DO PERSONAGEM (POR SOFTWARE)
-- =====================================================
local function aplicarHitboxPersonagem()
    if not hitboxPersonagemAtivo then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - hitbox.Position).Magnitude
    if dist <= hitboxPersonagemTamanho then
        if firetouchinterest then
            firetouchinterest(hrp, hitbox, 0)
            task.wait(0.01)
            firetouchinterest(hrp, hitbox, 1)
        end
    end
end

-- =====================================================
--  FORÇA DA BOLA COM CURVAS
-- =====================================================
local function aplicarForcaBola()
    if not forcaBolaEnabled then return end
    if not bolaValida or not bola then return end

    local tenho = euTenhoBola()
    
    if tinhaBola and not tenho then
        local dir = camera.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then
            dir = Vector3.new(1, 0, 0)
        else
            dir = dir.Unit
        end
        
        local vel = dir * forcaBolaVelocidade + Vector3.new(0, 15, 0)
        
        if curvaEnabled then
            local perp = Vector3.new(-dir.Z, 0, dir.X)
            local sinal = 0
            if curvaDirection == "Direita" then
                sinal = 1
            elseif curvaDirection == "Esquerda" then
                sinal = -1
            elseif curvaDirection == "Aleatório" then
                ultimaCurvaDirection = (math.random(1, 2) == 1) and 1 or -1
                sinal = ultimaCurvaDirection
            end
            local fator = (curvaIntensity / 10) * 20
            local lateral = perp * sinal * fator
            vel = vel + lateral
        end
        
        bola.AssemblyLinearVelocity = vel
    end
    
    tinhaBola = tenho
end

