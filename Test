--[[
    Blue Lock Rivals – Auto GK (Goleiro automático)
    Adicione esta seção ao seu hub principal.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- =====================================================
--  DETECÇÃO DA BOLA
-- =====================================================
local function getBall()
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then return ballAnims end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
        return football
    end
    return nil
end

-- =====================================================
--  VARIÁVEIS DO GK
-- =====================================================
local gkEnabled = false
local gkTeam = nil
local gkPosition = nil          -- posição fixa no gol
local gkCircle = nil
local gkRadius = 30             -- raio do círculo de detecção
local gkGrabRadius = 5          -- distância para pegar a bola
local gkLastDive = 0
local gkDiveCooldown = 1.0
local gkMoveToPosition = nil    -- posição alvo para o MoveTo
local gkStopMoving = false

-- =====================================================
--  DETECTAR TIME PELA POSIÇÃO
-- =====================================================
local function determinarTime()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local pos = hrp.Position
    local distHome = (pos - Vector3.new(-234, 11, -49)).Magnitude
    local distAway = (pos - Vector3.new(311, 11, -48)).Magnitude

    if distHome < distAway then
        return "Home"
    else
        return "Away"
    end
end

-- =====================================================
--  POSIÇÃO FIXA DO GOLEIRO
-- =====================================================
local function getGKPosition()
    if gkTeam == "Home" then
        return Vector3.new(-234, 11, -47)
    elseif gkTeam == "Away" then
        return Vector3.new(311, 11, -50)
    else
        return nil
    end
end

-- =====================================================
--  CRIAR CÍRCULO DE DETECÇÃO
-- =====================================================
local function criarCirculoGK()
    if gkCircle then return end
    if not gkPosition then return end

    gkCircle = Instance.new("Part")
    gkCircle.Name = "GKDetectionCircle"
    gkCircle.Shape = Enum.PartType.Cylinder
    gkCircle.Size = Vector3.new(gkRadius * 2, 0.5, gkRadius * 2)
    gkCircle.Position = gkPosition
    gkCircle.Transparency = 0.5
    gkCircle.Color = Color3.fromRGB(0, 150, 255)
    gkCircle.Anchored = true
    gkCircle.CanCollide = false
    gkCircle.Parent = workspace
end

local function removerCirculoGK()
    if gkCircle then
        gkCircle:Destroy()
        gkCircle = nil
    end
end

-- =====================================================
--  FUNÇÕES DE MOVIMENTO
-- =====================================================
local function moverGoleiro(posicao)
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Se já estiver próximo, para o movimento
    local dist = (hrp.Position - posicao).Magnitude
    if dist < 1.5 then
        humanoid:MoveTo(hrp.Position) -- para
        return
    end

    humanoid:MoveTo(posicao)
end

local function pararGoleiro()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    humanoid:MoveTo(char.HumanoidRootPart.Position)
end

-- =====================================================
--  AÇÕES DO GOLEIRO
-- =====================================================
local function pegarBola(ball)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Cria uma parte temporária para simular toque
    local tempPart = Instance.new("Part")
    tempPart.Size = Vector3.new(2, 2, 2)
    tempPart.Position = hrp.Position
    tempPart.Anchored = true
    tempPart.CanCollide = false
    tempPart.Transparency = 1
    tempPart.Parent = workspace

    if firetouchinterest then
        firetouchinterest(tempPart, ball, 0)
        task.wait(0.01)
        firetouchinterest(tempPart, ball, 1)
    end

    tempPart:Destroy()
end

local function chutarLonge(ball)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dir = (ball.Position - hrp.Position).Unit
    local shootEvent = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Knit")
        and ReplicatedStorage.Packages.Knit:FindFirstChild("Services")
        and ReplicatedStorage.Packages.Knit.Services:FindFirstChild("BallService")
        and ReplicatedStorage.Packages.Knit.Services.BallService:FindFirstChild("RE")
        and ReplicatedStorage.Packages.Knit.Services.BallService.RE:FindFirstChild("Shoot")

    if shootEvent then
        shootEvent:FireServer(110, ball.Position + dir * 60)
    end
end

local function usarDive()
    local now = tick()
    if now - gkLastDive < gkDiveCooldown then return end
    gkLastDive = now

    local diveEvent = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Knit")
        and ReplicatedStorage.Packages.Knit:FindFirstChild("Services")
        and ReplicatedStorage.Packages.Knit.Services:FindFirstChild("BallService")
        and ReplicatedStorage.Packages.Knit.Services.BallService:FindFirstChild("RE")
        and ReplicatedStorage.Packages.Knit.Services.BallService.RE:FindFirstChild("Dive")

    if diveEvent then
        diveEvent:FireServer()
    end
end

-- =====================================================
--  VERIFICAR ADVERSÁRIO NA ÁREA
-- =====================================================
local function getAdversarioComBolaNaArea()
    local area = workspace:FindFirstChild("AttemptGrabBox")
    if not area or not area:IsA("BasePart") then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char and char:FindFirstChild("Football") then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local relative = hrp.Position - area.Position
                    local size = area.Size / 2
                    if math.abs(relative.X) <= size.X and
                       math.abs(relative.Y) <= size.Y and
                       math.abs(relative.Z) <= size.Z then
                        return plr
                    end
                end
            end
        end
    end
    return nil
end

-- =====================================================
--  FUNÇÃO PRINCIPAL DE ATUALIZAÇÃO DO GK
-- =====================================================
local function atualizarGK()
    if not gkEnabled then return end
    if not gkPosition then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ball = getBall()
    if not ball then return end

    local distBola = (ball.Position - gkPosition).Magnitude
    local posAlvo = gkPosition

    -- 1. Verificar adversário com bola na área
    local adv = getAdversarioComBolaNaArea()
    if adv then
        local advChar = adv.Character
        if advChar then
            local advHrp = advChar:FindFirstChild("HumanoidRootPart")
            if advHrp then
                -- Posicionar na frente do adversário (distância de 8 studs)
                local dir = (gkPosition - advHrp.Position).Unit
                posAlvo = advHrp.Position + dir * 8
                posAlvo = Vector3.new(posAlvo.X, gkPosition.Y, posAlvo.Z) -- manter altura
            end
        end
    end

    -- 2. Mover goleiro para a posição alvo
    moverGoleiro(posAlvo)

    -- 3. Atualizar círculo (se não estiver seguindo o círculo, mantém fixo no gol)
    if gkCircle then
        if not adv then
            gkCircle.Position = gkPosition
        else
            gkCircle.Position = posAlvo
        end
    end

    -- 4. Verificar bola dentro do círculo
    if distBola <= gkRadius then
        local vel = ball.AssemblyLinearVelocity
        local speed = vel.Magnitude

        if speed < 2 then
            -- Bola parada -> pegar e chutar longe
            pegarBola(ball)
            chutarLonge(ball)
        else
            -- Prever se vem em direção ao gol
            local dirBola = vel.Unit
            local dirGol = (gkPosition - ball.Position).Unit
            local dot = dirBola:Dot(dirGol)

            if dot > 0.3 then
                if speed > 15 or distBola > 15 then
                    usarDive()
                elseif distBola < gkGrabRadius then
                    pegarBola(ball)
                    chutarLonge(ball)
                end
            end
        end
    end
end

-- =====================================================
--  INICIAR / DESATIVAR GK
-- =====================================================
local function iniciarGK()
    gkTeam = determinarTime()
    if not gkTeam then
        warn("Não foi possível determinar o time. Fique próximo ao gol.")
        return
    end

    gkPosition = getGKPosition()
    if not gkPosition then
        warn("Posição do gol não encontrada.")
        return
    end

    print("Você é do Time: " .. gkTeam)
    criarCirculoGK()

    -- Move o goleiro para a posição inicial
    moverGoleiro(gkPosition)
end

local function desativarGK()
    gkEnabled = false
    removerCirculoGK()
    pararGoleiro()
end

-- =====================================================
--  CONEXÃO DO LOOP
-- =====================================================
RunService.Heartbeat:Connect(atualizarGK)

