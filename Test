})

local Tab = Window:Tab({ Title = "Automação", Icon = "navigation" })

local EggDropdown = Tab:Dropdown({
    Title = "Selecione o Ovo",
    Values = getEggList(),
    Value = "",
    Callback = function(val)
        selectedEggName = val
    end
})

Tab:Button({
    Title = "🔄 Recarregar Dropdown",
    Callback = function()
        local newList = getEggList()
        if EggDropdown.SetValues then
            EggDropdown:SetValues(newList)
        elseif EggDropdown.Refresh then
            EggDropdown:Refresh(newList)
        end
        WindUI:Notify({ Title = "Atualizado", Content = "Lista de ovos recarregada!", Duration = 2 })
    end
})

-- Ajuste de estrutura do Slider conforme a documentação oficial do WindUI
Tab:Slider({
    Title = "Velocidade do Tween",
    Step = 1,
    Value = {
        Min = 10,
        Max = 500,
        Default = 150
    },
    Callback = function(val)
        tpSpeed = val
    end
})

Tab:Button({
    Title = "🚀 Iniciar Ciclo",
    Callback = startCycle
})

