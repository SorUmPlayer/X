local function getInimigoComBola()
    local myTeam = getMyTeam()
    if not myTeam then return nil end
    for _, outro in ipairs(Players:GetPlayers()) do
        if outro ~= player then
            local char = outro.Character
            if char and char:FindFirstChild("Football") then
                local values = outro:FindFirstChild("Values")
                if values then
                    local tv = values:FindFirstChild("Team")
                    if tv and tostring(tv.Value) ~= myTeam then return outro end
                end
            end
        end
    end
    return nil
end

local function atualizarVisaoBola()
    if not visaoBolaEnabled then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local inimigo = getInimigoComBola()
    if not inimigo then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local char = inimigo.Character
    if not char then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp
    if not origem then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local posInicio = origem.Position
    if origem == hrp then posInicio = posInicio + Vector3.new(0, 1.5, 0) end

    local direcao = Vector3.new(1, 0, 0)
    if head then direcao = head.CFrame.LookVector
    elseif hrp then direcao = hrp.CFrame.LookVector end
    direcao = Vector3.new(direcao.X, 0, direcao.Z)
    if direcao.Magnitude < 0.001 then direcao = Vector3.new(1, 0, 0) else direcao = direcao.Unit end

    local posFim = posInicio + direcao * 100

    if not linhaVisao or not linhaVisao.Parent then
        if linhaVisao then linhaVisao:Destroy() end
        linhaVisao = Instance.new("Part")
        linhaVisao.Name = "LinhaVisao"
        linhaVisao.Anchored = true
        linhaVisao.CanCollide = false
        linhaVisao.Transparency = 0.1
        linhaVisao.Color = Color3.fromRGB(0, 255, 0)
        linhaVisao.Material = Enum.Material.Neon
        linhaVisao.Size = Vector3.new(1.0, 1.0, 100)
        linhaVisao.Parent = Workspace
    end

    local meio = (posInicio + posFim) / 2
    local distancia = (posInicio - posFim).Magnitude
    if distancia < 0.1 then distancia = 0.1 end
    linhaVisao.Size = Vector3.new(1.0, 1.0, distancia)
    linhaVisao.CFrame = CFrame.lookAt(meio, posFim)
    linhaVisao.Transparency = 0.1
end

local function atualizarAdvinhaChute()
    if not advinhaChuteEnabled then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    if not bola or not bolaValida then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local vel = bola.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local gravidade = Vector3.new(0, -50, 0)
    local pos = bola.Position
    local v = vel
    local dt = 0.02
    local maxPassos = 500
    local chaoY = 0

    local pontos = {}
    table.insert(pontos, pos)
    for i = 1, maxPassos do
        v = v + gravidade * dt
        pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then break end
    end

    if #pontos < 2 then
        if linhaChute then linhaChute:Destroy() linhaChute = nil end
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local inicio = pontos[1]
    local fim = pontos[#pontos]
    local meio = (inicio + fim) / 2
    local distancia = (inicio - fim).Magnitude

    if not linhaChute or not linhaChute.Parent then
        if linhaChute then linhaChute:Destroy() end
        linhaChute = Instance.new("Part")
        linhaChute.Name = "LinhaChute"
        linhaChute.Anchored = true
        linhaChute.CanCollide = false
        linhaChute.Transparency = 0.2
        linhaChute.Color = Color3.fromRGB(255, 255, 0)
        linhaChute.Material = Enum.Material.Neon
        linhaChute.Size = Vector3.new(0.5, 0.5, 25)
        linhaChute.Parent = Workspace
    end

    if distancia > 0.1 then
        linhaChute.Size = Vector3.new(0.5, 0.5, distancia)
        linhaChute.CFrame = CFrame.lookAt(meio, fim)
        linhaChute.Transparency = 0.2
    else
        linhaChute.Transparency = 1
    end

    if v.Y < -0.5 then
        local posFinal = Vector3.new(fim.X, chaoY, fim.Z)
        if not circuloChute or not circuloChute.Parent then
            if circuloChute then circuloChute:Destroy() end
            circuloChute = Instance.new("Part")
            circuloChute.Name = "CirculoChute"
            circuloChute.Anchored = true
            circuloChute.CanCollide = false
            circuloChute.Transparency = 0.2
            circuloChute.Color = Color3.fromRGB(255, 255, 0)
            circuloChute.Material = Enum.Material.Neon
            circuloChute.Shape = Enum.PartType.Cylinder
            circuloChute.Size = Vector3.new(4, 0.1, 4)
            circuloChute.Parent = Workspace
        end
        circuloChute.Position = posFinal
        local t = math.clamp(vel.Magnitude / 8, 3, 8)
        circuloChute.Size = Vector3.new(t, 0.1, t)
        circuloChute.Transparency = 0.2
    else
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
    end
end

