local function shouldAimbotWorkAzure()
    local tenho = euTenhoBolaAzure()
    if tenho then
        aimbotBlockedAzure = true
        aimbotBlockedUntilAzure = tick() + aimbotDelayValueAzure
        return false
    end
    if aimbotBlockedAzure then
        if tick() >= aimbotBlockedUntilAzure then aimbotBlockedAzure = false; return true
        else return false end
    end
    return true
end

