-- =============================================
-- FUNÇÕES DE SALVAMENTO E CARREGAMENTO (COM VERIFICAÇÃO)
-- =============================================
local function SaveConfig()
    if not writefile then
        warn("[Save] writefile não disponível!")
        return false
    end

    -- Tenta criar a pasta
    if isfolder then
        pcall(function()
            if not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
        end)
    end

    local json, err = pcall(HttpService.JSONEncode, HttpService, Config)
    if not json then
        warn("[Save] Erro ao codificar JSON: " .. tostring(err))
        return false
    end

    local saved = false
    -- Tenta salvar na pasta
    pcall(function()
        writefile(CONFIG_FILE, json)
        saved = true
    end)

    -- Fallback: salva na raiz
    if not saved then
        pcall(function()
            writefile(FALLBACK_FILE, json)
            saved = true
        end)
    end

    if saved then
        print("[Save] Configurações salvas com sucesso!")
    else
        warn("[Save] FALHA ao salvar! Verifique permissões do executor.")
    end
    return saved
end

local function LoadConfig()
    if not isfile then
        print("[Load] isfile não disponível.")
        return false
    end

    local content
    -- Tenta ler da pasta
    if isfile(CONFIG_FILE) then
        local ok, data = pcall(readfile, CONFIG_FILE)
        if ok and data then
            content = data
            print("[Load] Lido de " .. CONFIG_FILE)
        end
    end

    -- Se não achou, tenta fallback
    if not content and isfile(FALLBACK_FILE) then
        local ok, data = pcall(readfile, FALLBACK_FILE)
        if ok and data then
            content = data
            print("[Load] Lido de " .. FALLBACK_FILE)
        end
    end

    if content then
        local decoded, err = pcall(HttpService.JSONDecode, HttpService, content)
        if decoded and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                Config[k] = v
            end
            print("[Load] Configurações carregadas com sucesso!")
            return true
        else
            warn("[Load] Erro ao decodificar JSON: " .. tostring(err))
        end
    else
        print("[Load] Nenhum arquivo encontrado. Usando padrões.")
    end
    return false
end

-- Carrega as configurações ao iniciar
LoadConfig()

-- =============================================
-- SALVAMENTO AUTOMÁTICO (LOOP INTELIGENTE)
-- =============================================
local lastSaveTime = 0
local autoSaveInterval = 0.5
local fpsMonitor = 60
local frameCount = 0
local frameTime = 0

RunService.Heartbeat:Connect(function(dt)
    frameCount = frameCount + 1
    frameTime = frameTime + dt
    if frameTime >= 0.5 then
        fpsMonitor = frameCount / frameTime
        frameCount = 0
        frameTime = 0
        autoSaveInterval = (fpsMonitor < 30) and 1.0 or 0.5
    end

    if tick() - lastSaveTime >= autoSaveInterval then
        SaveConfig()
        lastSaveTime = tick()
    end
end)

