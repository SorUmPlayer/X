-- =====================================================
--  FUNÇÃO SEGURA DE PARENT
-- =====================================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

-- =====================================================
--  DETECÇÃO DA BOLA (BLUE LOCK RIVALS)
-- =====================================================
local function getBall()
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then
                return ballAnims
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
        return football
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child:FindFirstChild("Football") then
            return child:FindFirstChild("Football")
        end
    end
    return nil
end

local function getHitbox()
    local ball = getBall()
    if ball then
        return ball:FindFirstChild("Hitbox") or ball
    end
    return nil
end

local function euTenhoBola()
    local meuModel = Workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  AIMBOT
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local gyro = nil
local aimbotDelayValues = {0, 0.1, 0.2, 0.25, 0.40, 0.60, 0.70, 1.0, 2.0, 3.0, 5.0}
local aimbotDelayValue = 0
local aimbotBlocked = false
local aimbotBlockedUntil = 0

local function shouldAimbotWork()
    local tenho = euTenhoBola()
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    return true
end

local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not shouldAimbotWork() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local hitbox = getHitbox()
    if not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if not shouldAimbotWork() then return end

    local hitbox = getHitbox()
    if not hitbox then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

-- =====================================================
--  VISÃO DE JOGO
-- =====================================================
local visaoBolaEnabled = false
local advinhaChuteEnabled = false
local linhaVisao = nil
local linhaChuteParts = {}
local circuloChute = nil

local function getInimigoComBola()
    for _, outro in ipairs(Players:GetPlayers()) do
        if outro ~= player and outro.Character then
            local football = outro.Character:FindFirstChild("Football")
            if football then
                return outro.Character
            end
        end
    end
    return nil
end

local function criarLinhaVisao()
    if not linhaVisao or not linhaVisao.Parent then
        if linhaVisao then linhaVisao:Destroy() end
        linhaVisao = Instance.new("Part")
        linhaVisao.Name = "LinhaVisao"
        linhaVisao.Anchored = true
        linhaVisao.CanCollide = false
        linhaVisao.Transparency = 0.15
        linhaVisao.Color = Color3.fromRGB(0, 255, 0)
        linhaVisao.Material = Enum.Material.Neon
        linhaVisao.Size = Vector3.new(0.8, 0.8, 100)
        linhaVisao.Parent = workspace
    end
    return linhaVisao
end

local function atualizarVisaoBola()
    if not visaoBolaEnabled then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local inimigoChar = getInimigoComBola()
    if not inimigoChar then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local head = inimigoChar:FindFirstChild("Head")
    local hrp = inimigoChar:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp or inimigoChar.PrimaryPart
    if not origem then
        if linhaVisao then linhaVisao:Destroy() linhaVisao = nil end
        return
    end

    local posInicio = origem.Position
    if origem == hrp then
        posInicio = posInicio + Vector3.new(0, 1.5, 0)
    end

    local direcao = Vector3.new(1, 0, 0)
    if head then
        direcao = head.CFrame.LookVector
    elseif hrp then
        direcao = hrp.CFrame.LookVector
    end
    direcao = Vector3.new(direcao.X, 0, direcao.Z)
    if direcao.Magnitude < 0.001 then
        direcao = Vector3.new(1, 0, 0)
    else
        direcao = direcao.Unit
    end

    local posFim = posInicio + direcao * 100

    criarLinhaVisao()
    local meio = (posInicio + posFim) / 2
    local distancia = (posInicio - posFim).Magnitude
    if distancia < 0.1 then distancia = 0.1 end
    linhaVisao.Size = Vector3.new(0.8, 0.8, distancia)
    linhaVisao.CFrame = CFrame.lookAt(meio, posFim)
    linhaVisao.Transparency = 0.15
end

local function criarParteTrajetoria(pos, cor)
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 0.3
    part.Color = cor
    part.Material = Enum.Material.Neon
    part.Size = Vector3.new(0.4, 0.4, 0.4)
    part.Position = pos
    part.Parent = workspace
    return part
end

local function atualizarAdvinhaChute()
    if not advinhaChuteEnabled then
        for _, p in ipairs(linhaChuteParts) do p:Destroy() end
        linhaChuteParts = {}
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local ball = getBall()
    if not ball then
        for _, p in ipairs(linhaChuteParts) do p:Destroy() end
        linhaChuteParts = {}
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < 0.5 then
        for _, p in ipairs(linhaChuteParts) do p:Destroy() end
        linhaChuteParts = {}
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local gravidade = Vector3.new(0, -55, 0)
    local pos = ball.Position
    local v = vel
    local dt = 0.03
    local maxPassos = 120
    local chaoY = 0

    local pontos = {}
    table.insert(pontos, pos)

    for i = 1, maxPassos do
        v = v + gravidade * dt
        pos = pos + v * dt
        table.insert(pontos, pos)
        if pos.Y <= chaoY then
            break
        end
    end

    for _, p in ipairs(linhaChuteParts) do p:Destroy() end
    linhaChuteParts = {}

    if #pontos < 2 then
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
        return
    end

    local cor = Color3.fromRGB(255, 255, 0)
    for i = 1, #pontos - 1 do
        local p1 = pontos[i]
        local p2 = pontos[i+1]
        local meio = (p1 + p2) / 2
        local dist = (p1 - p2).Magnitude
        if dist > 0.1 then
            local part = criarParteTrajetoria(meio, cor)
            part.Size = Vector3.new(0.3, 0.3, dist)
            part.CFrame = CFrame.lookAt(meio, p2)
            table.insert(linhaChuteParts, part)
        end
    end

    local posFinal = pontos[#pontos]
    posFinal = Vector3.new(posFinal.X, chaoY, posFinal.Z)

    if v.Y < -0.5 then
        if not circuloChute or not circuloChute.Parent then
            if circuloChute then circuloChute:Destroy() end
            circuloChute = Instance.new("Part")
            circuloChute.Name = "CirculoChute"
            circuloChute.Anchored = true
            circuloChute.CanCollide = false
            circuloChute.Transparency = 0.2
            circuloChute.Color = Color3.fromRGB(255, 255, 0)
            circuloChute.Material = Enum.Material.Neon
            circuloChute.Shape = Enum.PartType.Cylinder
            circuloChute.Size = Vector3.new(4, 0.1, 4)
            circuloChute.Parent = workspace
        end
        circuloChute.Position = posFinal
        local tamanho = math.clamp(vel.Magnitude / 8, 3, 8)
        circuloChute.Size = Vector3.new(tamanho, 0.1, tamanho)
        circuloChute.Transparency = 0.2
    else
        if circuloChute then circuloChute:Destroy() circuloChute = nil end
    end
end

-- =====================================================
--  DRIBLE (BYTENETRELIABLE)
-- =====================================================
local ByteNet = ReplicatedStorage:FindFirstChild("ByteNetReliable")
local dribleEnabled = false
local dribleSphere = nil
local dribleLastFired = 0
local dribleCooldown = 0.3
local dribleAnimId = "18668814876"
local driblePlayingAnims = {}
local dribleRadius = 25

local function dispararDrible()
    if not ByteNet then return end
    local args = {24, 1}
    local buffer = buffer.create(#args)
    for i, v in ipairs(args) do
        buffer.writeu8(buffer, i - 1, v)
    end
    ByteNet:FireServer(buffer, { {"dribble", false} })
end

local function setupDrible()
    if not dribleSphere then
        dribleSphere = Instance.new("Part")
        dribleSphere.Name = "DetectionSphereVisual"
        dribleSphere.Shape = Enum.PartType.Ball
        dribleSphere.Size = Vector3.new(dribleRadius * 2, dribleRadius * 2, dribleRadius * 2)
        dribleSphere.Material = Enum.Material.ForceField
        dribleSphere.Color = Color3.fromRGB(255, 0, 128)
        dribleSphere.Transparency = 0.6
        dribleSphere.CanCollide = false
        dribleSphere.Anchored = false
        dribleSphere.CastShadow = false
        dribleSphere.Parent = workspace
    end
end

local function trackDribleAnimation(character)
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChild("Animator") or humanoid

    local function checkTrack(track)
        if not track or not track.Animation then return end
        local animId = tostring(track.Animation.AnimationId)
        if string.find(animId, dribleAnimId) then
            driblePlayingAnims[character] = true
            local connStopped, connEnded
            connStopped = track.Stopped:Connect(function()
                driblePlayingAnims[character] = nil
                if connStopped then connStopped:Disconnect() end
                if connEnded then connEnded:Disconnect() end
            end)
            connEnded = track.Ended:Connect(function()
                driblePlayingAnims[character] = nil
                if connStopped then connStopped:Disconnect() end
                if connEnded then connEnded:Disconnect() end
            end)
        end
    end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        checkTrack(track)
    end
    animator.AnimationPlayed:Connect(checkTrack)
end

local function setupDriblePlayerTracking(plr)
    if plr == player then return end
    if plr.Character then
        task.spawn(trackDribleAnimation, plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        driblePlayingAnims[char] = nil
        task.spawn(trackDribleAnimation, char)
    end)
end

local function isDribleAnimActive(character)
    if driblePlayingAnims[character] then return true end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    local animator = humanoid:FindFirstChild("Animator") or humanoid
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation and string.find(tostring(track.Animation.AnimationId), dribleAnimId) then
            return true
        end
    end
    return false
end

local function isLookingAtLocal(targetHrp, localHrp)
    local directionToLocal = (localHrp.Position - targetHrp.Position).Unit
    local lookVector = targetHrp.CFrame.LookVector
    return lookVector:Dot(directionToLocal) >= 0.5
end

local function aplicarDrible()
    if not dribleEnabled then
        if dribleSphere then
            dribleSphere.Transparency = 1
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if dribleSphere then
        dribleSphere.Position = hrp.Position
        dribleSphere.Transparency = 0.6
        dribleSphere.Parent = workspace
    end

    local now = tick()
    if now - dribleLastFired < dribleCooldown then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local targetChar = plr.Character
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist <= dribleRadius then
                    if isLookingAtLocal(targetHrp, hrp) then
                        if isDribleAnimActive(targetChar) then
                            dribleLastFired = now
                            dispararDrible()
                            break
                        end
                    end
                end
            end
        end
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
    setupDriblePlayerTracking(plr)
end
Players.PlayerAdded:Connect(setupDriblePlayerTracking)
Players.PlayerRemoving:Connect(function(plr)
    if plr.Character then
        driblePlayingAnims[plr.Character] = nil
    end
end)

-- =====================================================
--  GK (GOLEIRO) – COM TELEPORTE FORÇADO
-- =====================================================
local gkEnabled = false
local gkTeam = nil
local gkPosition = nil
local gkCircle = nil
local gkRadius = 30
local gkGrabRadius = 5
local gkLastDive = 0
local gkDiveCooldown = 1.0

-- Determina o time pela posição
local function determinarTime()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local pos = hrp.Position
    local homePos = Vector3.new(-234, 11, -49)
    local awayPos = Vector3.new(311, 11, -48)

    if (pos - homePos).Magnitude < (pos - awayPos).Magnitude then
        return "Home"
    else
        return "Away"
    end
end

-- Posição fixa do goleiro
local function getGKPosition()
    if gkTeam == "Home" then
        return Vector3.new(-234, 11, -47)
    elseif gkTeam == "Away" then
        return Vector3.new(311, 11, -50)
    else
        return nil
    end
end

-- Cria círculo de detecção
local function criarCirculoGK()
    if gkCircle then return end
    if not gkPosition then return end

    gkCircle = Instance.new("Part")
    gkCircle.Name = "GKDetectionCircle"
    gkCircle.Shape = Enum.PartType.Cylinder
    gkCircle.Size = Vector3.new(gkRadius * 2, 0.5, gkRadius * 2)
    gkCircle.Position = gkPosition
    gkCircle.Transparency = 0.6
    gkCircle.Color = Color3.fromRGB(0, 150, 255)
    gkCircle.Anchored = true
    gkCircle.CanCollide = false
    gkCircle.Parent = workspace
    print("Círculo GK criado!")
end

-- Remove o círculo
local function removerCirculoGK()
    if gkCircle then
        gkCircle:Destroy()
        gkCircle = nil
    end
end

-- Teleporta o personagem para uma posição
local function teleportarPersonagem(pos)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(pos)
end

-- Funções do goleiro
local function pegarBola(ball)
    local tempPart = Instance.new("Part")
    tempPart.Size = Vector3.new(2, 2, 2)
    tempPart.Position = gkPosition
    tempPart.Anchored = true
    tempPart.CanCollide = false
    tempPart.Transparency = 1
    tempPart.Parent = workspace

    if firetouchinterest then
        firetouchinterest(tempPart, ball, 0)
        task.wait(0.01)
        firetouchinterest(tempPart, ball, 1)
    end

    tempPart:Destroy()
    print("Bola pega!")
end

local function chutarLonge(ball)
    local dir = (ball.Position - gkPosition).Unit
    local shootEvent = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Knit")
        and ReplicatedStorage.Packages.Knit:FindFirstChild("Services")
        and ReplicatedStorage.Packages.Knit.Services:FindFirstChild("BallService")
        and ReplicatedStorage.Packages.Knit.Services.BallService:FindFirstChild("RE")
        and ReplicatedStorage.Packages.Knit.Services.BallService.RE:FindFirstChild("Shoot")
    if shootEvent then
        shootEvent:FireServer(110, ball.Position + dir * 60)
        print("Chutou longe!")
    end
end

local function usarDive()
    local now = tick()
    if now - gkLastDive < gkDiveCooldown then return end
    gkLastDive = now

    local diveEvent = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Knit")
        and ReplicatedStorage.Packages.Knit:FindFirstChild("Services")
        and ReplicatedStorage.Packages.Knit.Services:FindFirstChild("BallService")
        and ReplicatedStorage.Packages.Knit.Services.BallService:FindFirstChild("RE")
        and ReplicatedStorage.Packages.Knit.Services.BallService.RE:FindFirstChild("Dive")
    if diveEvent then
        diveEvent:FireServer()
        print("Dive usado!")
    end
end

-- Adversário com bola na área AttemptGrabBox
local function getAdversarioComBolaNaArea()
    local area = workspace:FindFirstChild("AttemptGrabBox")
    if not area or not area:IsA("BasePart") then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char and char:FindFirstChild("Football") then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local relative = hrp.Position - area.Position
                    local size = area.Size / 2
                    if math.abs(relative.X) <= size.X and
                       math.abs(relative.Y) <= size.Y and
                       math.abs(relative.Z) <= size.Z then
                        return plr
                    end
                end
            end
        end
    end
    return nil
end

-- Posiciona o goleiro na frente do adversário
local function posicionarFrenteAdversario(adversario)
    local char = adversario.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local advPos = hrp.Position
    local dir = (gkPosition - advPos).Unit
    local novaPos = advPos + dir * 8

    gkPosition = novaPos
    if gkCircle then
        gkCircle.Position = novaPos
    end
    teleportarPersonagem(novaPos)
    print("Posicionado na frente do adversário.")
end

-- Restaura posição fixa
local function restaurarPosicaoGK()
    local pos = getGKPosition()
    if pos then
        gkPosition = pos
        if gkCircle then
            gkCircle.Position = pos
        end
        teleportarPersonagem(pos)
        print("Voltou à posição fixa.")
    end
end

-- Inicializa o GK
local function iniciarGK()
    gkTeam = determinarTime()
    if not gkTeam then
        warn("Não foi possível determinar o time. Fique perto do gol.")
        return
    end

    gkPosition = getGKPosition()
    if not gkPosition then
        warn("Posição do gol não encontrada.")
        return
    end

    print("GK Ativado! Time: " .. gkTeam)
    criarCirculoGK()
    teleportarPersonagem(gkPosition)
    gkEnabled = true
end

-- Desativa o GK
local function desativarGK()
    gkEnabled = false
    removerCirculoGK()
    print("GK Desativado.")
end

-- Função principal atualizarGK
local function atualizarGK()
    if not gkEnabled then return end
    if not gkPosition then return end

    local ball = getBall()
    if not ball then return end

    local distBola = (ball.Position - gkPosition).Magnitude

    -- Dentro do círculo?
    if distBola <= gkRadius then
        local vel = ball.AssemblyLinearVelocity
        local speed = vel.Magnitude

        if speed < 2 then
            pegarBola(ball)
            chutarLonge(ball)
        else
            local dirBola = vel.Unit
            local dirGol = (gkPosition - ball.Position).Unit
            local dot = dirBola:Dot(dirGol)

            if dot > 0.3 then
                if speed > 15 or distBola > 15 then
                    usarDive()
                elseif distBola < gkGrabRadius then
                    pegarBola(ball)
                    chutarLonge(ball)
                end
            end
        end
    end

    -- Adversário na área?
    local adv = getAdversarioComBolaNaArea()
    if adv then
        posicionarFrenteAdversario(adv)
    else
        restaurarPosicaoGK()
    end
end

-- =====================================================
--  BOTÃO VOADOR DA CÂMERA
-- =====================================================
local cameraButtonActive = false
local cameraScreenGui = nil
local cameraToggleButton = nil

local function toggleCameraButton()
    cameraButtonActive = not cameraButtonActive
    if cameraButtonActive then
        if cameraToggleButton then
            cameraToggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            cameraToggleButton.Text = "Aimbot Cam [ON]"
        end
        aimbotCamera = true
    else
        if cameraToggleButton then
            cameraToggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            cameraToggleButton.Text = "Aimbot Cam [OFF]"
        end
        aimbotCamera = false
    end
end

local function criarBotaoCameraFlutuante()
    if cameraScreenGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CameraAimbotGui"
    screenGui.ResetOnSpawn = false
    safeParent(screenGui)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.15, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Aimbot Cam [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn

    btn.MouseButton1Click:Connect(toggleCameraButton)

    cameraToggleButton = btn
    cameraScreenGui = screenGui
end

local function removerBotaoCameraFlutuante()
    if cameraButtonActive then
        toggleCameraButton()
    end
    if cameraScreenGui then
