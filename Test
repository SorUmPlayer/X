local UIS = game:GetService("UserInputService")

local abilities = {
    [Enum.KeyCode.One] = 1,
    [Enum.KeyCode.Two] = 2,
    [Enum.KeyCode.Three] = 3,
    [Enum.KeyCode.Four] = 4,
    [Enum.KeyCode.Five] = 5
}

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    local ability = abilities[input.KeyCode]

    if ability then
        print("Ativando habilidade:", ability)

        -- No seu próprio jogo:
        -- AbilityEvent:FireServer(ability)
    end
end)
