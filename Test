-- Script LocalScript (coloque em StarterGui ou dentro de um ScreenGui)
local player = game.Players.LocalPlayer

-- Cria a interface
local gui = Instance.new("ScreenGui")
gui.Parent = player.PlayerGui

-- Frame principal (verde)
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 450, 0, 250)
frame.Position = UDim2.new(0.5, -225, 0.5, -125)
frame.BackgroundColor3 = Color3.fromRGB(0, 180, 0) -- verde
frame.BackgroundTransparency = 0.15
frame.BorderSizePixel = 0
frame.Parent = gui

-- Texto da mensagem (inicial em português)
local mensagem = Instance.new("TextLabel")
mensagem.Size = UDim2.new(1, -20, 0, 60)
mensagem.Position = UDim2.new(0, 10, 0, 10)
mensagem.BackgroundTransparency = 1
mensagem.Text = "Olá! Selecione o idioma abaixo."
mensagem.TextColor3 = Color3.fromRGB(255, 255, 255)
mensagem.TextScaled = true
mensagem.Font = Enum.Font.SourceSansBold
mensagem.Parent = frame

-- Traduções
local traducoes = {
    Portugues = "Olá! Selecione o idioma abaixo.",
    English = "Hello! Select a language below.",
    Espanhol = "¡Hola! Selecciona un idioma abajo."
}

-- Função para traduzir
local function traduzir(idioma)
    mensagem.Text = traducoes[idioma] or mensagem.Text
end

-- Botão "Português" (verde)
local btnPT = Instance.new("TextButton")
btnPT.Size = UDim2.new(0, 120, 0, 45)
btnPT.Position = UDim2.new(0.5, -185, 0, 90)
btnPT.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
btnPT.Text = "Português"
btnPT.TextColor3 = Color3.fromRGB(255, 255, 255)
btnPT.Font = Enum.Font.SourceSansBold
btnPT.TextScaled = true
btnPT.Parent = frame
btnPT.MouseButton1Click:Connect(function() traduzir("Portugues") end)

-- Botão "English" (azul)
local btnEN = Instance.new("TextButton")
btnEN.Size = UDim2.new(0, 120, 0, 45)
btnEN.Position = UDim2.new(0.5, -60, 0, 90)
btnEN.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
btnEN.Text = "English"
btnEN.TextColor3 = Color3.fromRGB(255, 255, 255)
btnEN.Font = Enum.Font.SourceSansBold
btnEN.TextScaled = true
btnEN.Parent = frame
btnEN.MouseButton1Click:Connect(function() traduzir("English") end)

-- Botão "Espanhol" (laranja)
local btnES = Instance.new("TextButton")
btnES.Size = UDim2.new(0, 120, 0, 45)
btnES.Position = UDim2.new(0.5, 65, 0, 90)
btnES.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
btnES.Text = "Espanhol"
btnES.TextColor3 = Color3.fromRGB(255, 255, 255)
btnES.Font = Enum.Font.SourceSansBold
btnES.TextScaled = true
btnES.Parent = frame
btnES.MouseButton1Click:Connect(function() traduzir("Espanhol") end)

-- Botão "Copiar link" (cinza)
local btnCopy = Instance.new("TextButton")
btnCopy.Size = UDim2.new(0, 160, 0, 45)
btnCopy.Position = UDim2.new(0.5, -80, 0, 160)
btnCopy.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
btnCopy.Text = "Copiar link"
btnCopy.TextColor3 = Color3.fromRGB(255, 255, 255)
btnCopy.Font = Enum.Font.SourceSansBold
btnCopy.TextScaled = true
btnCopy.Parent = frame

-- Ação do botão copiar
btnCopy.MouseButton1Click:Connect(function()
    local sucesso, erro = pcall(function()
        setclipboard("https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp")
    end)
    if sucesso then
        btnCopy.Text = "✅ Link copiado!"
        task.wait(2)
        btnCopy.Text = "Copiar link"
    else
        btnCopy.Text = "❌ Erro ao copiar"
        task.wait(1.5)
        btnCopy.Text = "Copiar link"
    end
end)
