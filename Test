-- =============================================
-- DETECÇÃO DA BOLA
-- =============================================
local function getBall()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        local animBall = basketball:FindFirstChild("AnimBall")
        if animBall and animBall:IsA("BasePart") then
            return animBall
        end
        local collider = basketball:FindFirstChild("Collider")
        if collider and collider:IsA("BasePart") then
            return collider
        end
    end
    return nil
end

local function getHitbox()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        local collider = basketball:FindFirstChild("Collider")
        if collider and collider:IsA("BasePart") then
            return collider
        end
        local animBall = basketball:FindFirstChild("AnimBall")
        if animBall and animBall:IsA("BasePart") then
            return animBall
        end
    end
    return nil
end

-- =============================================
-- POSSE DA BOLA (simplificada)
-- =============================================
local function euTenhoBola()
    -- Verifica se a bola está no character do jogador
    local char = player.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("BasePart") and child.Name == "AnimBall" then
                return true
            end
        end
    end
    return false
end

-- =============================================
-- VARIÁVEIS
-- =============================================
local aimbotPersonagem = Config.aimbotPersonagem
local aimbotCamera = Config.aimbotCamera
local aimbotDelayValue = Config.aimbotDelay
local aimbotBlocked = false
local aimbotBlockedUntil = 0

local hitboxAtivo = Config.hitboxAtivo
local hitboxTamanho = Config.hitboxTamanho
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

local gyro = nil
local aimbotDelayValues = {0, 0.1, 0.2, 0.25, 0.40, 0.60, 0.70, 1.0, 2.0, 3.0, 5.0}

-- =============================================
-- LÓGICA DE BLOQUEIO (DELAY)
-- =============================================
local function shouldAimbotWork()
    local tenho = euTenhoBola()
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    return true
end

-- =============================================
-- AIMBOT PERSONAGEM
-- =============================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    Config.aimbotPersonagem = estado
    SaveConfig()
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not shouldAimbotWork() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local ball = getBall()
    if not ball then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = ball.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =============================================
-- AIMBOT CÂMERA
-- =============================================
local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if not shouldAimbotWork() then return end

    local ball = getBall()
    if not ball then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local posBola = ball.Position
    local posJogador = hrp.Position
    local direction = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

-- =============================================
-- HITBOX
-- =============================================
local function aplicarHitbox()
    local hitbox = getHitbox()
    if not hitbox then return end

    if not hitboxAtivo then
        if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end

    local novoSize = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 1 -- invisível
    end
end

-- =============================================
-- LOOP PRINCIPAL
-- =============================================
RunService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarHitbox()
end)

