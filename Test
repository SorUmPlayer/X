-- SHOULD AIMBOT
-- =============================================
local function shouldAimbotWork()
    if euTenhoBola() then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then aimbotBlocked = false; return true
        else return false end
    end
    return true
end

-- =============================================
-- REACH DA BOLA (fix AWK)
-- =============================================
local function aplicarReachBola()
    if not hitbox then return end
    local agora = tick()
    if alguemTemBola() then hitboxDesativadoAte = agora + 0.5 end
    if agora < hitboxDesativadoAte then
        if hitbox.Size ~= hitboxOriginalSize then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end
    if not reachBolaAtivo then
        if hitbox.Size ~= hitboxOriginalSize then
            hitbox.Size = hitboxOriginalSize
            hitbox.Transparency = hitboxOriginalTransparency
        end
        return
    end
    local td = Vector3.new(reachBolaDistancia, reachBolaDistancia, reachBolaDistancia)
    if hitbox.Size ~= td or hitbox.Transparency ~= 1 then
        hitbox.Size = td
        hitbox.Transparency = 1
    end
end

