local function getInimigoComBola()
    local myTeam = getMyTeam()
    if not myTeam then return nil end
    for _, outro in ipairs(Players:GetPlayers()) do
        if outro ~= player and outro.Character and outro.Character:FindFirstChild("Football") then
            local values = outro:FindFirstChild("Values")
            if values then
                local teamVal = values:FindFirstChild("Team")
                if teamVal and tostring(teamVal.Value) ~= myTeam then return outro end
            end
        end
    end
    return nil
end

local function criarLinhaVisao()
    if not linhaVisao or not linhaVisao.Parent then
        if linhaVisao then linhaVisao:Destroy() end
        linhaVisao = Instance.new("Part")
        linhaVisao.Name = "LinhaVisao"; linhaVisao.Anchored = true; linhaVisao.CanCollide = false
        linhaVisao.Transparency = 0.1; linhaVisao.Color = Color3.fromRGB(0, 255, 0)
        linhaVisao.Material = Enum.Material.Neon; linhaVisao.Size = Vector3.new(1.0, 1.0, 100)
        linhaVisao.Parent = workspace
    end
    return linhaVisao
end

local function atualizarVisaoBola()
    if not visaoBolaEnabled then
        if linhaVisao then linhaVisao:Destroy(); linhaVisao = nil end
        return
    end
    local inimigo = getInimigoComBola()
    if not inimigo then
        if linhaVisao then linhaVisao:Destroy(); linhaVisao = nil end
        return
    end
    local char = inimigo.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local origem = head or hrp
    if not origem then return end
    local posInicio = origem.Position
    if origem == hrp then posInicio = posInicio + Vector3.new(0, 1.5, 0) end
    local dir = Vector3.new(1, 0, 0)
    if head then dir = head.CFrame.LookVector
    elseif hrp then dir = hrp.CFrame.LookVector end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.001 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
    local posFim = posInicio + dir * 100
    criarLinhaVisao()
    local meio = (posInicio + posFim) / 2
    local dist = (posInicio - posFim).Magnitude
    if dist < 0.1 then dist = 0.1 end
    linhaVisao.Size = Vector3.new(1.0, 1.0, dist)
    linhaVisao.CFrame = CFrame.lookAt(meio, posFim)
end

