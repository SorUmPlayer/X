    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not gyroAzure then
        gyroAzure = Instance.new("BodyGyro")
        gyroAzure.Parent = hrp
        gyroAzure.D = 1000
        gyroAzure.P = 10000
        gyroAzure.MaxTorque = Vector3.new(8000, 8000, 8000)
