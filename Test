-- =============================================
-- DETECÇÃO DA BOLA E POSSE
-- =============================================
local function getBall()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        local animBall = basketball:FindFirstChild("AnimBall")
        if animBall and animBall:IsA("BasePart") then
            return animBall
        end
    end
    return nil
end

local function getCollider()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        local collider = basketball:FindFirstChild("Collider")
        if collider and collider:IsA("BasePart") then
            return collider
        end
    end
    return nil
end

local function euTenhoBola()
    local ball = getBall()
    if not ball then return false end
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - ball.Position).Magnitude < 2.5
end

local function getInimigoComBola()
    -- Verifica se algum outro jogador está com a bola (distância < 2.5)
    local ball = getBall()
    if not ball then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - ball.Position).Magnitude < 2.5 then
                return plr
            end
        end
    end
    return nil
end

-- =============================================
-- AIMBOT CÂMERA
-- =============================================
local aimbotCameraAtivo = Config.aimbotCamera
local cameraButtonAtivo = Config.botaoCamera
local aimbotDelayValues = {0, 0.1, 0.2, 0.25, 0.40, 0.60, 0.70, 1.0, 2.0, 3.0, 5.0}
local aimbotDelay = Config.aimbotDelay
local aimbotBlocked = false
local aimbotBlockedUntil = 0

local cameraScreenGui = nil
local cameraToggleButton = nil

local function shouldAimbotWork()
    local tenho = euTenhoBola()
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelay
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    return true
end

local function atualizarAimbotCamera()
    if not aimbotCameraAtivo then return end
    if not shouldAimbotWork() then return end

    local ball = getBall()
    if not ball then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local direction = (ball.Position - hrp.Position).Unit
    local camPos = hrp.Position - direction * 10 + Vector3.new(0, 5, 0)
    camera.CFrame = CFrame.new(camPos, hrp.Position)
end

-- =============================================
-- BOTÃO VOADOR DA CÂMERA
-- =============================================
local function toggleCameraButton()
    cameraButtonAtivo = not cameraButtonAtivo
    if cameraButtonAtivo then
        if cameraToggleButton then
            cameraToggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            cameraToggleButton.Text = "Aimbot Cam [ON]"
        end
        aimbotCameraAtivo = true
        Config.aimbotCamera = true
        SaveConfig()
    else
        if cameraToggleButton then
            cameraToggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            cameraToggleButton.Text = "Aimbot Cam [OFF]"
        end
        aimbotCameraAtivo = false
        Config.aimbotCamera = false
        SaveConfig()
    end
end

local function criarBotaoCameraFlutuante()
    if cameraScreenGui then return end
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CameraAimbotGui"
    screenGui.ResetOnSpawn = false
    safeParent(screenGui)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.15, 0)
    btn.BackgroundColor3 = cameraButtonAtivo and Color3.fromRGB(40, 167, 69) or Color3.fromRGB(220, 53, 69)
    btn.Text = cameraButtonAtivo and "Aimbot Cam [ON]" or "Aimbot Cam [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn
    btn.MouseButton1Click:Connect(toggleCameraButton)
    cameraToggleButton = btn
    cameraScreenGui = screenGui
end

local function removerBotaoCameraFlutuante()
    if cameraButtonAtivo then
        toggleCameraButton() -- desativa primeiro
    end
    if cameraScreenGui then
        cameraScreenGui:Destroy()
        cameraScreenGui = nil
        cameraToggleButton = nil
    end
end

-- =============================================
-- HITBOX
-- =============================================
local hitboxAtivo = Config.hitboxAtivo
local hitboxTamanho = Config.hitboxTamanho
local hitboxOriginalSize = nil

local function aplicarHitbox()
    local collider = getCollider()
    if not collider then return end

    if not hitboxAtivo then
        if hitboxOriginalSize then
            collider.Size = hitboxOriginalSize
        end
        return
    end

    -- Salva o tamanho original na primeira vez
    if not hitboxOriginalSize then
        hitboxOriginalSize = collider.Size
    end

    local tamanho = Vector3.new(hitboxTamanho, hitboxTamanho, hitboxTamanho)
    if collider.Size ~= tamanho then
        collider.Size = tamanho
    end
end

-- =============================================
-- LOOP PRINCIPAL
-- =============================================
RunService.Heartbeat:Connect(function()
    atualizarAimbotCamera()
    aplicarHitbox()
end)

