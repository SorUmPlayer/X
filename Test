-- --- LÓGICA DE EXECUÇÃO (LOOPS) ---

local function GetHRP()
    local character = LocalPlayer.Character
    if character then
        return character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function GetHumanoid()
    local character = LocalPlayer.Character
    if character then
        return character:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

-- Loop 1: Kill Aura em workspace.NPCs
task.spawn(function()
    while true do
        task.wait(Config.Delay)
        if Config.KillauraEnabled and DamageEvent then
            local hrp = GetHRP()
            local playerPos = hrp and hrp.Position
            local npcsFolder = workspace:FindFirstChild("NPCs")

            if playerPos and npcsFolder then
                for _, desc in ipairs(npcsFolder:GetDescendants()) do
                    if not Config.KillauraEnabled then break end
                    if desc:IsA("Humanoid") and desc.Health > 0 then
                        local model = desc.Parent
                        if model and model:IsA("Model") then
                            local targetHrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                            local inRange = true
                            if targetHrp then
                                local dist = (playerPos - targetHrp.Position).Magnitude
                                if dist > Config.KillauraDistance then
                                    inRange = false
                                end
                            end

                            if inRange then
                                pcall(function()
                                    DamageEvent:FireServer("NPCs", "Damage", desc, Config.KillauraDamage)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Loop 2: TP Cash (Teleporta, coleta e FICA no local)
task.spawn(function()
    while true do
        task.wait(0.3)
        if Config.CashEnabled and DamageEvent then
            pcall(function()
                local hrp = GetHRP()
                local cashFolder = workspace:FindFirstChild("Cash")

                if hrp and cashFolder then
                    for _, cashObj in ipairs(cashFolder:GetChildren()) do
                        if not Config.CashEnabled then break end

                        local part = nil
                        if cashObj:IsA("BasePart") then
                            part = cashObj
                        elseif cashObj:IsA("Model") then
                            part = cashObj.PrimaryPart or cashObj:FindFirstChildWhichIsA("BasePart")
                        end

                        if part then
                            hrp.CFrame = part.CFrame + Vector3.new(0, 2, 0)
                            task.wait(0.1)
                        end
                        DamageEvent:FireServer("Cash", "Collect", cashObj)
                    end
                end
            end)
        end
    end
end)

-- Loop 3: Quebrar Máquinas de forma segura
task.spawn(function()
    while true do
        task.wait(0.4)
        if Config.TemplateEnabled and DamageEvent then
            local map = workspace:FindFirstChild("Map")
            local buildings = map and map:FindFirstChild("Buildings")

            if buildings then
                local count = 0
                for _, desc in ipairs(buildings:GetDescendants()) do
                    if not Config.TemplateEnabled then break end
                    if desc:IsA("Model") and (desc.Name == "ATM" or desc.Name:find("Template") or desc.Name:find("Furniture") or desc:FindFirstChild("Humanoid") or desc:FindFirstChild("Health")) then
                        count = count + 1
                        if count > 15 then
                            count = 0
                            task.wait(0.2)
                        end
                        
                        pcall(function()
                            DamageEvent:FireServer(
                                "DamageToOpen",
                                "Damage",
                                desc,
                                Config.TemplateDamage,
                                "melee"
                            )
                        end)
                    end
                end
            end
        end
    end
end)

-- Loop 4: TP Loot (Passa por cada loot único, e ao terminar tudo ou desligar, retorna à posição original exata)
task.spawn(function()
    while true do
        task.wait(0.3)
        if Config.LootEnabled and FunctionEvent then
            pcall(function()
                local hrp = GetHRP()
                local lootFolder = workspace:FindFirstChild("Loot")

                if hrp and lootFolder then
                    local items = lootFolder:GetChildren()
                    if #items > 0 then
                        -- Salva a posição exata ANTES de começar a ir atrás dos loots
                        local originalPos = hrp.CFrame

                        for _, item in ipairs(items) do
                            if not Config.LootEnabled then break end
                            if not item.Parent then continue --> se o item já sumiu/foi pego, pula para o próximo

                            local handle = nil
                            if item:IsA("Tool") then
                                handle = item:FindFirstChild("Handle")
                            elseif item.Name == "Handle" and item:IsA("BasePart") then
                                handle = item
                            elseif item:IsA("Model") then
                                handle = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                            elseif item:IsA("BasePart") then
                                handle = item
                            end

                            if handle then
                                hrp.CFrame = handle.CFrame + Vector3.new(0, 2, 0)
                                task.wait(0.15)
                            end

                            pcall(function()
                                FunctionEvent:InvokeServer("Loot", "LootEquip", handle or item)
                            end)
                            task.wait(0.15)
                        end

                        -- Retorna rigorosamente para a coordenada de onde partiu
                        if originalPos then
                            hrp.CFrame = originalPos
                        end
                    end
                end

                -- Terminou de passar por todos os itens ou a pasta está vazia: desliga a opção automaticamente
                if Config.LootEnabled then
                    Config.LootEnabled = false
                    if LootToggleSetState then
                        LootToggleSetState(false)
                    end
                end
            end)
        end
    end
end)

-- Loop 5: SpeedWalkBoost
RunService.Stepped:Connect(function()
    if Config.SpeedEnabled then
        local humanoid = GetHumanoid()
        if humanoid then
            humanoid.WalkSpeed = Config.SpeedValue
        end
    else
        local humanoid = GetHumanoid()
        if humanoid and humanoid.WalkSpeed ~= 16 then
            humanoid.WalkSpeed = 16
        end
    end
end)

