-- CONFIG: FPS++, GRÁFICO, REMOVER LAG
-- =============================================
local originais = {
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    Brightness = Lighting.Brightness,
    GlobalShadows = Lighting.GlobalShadows,
    FogEnd = Lighting.FogEnd,
}
local efeitosSalvos = {}
local partsSombra = {}

local function aplicarFPSPlus()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(178, 178, 178)
        Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        Lighting.Brightness = 2
        Lighting.FogEnd = 100000
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") then
                efeitosSalvos[v] = v.Enabled
                v.Enabled = false
            end
        end
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                partsSombra[part] = part.CastShadow
                part.CastShadow = false
            end
        end
    end)
end

local function removerFPSPlus()
    pcall(function()
        Lighting.GlobalShadows = originais.GlobalShadows
        Lighting.Ambient = originais.Ambient
        Lighting.OutdoorAmbient = originais.OutdoorAmbient
        Lighting.Brightness = originais.Brightness
        Lighting.FogEnd = originais.FogEnd
        for v, e in pairs(efeitosSalvos) do
            if v and v.Parent then v.Enabled = e end
        end
        efeitosSalvos = {}
        for p, s in pairs(partsSombra) do
            if p and p.Parent then p.CastShadow = s end
        end
        partsSombra = {}
    end)
end

local function aplicarGrafico(nivel)
    pcall(function()
        if nivel == 0 then
            removerFPSPlus()
        elseif nivel == 1 then
            aplicarFPSPlus()
        elseif nivel == 2 then
            aplicarFPSPlus()
            for _, part in ipairs(Workspace:GetDescendants()) do
                if part:IsA("BasePart") and part.Material ~= Enum.Material.Plastic then
                    part.Material = Enum.Material.Plastic
                end
                if part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = 1
                end
            end
        elseif nivel == 3 then
            aplicarFPSPlus()
            for _, part in ipairs(Workspace:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Material = Enum.Material.Plastic
                    if part.Transparency < 0.9 and not part:FindFirstAncestorOfClass("Model") then
                        part.Transparency = 0.9
                    end
                end
                if part:IsA("Decal") or part:IsA("Texture") or part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Smoke") or part:IsA("Fire") or part:IsA("Sparkles") then
                    part.Enabled = false
                end
            end
        end
    end)
end

