local bola, hitbox, bolaValida = nil, nil, false

local function atualizarReferenciaBola()
    local f = Workspace:FindFirstChild("Football")
    if f then
        bola = f
        local hb = f:FindFirstChild("Hitbox")
        hitbox = (hb and hb:IsA("BasePart")) and hb or (f:IsA("Model") and f.PrimaryPart) or f
        bolaValida = true
        return
    end
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") and c.Name ~= "Football" then
            local f2 = c:FindFirstChild("Football")
            if f2 then
                bola = f2
                local hb = f2:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or (f2:IsA("Model") and f2.PrimaryPart) or f2
                bolaValida = true
                return
            end
        end
    end
    bola = nil; hitbox = nil; bolaValida = false
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
