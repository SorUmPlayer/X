-- Carregamento da Biblioteca WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Criação da Janela Principal
local Window = WindUI:CreateWindow({
    Title = "Blue Lock System - Spin Manager",
    Icon = "rotate-cw",
    Author = "Developer",
    Folder = "SpinManagerConfig",
    Size = UDim2.fromOffset(550, 400),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 180,
    HasOutline = true
})

-- Abas
local MainTab = Window:Tab({ Title = "Spin", Icon = "dices" })
local SettingsTab = Window:Tab({ Title = "Configurações", Icon = "settings" })

-- Estado Interno (State)
local State = {
    IsSpinning = false,
    AutoSpin = false,
    CurrentStyle = "Nenhum",
    TargetRarity = "World Class"
}

-- Lista de raridades/estilos simulados
local AvailableStyles = {
    { Name = "Basic Player", Rarity = "Common", Chance = 50 },
    { Name = "Barou", Rarity = "Rare", Chance = 30 },
    { Name = "Nagi", Rarity = "Epic", Chance = 15 },
    { Name = "Rin", Rarity = "Legendary", Chance = 4 },
    { Name = "Kaiser", Rarity = "World Class", Chance = 1 }
}

-- Função local para simulação do sorteio
local function PerformSpin()
    local roll = math.random(1, 100)
    if roll <= 1 then return AvailableStyles[5] end
    if roll <= 5 then return AvailableStyles[4] end
    if roll <= 20 then return AvailableStyles[3] end
    if roll <= 50 then return AvailableStyles[2] end
    return AvailableStyles[1]
end

-- UI - Seção Principal
local SpinSection = MainTab:Section({ Title = "Controle de Giros" })

local StyleDisplay = SpinSection:Paragraph({
    Title = "Estilo Atual",
    Desc = "Nenhum estilo obtido."
})

-- Botão de Giro Único
SpinSection:Button({
    Title = "Girar Estilo",
    Desc = "Consome 1 spin para obter um novo estilo",
    Callback = function()
        if State.IsSpinning then return end
        State.IsSpinning = true
        
        StyleDisplay:SetTitle("Girando...")
        StyleDisplay:SetDesc("Aguardando resposta...")
        
        task.wait(0.8) -- Tempo de rotação
        
        local result = PerformSpin()
        State.CurrentStyle = result.Name .. " (" .. result.Rarity .. ")"
        
        StyleDisplay:SetTitle("Estilo Obtido")
        StyleDisplay:SetDesc(State.CurrentStyle)
        
        WindUI:Notify({
            Title = "Spin Concluído",
            Content = "Você tirou: " .. State.CurrentStyle,
            Duration = 3
        })
        
        State.IsSpinning = false
    end
})

-- Toggle de Auto Spin com Loop Controlado
SpinSection:Toggle({
    Title = "Auto Spin Loop",
    Desc = "Executa giros contínuos até atingir a raridade desejada",
    Value = false,
    Callback = function(Value)
        State.AutoSpin = Value
        
        if State.AutoSpin then
            task.spawn(function()
                while State.AutoSpin do
                    if not State.IsSpinning then
                        State.IsSpinning = true
                        
                        StyleDisplay:SetTitle("Auto Spin em andamento...")
                        task.wait(0.4)
                        
                        local result = PerformSpin()
                        State.CurrentStyle = result.Name .. " (" .. result.Rarity .. ")"
                        
                        StyleDisplay:SetTitle("Estilo Atual")
                        StyleDisplay:SetDesc(State.CurrentStyle)
                        
                        -- Parar se atingir a raridade alvo
                        if result.Rarity == State.TargetRarity then
                            State.AutoSpin = false
                            WindUI:Notify({
                                Title = "Meta Atingida!",
                                Content = "Conseguiu: " .. State.CurrentStyle,
                                Duration = 5
                            })
                            State.IsSpinning = false
                            break
                        end
                        
                        State.IsSpinning = false
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

-- Configuração da Meta do Auto Spin
SettingsTab:Dropdown({
    Title = "Parar no Estilo/Raridade",
    Desc = "O Auto Spin será interrompido ao obter esta raridade",
    Values = { "Rare", "Epic", "Legendary", "World Class" },
    Value = "World Class",
    Callback = function(Selected)
        State.TargetRarity = Selected
    end
})
