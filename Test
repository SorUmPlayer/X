-- 6. LOOP DE REPLICAÇÃO DAS MÃOS (MOTOR6D)
RunService.Stepped:Connect(function()
    if not VR_Enabled then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local LeftInput = GetLeftInput()
    local RightInput = GetRightInput()

    LeftX = math.clamp(LeftX - (LeftInput.Y * Sensitivity), -2.2, 2.2)
    LeftY = math.clamp(LeftY - (LeftInput.X * Sensitivity), -2.2, 2.2)

    RightX = math.clamp(RightX - (RightInput.Y * Sensitivity), -2.2, 2.2)
    RightY = math.clamp(RightY - (RightInput.X * Sensitivity), -2.2, 2.2)

    local LeftShoulder = Character:FindFirstChild("Left Shoulder", true) or Character:FindFirstChild("LeftShoulder", true)
    local RightShoulder = Character:FindFirstChild("Right Shoulder", true) or Character:FindFirstChild("RightShoulder", true)

    if LeftShoulder then
        LeftShoulder.Transform = CFrame.new()
        LeftShoulder.C0 = CFrame.new(-1, 0.5, 0) * CFrame.Angles(LeftX, LeftY, 0) * CFrame.Angles(0, -math.pi/2, 0)
    end

    if RightShoulder then
        RightShoulder.Transform = CFrame.new()
        RightShoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(RightX, RightY, 0) * CFrame.Angles(0, math.pi/2, 0)
    end
end)

-- 7. CÂMERA E ROTAÇÃO REALISTA DE CABEÇA/CORPO (VR HEAD LOOK)
RunService.RenderStepped:Connect(function(deltaTime)
    if not VR_Enabled then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    local Neck = Character:FindFirstChild("Neck", true)

    if FirstPerson_Lock then
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 0.5
    else
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 400
    end

    if Humanoid and RootPart then
        Humanoid.AutoRotate = false

        -- Cálculo do ângulo entre Câmera e Corpo
        local Camera = workspace.CurrentCamera
        local _, CamYaw, _ = Camera.CFrame:ToOrientation()
        local _, RootYaw, _ = RootPart.CFrame:ToOrientation()

        local YawDiff = math.deg(CamYaw - RootYaw)
        YawDiff = (YawDiff + 180) % 360 - 180 -- Normaliza [-180, 180]

        local MaxHeadAngle = 60 -- Limite de giro da cabeça antes do corpo girar

        -- Se olhar além de 60 graus, o corpo roda para acompanhar
        if math.abs(YawDiff) > MaxHeadAngle then
            local Overflow = (YawDiff > 0 and (YawDiff - MaxHeadAngle) or (YawDiff + MaxHeadAngle))
            local NewRootYaw = RootYaw + math.rad(Overflow)
            RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, NewRootYaw, 0)
            YawDiff = math.clamp(YawDiff, -MaxHeadAngle, MaxHeadAngle)
        end

        -- Aplica rotação ao pescoço (Giro da Cabeça VR)
        if Neck then
            Neck.Transform = CFrame.new()
            Neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(0, math.rad(YawDiff), 0)
        end

        -- Balanço de Caminhada (Head Bobbing)
        if Humanoid.MoveDirection.Magnitude > 0 then
            BobStep = BobStep + (deltaTime * Humanoid.WalkSpeed * 1.3)
            local BobOffset = Vector3.new(
                math.cos(BobStep * 0.5) * 0.12,
                math.abs(math.sin(BobStep)) * 0.18,
                0
            )
            Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(BobOffset, 0.2)
        else
            Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(Vector3.new(0, 0, 0), 0.15)
        end
    end
end)
