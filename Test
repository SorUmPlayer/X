-- =============================================
-- ATIVA MASTER CONTROL E CRIA APLICATIVO
-- =============================================
local function ativarControleMestre()
    -- Injeção de valores Master Control
    pcall(function()
        local function addValor(caminho, nome)
            if caminho then
                local item = caminho:FindFirstChild(nome)
                if not item then
                    item = Instance.new("BoolValue")
                    item.Name = nome
                    item.Value = true
                    item.Parent = caminho
                else
                    if item:IsA("BoolValue") then item.Value = true end
                end
            end
        end
        local attrs = LocalPlayer:FindFirstChild("atributos")
        if attrs then
            local props = attrs:FindFirstChild("Ominitrix_Properties") or Instance.new("Folder", attrs)
            props.Name = "Ominitrix_Properties"
            addValor(props, "MasterControl")
            addValor(props, "Partial_MasterControl")
        end
        local inv = LocalPlayer:FindFirstChild("Inventory")
        if inv then
            local f1 = inv:FindFirstChild("Ominitrix_Unlocker") or Instance.new("Folder", inv)
            f1.Name = "Ominitrix_Unlocker"
            local f2 = f1:FindFirstChild("Ominitrix_Unlocker") or Instance.new("Folder", f1)
            f2.Name = "Ominitrix_Unlocker"
            addValor(f2, "Give_Master_Control")
        end
    end)

    -- Cria o aplicativo "S"
    criarAplicativoS()

    StarterGui:SetCore("SendNotification", {
        Title = "Omnitrix",
        Text = "Master Control ativado! App 'S' no celular.",
        Duration = 3
    })
end

