-- Carregamento seguro da WindUI
local WindUI
local success, err = pcall(function()
    WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()
end)

if not success or not WindUI then
    WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
end

-- Função para localizar o alvo com tempo de espera
local function getTarget()
    local area = workspace:WaitForChild("AreaEggSlotsClient", 5)
    if not area then return nil end
    
    -- Busca pelo ID específico
    local target = area:FindFirstChild("02057d36e0954bb79f2f3c0eec10b213")
    
    -- Caso o ID mude/não exista, pega o primeiro slot disponível na pasta
    if not target then
        target = area:GetChildren()[1]
    end
    
    return target
end

-- Função de Teleporte
local function teleportToTarget()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    local targetObject = getTarget()

    if hrp and targetObject then
        if targetObject:IsA("Model") then
            hrp.CFrame = targetObject:GetPivot()
        elseif targetObject:IsA("BasePart") then
            hrp.CFrame = targetObject.CFrame
        else
            WindUI:Notify({ Title = "Erro", Content = "Objeto não tem posição física.", Duration = 3 })
        end
    else
        WindUI:Notify({ Title = "Aviso", Content = "Alvo ou HumanoidRootPart não encontrado!", Duration = 3 })
    end
end

