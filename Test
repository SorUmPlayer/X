-- Loop 3: Quebrar Máquinas na pasta Template1
task.spawn(function()
    while true do
        task.wait(Config.Delay)
        if Config.TemplateEnabled and DamageEvent then
            local templateFolder = workspace:FindFirstChild("Map") 
                and workspace.Map:FindFirstChild("Buildings") 
                and workspace.Map.Buildings:FindFirstChild("GasStation") 
                and workspace.Map.Buildings.GasStation:FindFirstChild("Templates") 
                and workspace.Map.Buildings.GasStation.Templates:FindFirstChild("Template1")

            if templateFolder then
                for _, child in ipairs(templateFolder:GetChildren()) do
                    if not Config.TemplateEnabled then break end
                    pcall(function()
                        DamageEvent:FireServer(
                            "DamageToOpen",
                            "Damage",
                            child,
                            Config.TemplateDamage,
                            "melee"
                        )
                    end)
                end
            end
        end
    end
end)

