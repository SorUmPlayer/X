-- =====================================================
--  FUNÇÃO SEGURA DE PARENT
-- =====================================================
local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

-- =====================================================
--  DETECÇÃO DA BOLA (DINÂMICA)
-- =====================================================
local function getBall()
    -- 1. Procura bola solta (workspace.Terrain.Ball)
    local terrain = Workspace:FindFirstChild("Terrain")
    if terrain then
        local ball = terrain:FindFirstChild("Ball")
        if ball and ball:IsA("BasePart") then
            return ball
        end
    end

    -- 2. Procura bola em posse de algum jogador (workspace.characters.*.Ball)
    local characters = Workspace:FindFirstChild("characters")
    if characters then
        for _, charModel in ipairs(characters:GetChildren()) do
            if charModel:IsA("Model") then
                local ball = charModel:FindFirstChild("Ball")
                if ball and ball:IsA("BasePart") then
                    return ball
                end
            end
        end
    end

    -- 3. Fallback: procura por qualquer parte com "Ball" no nome
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Ball" then
            return obj
        end
    end

    return nil
end

local function getHitbox()
    -- No Azure Lock, a própria bola é a hitbox
    return getBall()
end

-- =====================================================
--  POSSE DA BOLA
-- =====================================================
local function euTenhoBola()
    local characters = Workspace:FindFirstChild("characters")
    if characters then
        local myChar = characters:FindFirstChild(player.Name)
        if myChar then
            local ball = myChar:FindFirstChild("Ball")
            if ball then return true end
        end
    end
    return false
end

-- =====================================================
--  DETECÇÃO DE TIME (fallback)
-- =====================================================
local function getMyTeam()
    local values = player:FindFirstChild("Values")
    if values then
        local teamVal = values:FindFirstChild("Team")
        if teamVal then
            return tostring(teamVal.Value)
        end
    end
    return nil
end

