-- =====================================================
--  LÓGICA DE BLOQUEIO DO AIMBOT (DELAY)
-- =====================================================
local function shouldAimbotWork()
    local tenho = euTenhoBola()
    if tenho then
        aimbotBlocked = true
        aimbotBlockedUntil = tick() + aimbotDelayValue
        return false
    end
    if aimbotBlocked then
        if tick() >= aimbotBlockedUntil then
            aimbotBlocked = false
            return true
        else
            return false
        end
    end
    return true
end

