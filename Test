local function isTackleAnim(char)
    local h = char:FindFirstChild("Humanoid")
    if not h then return false end
    local anim = h:FindFirstChild("Animator") or h
    for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
        if t.Animation then
            local id = tostring(t.Animation.AnimationId):lower()
            for _, p in ipairs(tackleAnimIds) do
                if string.find(id, p) then return true end
            end
        end
    end
    return false
end

local function antiTackle()
    if tick() - tackleCooldown < 0.5 then return end
    local char = player.Character
    if not char then return end
    local mh = char:FindFirstChild("HumanoidRootPart")
    if not mh then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local eh = p.Character:FindFirstChild("HumanoidRootPart")
            if eh then
                local d = (eh.Position - mh.Position).Magnitude
                if d < 8 and isTackleAnim(p.Character) then
                    local w = Instance.new("TextLabel")
                    w.Size = UDim2.new(0, 200, 0, 30)
                    w.Position = UDim2.new(0.5, -100, 0.7, 0)
                    w.BackgroundTransparency = 1
                    w.TextColor3 = Color3.fromRGB(255, 0, 0)
                    w.TextStrokeTransparency = 0
                    w.Text = "⚠️ RASTEIRA DETECTADA!"
                    w.Font = Enum.Font.GothamBold
                    w.TextSize = 18
                    w.Parent = player.PlayerGui
                    game:GetService("Debris"):AddItem(w, 0.8)
                    tackleCooldown = tick()
                    break
                end
            end
        end
    end
end

