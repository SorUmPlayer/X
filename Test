-- Services
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

-- Configurações
local HitboxEnabled = false
local HitboxSize = 15
local MinSize = 1
local MaxSize = 50

-- Remove UI antiga
if CoreGui:FindFirstChild("BallHitboxUI") then
    CoreGui.BallHitboxUI:Destroy()
end

-- ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BallHitboxUI"
ScreenGui.Parent = CoreGui

-- Frame Voador (Janela Arrastável)
local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 200, 0, 110)
Frame.Position = UDim2.new(0.5, -100, 0.4, 0)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Parent = ScreenGui

local FrameCorner = Instance.new("UICorner", Frame)
FrameCorner.CornerRadius = UDim.new(0, 8)

-- Arrastar Janela (Voador)
local dragging, dragStart, startPos
Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
    end
end)

Frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Botão ON / OFF
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.9, 0, 0, 32)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.12, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
ToggleBtn.Text = "Hitbox: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 15
ToggleBtn.Parent = Frame

local BtnCorner = Instance.new("UICorner", ToggleBtn)
BtnCorner.CornerRadius = UDim.new(0, 6)

ToggleBtn.MouseButton1Click:Connect(function()
    HitboxEnabled = not HitboxEnabled
    if HitboxEnabled then
        ToggleBtn.Text = "Hitbox: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        ToggleBtn.Text = "Hitbox: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end)

-- Slider (1 a 50)
local SliderLabel = Instance.new("TextLabel")
SliderLabel.Size = UDim2.new(0.9, 0, 0, 20)
SliderLabel.Position = UDim2.new(0.05, 0, 0.48, 0)
SliderLabel.BackgroundTransparency = 1
SliderLabel.Text = "Tamanho: " .. HitboxSize
SliderLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
SliderLabel.Font = Enum.Font.SourceSans
SliderLabel.TextSize = 13
SliderLabel.Parent = Frame

local SliderTrack = Instance.new("Frame")
SliderTrack.Size = UDim2.new(0.9, 0, 0, 6)
SliderTrack.Position = UDim2.new(0.05, 0, 0.72, 0)
SliderTrack.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SliderTrack.Parent = Frame

local TrackCorner = Instance.new("UICorner", SliderTrack)

local SliderKnob = Instance.new("Frame")
SliderKnob.Size = UDim2.new(0, 14, 0, 14)
SliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
SliderKnob.Position = UDim2.new((HitboxSize - MinSize) / (MaxSize - MinSize), 0, 0.5, 0)
SliderKnob.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
SliderKnob.Parent = SliderTrack

local KnobCorner = Instance.new("UICorner", SliderKnob)
KnobCorner.CornerRadius = UDim.new(1, 0)

-- Lógica Slider
local sliding = false
local function updateSlider(input)
    local percentage = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
    HitboxSize = math.floor(MinSize + (MaxSize - MinSize) * percentage)
    SliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)
    SliderLabel.Text = "Tamanho: " .. HitboxSize
end

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

-- Loop da Hitbox Dinâmica (detecta CLIENT_BALL_...)
task.spawn(function()
    while task.wait(0.1) do
        if HitboxEnabled then
            for _, item in ipairs(workspace:GetChildren()) do
                if string.sub(item.Name, 1, 12) == "CLIENT_BALL_" then
                    local parts = item:IsA("BasePart") and {item} or item:GetDescendants()
                    for _, part in ipairs(parts) do
                        if part:IsA("BasePart") then
                            part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                            part.Transparency = 0.5
                            part.CanCollide = false
                        end
                    end
                end
            end
        end
    end
end)
