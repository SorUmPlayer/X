-- 1. Proteção no setclipboard (evita que o script quebre se o executor não suportar)
local youtubeLink = "https://youtube.com/@sorumplayer?si=iLitOk-G9jOO-0bp"
pcall(function()
    if setclipboard then
        setclipboard(youtubeLink)
    end
end)

-- 2. Carregando o WindUI com Link Alternativo de Segurança
local success, WindUI = pcall(function()
    -- Tenta o link principal
    return loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()
end)

if not success or not WindUI then
    print("Link principal do WindUI falhou. Tentando link alternativo...")
    success, WindUI = pcall(function()
        -- Tenta o link raw do GitHub caso a API Vercel esteja fora do ar
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesys/WindUI/main/macaw.lua"))()
    end)
end

if not success or not WindUI then
    warn("Erro: O seu executor não conseguiu baixar o WindUI. Verifique a internet ou teste outro executor.")
    return -- Para o script aqui para não gerar mais erros
end

-- 3. Criando a Janela Principal
local Window = WindUI:CreateWindow({
    Title = "Menu de Tradução",
    Icon = "lucide-globe",
    Author = "sorumplayer",
    Folder = "SorumScript",
    Size = UDim2.fromOffset(500, 400),
    Transparent = false,
    Theme = "Dark",
    SideBarWidth = 150,
    HasOutline = true
})

-- Ajustando cores: Menu Verde com Texto Branco
WindUI:SetTheme({
    Accent = Color3.fromRGB(40, 200, 40),
    Text = Color3.fromRGB(255, 255, 255)
})

-- 4. Criando a Aba e o Texto
local MainTab = Window:Tab({
    Title = "Idiomas",
    Icon = "lucide-message-square"
})

local Message = MainTab:Paragraph({
    Title = "Mensagem",
    Desc = "Olá! Escolha o seu idioma clicando nos botões abaixo."
})

MainTab:Divider()

-- 5. Botões de Tradução
MainTab:Button({
    Title = "🟢 Português",
    Desc = "Mudar texto para Português",
    Callback = function()
        Message:Set({
            Title = "Mensagem",
            Desc = "Olá! Escolha o seu idioma clicando nos botões abaixo."
        })
    end
})

MainTab:Button({
    Title = "🔵 English",
    Desc = "Change text to English",
    Callback = function()
        Message:Set({
            Title = "Message",
            Desc = "Hello! Choose your language by clicking the buttons below."
        })
    end
})

MainTab:Button({
    Title = "🟠 Espanhol",
    Desc = "Cambiar texto al Español",
    Callback = function()
        Message:Set({
            Title = "Mensaje",
            Desc = "¡Hola! Elige tu idioma haciendo clic en los botones de abajo."
        })
    end
})

MainTab:Divider()

-- 6. Botão extra para copiar o link manualmente
MainTab:Button({
    Title = "🔗 Copiar link",
    Desc = "Copia o link do canal do YouTube",
    Callback = function()
        pcall(function()
            if setclipboard then
                setclipboard(youtubeLink)
                WindUI:Notify({
                    Title = "Sucesso!",
                    Content = "Link copiado para a área de transferência.",
                    Duration = 3,
                })
            end
        end)
    end
})

print("Script carregado com sucesso!")

