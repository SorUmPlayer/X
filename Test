-- =============================================
-- HITBOX REACH (força toque à distância)
-- =============================================
local function aplicarHitboxReach()
    if not hitboxAtivo then
        if espSphere then espSphere:Destroy() espSphere = nil end
        return
    end

    local ball = getBall()
    if not ball or euTenhoBola() then
        if espSphere then espSphere:Destroy() espSphere = nil end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - ball.Position).Magnitude

    if dist <= hitboxTamanho then
        if firetouchinterest and (tick() - hitboxCooldown > 0.05) then
            hitboxCooldown = tick()
            pcall(function()
                firetouchinterest(hrp, ball, 0)
                task.wait(0.01)
                firetouchinterest(hrp, ball, 1)
            end)
        end
    end

    -- ESP visual
    if espHitbox then
        if not espSphere or not espSphere.Parent then
            if espSphere then espSphere:Destroy() end
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = "ReachESP"
            espSphere.Adornee = ball
            espSphere.Parent = ball
            espSphere.Color3 = Color3.fromRGB(0, 255, 0)
            espSphere.Transparency = 0.6
        end
        local scale = hitboxTamanho / 2.5
        espSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espSphere then espSphere:Destroy() espSphere = nil end
    end
end

-- =============================================
-- INFINITE STAMINA (FireServer no Speed)
-- =============================================
local function infiniteStamina()
    task.spawn(function()
        while true do
            pcall(function()
                local staminaGui = player.PlayerGui:FindFirstChild("Stamina")
                if staminaGui then
                    local frame = staminaGui:FindFirstChild("Frame")
                    if frame then
                        local speedEvent = frame:FindFirstChild("Speed")
                        if speedEvent then
                            speedEvent:FireServer(10525299, 9999)
                        end
                    end
                end
            end)
            task.wait(0.3)
        end
    end)
end

