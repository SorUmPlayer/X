-- =============================================
-- REFERÊNCIAS DA BOLA
-- =============================================
local function getBall()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        local animBall = basketball:FindFirstChild("AnimBall")
        if animBall then return animBall end
    end
    return nil
end

local function getCollider()
    local basketball = Workspace:FindFirstChild("Basketball")
    if basketball then
        local collider = basketball:FindFirstChild("Collider")
        if collider then return collider end
    end
    return nil
end

local function getAro(team)
    if team == "Home" then
        return Workspace:FindFirstChild("AnimatedHome")
    elseif team == "Away" then
        return Workspace:FindFirstChild("AnimatedAway")
    end
    return nil
end

