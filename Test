-- [[ Blue Lock: Rivals - Reo Mikage Skill System (Tool + Tecla E) ]] --

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local CopiedSkillName = "Nenhuma"
local CopiedTarget = nil

-- Função para localizar o jogador mais próximo
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local myPos = myChar.HumanoidRootPart.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (myPos - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- Efeito Visual da Aura Roxa do Reo Mikage
local function ApplyReoAura(character)
    if not character then return end
    
    local highlight = character:FindFirstChild("ReoChameleonAura") or Instance.new("Highlight")
    highlight.Name = "ReoChameleonAura"
    highlight.FillColor = Color3.fromRGB(147, 51, 234) -- Roxo característico do Reo
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0
    highlight.Parent = character
    
    task.delay(2.5, function()
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end)
end

-- Execução da Habilidade de Cópia
local function ActivateReoSkill(toolObject)
    local target = GetClosestPlayer()
    local myChar = LocalPlayer.Character
    
    if target and target.Character then
        CopiedTarget = target
        
        -- Busca a ferramenta/estilo do jogador mais próximo
        local targetTool = target.Character:FindFirstChildOfClass("Tool") 
            or target.Backpack:FindFirstChildOfClass("Tool")
        
        CopiedSkillName = targetTool and targetTool.Name or ("Estilo de " .. target.DisplayName)
        
        -- Atualiza o nome da Skill na Hotbar para mostrar o que foi roubado
        if toolObject then
            toolObject.Name = "⚡ [Reo] " .. CopiedSkillName
        end
        
        -- Ativa a Aura do Reo no seu personagem
        ApplyReoAura(myChar)
        
        print("[REO SKILL] Skill roubada do jogador @" .. target.Name .. ": " .. CopiedSkillName)
    else
        print("[REO SKILL] Nenhum jogador próximo encontrado para copiar.")
    end
end

-- Função para criar a Skill no Inventário (Backpack/Hotbar)
local function CreateReoTool()
    local backpack = LocalPlayer:WaitForChild("Backpack")
    
    -- Limpa versões antigas caso já exista
    for _, item in ipairs(backpack:GetChildren()) do
        if item.Name:sub(1, 6) == "🟣 Skill" or item.Name:sub(1, 7) == "⚡ [Reo]" then
            item:Destroy()
        end
    end
    
    local skillTool = Instance.new("Tool")
    skillTool.Name = "🟣 Skill: Roubo Camaleão"
    skillTool.RequiresHandle = false
    skillTool.CanBeDropped = false
    
    -- Ao clicar na Skill/Tool equipada
    skillTool.Activated:Connect(function()
        ActivateReoSkill(skillTool)
    end)
    
    skillTool.Parent = backpack
    return skillTool
end

-- Criar a Skill na Hotbar assim que o script é executado
local currentSkillTool = CreateReoTool()

-- Recolocar a Skill no Inventário se o seu personagem morrer/renascer (Respawn)
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    currentSkillTool = CreateReoTool()
end)

-- Atalho de Teclado (Pressionar 'E' aciona a skill diretamente)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E then
        ActivateReoSkill(currentSkillTool)
    end
end)
