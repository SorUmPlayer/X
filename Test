-- Carregamento robusto da WindUI compatível com múltiplos executores
local success, WindUI = pcall(function()
    local url = "https://raw.githubusercontent.com/FootagesDropdown/WindUI/main/main.lua"
    local req = (syn and syn.request) or request or (http and http.request) or http_request
    
    if req then
        local response = req({Url = url, Method = "GET"})
        if response and response.Body then
            return loadstring(response.Body)()
        end
    end
    
    return loadstring(game:HttpGet(url))()
end)

if not success or not WindUI then
    warn("[KillAura] ERRO: O executor bloqueou o carregamento da WindUI ou não suporta loadstring.")
    return
end

-- Serviços
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Caminho do Evento
local DamageEvent = ReplicatedStorage:WaitForChild("FlowClient"):WaitForChild("ClientRunner"):WaitForChild("Event")

-- Configurações e Estado
local Config = {
    Enabled = false,
    Damage = 13.65,
    Distance = 50,
    Delay = 0.2
}

-- Obter posição do jogador
local function GetPlayerPosition()
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position end
    end
    return nil
end

-- Varredura de todos os Humanóides dentro de workspace.NPCs (incluindo subpastas)
local function GetTargetsInFolder(folder)
    local targets = {}
    if not folder then return targets end

    for _, desc in ipairs(folder:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Health > 0 then
            local parentModel = desc.Parent
            if parentModel and parentModel:IsA("Model") then
                local hrp = parentModel:FindFirstChild("HumanoidRootPart") or parentModel.PrimaryPart
                targets[#targets + 1] = {
                    Humanoid = desc,
                    Part = hrp
                }
            end
        end
    end

    return targets
end

-- Loop do Kill Aura
task.spawn(function()
    while true do
        task.wait(Config.Delay)

        if Config.Enabled and DamageEvent then
            local playerPos = GetPlayerPosition()
            local npcsFolder = workspace:FindFirstChild("NPCs")

            if playerPos and npcsFolder then
                local targets = GetTargetsInFolder(npcsFolder)

                for _, targetData in ipairs(targets) do
                    if not Config.Enabled then break end

                    local humanoid = targetData.Humanoid
                    local part = targetData.Part

                    if humanoid and humanoid.Health > 0 then
                        local inRange = true

                        if part then
                            local dist = (playerPos - part.Position).Magnitude
                            if dist > Config.Distance then
                                inRange = false
                            end
                        end

                        if inRange then
                            pcall(function()
                                DamageEvent:FireServer(
                                    "NPCs",
                                    "Damage",
                                    humanoid,
                                    Config.Damage
                                )
                            end)
                        end
                    end
                end
            end
        end
    end
end)

-- Interface WindUI (Menu Flutuante)
local Window = WindUI:CreateWindow({
    Title = "Kill Aura - NPCs",
    Icon = "rbxassetid://4483345998",
    Folder = "KillAuraConfig",
    Size = UDim2.fromOffset(380, 280),
    Transparent = true,
    Theme = "Dark"
})

local MainTab = Window:Tab({ Title = "Main", Icon = "sword" })

MainTab:Section({ Title = "Configurações" })

-- Input de Dano
MainTab:Input({
    Title = "Dano",
    Desc = "Valor numérico do dano",
    Value = tostring(Config.Damage),
    Placeholder = "Ex: 13.65",
    Callback = function(text)
        local num = tonumber(text)
        if num then Config.Damage = num end
    end
})

-- Input de Distância
MainTab:Input({
    Title = "Distância Máxima",
    Desc = "Alcance em studs",
    Value = tostring(Config.Distance),
    Placeholder = "Ex: 50",
    Callback = function(text)
        local num = tonumber(text)
        if num then Config.Distance = num end
    end
})

-- Toggle para Ativar/Desativar
MainTab:Toggle({
    Title = "Ativar Kill Aura",
    Desc = "Ataca todos os NPCs na pasta workspace.NPCs",
    Value = Config.Enabled,
    Callback = function(state)
        Config.Enabled = state
    end
})
