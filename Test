local selectedEggName = nil
local tpSpeed = 80 -- Velocidade padrão mais segura contra kicks
local isTeleporting = false
local returnCFrame = CFrame.new(509, 71, -372)

-- Pega a lista de ovos da pasta
local function getEggList()
    local list = {}
    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    if area then
        for _, child in ipairs(area:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    if #list == 0 then table.insert(list, "Nenhum ovo encontrado") end
    return list
end

-- Teleporte seguro pelo ar (evita chão e anti-cheat)
local function safeTweenTo(targetCFrame)
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    -- Margem de +3 studs na altura para não entrar no chão
    local finalCFrame = targetCFrame + Vector3.new(0, 3, 0)
    
    local startPos = hrp.Position
    local endPos = finalCFrame.Position
    
    -- Calcula uma altura segura acima da origem e do destino (+15 studs)
    local safeY = math.max(startPos.Y, endPos.Y) + 15

    -- Waypoints: Subir -> Ir pelo alto -> Descer no alvo
    local waypoints = {
        CFrame.new(startPos.X, safeY, startPos.Z),
        CFrame.new(endPos.X, safeY, endPos.Z),
        finalCFrame
    }

    -- Ajusta gravidade e estado para evitar detecção de física do Roblox
    local oldGravity = workspace.Gravity
    workspace.Gravity = 0
    if humanoid then humanoid.PlatformStand = true end

    -- Noclip durante o percurso
    local noclipConn = RunService.Stepped:Connect(function()
        if player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    -- Executa o trajeto em etapas
    for _, wpCFrame in ipairs(waypoints) do
        local dist = (hrp.Position - wpCFrame.Position).Magnitude
        local duration = dist / math.max(tpSpeed, 1)

        if duration > 0.02 then
            local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = wpCFrame})
            tween:Play()
            tween.Completed:Wait()
        end
    end

    -- Restaura físicas normais
    noclipConn:Disconnect()
    workspace.Gravity = oldGravity
    if humanoid then humanoid.PlatformStand = false end
end

-- Acionar ProximityPrompt
local function triggerPrompt(targetObj)
    task.wait(0.3)
    if not targetObj then return end
    local prompt = targetObj:FindFirstChildOfClass("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end
    end
end

-- Ciclo Principal
local function startCycle()
    if isTeleporting then return end

    if not selectedEggName or selectedEggName == "" or selectedEggName == "Nenhum ovo encontrado" then
        WindUI:Notify({ Title = "Erro", Content = "Selecione um ovo no Dropdown!", Duration = 3 })
        return
    end

    local area = workspace:FindFirstChild("AreaEggSlotsClient")
    local eggTarget = area and area:FindFirstChild(selectedEggName)

    if not eggTarget then
        WindUI:Notify({ Title = "Erro", Content = "Ovo não encontrado no Workspace!", Duration = 3 })
        return
    end

    isTeleporting = true

    local targetCFrame
    if eggTarget:IsA("Model") then
        targetCFrame = eggTarget:GetPivot()
    elseif eggTarget:IsA("BasePart") then
        targetCFrame = eggTarget.CFrame
    end

    if targetCFrame then
        WindUI:Notify({ Title = "Teleporte", Content = "Viajando pelo ar até o ovo...", Duration = 2 })
        safeTweenTo(targetCFrame)

        WindUI:Notify({ Title = "Coleta", Content = "Ativando ProximityPrompt...", Duration = 2 })
        triggerPrompt(eggTarget)
        task.wait(0.5)

        WindUI:Notify({ Title = "Retorno", Content = "Voltando para a base...", Duration = 2 })
        safeTweenTo(returnCFrame)

        WindUI:Notify({ Title = "Sucesso", Content = "Ciclo Concluído!", Duration = 3 })
    end

    isTeleporting = false
end

