local function onChatMessage(msg)
    local lower = msg:lower()
    if lower:match("^força da bola") then
        local num = msg:match("^força da bola (%d+)")
        if num then
            local val = tonumber(num)
            if val and val > 0 and val <= 200 then
                forcaBolaVelocidade = val; Config.forcaBolaVelocidade = val; SaveConfig()
                player:Chat("Força da bola ajustada para " .. val)
            else player:Chat("Use um número entre 1 e 200.") end
        else player:Chat("Use: Força da bola [número]") end
    end
    local n1 = msg:match("^velocidade%s+(%d+)")
    local n2 = msg:match("^(%d+)$")
    local num = n1 or n2
    if num then
        local val = tonumber(num)
        if val and val >= 0 and val <= 200 then
            atualizarSliderVisual(val)
            player:Chat("Velocidade da bola ajustada para " .. val)
        end
    end
end

