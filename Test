task.spawn(function()
    while true do
        task.wait(1)
        if not bolaValida or not hitbox then atualizarReferenciaBola() end
    end
end)

local function getBall()
    if bola and bolaValida then return bola end
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then return ballAnims end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

-- Retorna a bola somente se estiver LIVRE (workspace.Football, não presa a nenhum player)
local function getFreeBall()
    if alguemTemBola and alguemTemBola() then return nil end
    local football = Workspace:FindFirstChild("Football")
    if not football then return nil end
    local ballAnims = football:FindFirstChild("BallAnims")
    if ballAnims then
        if ballAnims:IsA("BasePart") then return ballAnims end
        return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
    end
    return football
end

local function euTenhoBola()
    local meuModel = Workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then return true end
    return false
end

local function alguemTemBola()
